# Copy this to .env and adjust for your home lab.
# The web server binds :8080 on the tailnet; do not expose it publicly (ADR 0009).

# Postgres password (used by both db and web)
MOUSEION_DB_PASSWORD=change-me-strong-password

# App-level secret (encrypts OPDS connection passwords at rest)
MOUSEION_SECRET=change-me-to-a-long-random-string

# "true" only if serving HTTPS (tailscale cert / TLS reverse proxy); default false (plain HTTP over tailnet)
MOUSEION_COOKIE_SECURE=false

# Optional external translation. Prepared-deck translation requires the
# official OpenAI API base URL; custom OpenAI-compatible endpoints remain
# available only to non-prepared-deck enrichment.
MOUSEION_LLM_ENABLED=false
MOUSEION_LLM_API_KEY=
MOUSEION_LLM_MODEL=
MOUSEION_LLM_BASE_URL=https://api.openai.com/v1
MOUSEION_LLM_TIMEOUT=30s
MOUSEION_LLM_REASONING_EFFORT=low
MOUSEION_LLM_SUPPORTS_REASONING_EFFORT=false

# Prepared-deck Batch operations (accepted defaults).
MOUSEION_PREPARED_DECK_BATCH_MAX_REQUESTS=5000
MOUSEION_PREPARED_DECK_BATCH_POLL_INTERVAL=30s
