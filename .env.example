# Copy this to .env and adjust for your home lab.
# The web server binds :8080 on the tailnet; do not expose it publicly (ADR 0009).

# Postgres password (used by both db and web)
MOUSEION_DB_PASSWORD=change-me-strong-password

# App-level secret (encrypts OPDS connection passwords at rest)
MOUSEION_SECRET=change-me-to-a-long-random-string

# "true" only if serving HTTPS (tailscale cert / TLS reverse proxy); default false (plain HTTP over tailnet)
MOUSEION_COOKIE_SECURE=false
