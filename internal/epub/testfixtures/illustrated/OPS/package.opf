<?xml version="1.0" encoding="UTF-8"?>
<package xmlns="http://www.idpf.org/2007/opf" version="3.0" unique-identifier="book-id">
  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">
    <dc:identifier id="book-id">urn:mouseion:illustrated-fixture</dc:identifier>
    <dc:title>Illustrated Fixture</dc:title>
    <meta name="cover" content="cover-image"/>
  </metadata>
  <manifest>
    <item id="nav" href="Navigation/nav.xhtml" media-type="application/xhtml+xml" properties="nav"/>
    <item id="ncx" href="toc.ncx" media-type="application/x-dtbncx+xml"/>
    <item id="style" href="styles/book.css" media-type="text/css"/>
    <item id="chapter" href="Text/chapter.xhtml" media-type="application/xhtml+xml"/>
    <item id="plate" href="Text/plate.svg" media-type="image/svg+xml"/>
    <item id="cover-image" href="images/cover.jpg" media-type="image/jpeg"/>
    <item id="inline-image" href="images/figure.png" media-type="image/png"/>
    <item id="font-otf" href="fonts/book.otf" media-type="font/otf"/>
    <item id="font-legacy" href="fonts/legacy.ttf" media-type="application/x-font-ttf"/>
    <item id="audio" href="media/sample.mp3" media-type="audio/mpeg"/>
    <item id="video" href="media/sample.mp4" media-type="video/mp4"/>
  </manifest>
  <spine toc="ncx">
    <itemref idref="chapter"/>
    <itemref idref="plate"/>
    <itemref idref="nav"/>
  </spine>
  <guide>
    <reference type="cover" title="Cover" href="images/cover.jpg"/>
  </guide>
</package>
