package webapp

import (
	"fmt"
	"net/url"
	"github.com/justin-hayes/mouseion/internal/domain"
)

templ LemmaReviewPage(user domain.User, csrf, bookID, title, form, pageError string, canCorrect bool, occurrences []domain.LemmaReviewOccurrence, proposal *lemmaDecisionProposal, recovery lemmaReviewRecovery, suggestion *lemmaReviewSuggestion) {
	@ShellLayout("Review a word", &user, csrf, NavigationReadingJourney, shellStyleReading, shellStyleVocabulary) {
		<main class="page-container data-width lemma-review">
			<p><a href="/reading">Back to Reading</a></p>
			<h1>Review a word in { title }</h1>
			<p>Search one exact observed form in this Book's current analysis. Each decision starts with one occurrence; review sentence contexts and explicitly select any additional occurrences to include. Analyzer results remain unchanged.</p>
			if !recovery.ReferenceAssessed {
				<p role="status">Automatic German reference assessment is unavailable or not supported for this language. This is not a clean verdict; manual occurrence review remains available.</p>
			}
			<form method="get" action={ templ.SafeURL("/reading/books/"+bookID+"/lemma-review") }>
				<label>Exact observed form<input name="form" value={ form } required /></label>
				<button type="submit">Find occurrences</button>
			</form>
			if pageError != "" {
				<article role="alert">{ pageError }</article>
			}
			if recovery.ActiveReading {
				<article aria-labelledby="active-reading-lemma-recovery">
					<h2 id="active-reading-lemma-recovery">Stop before changing this Book's vocabulary</h2>
					<p>Reading uses a frozen snapshot. To use a corrected identity, stop this reading without marking it finished, review and confirm the occurrence decision, then start the Book again to create a new snapshot. Re-prepare its deck from that new snapshot if needed.</p>
					<p><a href="/reading">Open Reading to stop this Book</a></p>
				</article>
			}
			if recovery.ReadyPreparationID != "" {
				<article aria-labelledby="ready-deck-lemma-recovery">
					<h2 id="ready-deck-lemma-recovery">A ready deck is a historical artifact</h2>
					if recovery.ReadyDeckSnapshotID != "" {
						<p>The existing deck remains available for download and stays bound to its old Reading snapshot. After confirming an identity change, Mouseion will start a new Reading snapshot and prepare a new deck generation from it. The old artifact is not changed.</p>
						if recovery.ActiveReadingBookID != "" && recovery.ActiveReadingBookID != bookID {
							<p role="note">Another Book is current reading. Stop or switch that reading before confirming this recovery, so Mouseion can restart this Book with its corrected snapshot.</p>
						}
					} else {
						<p>The existing deck remains available for download. An identity-changing decision does not update it; after confirming a decision, explicitly re-prepare into a new generation. Do not use presentation-only re-rendering for a vocabulary identity change.</p>
					}
					<p><a href={ templ.SafeURL("/deck-preparations/"+recovery.ReadyPreparationID+"/download") }>Download the existing deck</a></p>
					if canCorrect && recovery.HasIdentityDecision && recovery.ReadyDeckSnapshotID == "" {
						<form method="post" action={ templ.SafeURL("/deck-preparations/"+recovery.ReadyPreparationID+"/reprepare") }>
							<input type="hidden" name="csrf_token" value={ csrf } />
							<button type="submit">Re-prepare deck with current vocabulary identities</button>
						</form>
					}
				</article>
			}
			if recovery.HasCompletedReading {
				<article aria-labelledby="completed-reading-lemma-recovery">
					<h2 id="completed-reading-lemma-recovery">Completed reading and Known vocabulary stay unchanged</h2>
					<p>This decision affects future vocabulary preparation only. Mouseion never rewrites finished Reading history or its Known facts. Importing a deck with changed note identities may leave an obsolete note in Anki; you may need to remove that note manually. Mouseion does not delete Anki notes.</p>
				</article>
			}
			if form != "" && len(occurrences) == 0 {
				<p role="status">No matching content-word occurrence was found in the current analysis. Check the exact spelling and try again.</p>
			}
			for i, occurrence := range occurrences {
				<article>
					<p class="reading-text">{ occurrence.SentenceText }</p>
					<p><strong>Observed form:</strong> { occurrence.Surface } · <strong>Analyzer lemma:</strong> { occurrence.CanonicalLemma } ({ occurrence.RawLemma }) · <strong>Part of speech:</strong> { occurrence.UPOS }</p>
					if occurrence.ReviewFlagReason != "" {
						if occurrence.ReviewFlagResolution == "" {
							<p role="alert"><strong>Needs learner review — not a verdict.</strong> { occurrence.ReviewFlagReason }</p>
						} else {
							<p role="status"><strong>Previously reviewed:</strong> { occurrence.ReviewFlagResolution }. New reference evidence does not reopen this decision.</p>
						}
						{{ evidence := evidenceForLemmaReview(occurrence) }}
						if evidence.Alternative != "" {
							<p><strong>Local-index alternative:</strong> { evidence.Alternative } · <strong>Source:</strong> { evidence.Source } · <strong>Version:</strong> { evidence.Version }</p>
							if evidence.EvidenceID != "" {
								<p><strong>Evidence ID:</strong> { evidence.EvidenceID }</p>
							}
						}
					}
					if suggestion != nil && form != "" && i == suggestion.Target {
						if suggestion.Message != "" {
							<p role="status">{ suggestion.Message }</p>
						} else {
							<p role="status"><strong>LLM lemma suggestion — not applied:</strong> { suggestion.Lemma } · <strong>Provider:</strong> { suggestion.Provider } · <strong>Version:</strong> { suggestion.Version }</p>
						}
					}
					if occurrence.Excluded {
						<p role="status"><strong>Vocabulary selection:</strong> excluded for this occurrence.</p>
					} else if occurrence.CorrectedLemma != "" {
						<p role="status"><strong>Effective lemma:</strong> { occurrence.CorrectedLemma } (corrected)</p>
					} else {
						<p><strong>Effective lemma:</strong> { occurrence.CanonicalLemma } (analyzer assignment)</p>
					}
					if form == "" {
						<p><a href={ templ.SafeURL("/reading/books/"+bookID+"/lemma-review?form="+url.QueryEscape(occurrence.Surface)) }>Review exact form “{ occurrence.Surface }”</a></p>
					} else {
						<form method="post" action={ templ.SafeURL("/reading/books/"+bookID+"/lemma-suggestion") }>
							<input type="hidden" name="csrf_token" value={ csrf } />
							<input type="hidden" name="form" value={ form } />
							<input type="hidden" name="target" value={ fmt.Sprint(i) } />
							<button type="submit">Ask for an optional LLM lemma suggestion</button>
						</form>
						if canCorrect {
					<form method="post" action={ templ.SafeURL("/reading/books/"+bookID+"/lemma-review") }>
						<input type="hidden" name="csrf_token" value={ csrf } />
						<input type="hidden" name="stage" value="preview" />
						<input type="hidden" name="form" value={ form } />
						<input type="hidden" name="target" value={ fmt.Sprint(i) } />
						<label>Corrected canonical lemma<input name="lemma" value={ occurrence.CorrectedLemma } required /></label>
						<fieldset>
							<legend>Also include reviewed occurrences of “{ occurrence.Surface }” in this Book</legend>
							<p>Only the occurrence shown above is selected by default. Review each context before selecting another.</p>
							for j, other := range occurrences {
								if j != i {
									<label><input type="checkbox" name="also" value={ fmt.Sprint(j) } /> Include “{ other.Surface }” in: <span class="reading-text">{ other.SentenceText }</span></label>
								}
							}
						</fieldset>
						<button type="submit" name="decision" value="correct">Preview correction</button>
						<button type="submit" name="decision" value="keep" formnovalidate>Preview keeping analyzer lemma</button>
						<details>
							<summary>Exclude this occurrence from vocabulary selection</summary>
							<p>Only this occurrence will stop contributing to recurrence, Reading snapshots, deck candidates, and Known or Reserved counts. It remains in the analyzed text and coverage denominator, so exclusion cannot improve coverage. You can restore it before a Reading snapshot or deck freezes; existing frozen artifacts and completed Known facts will not change.</p>
							<button type="submit" name="decision" value="exclude" formnovalidate>Preview exclusion</button>
						</details>
					</form>
						}
					}
				</article>
			}
			if proposal != nil {
				<article aria-labelledby="lemma-preview-heading">
					<h2 id="lemma-preview-heading">Review the proposed change</h2>
					<p>This is a preview only. Nothing changes until you confirm.</p>
					<p><strong>Selected occurrences:</strong> { fmt.Sprint(len(proposal.Occurrences)) } · <strong>Decision:</strong> { proposal.Action }</p>
					<ul>
						for _, change := range proposal.Changes {
							<li><span class="reading-text">{ change.Sentence }</span> — effective identity { change.Before } → { change.After }</li>
						}
					</ul>
					<p>Only the explicitly selected contexts are included. Other occurrences, including matching forms elsewhere in this Book or in other Books, remain unchanged. Recurrence eligibility uses the three-occurrence floor. Known matching is separate from Reserved matching; eligible identities can change Reading snapshot and direct-deck membership. Frozen snapshots and decks are not rewritten.</p>
					<ul>
						for _, impact := range proposal.Impacts {
							<li><strong>{ impact.Lemma } ({ impact.UPOS }):</strong> recurrence { fmt.Sprint(impact.BeforeCount) } → { fmt.Sprint(impact.AfterCount) }; Known match { yesNo(impact.BeforeKnown) }; Reserved match { yesNo(impact.BeforeReserved) }; Reading snapshot/deck eligible { yesNo(impact.BeforeEligible) } → { yesNo(impact.AfterEligible) }.</li>
						}
					</ul>
					if len(proposal.Impacts) == 0 {
						<p role="status">The selected contexts do not currently change an effective vocabulary identity.</p>
					}
					<form method="post" action={ templ.SafeURL("/reading/books/"+bookID+"/lemma-review") }>
						<input type="hidden" name="csrf_token" value={ csrf } />
						<input type="hidden" name="stage" value="confirm" />
						<input type="hidden" name="form" value={ form } />
						<input type="hidden" name="decision" value={ proposal.Action } />
						<input type="hidden" name="lemma" value={ proposal.Lemma } />
						<input type="hidden" name="fingerprint" value={ proposal.Fingerprint } />
						for _, i := range proposal.Indices {
							<input type="hidden" name="selected" value={ fmt.Sprint(i) } />
						}
						if recovery.ReadyPreparationID != "" && lemmaProposalChangesIdentity(proposal) {
							if recovery.ReadyDeckSnapshotID != "" {
								<p>Confirming will restart this Book with a new snapshot and prepare its deck from the corrected identities. The ready deck stays available as history.</p>
								<label><input type="checkbox" name="reprepare_ready_deck" value="yes" required /> Start this Book again with a new snapshot and prepare a new deck when I confirm this decision</label>
							} else {
								<p>The ready deck is a historical artifact. Confirming this identity change will explicitly create a new deck generation; the existing artifact will remain downloadable. This is a full re-preparation, not a presentation-only re-render.</p>
								<label><input type="checkbox" name="reprepare_ready_deck" value="yes" required /> Re-prepare the ready deck with these current vocabulary identities when I confirm this decision</label>
							}
						}
						if proposal.Action == "correct" {
							<button type="submit">Apply correction to selected occurrences</button>
						} else if proposal.Action == "keep" {
							<button type="submit">Keep analyzer lemma for selected occurrences</button>
						} else {
							<button type="submit">Exclude selected occurrences from vocabulary</button>
						}
					</form>
				</article>
			}
			if canCorrect && form != "" && len(occurrences) > 0 {
				if recovery.ReadyPreparationID == "" {
					<p><a href={ templ.SafeURL("/reading/books/"+bookID+"/deck/preparations/new") }>Prepare a direct deck with the effective vocabulary identity</a></p>
				}
			}
		</main>
		}
	}
