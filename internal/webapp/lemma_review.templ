package webapp

import (
	"github.com/justin-hayes/mouseion/internal/domain"
	"github.com/justin-hayes/mouseion/internal/lemmareview"
	"net/url"
)

templ LemmaReviewPage(user domain.User, csrf, bookID, title, form, pageError string, canCorrect bool, occurrences []domain.LemmaReviewOccurrence, proposal *lemmareview.Preview, recovery lemmareview.Recovery, suggestion *lemmaReviewSuggestion, reports []domain.StudyReport) {
	@ShellLayout("Review a word", &user, csrf, NavigationReading, shellStyleReading, shellStyleVocabulary) {
		<main class="page-container data-width lemma-review">
			<p><a href={ templ.SafeURL(readingPagePath(ctx)) }>Back to Reading</a></p>
			<h1>Review a word in { title }</h1>
			<p>Search one exact observed form in this Book's current analysis. Each decision starts with one occurrence; review sentence contexts and explicitly select any additional occurrences to include. Analyzer results remain unchanged.</p>
			if !recovery.ReferenceAssessed {
				<p role="status">Automatic German reference assessment is unavailable or not supported for this language. This is not a clean verdict; manual occurrence review remains available.</p>
			}
			<form method="get" action={ templ.SafeURL("/reading/books/" + bookID + "/lemma-review") }>
				<label>Exact observed form<input class="input" name="form" value={ form } required/></label>
				<button class="button" type="submit">Find occurrences</button>
			</form>
			if pageError != "" {
				<article role="alert">{ pageError }</article>
			}
			if recovery.ActiveReading {
				<article aria-labelledby="active-reading-lemma-recovery">
					<h2 id="active-reading-lemma-recovery">Stop before changing this Book's vocabulary</h2>
					<p>Reading uses a frozen snapshot. To use a corrected identity, stop this reading without marking it finished, review and confirm the occurrence decision, then start the Book again to create a new snapshot.</p>
					<p><a href={ templ.SafeURL(readingPagePath(ctx)) }>Open Reading to stop this Book</a></p>
				</article>
			}
			if recovery.HasCompletedReading {
				<article aria-labelledby="completed-reading-lemma-recovery">
					<h2 id="completed-reading-lemma-recovery">Completed reading and Known vocabulary stay unchanged</h2>
					<p>This decision affects future vocabulary only. Mouseion never rewrites finished Reading history or its Known facts.</p>
				</article>
			}
			if form != "" && len(occurrences) == 0 {
				<p role="status">No matching content-word occurrence was found in the current analysis. Check the exact spelling and try again.</p>
			}
			if len(reports) > 0 {
				<section id="lemma-review-study-reports" aria-labelledby="lemma-review-study-reports-heading">
					<h2 id="lemma-review-study-reports-heading">Reported in Study</h2>
					<p>You reported these words as wrong words in Study. Study holds each word until you repair its occurrence.</p>
					<ul>
						for _, report := range reports {
							<li>
								<a href={ templ.SafeURL(studyRemediationPath(report.ID)) }>{ report.TargetWord }</a>
								if report.Note != "" {
									— { report.Note }
								}
							</li>
						}
					</ul>
				</section>
			}
			for _, occurrence := range occurrences {
				{{ id := occurrence.ID() }}
				<article>
					<p class="reading-text">{ occurrence.SentenceText }</p>
					for _, report := range reports {
						if lemmaReviewReported(report, occurrence) {
							<p role="status" class="lemma-review-study-report"><strong>Reported as a wrong word in Study.</strong>
								if report.Note != "" {
									{ report.Note }
								}
							</p>
						}
					}
					<p><strong>Observed form:</strong> { occurrence.Surface } · <strong>Analyzer lemma:</strong> { lemmaReviewKeyDisplay(ctx, occurrence.CanonicalLemma) } ({ occurrence.RawLemma }) · <strong>Part of speech:</strong> { occurrence.UPOS }</p>
					if occurrence.ReviewFlagReason != "" {
						if occurrence.ReviewFlagResolution == "" {
							<p role="alert"><strong>Needs learner review — not a verdict.</strong> { occurrence.ReviewFlagReason }</p>
						} else {
							<p role="status"><strong>Previously reviewed:</strong> { occurrence.ReviewFlagResolution }. New reference evidence does not reopen this decision.</p>
						}
						{{ evidence := lemmareview.EvidenceOf(occurrence) }}
						if evidence.ProviderSourced {
							<p><strong>Model evidence (advisory).</strong> Raised by the configured contextual-Gloss provider — not a proposed correction.</p>
							<p>
								if evidence.Provider != "" {
									<span><strong>Provider:</strong> { evidence.Provider }</span>
								}
								if evidence.Model != "" {
									<span> · <strong>Model:</strong> { evidence.Model }</span>
								}
								if evidence.PromptVersion != "" {
									<span> · <strong>Prompt version:</strong> { evidence.PromptVersion }</span>
								}
							</p>
							if evidence.Reason != "" {
								<p><strong>Model explanation:</strong> { evidence.Reason }</p>
							}
						} else if evidence.Alternative != "" {
							<p><strong>Local-index alternative:</strong> { evidence.Alternative } · <strong>Source:</strong> { evidence.Source } · <strong>Version:</strong> { evidence.Version }</p>
							if evidence.EvidenceID != "" {
								<p><strong>Evidence ID:</strong> { evidence.EvidenceID }</p>
							}
						}
					}
					if suggestion != nil && form != "" && id == suggestion.Target {
						if suggestion.Message != "" {
							<p role="status">{ suggestion.Message }</p>
						} else {
							<p role="status"><strong>LLM lemma suggestion — not applied:</strong> { lemmaReviewKeyDisplay(ctx, suggestion.Lemma) } · <strong>Provider:</strong> { suggestion.Provider } · <strong>Version:</strong> { suggestion.Version }</p>
						}
					}
					if occurrence.Excluded {
						<p role="status"><strong>Vocabulary selection:</strong> excluded for this occurrence.</p>
					} else if occurrence.CorrectedLemma != "" {
						<p role="status"><strong>Effective lemma:</strong> { lemmaReviewKeyDisplay(ctx, occurrence.CorrectedLemma) } (corrected)</p>
					} else {
						<p><strong>Effective lemma:</strong> { lemmaReviewKeyDisplay(ctx, occurrence.CanonicalLemma) } (analyzer assignment)</p>
					}
					if form == "" {
						<p><a href={ templ.SafeURL("/reading/books/" + bookID + "/lemma-review?form=" + url.QueryEscape(occurrence.Surface)) }>Review exact form “{ occurrence.Surface }”</a></p>
					} else {
						<form method="post" action={ templ.SafeURL("/reading/books/" + bookID + "/lemma-suggestion") }>
							<input type="hidden" name="csrf_token" value={ csrf }/>
							<input type="hidden" name="form" value={ form }/>
							<input type="hidden" name="target" value={ id }/>
							<button class="button button--outline" type="submit">Ask for an optional LLM lemma suggestion</button>
						</form>
						if canCorrect {
							<form method="post" action={ templ.SafeURL("/reading/books/" + bookID + "/lemma-review") }>
								<input type="hidden" name="csrf_token" value={ csrf }/>
								<input type="hidden" name="stage" value="preview"/>
								<input type="hidden" name="form" value={ form }/>
								<input type="hidden" name="target" value={ id }/>
								<label>Corrected canonical lemma<input class="input" name="lemma" value={ lemmaReviewKeyDisplay(ctx, occurrence.CorrectedLemma) } required/></label>
								<fieldset>
									<legend>Also include reviewed occurrences of “{ occurrence.Surface }” in this Book</legend>
									<p>Only the occurrence shown above is selected by default. Review each context before selecting another.</p>
									for _, other := range occurrences {
										if other.ID() != id {
											<label><input type="checkbox" name="also" value={ other.ID() }/> <span>Include “{ other.Surface }” in: <span class="reading-text">{ other.SentenceText }</span></span></label>
										}
									}
								</fieldset>
								<button class="button" type="submit" name="decision" value="correct">Preview correction</button>
								<button class="button button--outline" type="submit" name="decision" value="keep" formnovalidate>Preview keeping analyzer lemma</button>
								<details>
									<summary>Exclude this occurrence from vocabulary selection</summary>
									<p>Only this occurrence will stop contributing to recurrence, Reading snapshots and Known or Reserved counts. It remains in the analyzed text and coverage denominator, so exclusion cannot improve coverage. You can restore it before a Reading snapshot freezes; existing frozen snapshots and completed Known facts will not change.</p>
									<button class="button button--danger" type="submit" name="decision" value="exclude" formnovalidate>Preview exclusion</button>
								</details>
							</form>
						}
					}
				</article>
			}
			if proposal != nil {
				@LemmaDecisionPreview(csrf, "/reading/books/"+bookID+"/lemma-review", form, "", *proposal, recovery)
			}
		</main>
	}
}
