package webapp

import (
	"fmt"
	"net/url"
	"strings"
	"unicode"

	"github.com/justin-hayes/mouseion/internal/classical"
	"github.com/justin-hayes/mouseion/internal/domain"
)

// ClassicalCatalogRecord is the built-in, read-only source on Catalogs. It
// appears above the learner's OPDS connections and carries no setup, sync or
// credentials.
templ ClassicalCatalogRecord(counts classical.CatalogCounts) {
	<article class="classical-catalog-record" id="classical-catalog" aria-labelledby="classical-catalog-title">
		<header>
			<h2 id="classical-catalog-title">Classical catalog</h2>
			<p>Reviewed Ancient Greek texts that ship with this release. The catalog is built in and read-only: it needs no setup, sync or credentials.</p>
		</header>
		@ClassicalCatalogCounts(counts, "classical-catalog-record__margin")
		<p class="classical-catalog-record__note">Sources are fetched at To Read. Adding a work downloads nothing.</p>
		<div class="action-group"><a role="button" href="/catalogs/classical">Browse the Classical catalog</a></div>
	</article>
}

// ClassicalAuthorIndexPage is the catalog index. Every Work under its author
// carries its Opening and length on one page-wide word scale, with the facts
// and Add controls in a margin note.
templ ClassicalAuthorIndexPage(user domain.User, csrf string, authors []classical.CatalogAuthor, counts classical.CatalogCounts, attributions []classical.SourceAttribution, view classicalCatalogView, confirmation classicalAddConfirmation, pageError string) {
	@ShellLayout("Classical catalog", &user, csrf, NavigationCatalogs, shellStyleCatalogs) {
		@Breadcrumb("/catalogs", "Catalogs")
		@PageHeader("Classical catalog", "Browse the Ancient Greek works this release carries. Sources are fetched when a Book moves to To Read; adding downloads nothing.", nil)
		@ClassicalCatalogCounts(counts, "classical-catalog-margin")
		if confirmation.Message != "" {
			@ClassicalAddFeedback(confirmation)
		}
		if pageError != "" && view.AddAvailable {
			@Feedback(FeedbackError, "Add is unavailable", pageError)
		}
		if !view.AddAvailable {
			@Feedback(FeedbackError, "Add is unavailable", view.AddUnavailableReason)
		}
		if len(authors) == 0 {
			@EmptyState("No Ancient Greek works", "This release carries no Classical catalog definitions.")
		} else {
			{{ axis := classicalLengthAxis(authors) }}
			<div class="classical-work-index">
				for _, author := range authors {
					<section class="classical-author-section" id={ classicalAuthorAnchor(author.Name) } aria-label={ author.Name }>
						<h2 class="classical-author-section__name">{ author.Name }</h2>
						<ul class="classical-author-section__works">
							for _, work := range author.Works {
								<li class="classical-work-entry" id={ "work-" + work.Key }>
									<div class="classical-work-entry__identity">
										<h3 class="classical-work-entry__title bibliographic-title">
											<a href={ templ.SafeURL(classicalWorkURL(work.Key)) }>{ work.Title }</a>
											if work.GreekTitle != "" {
												<span class="classical-work-entry__greek" lang="grc">{ work.GreekTitle }</span>
											}
										</h3>
										<p class="classical-opening" lang="grc"><span class="classical-opening__citation" lang="en"><span class="sr-only">Begins at </span>{ classicalWorkOpeningCitation(work) }</span>{ work.Opening }</p>
										<p class="classical-length-caption">{ classicalWorkLengthCaption(work) }</p>
										<div class="classical-length" aria-hidden="true">
											for _, unit := range work.Units {
												<span class={ classicalLengthSegmentClass(unit, view) } style={ classicalLengthWidth(unit.Words, axis) }>
													if unit.ConstituentBook != 0 {
														<i>{ fmt.Sprintf("%d", unit.ConstituentBook) }</i>
													}
												</span>
											}
										</div>
										if !work.WholeWork {
											<details class="classical-books">
												<summary>Choose books</summary>
												<table class="classical-books__table">
													<thead>
														<tr><th scope="col">Book</th><th scope="col">Passage</th><th scope="col" class="classical-books__number">Words</th><th scope="col"><span class="sr-only">Add</span></th></tr>
													</thead>
													<tbody>
														for _, unit := range work.Units {
															<tr>
																<th scope="row">{ classicalBookLabel(unit.ConstituentBook) }</th>
																<td class="numeric">{ classicalCitationRange(unit) }</td>
																<td class="classical-books__number numeric">{ fmt.Sprintf("%d", unit.Words) }</td>
																<td class="classical-books__action">
																	if bookID := view.OwnedUnits[unit.Key]; bookID != "" {
																		<a href={ templ.SafeURL(classicalBookInMyBooksURL(bookID)) }>In My Books</a>
																	} else if view.AddAvailable {
																		@ClassicalAddForm(csrf, classicalUnitAddURL(unit.Key), "Add", false, classicalAddReturnIndex)
																	}
																</td>
															</tr>
														}
													</tbody>
												</table>
											</details>
										}
									</div>
									<div class="classical-work-entry__margin">
										<p>{ work.EditionLabel }</p>
										<p class="numeric">Passage { classicalWorkCitationRange(work) }</p>
										<p>{ classicalTranslationLabel(work.TranslationAvailable) }</p>
										if ownership := classicalWorkOwnershipLabel(work, view); ownership != "" {
											<p class="classical-work-entry__owned"><span class="classical-work-entry__owned-marker" aria-hidden="true"></span><a href={ templ.SafeURL(classicalWorkInMyBooksURL(work.Key)) }>{ ownership }</a></p>
										}
										if classicalWorkCanAdd(work, view) {
											<div class="action-group">@ClassicalAddForm(csrf, classicalWorkAddURL(work.Key), classicalWorkAddLabel(work, view), false, classicalAddReturnIndex)</div>
										}
									</div>
								</li>
							}
						</ul>
					</section>
				}
			</div>
			@ClassicalCatalogAttribution(attributions)
		}
	}
}

// ClassicalCatalogAttribution credits the Greek text to each source layer and
// licence the current catalog uses.
templ ClassicalCatalogAttribution(attributions []classical.SourceAttribution) {
	if len(attributions) > 0 {
		<div class="classical-attribution">
			for _, attribution := range attributions {
				<p>Greek text source: { attribution.Text }</p>
			}
		</div>
	}
}

// ClassicalWorkPage lists one row per constituent book of a Work.
templ ClassicalWorkPage(user domain.User, csrf string, work classical.CatalogWork, view classicalCatalogView, confirmation classicalAddConfirmation, pageError string) {
	@ShellLayout(work.Title+" · Classical catalog", &user, csrf, NavigationCatalogs, shellStyleCatalogs) {
		@Breadcrumb(classicalAuthorIndexURL(work.Author), work.Author)
		@PageHeader(work.Title, "Constituent books in the Classical catalog. Word counts are length facts, not coverage or difficulty.", nil) {
			if view.AddAvailable {
				@ClassicalAddForm(csrf, classicalWorkAddURL(work.Key), "Add the whole work", true, "")
			}
			if view.OwnedWorks[work.Key] != "" {
				<a class="button button--outline" href={ templ.SafeURL(classicalWorkInMyBooksURL(work.Key)) }>In My Books</a>
			}
		}
		if confirmation.Message != "" {
			@ClassicalAddFeedback(confirmation)
		}
		if pageError != "" && view.AddAvailable {
			@Feedback(FeedbackError, "Add is unavailable", pageError)
		}
		if !view.AddAvailable {
			@Feedback(FeedbackError, "Add is unavailable", view.AddUnavailableReason)
		}
		if work.GreekTitle != "" {
			<p class="classical-work-page__greek" lang="grc">{ work.GreekTitle }</p>
		}
		<p class="classical-work-page__summary">{ classicalWorkSizeLabel(work) } · { fmt.Sprintf("%d", work.Words) } words · { classicalTranslationLabel(work.TranslationAvailable) }</p>
		@ResponsiveTable("Books of "+work.Title) {
			<thead><tr><th>Book</th><th>Passage</th><th>Words</th><th>In My Books</th></tr></thead>
			<tbody>
				for _, unit := range work.Units {
					<tr>
						<td>{ classicalBookLabel(unit.ConstituentBook) }</td>
						<td>{ classicalCitationRange(unit) }</td>
						<td>{ fmt.Sprintf("%d", unit.Words) }</td>
						<td>
							if bookID := view.OwnedUnits[unit.Key]; bookID != "" {
								<a href={ templ.SafeURL(classicalBookInMyBooksURL(bookID)) }>In My Books</a>
							} else if view.AddAvailable {
								@ClassicalAddForm(csrf, classicalUnitAddURL(unit.Key), "Add", false, "")
							}
						</td>
					</tr>
				}
			</tbody>
		}
	}
}

// ClassicalAddFeedback confirms the Add. When another study language is active
// it also offers the "In My Books" path that opens the added Books in Ancient
// Greek; following that path is what switches the study language.
templ ClassicalAddFeedback(confirmation classicalAddConfirmation) {
	@Feedback(FeedbackSuccess, "", confirmation.Message) {
		if confirmation.InMyBooksURL() != "" {
			<p><a href={ templ.SafeURL(confirmation.InMyBooksURL()) }>Open Ancient Greek in My Books</a></p>
		}
	}
}

// ClassicalCatalogCounts states the running release's counts in a margin.
templ ClassicalCatalogCounts(counts classical.CatalogCounts, className string) {
	<dl class={ className } aria-label="Running release counts">
		<div><dt>Works</dt><dd>{ fmt.Sprintf("%d", counts.Works) }</dd></div>
		<div><dt>Authors</dt><dd>{ fmt.Sprintf("%d", counts.Authors) }</dd></div>
		<div><dt>Reading units</dt><dd>{ fmt.Sprintf("%d", counts.Units) }</dd></div>
	</dl>
}

// ClassicalAddForm is the one Add control used by the catalog. An index Add
// returns there; every other Add returns to the work.
templ ClassicalAddForm(csrf, action, label string, primary bool, returnTo string) {
	<form class="inline-action" method="post" action={ templ.SafeURL(action) }>
		<input type="hidden" name="csrf_token" value={ csrf }/>
		if returnTo != "" {
			<input type="hidden" name="return" value={ returnTo }/>
		}
		if primary {
			<button class="button" type="submit">{ label }</button>
		} else {
			<button class="button button--outline" type="submit">{ label }</button>
		}
	</form>
}

// classicalAuthorAnchor is the stable fragment for one author's index section.
// Curated author names keep their letters and digits; every other run becomes
// one hyphen, so the id carries no whitespace or delimiter and the URL fragment
// matches it after percent-encoding.
func classicalAuthorAnchor(name string) string {
	var anchor strings.Builder
	anchor.WriteString("author-")
	hyphen := false
	for _, r := range name {
		if unicode.IsLetter(r) || unicode.IsDigit(r) {
			anchor.WriteRune(r)
			hyphen = false
			continue
		}
		if !hyphen {
			anchor.WriteByte('-')
			hyphen = true
		}
	}
	return strings.TrimSuffix(anchor.String(), "-")
}

// classicalWorkOpeningCitation names where a Work's Opening starts.
func classicalWorkOpeningCitation(work classical.CatalogWork) string {
	if len(work.Units) == 0 {
		return ""
	}
	return work.Units[0].CitationStart
}

// classicalWorkCitationRange renders the Work's inclusive passage range.
func classicalWorkCitationRange(work classical.CatalogWork) string {
	if len(work.Units) == 0 {
		return ""
	}
	first, last := work.Units[0], work.Units[len(work.Units)-1]
	if first.CitationStart == last.CitationEnd {
		return first.CitationStart
	}
	return first.CitationStart + "–" + last.CitationEnd
}

// classicalWorkLengthCaption states the Work's total and its shape without
// implying difficulty or coverage.
func classicalWorkLengthCaption(work classical.CatalogWork) string {
	if work.WholeWork {
		return fmt.Sprintf("%d words, read whole", work.Words)
	}
	return fmt.Sprintf("%d words in %s", work.Words, classicalCountLabel(work.ConstituentBooks, "book", "books"))
}

// classicalLengthAxis ends at the next 10,000 words above the longest Work's
// total, so every Work's strip shares one page-wide scale.
func classicalLengthAxis(authors []classical.CatalogAuthor) int {
	longest := 0
	for _, author := range authors {
		for _, work := range author.Works {
			if work.Words > longest {
				longest = work.Words
			}
		}
	}
	return (longest/10000 + 1) * 10000
}

// classicalLengthWidth renders one Reading unit's share of the page-wide axis.
func classicalLengthWidth(words, axis int) string {
	if axis <= 0 {
		return "width:0%"
	}
	return fmt.Sprintf("width:%.3f%%", 100*float64(words)/float64(axis))
}

// classicalLengthSegmentClass marks a segment the learner owns.
func classicalLengthSegmentClass(unit classical.CatalogUnit, view classicalCatalogView) string {
	if view.OwnedUnits[unit.Key] != "" {
		return "classical-length__segment classical-length__segment--owned"
	}
	return "classical-length__segment"
}

// classicalOwnedUnitCount counts the Work's Reading units already in My Books.
func classicalOwnedUnitCount(work classical.CatalogWork, view classicalCatalogView) int {
	owned := 0
	for _, unit := range work.Units {
		if view.OwnedUnits[unit.Key] != "" {
			owned++
		}
	}
	return owned
}

// classicalWorkOwnershipLabel states the learner's real ownership, or nothing
// when none of the Work is owned.
func classicalWorkOwnershipLabel(work classical.CatalogWork, view classicalCatalogView) string {
	if work.WholeWork {
		if view.OwnedWorks[work.Key] != "" {
			return "In My Books"
		}
		return ""
	}
	owned := classicalOwnedUnitCount(work, view)
	if owned == 0 {
		return ""
	}
	return fmt.Sprintf("%d of %d books in My Books", owned, work.ConstituentBooks)
}

// classicalWorkCanAdd reports whether a meaningful whole-Work Add remains.
func classicalWorkCanAdd(work classical.CatalogWork, view classicalCatalogView) bool {
	if !view.AddAvailable {
		return false
	}
	if work.WholeWork {
		return view.OwnedWorks[work.Key] == ""
	}
	return classicalOwnedUnitCount(work, view) < len(work.Units)
}

// classicalWorkAddLabel names the whole-Work Add by what it will actually add.
func classicalWorkAddLabel(work classical.CatalogWork, view classicalCatalogView) string {
	if work.WholeWork {
		return "Add the work"
	}
	if classicalOwnedUnitCount(work, view) == 0 {
		return "Add the whole work"
	}
	return "Add the remaining books"
}

// classicalAuthorIndexURL names one author's section of the catalog index.
func classicalAuthorIndexURL(name string) string {
	return classicalCatalogURL() + "#" + classicalAuthorAnchor(name)
}

// classicalCatalogURL names the catalog index.
func classicalCatalogURL() string {
	return "/catalogs/classical"
}

// classicalWorkURL names a Work page by its stable key.
func classicalWorkURL(key string) string {
	return "/catalogs/classical/works/" + url.PathEscape(key)
}

func classicalWorkAddURL(key string) string {
	return classicalWorkURL(key) + "/add"
}

func classicalUnitAddURL(key string) string {
	return "/catalogs/classical/units/" + url.PathEscape(key) + "/add"
}

func classicalWorkInMyBooksURL(key string) string {
	return classicalWorkURL(key) + "/in-my-books"
}

func classicalBookInMyBooksURL(bookID string) string {
	return "/catalogs/classical/books/" + url.PathEscape(bookID) + "/in-my-books"
}

// classicalWorkSizeLabel says how a Work is divided: books or a whole passage.
func classicalWorkSizeLabel(work classical.CatalogWork) string {
	if work.WholeWork {
		return "passage"
	}
	return classicalCountLabel(work.ConstituentBooks, "book", "books")
}

// classicalTranslationLabel never promises a partial translation.
func classicalTranslationLabel(available bool) string {
	if available {
		return "English translation available"
	}
	return "English translation not available"
}

// classicalBookLabel names a constituent book or a whole-work passage.
func classicalBookLabel(book int) string {
	if book == 0 {
		return "Passage"
	}
	return fmt.Sprintf("Book %d", book)
}

// classicalCitationRange renders one unit's inclusive citation range.
func classicalCitationRange(unit classical.CatalogUnit) string {
	if unit.CitationStart == unit.CitationEnd {
		return unit.CitationStart
	}
	return unit.CitationStart + "–" + unit.CitationEnd
}

// classicalCountLabel renders one or many of a counted noun.
func classicalCountLabel(count int, singular, plural string) string {
	if count == 1 {
		return fmt.Sprintf("1 %s", singular)
	}
	return fmt.Sprintf("%d %s", count, plural)
}
