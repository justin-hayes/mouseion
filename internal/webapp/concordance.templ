package webapp

import (
	"fmt"
	"maps"
	"net/url"
	"strings"
	"unicode"
	"unicode/utf8"

	"github.com/justin-hayes/mouseion/internal/domain"
)

templ VocabularyConcordancePageView(user domain.User, csrf, language string, lookup domain.ConcordanceLookup, result domain.ConcordanceResult, applied, readingChanged bool, message, focusTarget string, origin browseOrigin) {
	@ShellLayout("Concordance", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@VocabularyPageHeader("concordance")
		<p id="concordance-pending" class="htmx-indicator" role="status">Searching. The previous results remain under their previously applied lookup.</p>
		<div id="concordance-workflow" hx-on:htmx:error="window.showConcordanceNetworkRecovery(ctx)">
			if language == "" {
				@EmptyState("No study languages yet", "Add or sync a Book with a chosen language before looking up vocabulary.") {
					<a href="/catalogs">Connect a catalog</a>
				}
			}
			if language != "" {
				@concordanceOriginReturn(origin, language)
				<form method="get" action="/vocabulary/concordance" hx-get="/vocabulary/concordance" hx-target="#concordance-workflow" hx-select="#concordance-workflow" hx-swap="outerHTML" hx-push-url="true" hx-sync="#concordance-workflow:replace" hx-config="timeout:9s" hx-indicator="#concordance-pending" hx-status:409="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:4xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:5xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" class="concordance-query">
					<input type="hidden" name="language" value={ lookup.Language }/>
					@concordanceOriginFields(origin)
					<div class="concordance-query-term">
						<label for="concordance-term">Lemma or word form</label>
						<div class="concordance-query-term-controls"><input class="input" id="concordance-term" type="search" name="term" value={ lookup.Term } autocomplete="off" autocapitalize="off" spellcheck="false" required aria-describedby="concordance-term-help"/><button class="button" type="submit">Find</button></div>
					</div>
				</form>
				<p id="concordance-term-help" class="concordance-term-help">Searches every analyzed Book in this study language. An evidenced lemma finds its observed forms; any other word matches only that form.</p>
				if message != "" {
					<div id="concordance-recovery" aria-live="polite">
						<p role="alert">{ message }</p>
						if lookup.Term != "" {
							<a class="button button--outline" href={ templ.SafeURL(origin.Apply(vocabularyConcordanceRestartURL(lookup))) }>Retry Concordance lookup</a>
						}
					</div>
				} else {
					<div id="concordance-recovery" aria-live="polite"></div>
				}
				if applied {
					<section id="concordance-results" aria-labelledby="concordance-summary">
						<h2 id="concordance-summary" tabindex="-1" autofocus?={ concordanceFocusFallsBackToSummary(result.Occurrences, focusTarget) }>{ concordanceAppliedSummary(lookup, result) }</h2>
						<p class="concordance-results-summary">{ concordanceResultsSummary(result) }</p>
						if concordanceFocusFallsBackToSummary(result.Occurrences, focusTarget) {
							<p id="concordance-focus-missing" role="status">The sentence you came from is no longer on this page of results. Nothing else was substituted; these are the current results for the same lookup.</p>
						}
						if note := concordancePriorityNote(result); note != "" && (len(result.Occurrences) > 0 || lookup.Page == 1) {
							<p id="concordance-priority" class="concordance-priority">{ note }</p>
						}
						if readingChanged {
							<p id="concordance-reading-changed" class="concordance-priority" role="status">
								Your reading changed after this lookup, so these results keep their original order.
								<a href={ templ.SafeURL(origin.Apply(vocabularyConcordanceRestartURL(concordanceAppliedLookup(lookup, result)))) }>Refresh results</a>
							</p>
						}
						if len(result.Occurrences) == 0 && lookup.Page == 1 {
							<p>No analyzed occurrences of this { concordanceMatchNoun(result) } in your { language } Books. This is a corpus result, not a lookup failure.</p>
						}
						if len(result.Occurrences) == 0 && lookup.Page > 1 {
							<p>No results on this page. <a href={ templ.SafeURL(origin.Apply(vocabularyConcordancePageURL(1, concordanceAppliedLookup(lookup, result)))) }>Go to page 1</a></p>
						}
						if len(result.Occurrences) > 0 {
							<ol id="concordance-native-results" class="concordance-results" role="list">
								for index, occurrence := range result.Occurrences {
									<li class="concordance-result">
										if concordanceStartsBookGroup(result.Occurrences, index) {
											// A static label, not a control: the complete title stays in the text
											// and CSS only ellipsizes it visually, so it never sets the row height.
											<p class="concordance-source">
												<span class="concordance-source-title">{ occurrence.BookTitle }</span>
												<span class="concordance-source-count"><span class="concordance-count-full">{ concordanceBookGroupCountText(result.Occurrences, index) }</span><span class="concordance-count-compact" aria-hidden="true">{ concordanceBookGroupCompactCount(result.Occurrences, index) }</span></span>
											</p>
										}
										<details class="concordance-row" name="concordance-occurrences" id={ concordanceOccurrenceID(occurrence) } tabindex="-1" autofocus?={ concordanceFocusMatches(occurrence, focusTarget) }>
											{{ before, target, after := concordanceSentenceParts(occurrence) }}
											<summary aria-label={ "Occurrence of " + occurrence.Surface + " in " + occurrence.BookTitle }>
												if target != "" {
													// One line: inline whitespace between these parts would add spaces to the sentence.
													<span class="concordance-before"><span>{ concordanceContextText(before) }</span></span><strong class="concordance-surface">{ target }</strong><span class="concordance-after">{ concordanceContextText(after) }</span>
												} else {
													<span class="concordance-before"></span><strong class="concordance-surface">{ occurrence.Surface }</strong><span class="concordance-after">{ " " + occurrence.SentenceText }</span>
												}
											</summary>
											<div class="concordance-context">
												<p class="reading-text">
													if target != "" {
														{ before }<strong class="concordance-observed-target">{ target }</strong>{ after }
													} else {
														{ occurrence.SentenceText }
													}
												</p>
											</div>
										</details>
										<a class="concordance-study-link" aria-label="Study this sentence and its syntax" href={ templ.SafeURL(vocabularySentenceStudyURL(occurrence, concordanceAppliedLookup(lookup, result), origin)) }>Study</a>
									</li>
								}
							</ol>
						}
						if result.HasPrevious || result.HasNext {
							<nav aria-label="Concordance pages">
								if result.HasPrevious {
									<a class="button button--outline" href={ templ.SafeURL(origin.Apply(vocabularyConcordancePageURL(result.Page-1, concordanceAppliedLookup(lookup, result)))) } hx-get={ templ.SafeURL(origin.Apply(vocabularyConcordancePageURL(result.Page-1, concordanceAppliedLookup(lookup, result)))) } hx-target="#concordance-results" hx-select="#concordance-results" hx-swap="outerHTML" hx-push-url="true" hx-sync="#concordance-workflow:replace" hx-config="timeout:9s" hx-indicator="#concordance-pending" hx-status:409="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:4xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:5xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false">Previous</a>
								}
								if result.HasNext {
									<a class="button button--outline" href={ templ.SafeURL(origin.Apply(vocabularyConcordancePageURL(result.Page+1, concordanceAppliedLookup(lookup, result)))) } hx-get={ templ.SafeURL(origin.Apply(vocabularyConcordancePageURL(result.Page+1, concordanceAppliedLookup(lookup, result)))) } hx-target="#concordance-results" hx-select="#concordance-results" hx-swap="outerHTML" hx-push-url="true" hx-sync="#concordance-workflow:replace" hx-config="timeout:9s" hx-indicator="#concordance-pending" hx-status:409="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:4xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:5xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false">Next</a>
								}
							</nav>
						}
					</section>
				}
			}
		</div>
	}
}

templ VocabularySentenceStudyPageView(user domain.User, csrf string, study domain.SentenceStudy, back string) {
	@ShellLayout("Sentence study", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@PageHeader("Study this sentence and its syntax", "A complete source sentence with syntax attributed to the analyzer.", nil)
		<p><a href={ templ.SafeURL(back) }>Return to Concordance results</a></p>
		<section class="reading-width" aria-labelledby="sentence-study-heading">
			<h2 id="sentence-study-heading">{ study.BookTitle }</h2>
			<p>{ study.ChapterTitle } · sentence { fmt.Sprintf("%d", study.SentenceOrdinal+1) }</p>
			<p>Identified target: <strong>{ sentenceStudyTarget(study) }</strong></p>
			<p class="reading-text sentence-study-text">
				{ study.SentenceText }
			</p>
			if len(study.Tokens) == 0 {
				<p>Syntax evidence is unavailable for this sentence; the complete sentence remains available to study.</p>
			} else {
				<h3>Analyzer-attributed tokens</h3>
				<ol class="sentence-study-tokens">
					for _, token := range study.Tokens {
						<li>
							if token.Ordinal == study.TargetOrdinal {
								<strong>{ token.Surface } — identified target</strong>
							} else {
								<strong>{ token.Surface }</strong>
							}
							: <code>{ token.UPOS }</code>, lemma evidence <code>{ token.RawLemma }</code>, effective lemma <code>{ token.EffectiveLemma }</code>;
							dependency <code>{ token.Dependency }</code>, head { token.HeadSurface } (token { fmt.Sprintf("%d", token.HeadOrdinal+1) }).
							if token.Corrected {
								<span>Corrected for this occurrence.</span>
							}
							if token.Excluded {
								<span>Excluded from effective vocabulary; retained as syntax evidence.</span>
							}
						</li>
					}
				</ol>
			}
		</section>
	}
}

// vocabularyConcordanceURL links a Browse identity to its exact effective
// lemma/POS lookup; it never goes through lemma-or-form recognition.
func vocabularyConcordanceURL(language, lemma, upos string) string {
	return vocabularyConcordancePageURL(1, domain.ConcordanceLookup{
		Language: language, Term: lemma, Match: domain.ConcordanceMatchLemma, UPOS: upos,
	})
}

// concordanceAppliedLookup carries the interpretation the server applied, so
// page and Study links never rerun recognition silently.
func concordanceAppliedLookup(lookup domain.ConcordanceLookup, result domain.ConcordanceResult) domain.ConcordanceLookup {
	if result.Match != "" {
		lookup.Match = result.Match
	}
	if lookup.Match != domain.ConcordanceMatchLemma {
		lookup.UPOS = ""
	}
	if result.Revision != "" {
		lookup.Revision = result.Revision
	}
	return lookup
}

func concordanceAppliedSummary(lookup domain.ConcordanceLookup, result domain.ConcordanceResult) string {
	term := result.Term
	if term == "" {
		term = lookup.Term
	}
	if result.Match == domain.ConcordanceMatchLemma {
		if lookup.UPOS != "" {
			return "Forms of " + term + " · " + concordancePartOfSpeechName(lookup.UPOS)
		}
		return "Forms of " + term
	}
	return "Word form " + term
}

func concordanceMatchNoun(result domain.ConcordanceResult) string {
	if result.Match == domain.ConcordanceMatchLemma {
		return "lemma"
	}
	return "word form"
}

var concordancePartOfSpeechNames = map[string]string{
	"NOUN": "noun", "VERB": "verb", "ADJ": "adjective", "ADV": "adverb", "PROPN": "proper noun",
	"PRON": "pronoun", "DET": "determiner", "ADP": "adposition", "AUX": "auxiliary verb",
	"CCONJ": "coordinating conjunction", "SCONJ": "subordinating conjunction", "NUM": "numeral",
	"PART": "particle", "INTJ": "interjection", "PUNCT": "punctuation", "SYM": "symbol", "X": "other",
}

func concordancePartOfSpeechName(upos string) string {
	if name, ok := concordancePartOfSpeechNames[upos]; ok {
		return name
	}
	return strings.ToLower(upos)
}

func concordanceResultsSummary(result domain.ConcordanceResult) string {
	page := max(result.Page, 1)
	if len(result.Occurrences) == 0 {
		return "No results on page " + fmt.Sprintf("%d", page) + "."
	}
	summary := concordanceResultRange(result) + " on page " + fmt.Sprintf("%d", page)
	if result.Continued {
		summary += "; continues " + result.Occurrences[0].BookTitle + " from the previous page"
	}
	if result.HasNext {
		summary += "; more results are available"
	}
	return summary + "."
}

// concordancePriorityNote explains how the captured priority Book shaped the
// order. It names the Book as the one being read at lookup time, never as the
// current one, and never reports an unavailable analysis as zero matches.
func concordancePriorityNote(result domain.ConcordanceResult) string {
	switch result.PriorityState {
	case domain.ConcordancePriorityMatches:
		return "Results begin with " + result.PriorityTitle + ", the Book you were reading when you looked this up."
	case domain.ConcordancePriorityNoMatches:
		return "No matches in " + result.PriorityTitle + ", the Book you were reading when you looked this up. Results from your other Books follow."
	case domain.ConcordancePriorityUnavailable:
		return result.PriorityTitle + ", the Book you were reading when you looked this up, has no current analysis to search, so its occurrences are not counted. Results from your other Books follow."
	}
	return "No Book was being read when you looked this up, so Books are ordered by title."
}

func concordanceStartsBookGroup(occurrences []domain.ConcordanceResultOccurrence, index int) bool {
	return index == 0 || occurrences[index-1].BookID != occurrences[index].BookID
}

func concordanceBookGroupSize(occurrences []domain.ConcordanceResultOccurrence, index int) int {
	count := 1
	for next := index + 1; next < len(occurrences) && occurrences[next].BookID == occurrences[index].BookID; next++ {
		count++
	}
	return count
}

func concordanceBookGroupCountText(occurrences []domain.ConcordanceResultOccurrence, index int) string {
	if count := concordanceBookGroupSize(occurrences, index); count > 1 {
		return fmt.Sprintf("%d occurrences on this page", count)
	}
	return "1 occurrence on this page"
}

// concordanceBookGroupCompactCount is the narrow-screen form of the count; it
// stays explicitly page-local so a continued Book is never read as a total.
func concordanceBookGroupCompactCount(occurrences []domain.ConcordanceResultOccurrence, index int) string {
	return fmt.Sprintf("%d on page", concordanceBookGroupSize(occurrences, index))
}

func concordanceOccurrenceID(occurrence domain.ConcordanceResultOccurrence) string {
	return fmt.Sprintf("occurrence-%s-%d-%d", occurrence.BookID, occurrence.SentenceOrdinal, occurrence.TokenOrdinal)
}

func concordanceFocusMatches(occurrence domain.ConcordanceResultOccurrence, focusTarget string) bool {
	return focusTarget != "" && focusTarget == concordanceOccurrenceID(occurrence)
}

func concordanceFocusFallsBackToSummary(occurrences []domain.ConcordanceResultOccurrence, focusTarget string) bool {
	if focusTarget == "" {
		return false
	}
	for _, occurrence := range occurrences {
		if concordanceFocusMatches(occurrence, focusTarget) {
			return false
		}
	}
	return true
}

func vocabularySentenceStudyURL(occurrence domain.ConcordanceResultOccurrence, lookup domain.ConcordanceLookup, origin browseOrigin) string {
	values := url.Values{
		"book": {occurrence.BookID}, "run": {occurrence.AnalysisRunID}, "corpus": {occurrence.CorpusID},
		"unit": {occurrence.UnitID}, "sentence": {fmt.Sprintf("%d", occurrence.SentenceOrdinal)},
		"target": {fmt.Sprintf("%d", occurrence.TokenOrdinal)}, "target_surface": {occurrence.Surface},
	}
	if lookup.Language != "" {
		values.Set("language", lookup.Language)
	}
	focusTarget := concordanceOccurrenceID(occurrence)
	backValues, _ := url.Parse(vocabularyConcordancePageURL(lookup.Page, lookup))
	backQuery := backValues.Query()
	backQuery.Set("focus", focusTarget)
	maps.Copy(backQuery, origin.Values())
	backValues.RawQuery = backQuery.Encode()
	back := backValues.String() + "#" + url.PathEscape(focusTarget)
	values.Set("return", back)
	return "/vocabulary/concordance/sentence?" + values.Encode()
}

func sentenceStudyTarget(study domain.SentenceStudy) string {
	for _, token := range study.Tokens {
		if token.Ordinal == study.TargetOrdinal {
			return token.Surface
		}
	}
	if study.TargetSurface != "" {
		return study.TargetSurface + " (syntax evidence unavailable)"
	}
	return "Target unavailable in syntax evidence"
}

func concordanceDecisionLabelForStudy(token domain.SentenceStudyToken) string {
	if token.Excluded {
		return " (excluded from effective vocabulary; retained as syntax evidence)"
	}
	if token.Corrected {
		return " (corrected for this occurrence)"
	}
	return ""
}

func concordanceResultRange(result domain.ConcordanceResult) string {
	if len(result.Occurrences) == 0 {
		return "No results on this page"
	}
	start := (result.Page-1)*25 + 1
	return fmt.Sprintf("Results %d–%d", start, start+len(result.Occurrences)-1)
}

func concordanceLocation(occurrence domain.ConcordanceResultOccurrence) string {
	if occurrence.ChapterTitle != "" {
		return occurrence.ChapterTitle
	}
	return "sentence " + fmt.Sprintf("%d", occurrence.SentenceOrdinal+1)
}

func concordanceDecisionLabel(occurrence domain.ConcordanceResultOccurrence) string {
	var labels []string
	if occurrence.Corrected {
		labels = append(labels, "corrected for this occurrence")
	}
	if occurrence.Excluded {
		labels = append(labels, "excluded from effective vocabulary; retained as analyzer evidence")
	}
	if len(labels) == 0 {
		return ""
	}
	return " (" + strings.Join(labels, "; ") + ")"
}

// concordanceSentenceParts splits the sentence around the observed occurrence.
// Corpus offsets count Unicode code points (SourceLocation in
// normalized_corpus.proto), so they are converted to byte offsets before
// slicing; otherwise every multi-byte letter before the occurrence shifts it.
func concordanceSentenceParts(occurrence domain.ConcordanceResultOccurrence) (string, string, string) {
	text := occurrence.SentenceText
	start, startOK := codePointByteOffset(text, occurrence.SentenceStartOffset)
	end, endOK := codePointByteOffset(text, occurrence.SentenceEndOffset)
	if !startOK || !endOK || end <= start {
		return "", "", ""
	}
	return text[:start], text[start:end], text[end:]
}

// concordanceContextText collapses whitespace runs to single spaces while
// keeping a boundary space, so the KWIC summary separates the key word from
// its neighbours exactly where the sentence does. The boundary space is a
// no-break space: the left context is laid out right-to-left so it can be cut
// at its start, and bidi rule L1 would move an ordinary trailing space to the
// far edge of that line.
func concordanceContextText(text string) string {
	const boundary = " "
	collapsed := strings.Join(strings.Fields(text), " ")
	if collapsed == "" {
		if text != "" {
			return boundary
		}
		return ""
	}
	if first, _ := utf8.DecodeRuneInString(text); unicode.IsSpace(first) {
		collapsed = boundary + collapsed
	}
	if last, _ := utf8.DecodeLastRuneInString(text); unicode.IsSpace(last) {
		collapsed += boundary
	}
	return collapsed
}

func codePointByteOffset(text string, offset int64) (int, bool) {
	if offset < 0 {
		return 0, false
	}
	var seen int64
	for index := range text {
		if seen == offset {
			return index, true
		}
		seen++
	}
	if seen == offset {
		return len(text), true
	}
	return 0, false
}

templ VocabularyConcordanceErrorPageView(user domain.User, csrf, language string, lookup domain.ConcordanceLookup, timeout bool, origin browseOrigin) {
	@ShellLayout("Concordance", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@VocabularyPageHeader("concordance")
		<p>Active study language: <code>{ language }</code>.</p>
		@concordanceOriginReturn(origin, language)
		@VocabularyConcordanceErrorRecovery(lookup, timeout, origin)
	}
}

templ VocabularyConcordanceErrorRecovery(lookup domain.ConcordanceLookup, timeout bool, origin browseOrigin) {
	<div id="concordance-recovery" aria-live="polite">
		if timeout {
			@Feedback(FeedbackError, "Concordance server timed out", "The server could not complete this lookup in time. Your current results, if shown, remain under their old applied label. A timeout is not a zero-result claim.")
		} else {
			@Feedback(FeedbackError, "Concordance lookup was not applied", "The lookup did not complete. A failed lookup is not a zero-result claim.")
		}
		<form method="get" action="/vocabulary/concordance">
			<input type="hidden" name="language" value={ lookup.Language }/>
			@concordanceOriginFields(origin)
			<input type="hidden" name="term" value={ lookup.Term }/>
			if lookup.Match != "" {
				<input type="hidden" name="as" value={ lookup.Match }/>
			}
			if lookup.UPOS != "" {
				<input type="hidden" name="upos" value={ lookup.UPOS }/>
			}
			if lookup.Page > 1 {
				<input type="hidden" name="page" value={ fmt.Sprintf("%d", lookup.Page) }/>
			}
			if lookup.Priority != "" {
				<input type="hidden" name="priority" value={ lookup.Priority }/>
			}
			if lookup.Revision != "" {
				<input type="hidden" name="rev" value={ lookup.Revision }/>
			}
			<button class="button" type="submit">Retry</button>
		</form>
	</div>
}

templ VocabularyConcordanceChangedPageView(user domain.User, csrf, language string, lookup domain.ConcordanceLookup, origin browseOrigin) {
	@ShellLayout("Concordance", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@VocabularyPageHeader("concordance")
		<p>Active study language: <code>{ language }</code>.</p>
		@concordanceOriginReturn(origin, language)
		@VocabularyConcordanceChangedRecovery(lookup, origin)
	}
}

templ VocabularyConcordanceChangedRecovery(lookup domain.ConcordanceLookup, origin browseOrigin) {
	<div id="concordance-recovery" aria-live="polite">
		@Feedback(FeedbackWarning, "Current evidence changed", "This page was not applied because analyses or occurrence corrections changed after the previous result page. Refresh results to start from page 1 with current evidence.")
		<a class="button button--outline" href={ templ.SafeURL(origin.Apply(vocabularyConcordanceRestartURL(lookup))) }>Refresh results</a>
	</div>
}

// concordanceOriginReturn offers the way back to the Browse excursion this
// lookup came from. Reading decides whether that excursion is still valid.
templ concordanceOriginReturn(origin browseOrigin, language string) {
	if origin.Active() {
		<p class="concordance-origin"><a id="concordance-origin-return" href={ templ.SafeURL(origin.ReturnURL(language)) }>Back to book vocabulary</a></p>
	}
}

// concordanceOriginFields keeps the Browse origin through a new search or a
// retry, separately from the lookup the learner typed.
templ concordanceOriginFields(origin browseOrigin) {
	if origin.Active() {
		for _, key := range originKeys {
			if value := origin.Values().Get(key); value != "" {
				<input type="hidden" name={ key } value={ value }/>
			}
		}
	}
}
