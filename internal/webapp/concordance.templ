package webapp

import (
	"fmt"
	"net/url"
	"strings"
	"unicode"
	"unicode/utf8"

	"github.com/justin-hayes/mouseion/internal/domain"
)

templ VocabularyConcordancePageView(user domain.User, csrf, language string, books []domain.SourceMaterialSummary, lookup domain.ConcordanceLookup, result domain.ConcordanceResult, applied bool, message, focusTarget string) {
	@ShellLayout("Concordance", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@VocabularyPageHeader("concordance")
		<p id="concordance-pending" class="htmx-indicator" role="status">Searching. The previous results remain under their previously applied query and scope.</p>
		<div id="concordance-workflow" hx-on:htmx:error="window.showConcordanceNetworkRecovery(ctx)">
		if language == "" {
			@EmptyState("No study languages yet", "Add or sync a Book with a chosen language before looking up vocabulary.") {
				<a href="/catalogs">Connect a catalog</a>
			}
		}
		if language != "" {
			<form method="get" action="/vocabulary/concordance" hx-get="/vocabulary/concordance" hx-target="#concordance-workflow" hx-select="#concordance-workflow" hx-swap="outerHTML" hx-push-url="true" hx-sync="#concordance-workflow:replace" hx-config="timeout:9s" hx-indicator="#concordance-pending" hx-status:409="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:4xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:5xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" class="concordance-query">
				<input type="hidden" name="language" value={ lookup.Language }/>
				for _, bookID := range lookup.BookIDs {
					<input type="hidden" name="book" value={ bookID }/>
				}
				if lookup.GrammarDirection != "" {
					<input type="hidden" name="grammar" value={ lookup.GrammarDirection }/><input type="hidden" name="relation" value={ lookup.Relation }/>
				}
				<div class="concordance-query-field">
					<label for="concordance-mode">Lookup evidence</label>
				<select class="input" id="concordance-mode" name="mode">
						<option value="surface" selected?={ lookup.Mode == "surface" }>Observed surface</option>
						<option value="effective" selected?={ lookup.Mode == "effective" }>Effective lemma</option>
						<option value="analyzer" selected?={ lookup.Mode == "analyzer" }>Analyzer lemma (evidence)</option>
					</select>
				</div>
				<div class="concordance-query-term">
					<label for="concordance-term">Exact term</label>
					<div class="concordance-query-term-controls"><input class="input" id="concordance-term" type="search" name="term" value={ lookup.Term } required/><button class="button" type="submit">Find</button></div>
				</div>
				<div class="concordance-pos-field">
					<label for="concordance-upos">Part of speech</label>
					<select class="input" id="concordance-upos" name="upos"><option value="">Choose for a lemma lookup</option>
						for _, pos := range []string{"NOUN", "VERB", "ADJ", "ADV", "PROPN", "PRON", "DET", "ADP", "AUX", "CCONJ", "SCONJ", "NUM", "PART", "INTJ", "PUNCT", "SYM", "X"} {
							<option value={ pos } selected?={ lookup.UPOS == pos }>{ pos }</option>
						}
					</select>
				</div>
			</form>
			<div class="concordance-scopes">
			<details>
				<summary>Books (applied: { concordanceBookScope(lookup, books) })</summary>
			<form method="get" action="/vocabulary/concordance" hx-get="/vocabulary/concordance" hx-target="#concordance-workflow" hx-select="#concordance-workflow" hx-swap="outerHTML" hx-push-url="true" hx-sync="#concordance-workflow:replace" hx-config="timeout:9s" hx-indicator="#concordance-pending" hx-status:409="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:4xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:5xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false">
				<input type="hidden" name="language" value={ lookup.Language }/>
					<input type="hidden" name="mode" value={ lookup.Mode }/><input type="hidden" name="term" value={ lookup.Term }/><input type="hidden" name="upos" value={ lookup.UPOS }/>
					if lookup.GrammarDirection != "" {
						<input type="hidden" name="grammar" value={ lookup.GrammarDirection }/><input type="hidden" name="relation" value={ lookup.Relation }/>
					}
					<fieldset><legend>Search current analysis in</legend>
						for _, book := range books {
							<label><input type="checkbox" name="book" value={ book.BookID } checked?={ concordanceBookSelected(lookup.BookIDs, book.BookID) }/>{ concordanceBookTitle(book) }</label>
						}
					</fieldset>
					<button class="button button--outline" type="submit">Apply Books</button>
				</form>
			</details>
			<details>
				<summary>Grammar (applied: { concordanceGrammarScope(lookup) })</summary>
				<form method="get" action="/vocabulary/concordance" hx-get="/vocabulary/concordance" hx-target="#concordance-workflow" hx-select="#concordance-workflow" hx-swap="outerHTML" hx-push-url="true" hx-sync="#concordance-workflow:replace" hx-config="timeout:9s" hx-indicator="#concordance-pending" hx-status:409="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:4xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:5xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false">
					<input type="hidden" name="language" value={ lookup.Language }/>
					<input type="hidden" name="mode" value={ lookup.Mode }/><input type="hidden" name="term" value={ lookup.Term }/><input type="hidden" name="upos" value={ lookup.UPOS }/>
					for _, bookID := range lookup.BookIDs {
						<input type="hidden" name="book" value={ bookID }/>
					}
					<label for="concordance-grammar">Grammar direction</label>
					<select class="input" id="concordance-grammar" name="grammar"><option value="">No grammar filter</option><option value="own" selected?={ lookup.GrammarDirection == "own" }>Queried occurrence's own relation</option><option value="governor" selected?={ lookup.GrammarDirection == "governor" }>Dependents of queried governor</option></select>
					<label for="concordance-relation">Dependency relation</label><input class="input" id="concordance-relation" name="relation" value={ lookup.Relation } placeholder="e.g. nsubj"/>
					<button class="button button--outline" type="submit">Apply grammar</button>
				</form>
			</details>
			</div>
			if message != "" {
				<div id="concordance-recovery" aria-live="polite">
					<p role="alert">{ message }</p>
					<a class="button button--outline" href={ templ.SafeURL(vocabularyConcordancePageURL(1, lookup)) }>Retry Concordance lookup</a>
				</div>
			} else {
				<div id="concordance-recovery" aria-live="polite"></div>
			}
			if applied {
				<section id="concordance-results" aria-labelledby="concordance-summary">
					<h2 id="concordance-summary" tabindex="-1" autofocus?={ concordanceFocusFallsBackToSummary(result.Occurrences, focusTarget) }>Current results</h2>
					<p class="concordance-results-summary">{ concordanceResultsSummary(lookup, books, result) }</p>
					if len(result.Occurrences) == 0 && lookup.Page == 1 {
						<p>No current analyzed occurrences match this exact lookup.</p>
					}
					if len(result.Occurrences) == 0 && lookup.Page > 1 {
						<p>No results are available on this page. The search scope may have changed; use Previous or restart the lookup rather than treating this page as a zero-match search.</p>
					}
					if len(result.Occurrences) > 0 {
						<ol id="concordance-native-results" class="concordance-results" role="list">
						for index, occurrence := range result.Occurrences {
							<li class={ "concordance-result" + concordanceBookGroupClass(result.Occurrences, index) }>
								if concordanceStartsBookGroup(result.Occurrences, index) {
									<div class="concordance-book-label">
										<span class="concordance-book-title">{ occurrence.BookTitle }</span>
								<span class="concordance-book-count">{ concordanceBookGroupCountText(result.Occurrences, index) }</span>
									</div>
								} else {
									<div class="concordance-book-label" aria-hidden="true"></div>
								}
								<details class="concordance-row" name="concordance-occurrences" id={ concordanceOccurrenceID(occurrence) } tabindex="-1" autofocus?={ concordanceFocusMatches(occurrence, focusTarget) }>
									{{ before, target, after := concordanceSentenceParts(occurrence) }}
									<summary aria-label={ "Occurrence of " + occurrence.Surface + " in " + occurrence.BookTitle }>
										if target != "" {
											// One line: inline whitespace between these parts would add spaces to the sentence.
											<span class="concordance-before"><span>{ concordanceContextText(before) }</span></span><strong class="concordance-surface">{ target }</strong><span class="concordance-after">{ concordanceContextText(after) }</span>
										} else {
											<span class="concordance-before"></span><strong class="concordance-surface">{ occurrence.Surface }</strong><span class="concordance-after">{ " " + occurrence.SentenceText }</span>
										}
									</summary>
									<div class="concordance-context">
										<p class="reading-text">
											if target != "" {
												{ before }<strong class="concordance-observed-target">{ target }</strong>{ after }
											} else {
												{ occurrence.SentenceText }
											}
										</p>
									</div>
								</details>
								<a class="concordance-study-link" aria-label="Study this sentence and its syntax" href={ templ.SafeURL(vocabularySentenceStudyURL(occurrence, lookup)) }>Study</a>
							</li>
						}
						</ol>
					}
					if result.HasPrevious || result.HasNext {
						<nav aria-label="Concordance pages">
							if result.HasPrevious {
							<a class="button button--outline" href={ templ.SafeURL(vocabularyConcordancePageURL(result.Page-1, lookup)) } hx-get={ templ.SafeURL(vocabularyConcordancePageURL(result.Page-1, lookup)) } hx-target="#concordance-results" hx-select="#concordance-results" hx-swap="outerHTML" hx-push-url="true" hx-sync="#concordance-workflow:replace" hx-config="timeout:9s" hx-indicator="#concordance-pending" hx-status:409="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:4xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:5xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false">Previous</a>
							}
							if result.HasNext {
							<a class="button button--outline" href={ templ.SafeURL(vocabularyConcordancePageURL(result.Page+1, lookup)) } hx-get={ templ.SafeURL(vocabularyConcordancePageURL(result.Page+1, lookup)) } hx-target="#concordance-results" hx-select="#concordance-results" hx-swap="outerHTML" hx-push-url="true" hx-sync="#concordance-workflow:replace" hx-config="timeout:9s" hx-indicator="#concordance-pending" hx-status:409="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:4xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:5xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false">Next</a>
							}
						</nav>
					}
				</section>
				}
			}
		</div>
		}
}

templ VocabularySentenceStudyPageView(user domain.User, csrf string, study domain.SentenceStudy, back string) {
	@ShellLayout("Sentence study", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@PageHeader("Study this sentence and its syntax", "A complete source sentence with syntax attributed to the analyzer.", nil)
		<p><a href={ templ.SafeURL(back) }>Return to Concordance results</a></p>
		<section class="reading-width" aria-labelledby="sentence-study-heading">
			<h2 id="sentence-study-heading">{ study.BookTitle }</h2>
			<p>{ study.ChapterTitle } · sentence { fmt.Sprintf("%d", study.SentenceOrdinal+1) }</p>
			<p>Identified target: <strong>{ sentenceStudyTarget(study) }</strong></p>
			<p class="reading-text sentence-study-text">
				{ study.SentenceText }
			</p>
			if len(study.Tokens) == 0 {
				<p>Syntax evidence is unavailable for this sentence; the complete sentence remains available to study.</p>
			} else {
				<h3>Analyzer-attributed tokens</h3>
				<ol class="sentence-study-tokens">
					for _, token := range study.Tokens {
						<li>
							if token.Ordinal == study.TargetOrdinal {
								<strong>{ token.Surface } — identified target</strong>
							} else {
								<strong>{ token.Surface }</strong>
							}
							: <code>{ token.UPOS }</code>, lemma evidence <code>{ token.RawLemma }</code>, effective lemma <code>{ token.EffectiveLemma }</code>;
							dependency <code>{ token.Dependency }</code>, head { token.HeadSurface } (token { fmt.Sprintf("%d", token.HeadOrdinal+1) }).
							if token.Corrected {
								<span> Corrected for this occurrence.</span>
							}
							if token.Excluded {
								<span> Excluded from effective vocabulary; retained as syntax evidence.</span>
							}
						</li>
					}
				</ol>
				if study.GrammarDirection == "governor" {
					<h3>Relevant dependents · <code>{ study.Relation }</code></h3>
					<ul>
						for _, token := range sentenceStudyRelevantDependents(study) {
							<li>{ token.Surface } — token { fmt.Sprintf("%d", token.Ordinal+1) }, head { token.HeadSurface }, relation <code>{ token.Dependency }</code>{ concordanceDecisionLabelForStudy(token) }</li>
						}
					</ul>
				}
			}
		</section>
	}
}

func vocabularyConcordanceURL(language, lemma, upos, bookID string) string {
	values := url.Values{"mode": {"effective"}, "term": {lemma}, "upos": {upos}}
	if language != "" {
		values.Set("language", language)
	}
	if bookID != "" {
		values.Set("book", bookID)
	}
	return "/vocabulary/concordance?" + values.Encode()
}

func concordanceAppliedSummary(lookup domain.ConcordanceLookup) string {
	switch lookup.Mode {
	case "effective":
		return "Applied effective lemma + " + lookup.UPOS + " lookup for “" + lookup.Term + "”"
	case "analyzer":
		return "Applied analyzer lemma evidence + " + lookup.UPOS + " lookup for “" + lookup.Term + "”"
	default:
		return "Applied exact observed surface lookup for “" + lookup.Term + "”"
	}
}

func concordanceResultsSummary(lookup domain.ConcordanceLookup, books []domain.SourceMaterialSummary, result domain.ConcordanceResult) string {
	page := result.Page
	if page < 1 {
		page = 1
	}
	summary := concordanceAppliedSummary(lookup) + " in " + concordanceBookScope(lookup, books) + " with " + concordanceGrammarScope(lookup) + "; "
	if len(result.Occurrences) == 0 {
		return summary + "no results on page " + fmt.Sprintf("%d", page) + "."
	}
	summary += "showing " + concordanceResultRange(result) + " on page " + fmt.Sprintf("%d", page)
	if result.HasNext {
		summary += "; more results are available"
	}
	return summary + "."
}

func concordanceBookScope(lookup domain.ConcordanceLookup, books []domain.SourceMaterialSummary) string {
	if len(lookup.BookIDs) == 0 { return "all current Books" }
	titles := make([]string, 0, len(lookup.BookIDs))
	for _, bookID := range lookup.BookIDs {
		for _, book := range books {
			if book.BookID == bookID {
				titles = append(titles, concordanceBookTitle(book))
				break
			}
		}
	}
	if len(titles) == 0 { return "selected Book subset (unavailable or no current match)" }
	return strings.Join(titles, ", ")
}

func concordanceGrammarScope(lookup domain.ConcordanceLookup) string {
	if lookup.GrammarDirection == "own" { return "own relation: " + lookup.Relation }
	if lookup.GrammarDirection == "governor" { return "governor dependents, relation: " + lookup.Relation }
	return "no grammar filter"
}

func concordanceBookSelected(ids []string, candidate string) bool {
	for _, id := range ids { if id == candidate { return true } }
	return false
}

func concordanceBookTitle(book domain.SourceMaterialSummary) string {
	if book.BookTitle != "" { return book.BookTitle }
	return book.Source.Title
}

func concordanceStartsBookGroup(occurrences []domain.ConcordanceResultOccurrence, index int) bool {
	return index == 0 || occurrences[index-1].BookID != occurrences[index].BookID
}

func concordanceBookGroupClass(occurrences []domain.ConcordanceResultOccurrence, index int) string {
	if index > 0 && concordanceStartsBookGroup(occurrences, index) {
		return " concordance-result--book-start"
	}
	return ""
}

func concordanceBookGroupCountText(occurrences []domain.ConcordanceResultOccurrence, index int) string {
	count := 1
	for next := index + 1; next < len(occurrences) && occurrences[next].BookID == occurrences[index].BookID; next++ {
		count++
	}
	if count == 1 {
		return "1 occurrence on this page"
	}
	return fmt.Sprintf("%d occurrences on this page", count)
}

func concordanceOccurrenceID(occurrence domain.ConcordanceResultOccurrence) string {
	return fmt.Sprintf("occurrence-%s-%d-%d", occurrence.BookID, occurrence.SentenceOrdinal, occurrence.TokenOrdinal)
}

func concordanceFocusMatches(occurrence domain.ConcordanceResultOccurrence, focusTarget string) bool {
	return focusTarget != "" && focusTarget == concordanceOccurrenceID(occurrence)
}

func concordanceFocusFallsBackToSummary(occurrences []domain.ConcordanceResultOccurrence, focusTarget string) bool {
	if focusTarget == "" {
		return false
	}
	for _, occurrence := range occurrences {
		if concordanceFocusMatches(occurrence, focusTarget) {
			return false
		}
	}
	return true
}

func vocabularySentenceStudyURL(occurrence domain.ConcordanceResultOccurrence, lookup domain.ConcordanceLookup) string {
	values := url.Values{
		"book": {occurrence.BookID}, "run": {occurrence.AnalysisRunID}, "corpus": {occurrence.CorpusID},
		"unit": {occurrence.UnitID}, "sentence": {fmt.Sprintf("%d", occurrence.SentenceOrdinal)},
		"target": {fmt.Sprintf("%d", occurrence.TokenOrdinal)}, "target_surface": {occurrence.Surface},
	}
	if lookup.GrammarDirection != "" {
		values.Set("grammar", lookup.GrammarDirection)
		values.Set("relation", lookup.Relation)
	}
	if lookup.Language != "" {
		values.Set("language", lookup.Language)
	}
	focusTarget := concordanceOccurrenceID(occurrence)
	backValues, _ := url.Parse(vocabularyConcordancePageURL(lookup.Page, lookup))
	backQuery := backValues.Query()
	backQuery.Set("focus", focusTarget)
	backValues.RawQuery = backQuery.Encode()
	back := backValues.String() + "#" + url.PathEscape(focusTarget)
	values.Set("return", back)
	return "/vocabulary/concordance/sentence?" + values.Encode()
}

func sentenceStudyTarget(study domain.SentenceStudy) string {
	for _, token := range study.Tokens {
		if token.Ordinal == study.TargetOrdinal {
			return token.Surface
		}
	}
	if study.TargetSurface != "" { return study.TargetSurface + " (syntax evidence unavailable)" }
	return "Target unavailable in syntax evidence"
}

func sentenceStudyRelevantDependents(study domain.SentenceStudy) []domain.SentenceStudyToken {
	var target *domain.SentenceStudyToken
	for i := range study.Tokens {
		if study.Tokens[i].Ordinal == study.TargetOrdinal {
			target = &study.Tokens[i]
			break
		}
	}
	if target == nil { return nil }
	var relevant []domain.SentenceStudyToken
	for _, token := range study.Tokens {
		if token.HeadOrdinal == target.HeadOrdinal && token.Dependency == study.Relation {
			relevant = append(relevant, token)
		}
	}
	return relevant
}

func concordanceDecisionLabelForStudy(token domain.SentenceStudyToken) string {
	if token.Excluded { return " (excluded from effective vocabulary; retained as syntax evidence)" }
	if token.Corrected { return " (corrected for this occurrence)" }
	return ""
}

func concordanceResultRange(result domain.ConcordanceResult) string {
	if len(result.Occurrences) == 0 {
		return "No results on this page"
	}
	start := (result.Page-1)*25 + 1
	return fmt.Sprintf("Results %d–%d", start, start+len(result.Occurrences)-1)
}

func concordanceLocation(occurrence domain.ConcordanceResultOccurrence) string {
	if occurrence.ChapterTitle != "" {
		return occurrence.ChapterTitle
	}
	return "sentence " + fmt.Sprintf("%d", occurrence.SentenceOrdinal+1)
}

func concordanceDecisionLabel(occurrence domain.ConcordanceResultOccurrence) string {
	var labels []string
	if occurrence.Corrected {
		labels = append(labels, "corrected for this occurrence")
	}
	if occurrence.Excluded {
		labels = append(labels, "excluded from effective vocabulary; retained as analyzer evidence")
	}
	if len(labels) == 0 {
		return ""
	}
	return " (" + strings.Join(labels, "; ") + ")"
}

// concordanceSentenceParts splits the sentence around the observed occurrence.
// Corpus offsets count Unicode code points (SourceLocation in
// normalized_corpus.proto), so they are converted to byte offsets before
// slicing; otherwise every multi-byte letter before the occurrence shifts it.
func concordanceSentenceParts(occurrence domain.ConcordanceResultOccurrence) (string, string, string) {
	text := occurrence.SentenceText
	start, startOK := codePointByteOffset(text, occurrence.SentenceStartOffset)
	end, endOK := codePointByteOffset(text, occurrence.SentenceEndOffset)
	if !startOK || !endOK || end <= start {
		return "", "", ""
	}
	return text[:start], text[start:end], text[end:]
}

// concordanceContextText collapses whitespace runs to single spaces while
// keeping a boundary space, so the KWIC summary separates the key word from
// its neighbours exactly where the sentence does. The boundary space is a
// no-break space: the left context is laid out right-to-left so it can be cut
// at its start, and bidi rule L1 would move an ordinary trailing space to the
// far edge of that line.
func concordanceContextText(text string) string {
	const boundary = " "
	collapsed := strings.Join(strings.Fields(text), " ")
	if collapsed == "" {
		if text != "" {
			return boundary
		}
		return ""
	}
	if first, _ := utf8.DecodeRuneInString(text); unicode.IsSpace(first) {
		collapsed = boundary + collapsed
	}
	if last, _ := utf8.DecodeLastRuneInString(text); unicode.IsSpace(last) {
		collapsed += boundary
	}
	return collapsed
}

func codePointByteOffset(text string, offset int64) (int, bool) {
	if offset < 0 {
		return 0, false
	}
	var seen int64
	for index := range text {
		if seen == offset {
			return index, true
		}
		seen++
	}
	if seen == offset {
		return len(text), true
	}
	return 0, false
}

templ VocabularyConcordanceErrorPageView(user domain.User, csrf, language string, books []domain.SourceMaterialSummary, lookup domain.ConcordanceLookup, timeout bool) {
	@ShellLayout("Concordance", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@VocabularyPageHeader("concordance")
		<p>Active study language: <code>{ language }</code>.</p>
		@VocabularyConcordanceErrorRecovery(books, lookup, timeout)
	}
}

templ VocabularyConcordanceErrorRecovery(books []domain.SourceMaterialSummary, lookup domain.ConcordanceLookup, timeout bool) {
	<div id="concordance-recovery" aria-live="polite">
		if timeout {
			@Feedback(FeedbackError, "Concordance server timed out", "The server could not complete this search in time. Your current results, if shown, remain under their old applied label; retry or narrow the Book scope. A timeout is not a zero-result claim.")
		} else {
			@Feedback(FeedbackError, "Concordance lookup was not applied", "The search did not complete. Retry it, or narrow the term or Book scope. A failed search is not a zero-result claim.")
		}
		<form method="get" action="/vocabulary/concordance">
			<input type="hidden" name="language" value={ lookup.Language }/>
			<input type="hidden" name="mode" value={ lookup.Mode }/><input type="hidden" name="term" value={ lookup.Term }/><input type="hidden" name="upos" value={ lookup.UPOS }/>
			if lookup.GrammarDirection != "" {
				<input type="hidden" name="grammar" value={ lookup.GrammarDirection }/><input type="hidden" name="relation" value={ lookup.Relation }/>
			}
			<input type="hidden" name="page" value="1"/>
			<fieldset><legend>Books for this search (leave all unchecked to search all current Books)</legend>
				for _, book := range books {
					<label><input type="checkbox" name="book" value={ book.BookID } checked?={ concordanceBookSelected(lookup.BookIDs, book.BookID) }/>{ concordanceBookTitle(book) }</label>
				}
			</fieldset>
			<button class="button" type="submit">Retry Concordance lookup from page 1</button>
		</form>
		<p>For an unusually broad query, select one or a few Books above. Retry begins at page 1 so it cannot silently skip matches after a scope change.</p>
	</div>
}

templ VocabularyConcordanceChangedPageView(user domain.User, csrf, language string, books []domain.SourceMaterialSummary, lookup domain.ConcordanceLookup) {
	@ShellLayout("Concordance", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@VocabularyPageHeader("concordance")
		<p>Active study language: <code>{ language }</code>.</p>
		@VocabularyConcordanceChangedRecovery(books, lookup)
	}
}

templ VocabularyConcordanceChangedRecovery(books []domain.SourceMaterialSummary, lookup domain.ConcordanceLookup) {
	<div id="concordance-recovery" aria-live="polite">
		@Feedback(FeedbackWarning, "Current evidence changed", "This page was not applied because analyses or occurrence corrections changed after the previous result page. Restart to avoid silently skipping or repeating matches.")
		<a class="button button--outline" href={ templ.SafeURL(vocabularyConcordanceRestartURL(lookup)) }>Restart from results</a>
		<form method="get" action="/vocabulary/concordance">
			<input type="hidden" name="language" value={ lookup.Language }/>
			<input type="hidden" name="mode" value={ lookup.Mode }/><input type="hidden" name="term" value={ lookup.Term }/><input type="hidden" name="upos" value={ lookup.UPOS }/>
			if lookup.GrammarDirection != "" {
				<input type="hidden" name="grammar" value={ lookup.GrammarDirection }/><input type="hidden" name="relation" value={ lookup.Relation }/>
			}
			for _, book := range books {
				<label><input type="checkbox" name="book" value={ book.BookID } checked?={ concordanceBookSelected(lookup.BookIDs, book.BookID) }/>{ concordanceBookTitle(book) }</label>
			}
			<button class="button" type="submit">Retry with current evidence</button>
		</form>
	</div>
}
