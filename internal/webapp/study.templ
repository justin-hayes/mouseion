package webapp

import (
	"fmt"
	"strings"
	"github.com/justin-hayes/mouseion/internal/domain"
)

templ StudyPage(user domain.User, csrf string, view studyPageView) {
	@ShellLayout("Study", &user, csrf, NavigationLearning) {
		@PageHeader("Study", studyPageDescription(view), nil)
		if !view.Available {
			<section class="study-unavailable" aria-labelledby="study-unavailable-heading">
				<h2 id="study-unavailable-heading">Study isn't available for this language yet</h2>
				<p>Study needs a meaning that fits each sentence, and this language does not provide one yet. Prepared decks still work for it.</p>
				<a class="button button--outline" href={ templ.SafeURL(myBooksPagePath(ctx)) }>Open My Books</a>
			</section>
		} else {
			if view.Finished {
				<p id="study-finished" class="study-status">Today is finished. Your next reviews start with the next Study day.</p>
			} else {
				<p id="study-remaining" class="study-status">{ studyRemainingText(view.Remaining) }</p>
			}
			if view.Reintroducing > 0 {
				<p id="study-reintroducing" class="study-status">{ studyReintroducingText(view.Reintroducing) }</p>
			}
			if view.Held > 0 {
				<p id="study-held" class="study-status">{ studyHeldText(view.Held) }</p>
			}
			if view.Reported != nil {
				@StudyReportedCard(csrf, view)
			} else if view.Card != nil {
				@StudyCard(csrf, view)
			} else if !view.Finished {
				<section class="study-today" aria-labelledby="study-today-heading">
					<h2 id="study-today-heading">Today</h2>
					<p id="study-waiting">The next review comes back in a few minutes.</p>
				</section>
			} else if view.Offer > 0 && !view.FluencyUnlocked {
				@StudyBatchOffer(csrf, view)
			} else {
				if view.Fluency != nil {
					@FluencyCard(csrf, view)
				}
				if view.NothingMature {
					<p id="study-nothing-mature" class="study-status">Nothing is mature yet. A word is mature once its review interval reaches 21 days.</p>
				}
				if view.FluencyPreparing {
					<p id="study-fluency-preparing" class="study-status">Fluency contexts for your mature words are being prepared.</p>
				}
				if view.Offer > 0 {
					@StudyBatchOffer(csrf, view)
				}
				if view.Repeating > 0 {
					<section class="study-today" aria-labelledby="study-today-heading">
						<h2 id="study-today-heading">Today</h2>
						<p id="study-repeating">{ studyRepeatingText(view.Repeating-view.RepeatingIdioms, view.RepeatingIdioms) }</p>
					</section>
				} else if view.Fluency == nil && view.Offer == 0 {
					<section class="study-today" aria-labelledby="study-today-heading">
						<h2 id="study-today-heading">Today</h2>
						<p id="study-idle">Nothing to study right now.</p>
					</section>
				}
			}
			<section class="study-preparation" aria-labelledby="study-preparation-heading">
				<h2 id="study-preparation-heading">{ studyPreparationHeading(view.IdiomCounts) }</h2>
				<p id="study-ready">{ studyReadyText(view.Counts.Ready-view.IdiomCounts.Ready, view.IdiomCounts.Ready) }</p>
				if view.Counts.Preparing > 0 {
					<p id="study-preparing">{ studyPreparingText(view.Counts.Preparing-view.IdiomCounts.Preparing, view.IdiomCounts.Preparing) }</p>
				}
				if view.Counts.Unpreparable > 0 {
					<p id="study-skipped">{ studySkippedText(view.Counts.Unpreparable-view.IdiomCounts.Unpreparable, view.IdiomCounts.Unpreparable) }</p>
				}
				if view.Counts.Ready == 0 && view.Counts.Preparing == 0 && view.Counts.Unpreparable == 0 {
					<p id="study-empty">Nothing new is queued yet. New words and idioms come from the Books you have analysed.</p>
				}
			</section>
			<p id="study-reported-link"><a href={ templ.SafeURL(studyLanguagePath(pageKindStudyReports, view.Language)) }>Reported words</a></p>
			if len(view.WaitingForSentence) > 0 {
				<section class="study-waiting-sentence" aria-labelledby="study-waiting-sentence-heading">
					<h2 id="study-waiting-sentence-heading">Waiting for a usable sentence</h2>
					<p>These words have no usable sentence yet after a correction. Your progress is kept, and they return when new evidence gives them one.</p>
					<ul id="study-waiting-sentence" lang={ view.Language }>
						for _, word := range view.WaitingForSentence {
							<li>{ word }</li>
						}
					</ul>
				</section>
			}
			if len(view.NoSuitableContext) > 0 {
				<section class="study-no-suitable-context" aria-labelledby="study-no-suitable-context-heading">
					<h2 id="study-no-suitable-context-heading">No suitable context left</h2>
					<p>Every sentence for these words was reported as unsuitable or is not good enough to study. Your progress is kept, and they return when a new Book provides a context.</p>
					<ul id="study-no-suitable-context" lang={ view.Language }>
						for _, word := range view.NoSuitableContext {
							<li>{ word }</li>
						}
					</ul>
				</section>
			}
			if len(view.Withdrawn) > 0 {
				<section class="study-withdrawn" aria-labelledby="study-withdrawn-heading">
					<h2 id="study-withdrawn-heading">Withdrawn by a correction</h2>
					<p>These words have no usable sentence left in your library. Your progress is kept, and they return if one reappears.</p>
					<ul id="study-withdrawn" lang={ view.Language }>
						for _, word := range view.Withdrawn {
							<li>{ word }</li>
						}
					</ul>
				</section>
			}
			if len(view.SourceNotices) > 0 {
				<section class="study-source-notices" aria-labelledby="study-source-notices-heading">
					<h2 id="study-source-notices-heading">Sources</h2>
					for _, notice := range view.SourceNotices {
						<p class="study-source-notice">{ notice }</p>
					}
				</section>
			}
		}
	}
}

templ StudyCard(csrf string, view studyPageView) {
	<section class="study-card" aria-labelledby="study-card-heading">
		<h2 id="study-card-heading">
			if view.Card.Introduction {
				New word
			} else {
				Review
			}
		</h2>
		if view.Card.Corrected {
			<p id="study-corrected" class="study-status">Corrected: a new sentence for a word already in study.</p>
		}
		@cardFaceView(view.Language, "study", view.Card.cardFace)
		if view.Card.ShowAnswer {
			<div class="study-card__grades">
				@studyGradeForm(csrf, view, "again", "Again", "button button--outline")
				@studyGradeForm(csrf, view, "got-it", "Got it", "button")
			</div>
			if view.Card.AlreadyKnown {
				@studyAlreadyKnownForm(csrf, view)
			}
			if !view.Card.NoReport {
				@studyReportForm(csrf, view)
			}
		} else {
			<form method="get" action={ templ.SafeURL(studyLanguagePath(pageKindStudy, view.Language)) }>
				<input type="hidden" name="answer" value="1"/>
				<button class="button study-card__show" type="submit">Show answer</button>
			</form>
		}
	</section>
}

// StudyReportedCard shows the card just reported as an unsuitable context, with
// its answer side. The review was not graded: the word comes back on the next
// Study day from another context. Undo restores the word and its card while no
// other Study action has followed; moving on ends the offer.
templ StudyReportedCard(csrf string, view studyPageView) {
	<section class="study-card study-card--reported" aria-labelledby="study-reported-heading">
		<h2 id="study-reported-heading">Reported</h2>
		<p id="study-reported" class="study-status">Reported as an unsuitable context. This sentence will not be used for this word again, and it comes back on the next Study day from another one.</p>
		@cardFaceView(view.Language, "study", view.Reported.cardFace)
		<div class="study-card__grades">
			<form method="post" action={ "/study/reports/" + view.Reported.ReportID + "/undo" }>
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<input type="hidden" name="language" value={ view.Language }/>
				<button id="study-reported-undo" class="button button--outline" type="submit">Undo</button>
			</form>
			<form method="post" action={ "/study/reports/" + view.Reported.ReportID + "/next" }>
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<input type="hidden" name="language" value={ view.Language }/>
				<button id="study-reported-next" class="button" type="submit">Next</button>
			</form>
		</div>
	</section>
}

templ FluencyCard(csrf string, view studyPageView) {
	<section class="study-card study-card--fluency" aria-labelledby="fluency-card-heading">
		<h2 id="fluency-card-heading">Fluency</h2>
		@cardFaceView(view.Language, "fluency", view.Fluency.cardFace)
		if view.Fluency.ShowAnswer {
			<div class="study-card__grades">
				@fluencyResponseForm(csrf, view, "not-recognised", "Didn't recognise it", "button button--outline")
				@fluencyResponseForm(csrf, view, "recognised", "Recognised", "button")
			</div>
		} else {
			<form method="get" action={ templ.SafeURL(studyLanguagePath(pageKindStudy, view.Language)) }>
				<input type="hidden" name="answer" value="1"/>
				<input type="hidden" name="context" value={ view.Fluency.ContextID }/>
				<button class="button study-card__show" type="submit">Show answer</button>
			</form>
		}
	</section>
}

// cardFaceView is the sentence with the target word marked and, once revealed,
// the answer. Graded and Fluency cards share it; prefix keeps their ids apart.
templ cardFaceView(language, prefix string, face cardFace) {
	<p class="study-card__sentence" lang={ language }>
		if face.Idiom {
			for _, segment := range face.Segments {
				if segment.Marked {
					<mark class="study-card__target"><strong>{ segment.Text }</strong></mark>
				} else {
					{ segment.Text }
				}
			}
		} else {
			{ face.Before }
			if face.Marked {
				<mark class="study-card__target">{ face.Target }</mark>
			}
			{ face.After }
		}
	</p>
	if face.ShowAnswer && face.Idiom {
		<dl class="study-card__answer study-card__answer--idiom">
			<dt>Idiom</dt>
			<dd id={ prefix + "-headword" } lang={ language }>
				{ face.Headword }
				<span class="metadata study-card__kind" id={ prefix + "-kind" }>idiom</span>
			</dd>
			<dt>Meaning</dt>
			<dd id={ prefix + "-gloss" }>{ face.Gloss }</dd>
			<dt>Translation</dt>
			<dd id={ prefix + "-translation" }>@templ.Raw(face.TranslationHTML)</dd>
		</dl>
	} else if face.ShowAnswer {
		<dl class="study-card__answer">
			<dt>Meaning</dt>
			<dd id={ prefix + "-gloss" }>{ face.Gloss }</dd>
			<dt>Translation</dt>
			<dd id={ prefix + "-translation" }>{ face.Translation }</dd>
			<dt>Word</dt>
			<dd id={ prefix + "-headword" } lang={ language }>{ face.Headword }</dd>
		</dl>
		@sourceCardSections(language, face.Source)
	}
}

// sourceCardSections are a source-evidence word's two collapsed sections below
// the answer rows (ADR 0138 §3). They reuse the native details disclosure of
// the Report control; each is absent when it has nothing to show.
templ sourceCardSections(language string, source sourceCardView) {
	if len(source.Entries) > 0 {
		<details class="study-dictionary" id="study-dictionary">
			<summary>Dictionary</summary>
			for _, entry := range source.Entries {
				<div class="study-dictionary__entry">
					<p class="study-dictionary__source">
						{ entry.Source }
						if entry.Headword != "" {
							<span lang={ language }>
								{ entry.Headword }
								if entry.Number > 0 {
									<sup>{ fmt.Sprint(entry.Number) }</sup>
								}
							</span>
						}
					</p>
					@outlineSenses(entry.Outline)
					for _, target := range entry.Targets {
						<div class="study-dictionary__target">
							<p class="study-dictionary__reference">{ target.Reference }</p>
							@outlineSenses(target.Outline)
						</div>
					}
				</div>
			}
		</details>
	}
	if !source.Passage.Empty() {
		<details class="study-passage" id="study-passage">
			<summary>Passage context</summary>
			<p class="study-passage__label">{ source.Passage.Label }</p>
			<p class="study-passage__text">{ source.Passage.Text }</p>
		</details>
	}
}

templ outlineSenses(senses []outlineSenseView) {
	<ul class="study-outline">
		for _, sense := range senses {
			<li class={ outlineSenseClass(sense) } data-level={ fmt.Sprint(sense.Level) }>
				if sense.Number != "" {
					<span class="study-sense__number">{ sense.Number }</span>
				}
				{ sense.Definitions }
				if sense.Cited {
					<strong class="study-sense__flag">(cited)</strong>
				}
			</li>
		}
	</ul>
}

func outlineSenseClass(sense outlineSenseView) string {
	if sense.Cited {
		return "study-sense study-sense--cited"
	}
	return "study-sense"
}

templ fluencyResponseForm(csrf string, view studyPageView, response, label, class string) {
	<form method="post" action="/study/fluency/responses">
		<input type="hidden" name="csrf_token" value={ csrf }/>
		<input type="hidden" name="language" value={ view.Language }/>
		<input type="hidden" name="context" value={ view.Fluency.ContextID }/>
		<input type="hidden" name="response" value={ response }/>
		<button class={ class } type="submit">{ label }</button>
	</form>
}

// studyReportForm is the Report control of a revealed card (ADR 0135). The
// reported review is not graded.
templ studyReportForm(csrf string, view studyPageView) {
	<details class="study-report" id="study-report">
		<summary>Report</summary>
		<form method="post" action="/study/reports">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<input type="hidden" name="language" value={ view.Language }/>
			<input type="hidden" name="progress" value={ view.Card.ProgressID }/>
			<input type="hidden" name="reps" value={ fmt.Sprint(view.Card.Reps) }/>
			<input type="hidden" name="material" value={ view.Card.MaterialID }/>
			<fieldset>
				<legend>What is wrong with this card?</legend>
				if view.Card.Idiom {
					<label>
						<input type="radio" name="kind" value="unsuitable_context" checked/>
						<span>Unsuitable context: the idiom is right, but this sentence does not teach its meaning. The sentence is never used for this idiom again, and the idiom comes back on the next Study day from another one.</span>
					</label>
				} else {
					<label>
						<input type="radio" name="kind" value="wrong_word" checked/>
						<span>Wrong word: the highlighted word is a different word here, so the Gloss does not fit. The word is held and gets no reviews until you repair the occurrence.</span>
					</label>
					<label>
						<input type="radio" name="kind" value="unsuitable_context"/>
						<span>Unsuitable context: the word is right, but this sentence does not teach its own meaning, for example inside an Idiom. The sentence is never used for this word again, and the word comes back on the next Study day from another one.</span>
					</label>
				}
			</fieldset>
			<label>Note (optional)<textarea class="input" name="note" maxlength={ fmt.Sprint(domain.StudyReportNoteMax) } rows="2"></textarea></label>
			<button class="button button--outline" type="submit">Send report</button>
		</form>
	</details>
}

templ studyGradeForm(csrf string, view studyPageView, grade, label, class string) {
	<form method="post" action="/study/grades">
		<input type="hidden" name="csrf_token" value={ csrf }/>
		<input type="hidden" name="language" value={ view.Language }/>
		<input type="hidden" name="progress" value={ view.Card.ProgressID }/>
		<input type="hidden" name="reps" value={ fmt.Sprint(view.Card.Reps) }/>
		<input type="hidden" name="grade" value={ grade }/>
		<button class={ class } type="submit">{ label }</button>
	</form>
}

// studyAlreadyKnownForm answers an introduction Already known: the word enters
// study Mature. It is an answer, never a grade.
templ studyAlreadyKnownForm(csrf string, view studyPageView) {
	<form class="study-card__already-known" method="post" action="/study/already-known">
		<input type="hidden" name="csrf_token" value={ csrf }/>
		<input type="hidden" name="language" value={ view.Language }/>
		<input type="hidden" name="progress" value={ view.Card.ProgressID }/>
		<input type="hidden" name="reps" value={ fmt.Sprint(view.Card.Reps) }/>
		<button class="button button--outline" type="submit">Already known</button>
	</form>
}

templ StudyBatchOffer(csrf string, view studyPageView) {
	<section class="study-batch" aria-labelledby="study-batch-heading">
		<h2 id="study-batch-heading">New-word batch</h2>
		<p id="study-offer">{ studyOfferText(view.Offer-view.OfferIdioms, view.OfferIdioms) }</p>
		if view.ShortBatch {
			<p id="study-short-batch">This batch is short: more are still being prepared.</p>
		}
		<div class="study-batch__actions">
			<form method="post" action="/study/batches/take">
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<input type="hidden" name="language" value={ view.Language }/>
				<button class="button" type="submit">Take these words</button>
			</form>
			if !view.FluencyUnlocked {
				<form method="post" action="/study/batches/decline">
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<input type="hidden" name="language" value={ view.Language }/>
					<input type="hidden" name="offer" value={ fmt.Sprint(view.OfferNumber) }/>
					<button class="button button--outline" type="submit">Not today</button>
				</form>
			}
		</div>
	</section>
}

func studyPageDescription(view studyPageView) string {
	return "Review vocabulary from your reading."
}

func studyOfferText(words, idioms int) string {
	return studyKindsText(words, idioms, "new ", "", "is ready to learn.", "are ready to learn.")
}

func studyRemainingText(count int) string {
	if count == 1 {
		return "1 review left today."
	}
	return fmt.Sprintf("%d reviews left today.", count)
}

func studyReintroducingText(count int) string {
	if count == 1 {
		return "1 review is waiting for a new sentence after a correction."
	}
	return fmt.Sprintf("%d reviews are waiting for a new sentence after a correction.", count)
}

func studyHeldText(count int) string {
	if count == 1 {
		return "1 word is held because you reported it. It gets no reviews until its occurrence is repaired."
	}
	return fmt.Sprintf("%d words are held because you reported them. They get no reviews until their occurrences are repaired.", count)
}

func studyRepeatingText(words, idioms int) string {
	return studyKindsText(words, idioms, "", "", "comes back later today.", "come back later today.")
}

func studyReadyText(words, idioms int) string {
	return studyKindsText(words, idioms, "new ", "", "is ready.", "are ready.")
}

func studyPreparingText(words, idioms int) string {
	return studyKindsText(words, idioms, "more ", "more ", "is being prepared.", "are being prepared.")
}

func studySkippedText(words, idioms int) string {
	return studyKindsText(words, idioms, "", "", "was skipped because it has no usable sentence or meaning.", "were skipped because they have no usable sentence or meaning.")
}

// studyPreparationHeading names the preparation section after what it counts.
func studyPreparationHeading(idioms domain.StudyMaterialCounts) string {
	if idioms == (domain.StudyMaterialCounts{}) {
		return "New words"
	}
	return "New words and idioms"
}

// studyKindsText counts words and Idioms each by name, in one sentence:
// "2 new words and 1 idiom are ready." Only the kinds present are named, and
// with neither it counts zero words. wordAdjective and idiomAdjective qualify
// each noun.
func studyKindsText(words, idioms int, wordAdjective, idiomAdjective, singular, plural string) string {
	noun := func(count int, adjective, one, many string) string {
		if count == 1 {
			return fmt.Sprintf("1 %s%s", adjective, one)
		}
		return fmt.Sprintf("%d %s%s", count, adjective, many)
	}
	var parts []string
	if words > 0 || idioms == 0 {
		parts = append(parts, noun(words, wordAdjective, "word", "words"))
	}
	if idioms > 0 {
		parts = append(parts, noun(idioms, idiomAdjective, "idiom", "idioms"))
	}
	verb := plural
	if words+idioms == 1 {
		verb = singular
	}
	return strings.Join(parts, " and ") + " " + verb
}

// StudyReportInvalidPage says why a report could not be sent and where to go
// next: the form was incomplete, so nothing was reported.
templ StudyReportInvalidPage(user domain.User, csrf, language string) {
	@ShellLayout("Report not sent", &user, csrf, NavigationLearning) {
		@PageHeader("Report not sent", "Your report was not saved because it was incomplete or its note was longer than "+fmt.Sprint(domain.StudyReportNoteMax)+" characters.", nil)
		<p id="study-report-invalid">Nothing was changed. Go back to Study, open the card's Report control again and send a shorter note.</p>
		<p><a class="button" href={ templ.SafeURL(studyLanguagePath(pageKindStudy, language)) }>Back to Study</a></p>
	}
}

// StudyReportsPage lists the learner's open Wrong-word reports in one study
// language (ADR 0135 §2).
templ StudyReportsPage(user domain.User, csrf string, view studyReportsView) {
	@ShellLayout("Reported words", &user, csrf, NavigationLearning) {
		@PageHeader("Reported words", "Words held because you reported their Study material as a wrong word. They get no reviews until you repair the occurrence.", nil)
		<p><a href={ templ.SafeURL(studyLanguagePath(pageKindStudy, view.Language)) }>Back to Study</a></p>
		if len(view.Reports) == 0 {
			<p id="study-reports-empty" class="study-status">No words are held. A word you report as a wrong word appears here.</p>
		} else {
			<ul id="study-reports" class="study-reports">
				for _, report := range view.Reports {
					<li class="study-report-entry" id={ "study-report-" + report.ID }>
						<h2 lang={ view.Language }>{ report.Word }</h2>
						<p class="study-card__sentence" lang={ view.Language }>
							{ report.Before }
							if report.Marked {
								<mark class="study-card__target">{ report.Target }</mark>
							}
							{ report.After }
						</p>
						<dl>
							<dt>Book</dt>
							<dd>{ report.BookTitle }</dd>
							<dt>Reported</dt>
							<dd>{ report.Date }</dd>
							if report.Note != "" {
								<dt>Note</dt>
								<dd>{ report.Note }</dd>
							}
						</dl>
						if report.RemediationPath != "" {
							<p><a class="study-report-review" href={ templ.SafeURL(report.RemediationPath) }>Repair this word</a></p>
						}
						<form method="post" action={ templ.SafeURL("/study/reports/" + report.ID + "/dismiss") }>
							<input type="hidden" name="csrf_token" value={ csrf }/>
							<input type="hidden" name="language" value={ view.Language }/>
							<button class="button button--outline" type="submit">Dismiss</button>
						</form>
					</li>
				}
			</ul>
		}
	}
}

// StudyRemediationPage repairs one Wrong-word report: the learner corrects the
// reported occurrence's Lemma or excludes the occurrence, after a preview of the
// consequence (ADR 0136 §6). The preview and its confirmation are Lemma review's
// own step.
templ StudyRemediationPage(user domain.User, csrf string, view studyRemediationView) {
	@ShellLayout("Repair a reported word", &user, csrf, NavigationLearning) {
		@PageHeader("Repair a reported word", "You reported this word as a wrong word. Correct the word's Lemma or exclude this occurrence; the word returns to Study on the next Study day.", nil)
		<p><a href={ templ.SafeURL(studyLanguagePath(pageKindStudyReports, view.Language)) }>Back to Reported words</a></p>
		<main class="page-container data-width study-remediation">
			<h2 lang={ view.Language }>{ view.Report.TargetWord }</h2>
			<p><strong>Book:</strong> { view.BookTitle }</p>
			if view.Report.Note != "" {
				<p><strong>Your note:</strong> { view.Report.Note }</p>
			}
			if !view.Found {
				<p role="status" id="study-remediation-missing">The reported occurrence is no longer in this Book's analysis, so it cannot be repaired here. Dismiss the report from Reported words to release the word.</p>
			} else {
				<p class="reading-text" lang={ view.Language }>{ view.Occurrence.SentenceText }</p>
				<p><strong>Observed form:</strong> { view.Occurrence.Surface } · <strong>Analyzer lemma:</strong> { lemmaReviewKeyDisplay(ctx, view.Occurrence.CanonicalLemma) } · <strong>Part of speech:</strong> { view.Occurrence.UPOS }</p>
				if view.Occurrence.Excluded {
					<p role="status"><strong>Vocabulary selection:</strong> excluded for this occurrence.</p>
				} else if view.Occurrence.CorrectedLemma != "" {
					<p role="status"><strong>Effective lemma:</strong> { lemmaReviewKeyDisplay(ctx, view.Occurrence.CorrectedLemma) } (corrected)</p>
				}
				if !view.CanCorrect {
					<article role="alert">This Book is current reading. End current reading before changing its vocabulary; the frozen reading snapshot remains unchanged.</article>
				} else if view.Preview == nil {
					<form method="post" action={ templ.SafeURL(view.Path) } id="study-remediation-form">
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<input type="hidden" name="stage" value="preview"/>
						<label>Corrected canonical lemma<input class="input" name="lemma" value={ lemmaReviewKeyDisplay(ctx, view.Occurrence.CorrectedLemma) } required/></label>
						@StudyRemediationMatches(view.Books)
						<button class="button" type="submit" name="decision" value="correct">Preview correction</button>
						<details>
							<summary>Exclude this occurrence from vocabulary selection</summary>
							<p>Only this occurrence stops contributing to vocabulary. It remains in the analyzed text and the coverage denominator.</p>
							<button class="button button--danger" type="submit" name="decision" value="exclude" formnovalidate>Preview exclusion</button>
						</details>
					</form>
				}
			}
			if view.Preview != nil {
				@LemmaDecisionPreview(csrf, view.Path, view.Report.TargetWord, "", *view.Preview, view.Recovery) {
					for _, match := range view.MatchPreviews {
						@StudyRemediationMatchPreview(match)
					}
				}
			}
		</main>
	}
}

// StudyRemediationMatches offers the other occurrences in the Corpus of the
// reported word's form and lemma, none ticked. Each ticked occurrence is
// decided on its own in its own Book's analysis; ticking is never a rule for
// every occurrence of the form (ADR 0136 §6).
templ StudyRemediationMatches(books []studyRemediationBook) {
	if len(books) > 0 {
		<fieldset id="study-remediation-matches">
			<legend>Other occurrences of this form and lemma in your Books</legend>
			<p>The same decision is applied only to the occurrences you tick, each in its own Book. Unticked occurrences stay as they are.</p>
			for _, book := range books {
				<h3>{ book.Title }</h3>
				if !book.CanCorrect {
					<p role="status">This Book is current reading. End current reading before changing its vocabulary.</p>
				}
				<ul>
					for _, match := range book.Matches {
						<li>
							<label>
								<input type="checkbox" name="match" value={ match.Value } disabled?={ !book.CanCorrect }/>
								<span class="reading-text">{ match.Sentence }</span>
							</label>
						</li>
					}
				</ul>
			}
		</fieldset>
	}
}

// StudyRemediationMatchPreview is the consequence of the ticked occurrences in
// one Book, and what its confirmation carries: the occurrences and the preview
// fingerprint the Book's own decision is checked against.
templ StudyRemediationMatchPreview(match studyRemediationMatchPreview) {
	<section aria-label={ "Matching occurrences in " + match.Title }>
		<h3>{ match.Title }</h3>
		<p><strong>Selected occurrences:</strong> { fmt.Sprint(len(match.Preview.OccurrenceIDs)) }</p>
		<ul>
			for _, change := range match.Preview.Changes {
				<li><span class="reading-text">{ change.Sentence }</span> — effective identity { lemmaReviewKeyDisplay(ctx, change.Before) } → { lemmaReviewKeyDisplay(ctx, change.After) }</li>
			}
		</ul>
		<input type="hidden" name="match_fingerprint" value={ match.BookID + "/" + match.Preview.Fingerprint }/>
		for _, occurrenceID := range match.Preview.OccurrenceIDs {
			<input type="hidden" name="match" value={ matchValue(match.BookID, occurrenceID) }/>
		}
	</section>
}
