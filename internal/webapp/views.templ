package webapp

import (
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/justin-hayes/mouseion/internal/analysis"
	"github.com/justin-hayes/mouseion/internal/cataloguesync"
	"github.com/justin-hayes/mouseion/internal/domain"
	"github.com/justin-hayes/mouseion/internal/enrichmentjob"
	"github.com/justin-hayes/mouseion/internal/knownvocab"
	"github.com/justin-hayes/mouseion/internal/lemmadisplay"
	"github.com/justin-hayes/mouseion/internal/lexical"
)

templ Layout(title string, user *domain.User, csrf string) {
	@ShellLayout(title, user, csrf, navigationContextForTitle(title))
}

templ ShellLayout(title string, user *domain.User, csrf string, context NavigationContext) {
	<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{ title } · Mouseion</title><link rel="stylesheet" href="/static/vendor/pico-2.1.1.min.css"/><link rel="stylesheet" href="/static/app.css"/><script src="/static/vendor/htmx-2.0.7.min.js" defer></script><script>
window.escapeHtml = function (s) {
  return String(s).replace(/[&<>"']/g, function (c) {
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
};
document.addEventListener('htmx:responseError', function (evt) {
  var target = evt.detail.target;
  if (!target) return;
  var text = ((evt.detail.xhr && evt.detail.xhr.responseText) || 'Request failed').trim();
  var workflowNode = target.closest && target.closest('[data-workflow]');
  var workflow = workflowNode ? workflowNode.getAttribute('data-workflow') : 'This operation';
  target.innerHTML = '<article role="alert"><strong>' + window.escapeHtml(workflow) + ' could not be updated:</strong> ' + window.escapeHtml(text) + '<p><small>Review this operation or try again.</small></p></article>';
});
document.addEventListener('submit', function (evt) {
  var form = evt.target.closest && evt.target.closest('form[data-acquire]');
  if (!form) return;
  var button = form.querySelector('button[type="submit"]');
  if (button) { button.disabled = true; button.setAttribute('aria-busy', 'true'); button.textContent = 'Adding to My Books…'; }
});
document.addEventListener('submit', async function (evt) {
  var form = evt.target.closest && evt.target.closest('form[data-prepare-deck]');
  if (!form) return;
  evt.preventDefault();
  var button = form.querySelector('button[type="submit"]');
  var status = form.parentElement.querySelector('[data-deck-preparation]');
  if (button) { button.disabled = true; button.setAttribute('aria-busy', 'true'); button.textContent = 'Preparing deck…'; }
  try {
    var response = await fetch(form.action, {method: 'POST', body: new FormData(form), credentials: 'same-origin', headers: {'Accept': 'application/json'}});
    if (!response.ok) {
      var detail = (await response.text()).trim();
      throw new Error(detail || ('Request failed with status ' + response.status));
    }
    form.hidden = true;
    status.hidden = false;
    await window.pollDeckPreparation(response.url, status, form);
  } catch (error) {
    status.hidden = false;
    status.innerHTML = '<p role="alert">Deck preparation could not start: ' + window.escapeHtml(error && error.message ? error.message : 'Please try again.') + '</p>';
    if (button) { button.disabled = false; button.removeAttribute('aria-busy'); button.textContent = 'Prepare deck'; }
  }
});
window.pollDeckPreparation = async function (statusURL, target, sourceForm) {
  try {
    var response = await fetch(statusURL, {credentials: 'same-origin', headers: {'Accept': 'application/json'}});
    if (!response.ok) throw new Error((await response.text()).trim() || ('Request failed with status ' + response.status));
    var preparation = await response.json();
    var stateLabels = {queued: 'Deck queued', preparing: 'Preparing deck', ready: 'Deck ready', failed: 'Deck preparation failed', cancelled: 'Deck preparation cancelled'};
    var phaseLabels = {queued: 'Waiting to start', freezing: 'Freezing the selected vocabulary', submitting: 'Submitting translation requests', waiting: 'Waiting for Batch translation; it can take hours (up to 24h)', reconciling: 'Reconciling translation results', retrying: 'Retrying temporary translation failures', translating: 'Translating selected vocabulary', assembling: 'Assembling the Anki package', finalizing: 'Finalizing the Anki package', completed: 'Preparation complete', failed: 'Preparation failed', cancelled: 'Preparation cancelled'};
    var active = preparation.state === 'queued' || preparation.state === 'preparing';
    var html = '<h3>' + window.escapeHtml(stateLabels[preparation.state] || 'Deck preparation') + '</h3>';
    if (active) {
      html += '<p aria-busy="true">' + window.escapeHtml(phaseLabels[preparation.phase] || (preparation.state === 'queued' ? 'Waiting for preparation to begin' : 'Preparing the deck')) + '…</p>';
      var t = preparation.translation || {};
      if (Number(t.eligible || 0) > 0) html += 'Translations: ' + Number(t.completed || 0) + ' complete · ' + Number(t.failed || 0) + ' unavailable · ' + Number(t.retrying || 0) + ' retrying · ' + Number(t.pending || 0) + ' waiting.';
      var b = preparation.batch || {};
      if (Number(b.requests || 0) > 0) html += 'Batch requests: ' + Number(b.completed || 0) + ' complete · ' + Number(b.failed || 0) + ' failed · ' + Number(b.expired || 0) + ' expired' + (Number(b.age_seconds || 0) > 0 ? ' · running for ' + Math.floor(Number(b.age_seconds || 0) / 3600) + 'h' : '') + '.';
    }
    html += '<progress aria-label="Deck preparation progress" value="' + Number(preparation.progress || 0) + '" max="100">' + Number(preparation.progress || 0) + '%</progress>';
    if (preparation.deck_name) html += '<p><strong>Deck:</strong> <code>' + window.escapeHtml(preparation.deck_name) + '</code><br/><strong>Filename:</strong> <code>' + window.escapeHtml(preparation.filename) + '</code></p>';
    if (preparation.ready) {
      var readyResponse = await fetch(statusURL, {credentials: 'same-origin', headers: {'Accept': 'text/html', 'HX-Request': 'true'}});
      if (!readyResponse.ok) throw new Error((await readyResponse.text()).trim() || ('Request failed with status ' + readyResponse.status));
      target.outerHTML = await readyResponse.text(); return;
    } else if (active) {
      html += '<button type="button" class="outline secondary" data-cancel-preparation>Cancel preparation</button>';
    } else {
      if (preparation.error) html += '<p role="alert">' + window.escapeHtml(preparation.error) + '</p>';
      html += '<button type="button" data-retry-preparation>Retry preparation</button>';
    }
    target.innerHTML = html;
    var cancel = target.querySelector('[data-cancel-preparation]');
    if (cancel) cancel.addEventListener('click', function () { window.updateDeckPreparation(statusURL.replace(/\/status$/, '/cancel'), target, sourceForm); });
    var retry = target.querySelector('[data-retry-preparation]');
    if (retry) retry.addEventListener('click', function () { window.updateDeckPreparation(statusURL.replace(/\/status$/, '/retry'), target, sourceForm); });
    if (active) setTimeout(function () { window.pollDeckPreparation(statusURL, target, sourceForm); }, 1500);
  } catch (error) {
    target.innerHTML = '<p role="alert">Could not check deck preparation: ' + window.escapeHtml(error && error.message ? error.message : 'Please try again.') + '</p><button type="button" data-check-preparation>Try again</button>';
    target.querySelector('[data-check-preparation]').addEventListener('click', function () { window.pollDeckPreparation(statusURL, target, sourceForm); });
  }
};
window.updateDeckPreparation = async function (action, target, sourceForm) {
  var data = new FormData();
  data.set('csrf_token', sourceForm.querySelector('[name="csrf_token"]').value);
  var consent = sourceForm.querySelector('[name="external_translation_consent"]');
  if (consent && consent.checked) data.set('external_translation_consent', 'on');
  try {
    var response = await fetch(action, {method: 'POST', body: data, credentials: 'same-origin', headers: {'Accept': 'application/json'}});
    if (!response.ok) throw new Error((await response.text()).trim() || ('Request failed with status ' + response.status));
    await window.pollDeckPreparation(action.replace(/\/(cancel|retry)$/, '/status'), target, sourceForm);
  } catch (error) {
    target.insertAdjacentHTML('beforeend', '<p role="alert">Deck action failed: ' + window.escapeHtml(error && error.message ? error.message : 'Please try again.') + '</p>');
  }
};
document.addEventListener('htmx:afterSwap', function (evt) {
  ['provisional-journey-list', 'primary-goal-section', 'library-results', 'book-metadata-region'].forEach(function (id) {
    var region = document.getElementById(id);
    if (!region) return;
    var focusID = region.getAttribute('data-focus-id');
    if (!focusID) return;
    var source = evt.detail && evt.detail.elt;
	if (source && !region.contains(source) && source.getAttribute('data-focus-results') !== 'true') {
      region.removeAttribute('data-focus-id');
      return;
    }
    var focusTarget = document.getElementById(focusID);
    if (focusTarget) focusTarget.focus();
    region.removeAttribute('data-focus-id');
  });
});
</script></head><body><a class="skip-link" href="#main-content">Skip to main content</a><header class="container site-header"><nav class="site-header__nav" aria-label="Primary navigation" data-navigation-context={ string(context) }><ul class="site-header__brand"><li><a href="/"><strong>Mouseion</strong></a></li></ul>
	if user != nil {
		<ul class="site-header__navigation">
		<li><a href="/library" { destinationAttributes(context, NavigationLibrary)... }>My Books</a></li><li><a href="/journey" { destinationAttributes(context, NavigationReadingJourney)... }>Reading Journey</a></li><li><a href="/vocabulary" { destinationAttributes(context, NavigationVocabulary)... }>Vocabulary</a></li>@ActiveStudyLanguageSwitcher(shellViewFromContext(ctx), csrf)
		<li class="site-header__account"><small>{ user.Username }</small></li><li class="site-header__session"><form class="inline" method="post" action="/logout"><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Log out</button></form></li></ul>
	}
	</nav></header><main id="main-content" class="container" tabindex="-1">{ children... }</main></body></html>
}
templ LibraryPage(user domain.User, csrf string, books []domain.SourceMaterialSummary, message, goalBookID string, hasCatalogueConnections bool) {
	@MyBooksPage(user, csrf, legacyMyBooks(books), message, "", goalBookID, hasCatalogueConnections, MyBooksBrowseState{})
}

templ JourneyMembershipAction(bookID string, member bool, revision int64, csrf string) {
	if bookID != "" {
		if member {
			<p><strong>In Reading Journey.</strong> <a href={ templ.SafeURL("/journey#" + journeyBookAnchorID(bookID)) }>View this Journey entry</a></p>
			@RemoveJourneyMembershipAction(bookID, revision, csrf)
		} else {
			<form method="post" action={ templ.SafeURL(journeyAddURL(bookID)) }>
				<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_revision" value={ fmt.Sprintf("%d", revision) }/>
				<button type="submit">Add to Reading Journey</button>
			</form>
		}
	}
}

templ RemoveJourneyMembershipAction(bookID string, revision int64, csrf string) {
	@Confirmation("Remove from Reading Journey", "This changes only Journey membership. Queued or running analysis continues, acquired content and completed analysis remain, and removing the current Primary Goal clears that Goal.", StatusDanger) {
		<form method="post" action={ templ.SafeURL(journeyRemoveURL(bookID)) }>
			<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_revision" value={ fmt.Sprintf("%d", revision) }/>
			<button type="submit" class="outline secondary">Confirm removal</button>
		</form>
	}
}

templ MyBookRow(csrf string, book domain.MyBook, goalBookID string) {
	<article class="resource-card library-book" data-acquired={ boolString(book.Acquired != nil) } aria-labelledby={ "book-title-" + book.Book.ID }>
		<div class="library-book__identity">
			<h2 id={ "book-title-" + book.Book.ID } class="bibliographic-title">
				<a href={ templ.SafeURL("/books/"+book.Book.ID) }>{ book.Book.Title }</a>
			</h2>
			if book.Acquired != nil && (book.Acquired.Source.MediaType != "" || !book.Acquired.Source.CreatedAt.IsZero()) {
				<p class="metadata">
					if book.Acquired.Source.MediaType != "" {
						<span>{ book.Acquired.Source.MediaType }</span>
					}
					if !book.Acquired.Source.CreatedAt.IsZero() {
						<span>acquired { book.Acquired.Source.CreatedAt.Format("2006-01-02") }</span>
					}
				</p>
				}
		</div>
		<div class="library-book__supporting">
			@StatusBadge(myBookEvidenceLabel(book.EvidenceState()), statusTone(myBookEvidenceLabel(book.EvidenceState())))
			if book.Book.ID == goalBookID || book.JourneyGoal {
				@StatusBadge("Current Primary Goal", StatusInfo)
				<p><a href={ templ.SafeURL("/journey#journey-book-"+book.Book.ID) }>View Primary Goal in Reading Journey</a></p>
			}
			if book.Acquired != nil && book.Acquired.AnalysisStatus != "" && book.Acquired.AnalysisStatus != myBookEvidenceLabel(book.EvidenceState()) {
				<p class="metadata">Analysis evidence: { myBookAnalysisLabel(book.Acquired.AnalysisStatus) }</p>
			}
			<p class="library-next-action"><strong>Next action:</strong>
				if myBookLifecycleActionFor(book).Status != myBookEvidenceLabel(book.EvidenceState()) {
					{ myBookLifecycleActionFor(book).Status }.
				}
				{ myBookLifecycleActionFor(book).Description }
			</p>
			<div class="action-group">
				if !book.JourneyGoal {
					@JourneyMembershipAction(book.Book.ID, book.JourneyMember, book.JourneyRevision, csrf)
				}
				{{ action := myBookLifecycleActionFor(book) }}
				if action.Label != "Start analysis" {
					@LifecycleActionControl(action, csrf)
				}
				@Confirmation("Remove from My Books", "This removes only My Books membership. Acquired content, aliases, and immutable history remain.", StatusDanger) {
					<form method="post" action={ templ.SafeURL("/library/books/"+book.Book.ID+"/remove") }><input type="hidden" name="csrf_token" value={ csrf }/><button type="submit" class="outline secondary">Confirm removal</button></form>
				}
			</div>
		</div>
	</article>
}

templ NeedsLanguageBookRow(book domain.MyBook) {
	<article class="resource-card library-book" aria-labelledby={ "book-title-" + book.Book.ID }>
		<div class="library-book__identity">
			<h2 id={ "book-title-" + book.Book.ID } class="bibliographic-title">{ book.Book.Title }</h2>
			<p class="metadata">Language not assigned in the catalogue</p>
		</div>
	</article>
}

templ MyBooksBrowseLink(browse MyBooksBrowseState, page int, label string, selected, focusResults bool) {
	<a class="outline" data-focus-results={ boolString(focusResults) } { myBooksSelectedAttributes(selected)... } href={ templ.SafeURL(myBooksResultsURL(browse, page)) } hx-get={ myBooksResultsURL(browse, page) } hx-target="#library-results" hx-swap="outerHTML" hx-push-url="true">{ label }</a>
}

templ MyBooksResults(csrf string, books []domain.MyBook, goalBookID string, browse MyBooksBrowseState) {
	<section id="library-results" aria-labelledby="library-books-heading" data-focus-id="library-books-heading">
		<h2 id="library-books-heading" tabindex="-1">{ myBooksResultsHeading(browse) }</h2>
		if browse.Total == 0 {
			<p { myBooksResultAnnouncementAttributes(browse.LanguageCorpus)... }>
				if browse.TextNoMatch && browse.NeedsLanguage {
					No books awaiting a language match “{ browse.Query }”. <a data-focus-results="true" href={ templ.SafeURL(myBooksURL("", 1, true)) } hx-get={ myBooksURL("", 1, true) } hx-target="#library-results" hx-swap="outerHTML" hx-push-url="true">Clear search</a>
				} else if browse.TextNoMatch {
					No books in your local collection in { myBooksLanguageName(browse) } match “{ browse.Query }”. <a data-focus-results="true" href={ templ.SafeURL(myBooksURL("", 1, browse.NeedsLanguage)) } hx-get={ myBooksURL("", 1, browse.NeedsLanguage) } hx-target="#library-results" hx-swap="outerHTML" hx-push-url="true">Clear search</a>
				} else if browse.NeedsLanguage {
					No books are awaiting a language in the local collection.
				} else if browse.Language != "" {
					No books in your local collection are in { myBooksLanguageName(browse) }.
				}
			</p>
		} else {
			<p { myBooksResultAnnouncementAttributes(browse.LanguageCorpus)... }>{ myBooksResultCount(browse.Total) }</p>
		}
		if len(books) > 0 {
			<div class="library-list">
				for _, book := range books {
					if browse.NeedsLanguage {
						@NeedsLanguageBookRow(book)
					} else if myBooksBookInLanguage(browse, book) {
						@MyBookRow(csrf, book, goalBookID)
					}
				}
			</div>
		}
		if browse.PageCount > 1 {
			<nav class="library-paging" aria-label="Paging">
				if browse.Page > 1 {
					@MyBooksBrowseLink(browse, browse.Page-1, "Previous", false, true)
				}
				@MyBooksBrowseLink(browse, browse.Page, fmt.Sprintf("Page %d of %d", browse.Page, browse.PageCount), true, true)
				if browse.Page < browse.PageCount {
					@MyBooksBrowseLink(browse, browse.Page+1, "Next", false, true)
				}
			</nav>
		}
		if browse.LanguageCorpus != nil {
			@LanguageCorpusPanel(browse, *browse.LanguageCorpus)
		}
	</section>
}

templ NeedsLanguageStrip(count int) {
	<section class="library-needs-language" aria-labelledby="library-needs-language-heading">
		<h2 id="library-needs-language-heading">Books awaiting a language</h2>
		if count == 1 {
			<p>1 book is outside the active language collections because the catalogue has not assigned a language.</p>
		} else {
			<p>{ fmt.Sprintf("%d books are outside the active language collections because the catalogue has not assigned a language.", count) }</p>
		}
		<p>Fix the language in the catalogue, then re-sync from <a href="/connections">Connections</a>.</p>
		<p><a href="/library?needs-language">Review books awaiting a language</a></p>
	</section>
}

templ MyBooksPage(user domain.User, csrf string, books []domain.MyBook, message, pageError, goalBookID string, hasCatalogueConnections bool, browse MyBooksBrowseState) {
	@ShellLayout("My Books", &user, csrf, NavigationLibrary) {
		<section class="library-masthead" aria-labelledby="library-page-title">
			<header class="page-header">
				<div class="page-header__content">
					<h1 id="library-page-title">{ myBooksPageHeading(browse) }</h1>
					<p>Your working collection: literature you care about, with clear evidence for what you can do next.</p>
				</div>
			</header>
		</section>
		if message != "" {
			@Feedback(FeedbackSuccess, "", message)
		}
		if pageError != "" {
			@Feedback(FeedbackError, "My Books needs attention", pageError)
		}
		if len(books) == 0 && (!browse.Enabled || (browse.AllCount == 0 && browse.Language != "")) {
			@EmptyState("Build My Books from your catalogue", "Connect a catalogue, then sync it. Ready-language metadata will appear here.") {
				<a role="button" href="/connections">Connect a catalogue</a>
				if hasCatalogueConnections {
					<a role="button" class="outline" href="/connections">Sync catalogue</a>
				}
			}
		}
		if browse.Enabled && browse.Language == "" && !browse.NeedsLanguage {
			if browse.NeedsLanguageCount > 0 {
				@NeedsLanguageStrip(browse.NeedsLanguageCount)
			} else if browse.AllCount == 0 {
				@EmptyState("Build My Books from your catalogue", "Connect a catalogue, then sync it. Ready-language metadata will appear here.") {
					<a role="button" href="/connections">Connect a catalogue</a>
					if hasCatalogueConnections {
						<a role="button" class="outline" href="/connections">Sync catalogue</a>
					}
				}
			} else {
				@EmptyState("Choose a study language", "Choose a language in the shell before browsing its Books.") {}
			}
		} else if browse.Enabled && (browse.AllCount > 0 || browse.NeedsLanguage) {
			if browse.NeedsLanguageCount > 0 {
				@NeedsLanguageStrip(browse.NeedsLanguageCount)
			}
			<section class="library-finder" aria-label="Find books">
				<form class="library-search" role="search" method="get" action={ templ.SafeURL(myBooksURL("", 1, browse.NeedsLanguage)) } hx-get={ myBooksURL("", 1, browse.NeedsLanguage) } hx-target="#library-results" hx-swap="outerHTML" hx-push-url="true">
					<label for="library-search-query">Search My Books</label>
					<div class="library-search__controls">
						<input id="library-search-query" type="search" name="q" value={ browse.Query } placeholder="Title, author, or edition"/>
						<button type="submit">Search</button>
					</div>
				</form>
			</section>
			@MyBooksResults(csrf, books, goalBookID, browse)
		} else if len(books) > 0 {
			<section class="library-list" aria-labelledby="acquired-books-heading">
				<h2 id="acquired-books-heading">Books in My Books</h2>
				for _, book := range books {
					@MyBookRow(csrf, book, goalBookID)
				}
			</section>
		}
	}
}

templ LanguageCorpusPanel(browse MyBooksBrowseState, panel languageCorpusPanelView) {
	<section id="language-view-panel" class="language-view-panel" data-state={ panel.State } aria-labelledby="language-view-panel-heading">
		<h2 id="language-view-panel-heading">{ fmt.Sprintf("Coverage across %s", panel.LanguageLabel) }</h2>
		<p class="language-view-announcement" role="status" aria-live="polite" aria-atomic="true">{ languageCorpusLiveSummary(panel) }</p>
		if panel.PanelUnavailable {
			<p>Current analyzed evidence could not be loaded. The book collection is unchanged; try again later.</p>
		} else if panel.AnalyzedBookCount == 0 {
			<section aria-labelledby="language-view-analyzed-heading">
				<h3 id="language-view-analyzed-heading">Analyzed books</h3>
				<p>No analyzed books in { panel.LanguageLabel } yet. Coverage appears for books with a current completed analysis.</p>
			</section>
		} else {
			<p>These figures use current known vocabulary and current completed analyses in { panel.LanguageLabel }. Coverage is evidence, not a recommendation or mastery claim.</p>
			<div class="language-view-aggregates">
				<section aria-labelledby="language-view-analyzed-heading">
					<h3 id="language-view-analyzed-heading">Analyzed books</h3>
					<dl><div><dt>Books with current evidence</dt><dd class="numeric">{ panel.AnalyzedBookCount }</dd></div></dl>
					<p>Books contributing to the analyzed set in { panel.LanguageLabel }.</p>
				</section>
				<section aria-labelledby="language-view-coverage-heading">
					<h3 id="language-view-coverage-heading">Current known coverage</h3>
					<dl><div><dt>Current, token-weighted coverage</dt><dd><strong class="numeric">{ panel.CoveragePercent }</strong> <span>({ panel.KnownTokenCount } of { panel.AnalyzableTokenCount } tokens)</span></dd></div></dl>
					<p>Current known vocabulary across the analyzed set in { panel.LanguageLabel }.</p>
				</section>
				<section aria-labelledby="language-view-unknown-heading">
					<h3 id="language-view-unknown-heading">Highest-impact unknown vocabulary</h3>
					<p>Ordered by occurrence contribution across the analyzed set; this order does not recommend study or imply mastery.</p>
					if len(panel.TopUnknownLemmas) == 0 {
						<p>No unknown vocabulary contribution is reported.</p>
					} else {
						<ol class="language-view-unknown-list">
							for _, lemma := range panel.TopUnknownLemmas {
								<li><span><strong>{ lemma.Lemma }</strong> <small>{ lemma.UPOS }</small></span><span>{ fmt.Sprintf("%d occurrences", lemma.OccurrenceCount) }</span></li>
							}
						</ol>
					}
				</section>
				<section aria-labelledby="language-view-books-heading">
					<h3 id="language-view-books-heading">Per-book spread</h3>
					<p>Open a book to inspect its own evidence. Excluded books are not assigned zero coverage and do not affect the aggregate.</p>
					if len(panel.PerBook) == 0 {
						<p>No book evidence is reported.</p>
					} else {
						<ul class="language-view-book-list">
							for _, book := range panel.PerBook {
								<li class="language-view-book-row">
									<h4>
										if book.BookID != "" {
											<a href={ templ.SafeURL("/books/" + url.PathEscape(book.BookID)) }>{ book.Title }</a>
										} else {
											{ book.Title }
										}
									</h4>
									if book.Included {
										<dl><div><dt>Current known coverage</dt><dd>{ book.CoveragePercent } ({ book.KnownTokenCount } of { book.AnalyzableTokenCount } tokens)</dd></div><div><dt>Evidence</dt><dd>{ book.EvidenceLabel }</dd></div></dl>
									} else {
										<p><strong>Excluded:</strong> { book.ExclusionReason }</p>
										<p><strong>Evidence:</strong> { book.EvidenceLabel }</p>
									}
								</li>
							}
						</ul>
					}
				</section>
			</div>
		}
	</section>
}
templ JourneyPage(user domain.User, csrf string, journey journeyPageView, message string, pageError string, activeCampaignID string) {
	@ShellLayout("Reading Journey", &user, csrf, NavigationReadingJourney) {
		@PageHeader(journeyPageTitle(journey), "Keep one current Primary Goal anchored first, followed by the provisional order you chose.", nil) {
			<a role="button" class="outline" href="/library">Prepare another deck</a>
		}
		if message != "" {
			@Feedback(FeedbackSuccess, "", message)
		}
		if pageError != "" {
			@Feedback(FeedbackError, "Action needed", pageError)
			if activeCampaignID != "" {
				<p><a href={ templ.SafeURL("#"+campaignAnchorID(activeCampaignID)) }>Return to the active campaign</a></p>
			}
		}
		@GoalSection(journey.Goal, journey.Residual, csrf, "", "", "")
		<section aria-labelledby="provisional-journey-heading"><h2 id="provisional-journey-heading">Provisional Journey</h2>
			@JourneyProvisionalList(journey, csrf, "", "")
		</section>
		if journey.RouteComparison != nil {
			<section aria-labelledby="route-comparison-heading" class="journey-comparison">
				<h2 id="route-comparison-heading">Compare your order with a vocabulary-efficient alternative</h2>
				<p class="reading-width">Your order above is canonical and remains the active order. This optional comparison is read-only evidence: it never reorders your Journey or selects a Primary Goal. It optimizes exactly one named lexical property—current known-token coverage—using exact integer token counts from current analyzed evidence.</p>
				<p class="reading-width">The comparison is calculated when this page is requested. Fixed constraints, including an active Primary Goal when it is a Journey member, remain fixed. Thresholds for 95%, 97%, and 99% coverage are supporting per-book investment data, not ordering inputs. Structural difficulty, coverage, evidence quality, and learner desire remain separate; this view does not combine them into one score.</p>
				<p class="reading-width">Current coverage is present evidence. Reserved active-campaign vocabulary is not current knowledge; when a reservation snapshot exists and is not confirmed, a separate conditional variant shows what would change if that single transition were confirmed. Reading a book does not change coverage.</p>
				if journey.RouteComparison.ComparisonUnavailable {
					<p role="status"><strong>Comparison unavailable.</strong> The current Journey evidence could not be loaded. Your canonical order is unchanged; try again when analyzed evidence is available.</p>
				} else if len(journey.RouteComparison.LearnerOrder) == 0 {
					<p role="status"><strong>Comparison unavailable.</strong> Add a second Journey book with current analyzed evidence to see a comparison.</p>
				} else {
					<p><strong>{ fmt.Sprintf("%d comparable, %d incomparable", journey.RouteComparison.ComparableCount, journey.RouteComparison.IncomparableCount) }</strong> — incomparable books stay in their learner positions, are not ranked, and are excluded from totals.</p>
					<h3>Your order (canonical)</h3>
					<ol aria-label="Your canonical Journey order">
						for _, item := range journey.RouteComparison.LearnerOrder {
							<li><strong>{ item.Title }</strong> — rank { item.RankLabel } @StatusBadge(item.EvidenceBadge, item.EvidenceTone)
								if item.Comparable {
									<span> · { item.CurrentCoverageLabel } current known-token coverage; threshold investment: { item.ThresholdLabel }</span>
								} else {
									<span> — { item.IncomparableDetail }</span>
								}
							</li>
						}
					</ol>
					if journey.RouteComparison.ComparableCount == 0 {
						<p role="status"><strong>No comparable evidence is available.</strong> The canonical positions above are retained until current analyzed evidence can be compared.</p>
					} else {
						<details>
							<summary>Show vocabulary-efficient alternative (optional comparison)</summary>
						<h3>Current advisory order</h3>
						<p>Comparable books are ordered by descending current known-token coverage, then learner position, then language and book ID. These are the visible tie-break assumptions; no other property changes the order.</p>
						<div class="table-region" tabindex="0" aria-label="Current advisory order table">
							<table><caption>Current advisory order; fixed and incomparable positions remain constrained.</caption><thead><tr><th scope="col">Rank</th><th scope="col">Book</th><th scope="col">Evidence</th><th scope="col">Current coverage</th><th scope="col">Threshold investment</th><th scope="col">Placement</th></tr></thead><tbody>
								for _, item := range journey.RouteComparison.AdvisoryOrder {
									<tr><td>{ item.RankLabel }</td><td>{ item.Title }</td><td>@StatusBadge(item.EvidenceBadge, item.EvidenceTone)</td><td>{ item.CurrentCoverageLabel }</td><td>{ item.ThresholdLabel }</td><td>{ routePlacementLabel(item) }{ routeIncomparableSuffix(item) }</td></tr>
								}
							</tbody></table>
						</div>
						if journey.RouteComparison.HasConditional && conditionalRouteDiffers(journey.RouteComparison.AdvisoryOrder, journey.RouteComparison.ConditionalOrder) {
							<h3>If the pending study is confirmed (conditional projected evidence)</h3>
							<p>This is a separate conditional projected variant, not current evidence. It assumes only the active campaign's reserved vocabulary graduates through the single justified transition.</p>
							<div class="table-region" tabindex="0" aria-label="Conditional advisory order table">
								<table><caption>Conditional advisory order if the pending study is confirmed.</caption><thead><tr><th scope="col">Rank</th><th scope="col">Book</th><th scope="col">Conditional coverage</th><th scope="col">Placement</th></tr></thead><tbody>
									for _, item := range journey.RouteComparison.ConditionalOrder {
										<tr><td>{ item.RankLabel }</td><td>{ item.Title }</td><td>{ item.ConditionalCoverageLabel }</td><td>{ routePlacementLabel(item) }{ routeIncomparableSuffix(item) }</td></tr>
									}
								</tbody></table>
							</div>
						}
						</details>
					}
				}
			</section>
		}
		<section aria-labelledby="campaign-operations-heading" class="journey-secondary"><h2 id="campaign-operations-heading">Campaign history &amp; operations</h2>
			<p>Campaign records and prepared decks are supporting history and operations. They are separate from Reading Journey membership.</p>
			if len(journey.Prepared) > 0 {
				<h3>Prepared books and decks</h3><div class="campaign-list">
				for _, item := range journey.Prepared {
					<article class="resource-card"><div><h4>{ canonicalBookTitle(item.Book) }</h4><p>@StatusBadge(deckPreparationTitle(item.Deck), deckPreparationStatusTone(item.Deck))</p>
					if deckPreparationEmpty(item.Deck) {
						<p>This book has no recurring vocabulary to study, so no cards were created.</p>
					} else {
						<p><code>{ item.Deck.DeckName }</code></p><p>{ fmt.Sprintf("%d cards", item.Deck.TotalCards) } · <a href={ templ.SafeURL("/deck-preparations/"+item.Deck.ID+"/download") }>Download deck</a></p>
					}
					</div></article>
				}
				</div>
			}
			if len(journey.Campaigns) == 0 && len(journey.Prepared) == 0 {
				<p>No campaign history or operations are available.</p>
			}
			for _, item := range journey.Campaigns {
				if item.Campaign.Status == domain.CampaignComplete || item.Campaign.Status == domain.CampaignAbandoned || item.Campaign.Status == domain.CampaignActive || item.Campaign.Status == domain.CampaignQueued {
					@CampaignCard(item, csrf, item.Campaign.Status == domain.CampaignQueued)
				}
			}
		</section>
	}
}

templ PrimaryGoalFinishPage(user domain.User, csrf string, outcome primaryGoalFinishView) {
	@ShellLayout("Reading finished", &user, csrf, NavigationReadingJourney) {
		@PrimaryGoalFinish(outcome, csrf)
	}
}

templ PrimaryGoalFinish(outcome primaryGoalFinishView, csrf string) {
	<section id="primary-goal-section" tabindex="-1" aria-labelledby="primary-goal-finish-heading" class="journey-goal journey-finish-outcome">
		<h1 id="primary-goal-finish-heading">Reading finished</h1>
		<p role="status" aria-live="polite" aria-atomic="true">Reading finished for <strong>{ outcome.BookTitle }</strong>.</p>
		if outcome.Error != "" {
			<article role="alert" class="feedback feedback--error"><strong>Action needed</strong><p>{ outcome.Error }</p></article>
		}
		<ol class="finish-outcome" aria-label="Reading finish outcome">
			<li>
				<h2>Reading finished</h2>
				<p>{ outcome.BookTitle } is recorded as finished reading. This does not complete the Reading Journey or establish vocabulary knowledge.</p>
			</li>
			<li>
				<h2>Vocabulary transition</h2>
				<p>{ finishGraduationText(outcome) }</p>
				if len(outcome.Graduated) > 0 {
					<p>Identities added to known vocabulary:</p>
					<ul>
						for _, item := range outcome.Graduated {
							<li>{ finishGraduatedIdentity(item) }</li>
						}
					</ul>
				}
				if outcome.Campaign != nil && outcome.ResidualVocabulary > 0 {
					<p>Continue or abandon this residual campaign from Campaign history &amp; operations. Its prepared deck and reservation remain part of history.</p>
				}
			</li>
			<li>
				<h2>Reading Journey recalculated</h2>
				if outcome.Error == "" {
					if len(outcome.Evidence) == 0 {
						<p>No remaining Journey books have evidence to show. The order remains available for editing.</p>
					}
					for _, item := range outcome.Evidence {
						<section class="finish-evidence" aria-labelledby={ "finish-evidence-" + journeyBookID(item.Book) }>
							<h3 id={ "finish-evidence-" + journeyBookID(item.Book) }>{ canonicalBookTitle(item.Book.Book) }</h3>
							if item.Changed {
								<p><strong>Before:</strong> { item.BeforeLabel }; current coverage { item.BeforeCurrent }; conditional-projected coverage { item.BeforeProjected }.</p>
							}
							<p><strong>Now — { item.AfterLabel }:</strong> current coverage { item.AfterCurrent }; conditional-projected coverage { item.AfterProjected }.</p>
						</section>
					}
				}
			</li>
			<li>
				<h2>Where next?</h2>
				<p>Choose what you want to do next. No new Primary Goal has been selected.</p>
				<div class="action-group">
					if len(outcome.Journey.Provisional) > 0 {
						<p><strong>First in your current order:</strong> { canonicalBookTitle(outcome.Journey.Provisional[0].Book) }</p>
						if outcome.Journey.Provisional[0].CanChooseGoal {
							<form method="post" action={ templ.SafeURL(finishOutcomeWhereNextURL(outcome.Journey.Provisional[0])) }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_goal_book_id" value=""/><button type="submit">Choose as Primary Goal</button></form>
						} else if outcome.Journey.Provisional[0].GoalEligibilityReason != "" {
							<p class="metadata">{ outcome.Journey.Provisional[0].GoalEligibilityReason }</p>
						}
					}
					<a role="button" class="outline" href="/journey">Reorder Reading Journey</a>
					<a role="button" class="outline" href="/journey">Choose another book from Reading Journey</a>
					<a href="/journey">Pause without a new Goal</a>
				</div>
				<p><a href="/journey">Return to the recalculated Reading Journey</a></p>
			</li>
		</ol>
	</section>
}
templ JourneyProvisionalList(journey journeyPageView, csrf, focusBookID, statusMessage string) {
	<div id="provisional-journey-list" data-focus-id={ journeyBookAnchorID(focusBookID) }>
		<p id="provisional-journey-status" class="journey-status" role="status" aria-live="polite" aria-atomic="true">{ statusMessage }</p>
		if len(journey.Provisional) == 0 {
			@EmptyState("No provisional books yet", "Your Reading Journey is empty after the Primary Goal. Add or reconsider books from My Books when you are ready.") {
				<a role="button" class="outline" href="/library">Browse My Books</a>
			}
		}
		<div class="journey-list">
			for _, item := range journey.Provisional {
				@JourneyBookCard(item, false, csrf, journey.Revision, journeyExpectedGoalBookID(journey))
			}
		</div>
	</div>
}
templ GoalSection(goal *journeyBookView, residual *goalResidualView, csrf string, message, sectionError, focusBookID string) {
	<section id="primary-goal-section" tabindex="-1" aria-labelledby="primary-goal-heading" class="journey-goal" data-focus-id={ goalSectionFocusID(focusBookID) }><h2 id="primary-goal-heading">Primary Goal</h2>
		if message != "" {
			<p id="goal-section-status" class="journey-status" role="status" aria-live="polite" aria-atomic="true">{ message }</p>
		}
		if sectionError != "" {
			<article role="alert" class="feedback feedback--error"><strong>Action needed</strong><p>{ sectionError }</p></article>
		}
		if goal == nil {
			@EmptyState("No Primary Goal yet", "Choose an analyzed member as your current commitment from your Reading Journey.")
		} else {
			@JourneyBookCard(goalCardView(goal, residual), true, csrf, 0, "")
		}
	</section>
}
templ JourneyBookCard(item journeyBookView, primary bool, csrf string, expectedRevision int64, expectedGoalBookID string) {
	<article id={ journeyBookAnchorID(journeyBookID(item)) } tabindex="-1" data-focus-anchor class={ journeyBookClass(primary) }><div><h3>
	if journeyEntryAvailable(item) {
		<a href={ templ.SafeURL(journeyEntryURL(journeyBookID(item))) }>{ canonicalBookTitle(item.Book) }</a>
	} else {
		{ canonicalBookTitle(item.Book) }
	}
	</h3>
	if primary {
		<p>@StatusBadge("Primary Goal", StatusInfo) <span aria-hidden="true">·</span> Current commitment</p>
	} else {
		<p>@StatusBadge("Provisional — your order", StatusNeutral) <span aria-hidden="true">·</span> Your order</p>
	}
	if primary && item.GoalReadingOnly {
		@StatusBadge("Reading-only Goal", StatusInfo)
		if item.GoalUnassessed {
			<p>No analysis or deck exists yet, so Mouseion cannot assess this book's vocabulary. This Goal stands on its own; nothing is prepared automatically.</p>
		} else {
			<p>Analysis evidence exists, but no deck has been prepared. Reading directly is the current path; a deck never prepares automatically.</p>
		}
	}
	if primary && item.GoalResidual != nil {
		@StatusBadge("Vocabulary work remains", StatusWarning)
		<p>Changing or clearing this Goal keeps the active campaign and its reserved vocabulary unchanged. Resolve it by graduating or abandoning it from Campaign history &amp; operations.
			if item.GoalResidual.ReservedCount != nil {
				{ fmt.Sprintf(" %d ungraduated vocabulary identities remain reserved.", *item.GoalResidual.ReservedCount) }
			}
		</p>
	}
	@JourneyEvidence(item, csrf)
	</div>
	if !primary {
		<div class="journey-book__controls" aria-label={ "Reorder "+canonicalBookTitle(item.Book) }>
			<form method="post" action={ journeyMoveURL(journeyBookID(item), true) } hx-post={ journeyMoveURL(journeyBookID(item), true) } hx-target="#provisional-journey-list" hx-swap="outerHTML">
				<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_revision" value={ fmt.Sprintf("%d", expectedRevision) }/>
				<button type="submit" class="outline" aria-label={ "Move "+canonicalBookTitle(item.Book)+" earlier" } disabled?={ !item.CanMoveEarlier }>Move earlier</button>
			</form>
			<form method="post" action={ journeyMoveURL(journeyBookID(item), false) } hx-post={ journeyMoveURL(journeyBookID(item), false) } hx-target="#provisional-journey-list" hx-swap="outerHTML">
				<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_revision" value={ fmt.Sprintf("%d", expectedRevision) }/>
				<button type="submit" class="outline" aria-label={ "Move "+canonicalBookTitle(item.Book)+" later" } disabled?={ !item.CanMoveLater }>Move later</button>
			</form>
			@RemoveJourneyMembershipAction(journeyBookID(item), item.JourneyRevision, csrf)
			if item.CanChooseGoal {
				<form method="post" action={ templ.SafeURL("/goal/books/"+journeyBookID(item)) }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_goal_book_id" value={ expectedGoalBookID }/><button type="submit" class="outline">Choose as Primary Goal</button></form>
			} else if item.GoalEligibilityReason != "" {
				<p class="metadata">{ item.GoalEligibilityReason }</p>
			}
		</div>
	} else {
		<div class="goal-card__actions">
			@Confirmation("Mark reading finished", "Record the reading achievement. Vocabulary is changed only when the associated prepared deck has been reviewed.", StatusNeutral) {
				<form method="post" action="/goal/finish" hx-post="/goal/finish" hx-target="#primary-goal-section" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_goal_book_id" value={ journeyBookID(item) }/><button type="submit">Mark reading finished</button></form>
			}
			if item.GoalResidual != nil {
				@Confirmation("Clear Primary Goal", "The active campaign and its reserved vocabulary stay unchanged. Graduate or abandon the residual work from Campaign history & operations.", StatusWarning) {
					<form method="post" action="/goal/clear"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_goal_book_id" value={ journeyBookID(item) }/><button type="submit" class="outline secondary">Clear Primary Goal</button></form>
				}
			} else {
				<form method="post" action="/goal/clear"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_goal_book_id" value={ journeyBookID(item) }/><button type="submit" class="outline secondary">Clear Primary Goal</button></form>
			}
			@RemoveJourneyMembershipAction(journeyBookID(item), item.JourneyRevision, csrf)
			<p>To choose a different Goal, use Choose as Primary Goal on another eligible book in your provisional order.</p>
		</div>
	}
	</article>
}
templ JourneyEvidence(item journeyBookView, csrf string) {
	<p><strong>{ journeyEvidenceLabel(item) }:</strong> { journeyEvidenceDescription(item) }</p>
	{{ action := journeyAnalysisAction(item) }}
	if action.Status != "" {
		<div class="journey-assessment">
			<p><strong>Assessment:</strong> @StatusBadge(action.Status, action.Tone)</p>
			if action.Label != "" && action.Submit {
				<form class="inline-action" method="post" action={ templ.SafeURL(action.URL) }><input type="hidden" name="csrf_token" value={ csrf }/><button type="submit" class="outline">{ action.Label }</button></form>
			} else if action.Label != "" && action.URL != "" {
				<p><a href={ templ.SafeURL(action.URL) }>{ action.Label }</a></p>
			}
		</div>
		<p>{ action.Description }</p>
	}
	<p><strong>Current coverage:</strong> { journeyCurrentCoverage(item) }</p>
	<p><strong>Projected coverage:</strong> { journeyProjectedCoverage(item) }</p>
}

func journeyEntryAvailable(item journeyBookView) bool {
	return item.Book.EvidenceState() == domain.BookAnalyzed && bookHasCompletedAnalysis(item.Book)
}
templ CampaignCard(item campaignView, csrf string, activatable bool) {
	<article id={ campaignAnchorID(item.Campaign.ID) } class={ campaignCardClass(item.Campaign.Status) }><div><h3><a href={ templ.SafeURL("/books/"+item.Book.Source.ID) }>{ canonicalBookTitle(item.Book) }</a></h3><p>@StatusBadge(campaignStatusLabel(item.Campaign.Status), statusTone(string(item.Campaign.Status))) <span aria-hidden="true">·</span> <span>Prepared deck: <code>{ item.Deck.DeckName }</code></span></p><dl class="metadata-list campaign-progress"><div><dt>Book</dt><dd>{ campaignBookLabel(item.Campaign.BookProgress) }{ campaignProgressTime(item.Campaign.BookFinishedAt) }</dd></div><div><dt>Deck</dt><dd>{ campaignDeckLabel(item.Campaign.DeckProgress) }{ campaignProgressTime(item.Campaign.DeckReviewedAt) }</dd></div></dl>
	if item.Campaign.Status == domain.CampaignQueued && item.Coverage != nil {
		<p><strong>{ fmt.Sprintf("%.1f%%", knownCoveragePercent(*item.Coverage)) }</strong> current-known coverage · <strong>{ fmt.Sprintf("%.1f%%", activeCampaignCoveragePercent(*item.Coverage)) }</strong> future-book coverage after the active campaign graduates</p>
	}
	if item.Campaign.CompletedAt != nil {
		<p>Completed { item.Campaign.CompletedAt.UTC().Format("2006-01-02 15:04 UTC") }</p>
	}
	if item.Campaign.Status == domain.CampaignQueued {
		<p>This prepared campaign is separate from Reading Journey membership. Starting reserves its assigned vocabulary for learning; it is not counted as known.</p>
	}
	if item.Campaign.Status == domain.CampaignComplete {
		<p>Assigned vocabulary was graduated to known vocabulary. Generated provenance and this prepared deck remain available.</p>
	}
	if item.Campaign.Status == domain.CampaignAbandoned {
		<p>This campaign remains in history with its book and prepared deck. Ungraduated vocabulary is eligible again unless independently known.</p>
	}
	<p><a href={ templ.SafeURL("/deck-preparations/"+item.Deck.ID+"/download") }>Download prepared deck</a></p></div>
	if activatable {
		<form method="post" action={ templ.SafeURL("/campaigns/"+item.Campaign.ID+"/activate") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_campaign_status" value={ string(item.Campaign.Status) }/><input type="hidden" name="expected_book_progress" value={ string(item.Campaign.BookProgress) }/><input type="hidden" name="expected_deck_progress" value={ string(item.Campaign.DeckProgress) }/><button>Start learning</button></form>
	}
	if item.Campaign.Status == domain.CampaignActive || item.Campaign.Status == domain.CampaignQueued {
		if item.Campaign.Status == domain.CampaignActive {
		<section aria-labelledby={ campaignAnchorID("remaining-"+item.Campaign.ID) } class="campaign-remaining"><h4 id={ campaignAnchorID("remaining-"+item.Campaign.ID) }>Remaining before completion</h4><ul>
			<li>Book: { campaignBookLabel(item.Campaign.BookProgress) }{ campaignRemainingBookText(item.Campaign.BookProgress) }</li>
			<li>Deck: { campaignDeckLabel(item.Campaign.DeckProgress) }{ campaignRemainingDeckText(item.Campaign.DeckProgress) }</li>
		</ul><p>When both conditions are finished, Mouseion adds the campaign's assigned vocabulary to known vocabulary while preserving generated provenance, recalculating coverage evidence, and making no claim about mastery or a spaced-repetition grade.</p></section>
		}
		@ActionGroup() {
			if item.Campaign.Status == domain.CampaignActive {
			if item.Campaign.BookProgress != domain.BookFinished {
				if item.Campaign.DeckProgress == domain.DeckReviewed {
					@Confirmation(campaignCompletionLabel(item), "Review this consequential transition before submitting.", StatusNeutral) {
						@CampaignCompletionDetails(item)
						<form method="post" action={ templ.SafeURL("/campaigns/"+item.Campaign.ID+"/book-finished") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_campaign_status" value={ string(item.Campaign.Status) }/><input type="hidden" name="expected_book_progress" value={ string(item.Campaign.BookProgress) }/><input type="hidden" name="expected_deck_progress" value={ string(item.Campaign.DeckProgress) }/><button>{ campaignCompletionLabel(item) }</button></form>
					}
				} else {
					<form method="post" action={ templ.SafeURL("/campaigns/"+item.Campaign.ID+"/book-finished") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_campaign_status" value={ string(item.Campaign.Status) }/><input type="hidden" name="expected_book_progress" value={ string(item.Campaign.BookProgress) }/><input type="hidden" name="expected_deck_progress" value={ string(item.Campaign.DeckProgress) }/><button>Mark book finished — campaign remains active</button></form>
				}
			}
			if item.Campaign.DeckProgress != domain.DeckReviewed {
				if item.Campaign.BookProgress == domain.BookFinished {
					@Confirmation(campaignCompletionLabel(item), "Review this consequential transition before submitting.", StatusNeutral) {
						@CampaignCompletionDetails(item)
						<form method="post" action={ templ.SafeURL("/campaigns/"+item.Campaign.ID+"/deck-reviewed") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_campaign_status" value={ string(item.Campaign.Status) }/><input type="hidden" name="expected_book_progress" value={ string(item.Campaign.BookProgress) }/><input type="hidden" name="expected_deck_progress" value={ string(item.Campaign.DeckProgress) }/><button>{ campaignCompletionLabel(item) }</button></form>
					}
				} else {
					<form method="post" action={ templ.SafeURL("/campaigns/"+item.Campaign.ID+"/deck-reviewed") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_campaign_status" value={ string(item.Campaign.Status) }/><input type="hidden" name="expected_book_progress" value={ string(item.Campaign.BookProgress) }/><input type="hidden" name="expected_deck_progress" value={ string(item.Campaign.DeckProgress) }/><button>Mark deck reviewed — campaign remains active</button></form>
				}
			}
			}
			@Confirmation("Abandon campaign", "This abandons the campaign without deleting it. The book, prepared deck, generated provenance, and campaign history remain available; any active reservation is released and its vocabulary can be eligible for future decks again unless independently known.", StatusDanger) {
				<p>Book: { canonicalBookTitle(item.Book) } · Prepared deck: { item.Deck.DeckName }</p><p>Abandonment is not deletion, and there is no completion or mastery claim.</p>
				<p>{ campaignAbandonmentOutcome(item.Campaign.Status) }</p>
				<form method="post" action={ templ.SafeURL("/campaigns/"+item.Campaign.ID+"/abandon") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_campaign_status" value={ string(item.Campaign.Status) }/><input type="hidden" name="expected_book_progress" value={ string(item.Campaign.BookProgress) }/><input type="hidden" name="expected_deck_progress" value={ string(item.Campaign.DeckProgress) }/><button class="outline">Confirm abandonment</button></form>
			}
		}
	}
	</article>
}

templ CampaignCompletionDetails(item campaignView) {
		<dl class="metadata-list"><div><dt>Book</dt><dd>{ canonicalBookTitle(item.Book) } — Finished</dd></div><div><dt>Prepared deck</dt><dd>{ item.Deck.DeckName } — Reviewed</dd></div></dl>
		<p>{ campaignGraduationOutcome(item) }</p>
		<p>Generated provenance remains attached to this campaign, book, and prepared deck. Coverage evidence will be recalculated after the transition. This is not a mastery claim or a spaced-repetition grade.</p>
		<p>Completion cannot currently be undone in Mouseion; there is no inline undo.</p>
}
templ BookPage(user domain.User, csrf string, book domain.SourceMaterialSummary, coverage *domain.AnalysisCoverage, statisticsUnavailable bool, message string) {
	@BookPageWithOptions(user, csrf, book, coverage, statisticsUnavailable, message, currentBookPageOptions(book), nil, emptyDeckJourneyAction())
}

templ BookPageWithOptions(user domain.User, csrf string, book domain.SourceMaterialSummary, coverage *domain.AnalysisCoverage, statisticsUnavailable bool, message string, page bookPageOptions, preparation *domain.DeckPreparation, journeyAction deckJourneyActionView) {
	@ShellLayout(canonicalBookTitle(book), &user, csrf, page.Navigation) {
	@Breadcrumb(page.BreadcrumbURL, page.BreadcrumbLabel)
	{{ action := bookLifecycleActionFor(book) }}
	@PageHeader(canonicalBookTitle(book), book.Source.Language+" · "+book.Source.MediaType, StatusBadge(action.Status, action.Tone)) {
		@LifecycleActionControl(action, csrf)
	}
	if message != "" {
		@Feedback(FeedbackSuccess, "", message)
	}
	@NextActionSummary(action)
	if page.Journey.Goal {
		<p><strong>Primary Goal.</strong></p>
		<p><a href={ templ.SafeURL("/journey#journey-book-"+journeyMembershipBookID(book)) }>View Primary Goal in Reading Journey</a></p>
		if page.ShowJourneyRemoval {
			@RemoveJourneyMembershipAction(journeyMembershipBookID(book), page.Journey.Revision, csrf)
		}
	} else {
		@JourneyMembershipAction(journeyMembershipBookID(book), page.Journey.Member, page.Journey.Revision, csrf)
	}
	if coverage != nil {
		if hasAnalysisWarnings(*coverage) {
			<section aria-labelledby="analysis-quality-heading"><h2 id="analysis-quality-heading">Analysis quality</h2>
				<p>These checks describe concrete gaps in the analyzer output. They do not assign a quality grade.</p>
				<article role="note">
					if coverage.TextProfile != nil && coverage.TextProfile.SentenceCount == 0 {
						<p><strong>No sentences returned.</strong> Sentence-length signals are unavailable. Analyze the book again if the source text should contain sentences.</p>
					}
					if coverage.TextProfile != nil && coverage.TextProfile.EmptySentenceCount > 0 {
						<p><strong>Empty sentences returned.</strong> { fmt.Sprintf("%d analyzer-provided sentences contained no tokens; those sentences count as zero tokens in the structural statistics.", coverage.TextProfile.EmptySentenceCount) }</p>
					}
					if coverage.TextProfile != nil && coverage.TextProfile.NormalizedTokenCount > 0 && coverage.AnalyzableTokenCount == 0 {
						<p><strong>No vocabulary-analyzable tokens.</strong> The analyzer returned normalized tokens, but none passed the vocabulary filters, so coverage and vocabulary projections have no usable token denominator.</p>
					}
				</article>
			</section>
		}
		<section aria-labelledby="coverage-heading"><h2 id="coverage-heading">Vocabulary coverage</h2>
			@StatGroup(currentCoverageStatItems(*coverage))
		</section>
		if len(coverage.Thresholds) > 0 {
			<section aria-labelledby="vocabulary-investment-heading"><h2 id="vocabulary-investment-heading">Vocabulary investment</h2>
				<h3>Additional vocabulary</h3><p>Smallest number of deck-eligible lemmas needed to reach each target across all analyzable tokens:</p>
				@StatGroup(thresholdStatItems(coverage.Thresholds))
			</section>
		}
		if len(coverage.TopUnknownLemmas) > 0 {
			<section aria-labelledby="top-unknown-heading"><h2 id="top-unknown-heading">Highest-impact unknown vocabulary</h2>
				<p>The most frequent deck-eligible lemmas in this analysis:</p>
				<ol class="top-unknown">
					for _, lemma := range coverage.TopUnknownLemmas {
						if lexical.IsLemma(lemma.CanonicalLemma) {
							<li><span><strong>{ lemmadisplay.Format(book.Source.Language, lemma.CanonicalLemma, lemma.UPOS) }</strong> <small>{ lemma.UPOS }</small></span><span>{ fmt.Sprintf("%d occurrences", lemma.OccurrenceCount) }</span></li>
						}
					}
				</ol>
			</section>
		}
	}
	if statisticsUnavailable {
		<article role="note"><h2>Analysis insights unavailable</h2><p>This book was analyzed before reproducible vocabulary statistics were recorded. Analyze it again to see current coverage and vocabulary investment.</p></article>
	}
	if book.AnalysisStatus == "analyzed" && bookHasCompletedAnalysis(book) {
		<section aria-labelledby="deck-preparation-heading"><h2 id="deck-preparation-heading">Deck preparation</h2>
			<p>Prepare vocabulary from this book's exact current analysis and EPUB snapshot. It does not start a learning campaign.</p>
			if preparation != nil {
				@DeckPreparationStatus(csrf, *preparation, "", journeyAction)
			} else {
				<form method="post" action={ templ.SafeURL(bookDeckPreparationURL(book)) } data-prepare-deck>
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<fieldset><legend>Optional external translation</legend>
						<p>English translation is optional. If selected, Mouseion sends each selected lemma and its example sentence outside Mouseion to the configured translation provider. Without consent, preparation stays local and translation fields may be incomplete.</p>
						<label><input type="checkbox" name="external_translation_consent"/> I consent to sending selected vocabulary and example sentences for translation</label>
					</fieldset>
					<button type="submit">Prepare deck</button>
				</form>
				<section data-deck-preparation role="status" aria-live="polite" aria-atomic="true" hidden></section>
			}
		</section>
	}
}

}

templ DeckPreparationStatusPage(user domain.User, csrf string, preparation domain.DeckPreparation, resultURL string, journeyAction deckJourneyActionView) {
	@ShellLayout("Deck preparation", &user, csrf, NavigationLibrary) {
		if resultURL != "" {
			@Breadcrumb(resultURL, "Book")
		} else {
			@Breadcrumb("/books/"+preparation.SourceMaterialID, "Book")
		}
		@PageHeader("Deck preparation", "Prepare an Anki deck from one exact completed analysis.", StatusBadge(deckPreparationTitle(preparation), deckPreparationStatusTone(preparation)))
		@DeckPreparationStatus(csrf, preparation, resultURL, journeyAction)
	}
}

templ DeckPreparationStatus(csrf string, preparation domain.DeckPreparation, resultURL string, journeyAction deckJourneyActionView) {
	@AsyncStatus(deckPreparationAttributes(preparation), "deck-preparation-status", deckPreparationTitle(preparation), deckPreparationSummary(preparation), preparationProgress(preparation), 100, deckPreparationActive(preparation)) {
		if resultURL != "" {
			<p><a href={ templ.SafeURL(resultURL) }>Return to book</a></p>
		}
		if preparation.TranslationEligible > 0 {
			<p><strong>Translations:</strong> { fmt.Sprintf("%d complete · %d unavailable · %d retrying · %d waiting", preparation.TranslationDone, preparation.TranslationFailed, preparation.TranslationRetrying, preparation.TranslationPending) }</p>
		}
		if preparation.BatchRequestCount > 0 {
			<p><strong>Batch translation:</strong> { fmt.Sprintf("%d of %d requests complete · %d failed · %d expired · completion can take hours (up to 24h)", preparation.BatchCompletedRequests, preparation.BatchRequestCount, preparation.BatchFailedRequests, preparation.BatchExpiredRequests) }</p>
		}
		if preparation.DeckName != "" && !deckPreparationEmpty(preparation) {
			<p><strong>Deck:</strong> <code>{ preparation.DeckName }</code> · <strong>Filename:</strong> <code>{ preparation.Filename }</code></p>
		}
		if preparation.State == domain.DeckPreparationReady {
			if deckPreparationEmpty(preparation) {
				@EmptyState("No recurring vocabulary", "This book has no recurring vocabulary to study, so no cards were created.")
			} else {
				<p><strong>Completeness:</strong> { fmt.Sprintf("%d cards · %d with English · %d with contextual sentence translations · %d omitted for sentence quality", preparation.TotalCards, preparation.CardsWithEnglish, preparation.CardsWithContextualSentenceTranslations, preparation.QualityOmissions) }</p>
				@ActionGroup() {
					<a role="button" download href={ templ.SafeURL("/deck-preparations/"+preparation.ID+"/download") }>Download deck</a>
				}
				@DeckJourneyAction(journeyAction, csrf)
			}
		} else if deckPreparationActive(preparation) {
			<form method="post" action={ templ.SafeURL("/deck-preparations/"+preparation.ID+"/cancel") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Cancel preparation</button></form>
		} else {
			if preparation.State == domain.DeckPreparationFailed {
				@Feedback(FeedbackError, "Action needed", preparationFailureMessage(preparation.FailureClass))
			}
			<form method="post" action={ templ.SafeURL("/deck-preparations/"+preparation.ID+"/retry") }>
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<fieldset><legend>Optional external translation for the retry</legend><p>If selected, Mouseion sends each selected lemma and its example sentence outside Mouseion to the configured translation provider. Without consent, the retry stays local and translation fields may be incomplete.</p><label><input type="checkbox" name="external_translation_consent"/> I consent to sending selected vocabulary and example sentences for translation</label></fieldset>
				<button type="submit">Retry preparation</button>
			</form>
		}
	}
}

func bookHasCompletedAnalysis(book domain.SourceMaterialSummary) bool { return book.AnalysisStatus == "analyzed" && book.AnalysisState == "completed" && book.AnalysisRunID != "" && book.CorpusID != "" }
func bookDeckPreparationURL(book domain.SourceMaterialSummary) string { return "/books/" + url.PathEscape(book.Source.ID) + "/deck/preparations" }
func completedAtLabel(value *time.Time) string { if value == nil || value.IsZero() { return "Unavailable" }; return value.UTC().Format("2006-01-02 15:04:05 UTC") }

func knownCoveragePercent(coverage domain.AnalysisCoverage) float64 {
	if coverage.AnalyzableTokenCount == 0 {
		return 0
	}
	return min(float64(coverage.KnownTokenCount)*100/float64(coverage.AnalyzableTokenCount), 100)
}

func activeCampaignCoveragePercent(coverage domain.AnalysisCoverage) float64 {
	if coverage.AnalyzableTokenCount == 0 { return 0 }
	return min(float64(coverage.KnownTokenCount+coverage.ActiveCampaignTokenCount)*100/float64(coverage.AnalyzableTokenCount), 100)
}

func concentrationPercent(projection domain.CoverageProjection) float64 {
	if projection.EligibleTokenCount == 0 {
		return 0
	}
	return float64(projection.OccurrenceCount) * 100 / float64(projection.EligibleTokenCount)
}

func projectedCoveragePercent(projection domain.CoverageProjection, analyzableTokens int64) float64 {
	if analyzableTokens == 0 {
		return 0
	}
	return min(float64(projection.ProjectedTokenCount)*100/float64(analyzableTokens), 100)
}

func longSentencePercent(profile domain.TextProfile) float64 {
	if profile.SentenceCount == 0 {
		return 0
	}
	return float64(profile.LongSentenceCount) * 100 / float64(profile.SentenceCount)
}

func hasAnalysisWarnings(coverage domain.AnalysisCoverage) bool {
	if coverage.TextProfile == nil {
		return false
	}
	return coverage.TextProfile.SentenceCount == 0 ||
		coverage.TextProfile.EmptySentenceCount > 0 ||
		(coverage.TextProfile.NormalizedTokenCount > 0 && coverage.AnalyzableTokenCount == 0)
}

func corpusUnitLabel(unit domain.CorpusSelectedUnit) string {
	if strings.TrimSpace(unit.Title) != "" {
		return unit.Title
	}
	if strings.TrimSpace(unit.SourceHref) != "" {
		return unit.SourceHref
	}
	return unit.UnitID
}

templ LoginPage(csrf, message, next string, onboarding bool) {
	@ShellLayout("Sign in", nil, csrf, navigationContextForTitle("Sign in")) { <article class="narrow">
	if onboarding {
		<h1>Create your account</h1><p>Set up the first learner account for this Mouseion installation.</p>
	} else {
		<h1>Sign in</h1>
	}
	if message != "" {
		<p role="alert">{ message }</p>
	}
	if onboarding {
		<form method="post" action="/onboarding"><input type="hidden" name="csrf_token" value={ csrf }/><label>Username<input name="username" required autocomplete="username"/></label><label>Password<input type="password" name="password" minlength="8" required autocomplete="new-password"/></label><button>Create account</button></form>
	} else {
		<form method="post" action="/login"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="next" value={ next }/><label>Username<input name="username" required autocomplete="username"/></label><label>Password<input type="password" name="password" required autocomplete="current-password"/></label><button>Sign in</button></form>
	}
	</article> }
}
templ ConnectionsPage(user domain.User, csrf string, connections []domain.OpdsConnection, message string, statuses map[string]domain.CatalogueSyncStatus) {
	@ConnectionsPageForBook(user, csrf, connections, message, "", statuses)
}

templ ConnectionsPageForBook(user domain.User, csrf string, connections []domain.OpdsConnection, message, bookID string, statuses map[string]domain.CatalogueSyncStatus) {
	@ShellLayout("Add books", &user, csrf, NavigationAcquisition) {
		@PageHeader("Add books", "Connect a catalog and add EPUB books to My Books.", nil)
		if message != "" {
			@Feedback(FeedbackSuccess, "", message)
		}
		if len(connections) == 0 {
			@EmptyState("Add your first catalog connection", "A connection lets Mouseion sync ready-language bibliographic metadata into My Books. Your credentials stay private and are never shown again.") {
				<a href="#catalog-connection-form">Add catalog connection</a>
			}
		}
		<article id="catalog-connection-form"><h2>Add catalog connection</h2><form method="post" action="/connections"><input type="hidden" name="csrf_token" value={ csrf }/>
			if bookID != "" {
				<input type="hidden" name="book_id" value={ bookID }/>
			}
			<div class="grid"><label>Name<input name="name" required/></label><label>Catalog URL<input type="url" name="url" required placeholder="https://example.com/opds"/></label></div><div class="grid"><label>Username <small>(optional)</small><input name="username" autocomplete="username"/></label><label>Password <small>(optional, encrypted at rest)</small><input type="password" name="password" autocomplete="new-password"/></label></div><button>Add catalog</button></form></article>
		if len(connections) > 0 {
			<h2>Catalog maintenance</h2>
			<p>Edit a saved connection or remove future catalog access. Owned books and their artifacts remain.</p>
		}
		<div class="catalog-list">
		for _, c := range connections {
				<article id={ "connection-" + c.ID } aria-labelledby={ "connection-name-" + c.ID }><header><h3 id={ "connection-name-" + c.ID }>{ c.Name }</h3></header><div id={ "connection-status-" + c.ID } role="status" aria-live="polite" aria-atomic="true">@CatalogueSyncConnectionStatus(catalogueSyncConnectionViewFor(c, statuses))</div>@CatalogueSyncConnectionActions(csrf, c, catalogueSyncConnectionViewFor(c, statuses))<p class="break">{ safeConnectionURL(c.URL) }</p><p>{ credentialSummary(c) }</p><details id={ "edit-connection-" + c.ID }><summary>Edit connection</summary><form method="post" action={ templ.SafeURL("/connections/"+c.ID) }><input type="hidden" name="csrf_token" value={ csrf }/><div class="grid"><label>Name<input name="name" value={ c.Name } required/></label><label>Catalog URL <small>(leave blank to keep current URL)</small><input type="url" name="url" value={ connectionURLForEdit(c) } placeholder="Leave blank to keep current URL"/></label></div><div class="grid"><label>Username<input name="username" value={ c.Username } autocomplete="username"/></label><label>New password <small>(leave blank to keep current)</small><input type="password" name="password" autocomplete="new-password"/></label></div><button class="outline">Save changes</button></form></details>@Confirmation("Delete catalog connection", "This removes future access through this connection and its credentials. Books already in My Books and their artifacts remain available.", StatusDanger) {<form method="post" action={ templ.SafeURL("/connections/"+c.ID+"/delete") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Confirm deletion</button></form>}</article>
		}
		</div>
	}
}
templ JobsPage(user domain.User, csrf string, jobs []domain.AnalysisJob, message string) {
	@ShellLayout("Jobs", &user, csrf, NavigationLibrary) {
		@PageHeader("Analysis jobs", "Operational history for submitted analyses.", nil)
		if message != "" {
			@Feedback(FeedbackInfo, "", message)
		}
		if len(jobs) == 0 {
			@EmptyState("No analysis runs yet", "Start analysis from any acquired book to generate insights.") {
				<a href="/library">Go to My Books</a>
			}
		}
		if len(jobs) > 0 {
			@ResponsiveTable("Analysis history") {
				<thead><tr><th>Job</th><th>Progress</th><th>Created</th><th>Error</th></tr></thead><tbody>
				for _, job := range jobs {
					<tr><td>
						if job.AnalysisState == "completed" && job.AnalysisRunID != "" && job.CorpusID != "" {
							<a href={ templ.SafeURL("/books/"+job.SourceMaterialID) }>{ fmt.Sprintf("#%d · result", job.DisplayNumber) }</a>
						} else {
							<a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", job.ID)) }>{ fmt.Sprintf("#%d", job.DisplayNumber) }</a>
						}
					</td><td><progress aria-label={ fmt.Sprintf("Analysis job %d progress", job.DisplayNumber) } value={ fmt.Sprintf("%d",job.Progress) } max="100"></progress> { fmt.Sprintf("%d%%",job.Progress) }</td><td>{ job.CreatedAt.Format("2006-01-02 15:04") }</td><td>{ job.Error }</td></tr>
				}
				</tbody>
			}
		}
	}
}

templ JobPage(user domain.User, csrf string, status analysis.Status) {
	@ShellLayout(fmt.Sprintf("Job #%d", status.DisplayNumber), &user, csrf, NavigationLibrary) {
		@PageHeader(fmt.Sprintf("Analysis job #%d", status.DisplayNumber), "Operational status for this analysis run.", nil)
		@JobStatus(csrf, status)
	}
}
templ JobStatus(csrf string, status analysis.Status) {
	@AsyncStatus(jobStatusAttributes(status.ID, jobRunning(status)), "job-status", jobState(status), analysisStatusSummary(status), status.Progress, 100, jobRunning(status)) {
		if status.Error != "" {
			@Feedback(FeedbackError, "Analysis needs attention", status.Error+" Retry the analysis when you are ready.")
		}
		@ActionGroup() {
			if jobRetryable(status) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/retry", status.ID)) }><input type="hidden" name="csrf_token" value={ csrf }/><button>Retry analysis</button></form>
			}
			if jobRunning(status) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/cancel", status.ID)) }><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Cancel analysis</button></form>
			}
		}
		if status.CorpusID != "" {
			if status.LogicalState == "completed" {
					if status.SourceMaterialID != "" && status.RunID != "" {
						<p>Analysis complete. Review the insights for this immutable analysis result.</p>
						<a role="button" class="outline" href={ templ.SafeURL("/books/"+status.SourceMaterialID) }>View analysis result</a>
					} else {
						<p>Analysis complete. Prepare a deck from this immutable analysis result.</p>
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/deck/preparations", status.ID)) } data-prepare-deck><input type="hidden" name="csrf_token" value={ csrf }/><label><input type="checkbox" name="external_translation_consent"/> Send each selected lemma and example sentence to the configured translation provider</label><small>Preparation runs in the background. You can download the completed deck when it is ready.</small><button type="submit">Prepare deck</button></form><section data-deck-preparation role="status" aria-live="polite" aria-atomic="true" hidden></section>
					}
			} else {
				<p>Analysis complete. Legacy/full-text results cannot unlock a new deck preparation.</p>
			}
		}
	}
}
templ VocabularyPageWithResult(user domain.User, csrf string, languages, knownLanguages []domain.StudyLanguage, language string, result *knownvocab.ImportResult, known []domain.KnownVocabulary, message string) {
	@ShellLayout("Vocabulary", &user, csrf, NavigationVocabulary) {
		@PageHeader("Vocabulary", "Import words you already know so pre-learning decks focus on new vocabulary.", nil)
		if language == "" {
			if len(languages) == 0 {
				@EmptyState("No study languages yet", "Add or sync a book with a chosen language before importing known vocabulary.") {
					<a href="/connections">Connect a catalogue</a>
				}
			} else {
				<p>Choose a study language in the shell to view known vocabulary or import a lemma file.</p>
			}
		} else {
			if len(languages) == 0 {
				<p>This language is preserved from earlier vocabulary imports, but it is not currently represented by a chosen-language book.</p>
			}
			<p>Viewing <strong>{ vocabularyLanguageName(languages, knownLanguages, language) }</strong> <code>{ language }</code>. Imports are additive and idempotent: new, duplicate, and rejected rows are reported separately.</p>
			if studyLanguagePresent(languages, language) {
				<form method="post" action="/vocabulary/import" enctype="multipart/form-data" hx-post={ knownVocabImportAction() } hx-encoding="multipart/form-data" hx-target="#vocabulary-results" hx-swap="innerHTML"><input type="hidden" name="csrf_token" value={ csrf }/><label>UTF-8 lemma file<input type="file" name="vocabulary_file" accept="text/plain,.txt" required/></label><small>One lemma per nonblank line. Tab-separated columns are rejected.</small><button>Import known vocabulary</button></form>
			} else {
				<p>This language is preserved from earlier vocabulary imports, but it is not currently represented by a chosen-language book. Importing is unavailable until a book in this language is added.</p>
			}
		}
		<section id="vocabulary-results">@KnownVocabResult(language, result, known, message)</section>
	}
}
templ KnownVocabResult(language string, result *knownvocab.ImportResult, known []domain.KnownVocabulary, message string) {
	if message != "" {
		@Feedback(FeedbackError, "Import not completed", message)
	}
	if result != nil {
		<article class="resource-card"><h2>Import result</h2><p role="status"><strong>{ fmt.Sprintf("%d new", result.Imported) }</strong> · { fmt.Sprintf("%d duplicates", result.AlreadyKnown) } · { fmt.Sprintf("%d rejected", len(result.Rejected)) }</p>
		if len(result.Rejected) > 0 {
			<h3>Rejected rows</h3>
			@ResponsiveTable("Rejected vocabulary rows") {
				<thead><tr><th>Row</th><th>Original</th><th>Reason</th></tr></thead><tbody>
				for _, rejection := range result.Rejected {
					<tr><td>{ fmt.Sprintf("%d", rejection.Row) }</td><td><code>{ rejection.Original }</code></td><td>{ rejection.Error }</td></tr>
				}
				</tbody>
			}
		}
		</article>
	}
	<h2>Known vocabulary
	if language != "" {
		<small> · language code { language }</small>
	}
	</h2>
	if language == "" {
		<p>Choose a language to view known vocabulary.</p>
	} else if len(known) == 0 {
		<p>No known vocabulary has been recorded for this language yet. This does not mean the language is unavailable or that the learner knows no words.</p>
	} else {
		@ResponsiveTable("Known vocabulary") {
			<thead><tr><th>Lemma</th><th>Part of speech</th><th>Provenance</th><th>Recorded</th></tr></thead><tbody>
			for _, entry := range known {
				<tr><td>{ lemmadisplay.Format(entry.Language, entry.CanonicalLemma, entry.UPOS) }</td><td>{ knownVocabUPOS(entry.UPOS) }</td><td>{ knownVocabProvenance(entry) }</td><td>{ entry.CreatedAt.Format("2006-01-02") }</td></tr>
			}
			</tbody>
		}
	}
}
templ KnownVocabImportStatus(status knownvocab.Status) {
	@AsyncStatus(knownVocabImportAttributes(status), "known-vocab-import-status", knownVocabImportTitle(status), knownVocabImportSummary(status), int(status.Processed), int(status.Total), knownVocabJobBusy(string(status.State))) {
		@knownVocabImportStatusBody(status)
	}
}
templ EnrichmentJobStatus(status enrichmentjob.Status, csrf string) {
	@AsyncStatus(enrichmentJobAttributes(status), "enrichment-job-status", "Contextual translations: "+enrichmentJobLabel(string(status.State)), enrichmentJobSummary(status), int(status.Completed), int(status.Total), status.State != "completed" && status.State != "cancelled" && status.State != "discarded") {
		if status.Error != "" {
			@Feedback(FeedbackError, "Translation needs attention", status.Error+" Review the affected book and try again when the provider is available.")
		}
		if status.State != "completed" && status.State != "cancelled" && status.State != "discarded" {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/enrichment-jobs/%d/cancel", status.ID)) } hx-post={ fmt.Sprintf("/enrichment-jobs/%d/cancel", status.ID) } hx-target="#enrichment-job-status" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Cancel translations</button></form>
		}
	}
}
templ knownVocabImportStatusBody(status knownvocab.Status) {
		if knownVocabJobBusy(string(status.State)) {
			<p>Return to Vocabulary to review the result after processing finishes.</p>
		}
		if status.State == "completed" {
			if len(status.Rejected) > 0 {
				<p><strong>Import completed with partial rejection.</strong> Successful rows remain known; correct the rejected rows and upload another additive import if needed.</p>
			} else {
				<p><strong>Import complete.</strong></p>
			}
			if len(status.Rejected) > 0 {
				<h3>Rejected rows</h3>@ResponsiveTable("Rejected vocabulary rows") {
					<thead><tr><th>Row</th><th>Original</th><th>Reason</th></tr></thead><tbody>
					for _, rejection := range status.Rejected {
						<tr><td>{ fmt.Sprintf("%d", rejection.Row) }</td><td><code>{ rejection.Original }</code></td><td>{ rejection.Error }</td></tr>
					}
					</tbody>
				}
				}
				<p><a href={ templ.SafeURL(knownVocabImportRecoveryTarget()) }>Review known vocabulary</a></p>
		}
		if status.State == "completed" || status.State == "discarded" || status.State == "cancelled" {
			<p><strong>{ fmt.Sprintf("%d new", status.Imported) }</strong> · { fmt.Sprintf("%d duplicates", status.AlreadyKnown) } · { fmt.Sprintf("%d rejected", len(status.Rejected)) }</p>
		}
		if status.Error != "" && status.State != "cancelled" && status.State != "discarded" {
			<p role="alert"><strong>Import failed:</strong> { status.Error } Upload the original file again after correcting the problem.</p>
		}
		if status.State == "cancelled" {
			<p role="alert"><strong>Import cancelled.</strong> No new result is available from this attempt. Upload the file again when ready.</p>
			if status.Language != "" {
				<p>Selected language: <code>{ status.Language }</code></p>
			}
			<p><a href={ templ.SafeURL(knownVocabImportRecoveryTarget()) }>Return to Vocabulary to retry the import</a></p>
		}
		if status.State == "discarded" {
			<p role="alert"><strong>Import failed.</strong>
			if status.Error != "" {
				{ status.Error }
			}
			The job was discarded after repeated attempts. Upload the file again after correcting the problem.</p>
			if status.Language != "" {
				<p>Selected language: <code>{ status.Language }</code></p>
			}
			<p><a href={ templ.SafeURL(knownVocabImportRecoveryTarget()) }>Return to Vocabulary to retry the import</a></p>
		}
}

templ DeckJourneyAction(action deckJourneyActionView, csrf string) {
	if action.State != deckJourneyUnknown {
		<div id={ deckJourneyActionID(action.BookID) } role="status" aria-live="polite" aria-atomic="true">
			if action.Message != "" {
				if strings.Contains(action.Message, "changed since") {
					<p role="alert">{ action.Message }</p>
				} else {
					<p role="status">{ action.Message }</p>
				}
			}
			if action.Error != "" {
				<p role="alert">{ action.Error }</p>
			}
			if action.State == deckJourneyNotMember {
				<p><strong>Not in Reading Journey.</strong> Add this book to your provisional Reading Journey when you are ready.</p>
				<form method="post" action={ templ.SafeURL(journeyAddURL(action.BookID)) } hx-post={ templ.SafeURL(journeyAddURL(action.BookID)) } hx-target={ templ.SafeURL("#"+deckJourneyActionID(action.BookID)) } hx-swap="outerHTML">
					<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_revision" value={ fmt.Sprintf("%d", action.Revision) }/>
					if action.PreparationID != "" {
						<input type="hidden" name="deck_preparation_id" value={ action.PreparationID }/>
					}
					<button type="submit">Add to Reading Journey</button>
				</form>
			} else if action.State == deckJourneyMember {
				<p><strong>In Reading Journey.</strong> This book is already in your Reading Journey.</p>
				<p><a href={ templ.SafeURL("/journey#"+journeyBookAnchorID(action.BookID)) }>View this Journey entry</a></p>
			} else if action.State == deckJourneyGoal {
				<p><strong>Primary Goal.</strong> This deck is preparation for your current Primary Goal.</p>
				<p><a href={ templ.SafeURL("/journey#"+journeyBookAnchorID(action.BookID)) }>View Primary Goal in Reading Journey</a></p>
			}
		</div>
	}
}

templ MetadataOnlyBookPage(user domain.User, csrf string, book domain.MyBook, message string, eligibleForRefresh bool) {
	@ShellLayout(book.Book.Title, &user, csrf, NavigationLibrary) {
		@Breadcrumb("/library", "My Books")
		@PageHeader(book.Book.Title, metadataOnlyBookDescription(book.Book.LanguageTag), StatusBadge("Not acquired", StatusNeutral))
		if eligibleForRefresh && !strings.HasPrefix(message, "Could not acquire ") {
			@MetadataOnlyBookMetadataRegion(csrf, book, message)
		} else if message != "" && !strings.HasPrefix(message, "Could not acquire ") {
			@Feedback(FeedbackSuccess, "", message)
		}
		<article aria-labelledby="metadata-only-heading">
			<h2 id="metadata-only-heading">Content not acquired</h2>
			<p>This book is saved with catalogue metadata, but Mouseion has not acquired an EPUB yet.</p>
			<p>Sync is metadata-only and never downloads book content. Start analysis to acquire, validate, and analyze the EPUB in one action.</p>
			if strings.HasPrefix(message, "Could not acquire ") {
				<p role="alert">{ message }</p>
			}
			if book.JourneyGoal {
				<p><strong>Primary Goal.</strong></p>
				<p><a href={ templ.SafeURL("/journey#journey-book-"+book.Book.ID) }>View Primary Goal in Reading Journey</a></p>
			} else {
				@JourneyMembershipAction(book.Book.ID, book.JourneyMember, book.JourneyRevision, csrf)
			}
			<form method="post" action={ templ.SafeURL("/books/" + book.Book.ID + "/analyze") }>
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<button type="submit">Start analysis</button>
			</form>
		</article>
	}
}

templ MetadataOnlyBookMetadataRegion(csrf string, book domain.MyBook, message string) {
	<section id="book-metadata-region" data-focus-id="book-refresh-status" aria-labelledby="book-metadata-heading">
		<h2 id="book-metadata-heading">Metadata freshness</h2>
		if book.Book.UpdatedAt.IsZero() {
			<p>Book metadata has not been refreshed yet.</p>
		} else {
			<p>Book metadata last refreshed: <time datetime={ book.Book.UpdatedAt.UTC().Format(time.RFC3339) }>{ book.Book.UpdatedAt.Format("2006-01-02 15:04") }</time>. This is distinct from the catalogue connection's last sync.</p>
		}
		<p id="book-refresh-status" tabindex="-1" role="status" aria-live="polite" aria-atomic="true">{ message }</p>
		if strings.Contains(message, "could not be refreshed") {
			<p><a href="/connections">Check catalogue connections</a></p>
		}
		<form method="post" action={ templ.SafeURL("/books/" + book.Book.ID + "/refresh") } hx-post={ templ.SafeURL("/books/" + book.Book.ID + "/refresh") } hx-target="#book-metadata-region" hx-swap="outerHTML" data-focus-results="true">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<button type="submit">Refresh metadata</button>
		</form>
	</section>
}

templ JobsPageWithCatalogueSync(user domain.User, csrf string, jobs []domain.AnalysisJob, syncJobs []cataloguesync.Status, message string) {
	@ShellLayout("Jobs", &user, csrf, NavigationLibrary) {
		@PageHeader("Jobs", "Operational history for catalogue sync and analysis work.", nil)
		if message != "" {
			@Feedback(FeedbackInfo, "", message)
		}
		if len(jobs) == 0 && len(syncJobs) == 0 {
			@EmptyState("No jobs yet", "Catalogue sync and analysis work will appear here when submitted.") { <a href="/library">Go to My Books</a> }
		}
		if len(syncJobs) > 0 {
			@ResponsiveTable("Catalogue sync history") {
				<thead><tr><th>Kind</th><th>Connection</th><th>Status</th><th>Attempt</th><th>Created</th><th>Error</th></tr></thead><tbody>
				for _, job := range syncJobs {
					<tr><td><a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", job.ID)) }>Catalogue sync</a></td><td>{ job.ConnectionName }</td><td>{ catalogueSyncJobState(job) }</td><td>{ fmt.Sprintf("%d", job.Attempt) }</td><td>{ job.CreatedAt.Format("2006-01-02 15:04") }</td><td>{ job.Error }</td></tr>
				}
				</tbody>
			}
		}
		if len(jobs) > 0 {
			@ResponsiveTable("Analysis history") {
				<thead><tr><th>Kind</th><th>Job</th><th>Progress</th><th>Created</th><th>Error</th></tr></thead><tbody>
				for _, job := range jobs {
					<tr><td>Analysis</td><td>
						if job.AnalysisState == "completed" && job.AnalysisRunID != "" && job.CorpusID != "" {
							<a href={ templ.SafeURL("/books/"+job.SourceMaterialID) }>{ fmt.Sprintf("#%d · result", job.DisplayNumber) }</a>
						} else {
							<a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", job.ID)) }>{ fmt.Sprintf("#%d", job.DisplayNumber) }</a>
						}
					</td><td><progress aria-label={ fmt.Sprintf("Analysis job %d progress", job.DisplayNumber) } value={ fmt.Sprintf("%d",job.Progress) } max="100"></progress> { fmt.Sprintf("%d%%",job.Progress) }</td><td>{ job.CreatedAt.Format("2006-01-02 15:04") }</td><td>{ job.Error }</td></tr>
				}
				</tbody>
			}
		}
	}
}

templ CatalogueSyncJobPage(user domain.User, csrf string, status cataloguesync.Status) {
	@ShellLayout(fmt.Sprintf("Catalogue sync #%d", status.ID), &user, csrf, NavigationLibrary) {
		@PageHeader("Catalogue sync", status.ConnectionName, nil)
		@CatalogueSyncJobStatus(csrf, status)
	}
}

templ CatalogueSyncJobStatus(csrf string, status cataloguesync.Status) {
	@AsyncStatus(catalogueSyncJobStatusAttributes(status.ID, catalogueSyncStatusRunning(status)), "catalogue-sync-job-status", catalogueSyncJobState(status), catalogueSyncJobSummary(status), status.Progress, 100, catalogueSyncStatusRunning(status)) {
		if status.Error != "" {
			@Feedback(FeedbackError, "Catalogue sync needs attention", status.Error)
		}
		@ActionGroup() {
			if status.LogicalState == "failed" || status.LogicalState == "cancelled" {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/retry", status.ID)) }><input type="hidden" name="csrf_token" value={ csrf }/><button>Retry catalogue sync</button></form>
			}
			if catalogueSyncStatusRunning(status) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/cancel", status.ID)) }><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Cancel catalogue sync</button></form>
			}
		}
		<p>Catalogue sync reconciles metadata only; it does not download EPUB content.</p>
	}
}
