package webapp

import (
	"fmt"
	"github.com/justin-hayes/mouseion/internal/analysis"
	"github.com/justin-hayes/mouseion/internal/cardexport"
	"github.com/justin-hayes/mouseion/internal/domain"
	"github.com/justin-hayes/mouseion/internal/knownvocab"
	"github.com/justin-hayes/mouseion/internal/opds"
	"github.com/justin-hayes/mouseion/internal/review"
)

templ Layout(title string, user *domain.User, csrf string) {
	<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{ title } · Mouseion</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/><link rel="stylesheet" href="/static/app.css"/><script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.7/dist/htmx.min.js" defer></script><script>
window.escapeHtml = function (s) {
  return String(s).replace(/[&<>"']/g, function (c) {
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
};
document.addEventListener('htmx:responseError', function (evt) {
  var target = evt.detail.target;
  if (!target) return;
  var text = ((evt.detail.xhr && evt.detail.xhr.responseText) || 'Request failed').trim();
  target.innerHTML = '<article role="alert"><strong>Catalog error:</strong> ' + window.escapeHtml(text) + '<p><small>Review the catalog connection or try again.</small></p></article>';
});
document.addEventListener('submit', function (evt) {
  var form = evt.target.closest && evt.target.closest('form[data-acquire]');
  if (!form) return;
  var button = form.querySelector('button[type="submit"]');
  if (button) { button.disabled = true; button.setAttribute('aria-busy', 'true'); button.textContent = 'Importing & analyzing…'; }
});
</script></head><body><header class="container"><nav><ul><li><a href="/"><strong>Mouseion</strong></a></li></ul>
	if user != nil {
		<ul>
		if user.IsAdmin {
			<li><a href="/admin">Administration</a></li>
		} else {
			<li><a href="/library">My Library</a></li><li><a href="/connections">Add books</a></li><li><a href="/known-vocab">Known words</a></li>
		}
		<li><small>{ user.Username }</small></li><li><form class="inline" method="post" action="/logout"><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Log out</button></form></li></ul>
	}
	</nav></header><main class="container">{ children... }</main></body></html>
}
templ LibraryPage(user domain.User, csrf string, books []domain.SourceMaterialSummary, message string) {
	@Layout("My Library", &user, csrf) { <header class="page-heading"><div><h1>My Library</h1><p>Your books, ready for pre-learning.</p></div><a role="button" href="/connections">Add a book</a></header>
	if message != "" {
		<p role="status">{ message }</p>
	}
	if len(books) == 0 {
		<article><h2>Your library is empty</h2><p>Browse a catalog and import a book to begin.</p><a href="/connections">Browse catalogs</a></article>
	}
	if len(books) > 0 {
		<div class="library-list">
		for _, book := range books {
			<article><div><h2><a href={ templ.SafeURL("/books/"+book.Source.ID) }>{ book.Source.Title }</a></h2><p><code>{ book.Source.Language }</code> · imported { book.Source.CreatedAt.Format("2006-01-02") }</p></div><span class={ "status status-"+statusClass(book.AnalysisStatus) }>{ book.AnalysisStatus }</span></article>
		}
		</div>
	}
	}
}
templ BookPage(user domain.User, csrf string, book domain.SourceMaterialSummary, message string) {
	@Layout(book.Source.Title, &user, csrf) { <p><a href="/library">← My Library</a></p><header class="page-heading"><div><h1>{ book.Source.Title }</h1><p><code>{ book.Source.Language }</code> · { book.Source.MediaType }</p></div><span class={ "status status-"+statusClass(book.AnalysisStatus) }>{ book.AnalysisStatus }</span></header>
	if message != "" {
		<p role="status">{ message }</p>
	}
	<div class="book-actions"><article><h2>Analysis</h2>
		if book.AnalysisJobID > 0 {
			<p><a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", book.AnalysisJobID)) }>View analysis status and results</a></p>
		}
		if book.AnalysisJobID == 0 {
			<p>Analyze the text to prepare vocabulary candidates.</p>
		}
		<form method="post" action={ templ.SafeURL("/books/"+book.Source.ID+"/analyze") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline">{ analyzeLabel(book.AnalysisStatus) }</button></form>
	</article><article><h2>Review vocabulary</h2><p>Review and curate vocabulary from this book.</p>
		if book.AnalysisStatus == "analyzed" {
			<a role="button" href={ templ.URL("/review?book="+book.Source.ID) }>Start review</a>
		} else {
			<button disabled>Available after analysis</button>
		}
	</article><article><h2>Anki deck</h2><p>Configure and generate a pre-learning deck. Import words you already know so the deck contains only new vocabulary.</p><p><a href={ templ.URL("/known-vocab?language="+book.Source.Language) }>Import known words</a></p>
		if book.AnalysisStatus == "analyzed" {
			<a role="button" href={ templ.URL("/deck?book="+book.Source.ID) }>Configure deck</a>
		} else {
			<button disabled>Available after analysis</button>
		}
	</article></div> }
}

templ LoginPage(csrf, message string) {
	@Layout("Sign in", nil, csrf) { <article class="narrow"><h1>Sign in</h1>
	if message != "" {
		<p role="alert">{ message }</p>
	}
	<form method="post" action="/login"><input type="hidden" name="csrf_token" value={ csrf }/><label>Username<input name="username" required autocomplete="username"/></label><label>Password<input type="password" name="password" required autocomplete="current-password"/></label><button>Sign in</button></form><hr/><p>First run? <a href="/register">Register the administrator</a>.</p></article> }
}
templ RegisterPage(csrf, message string) {
	@Layout("Register", nil, csrf) { <article class="narrow"><h1>Register administrator</h1><p>This one-time registration is disabled after the first administrator is created.</p>
	if message != "" {
		<p role="alert">{ message }</p>
	}
	<form method="post" action="/register"><input type="hidden" name="csrf_token" value={ csrf }/><label>Username<input name="username" required/></label><label>Password<input type="password" name="password" minlength="8" required/></label><button>Create administrator</button></form></article> }
}
templ Dashboard(user domain.User, csrf string, profiles []domain.LanguageProfile, connections []domain.OpdsConnection, jobs []domain.AnalysisJob) {
	@Layout("Dashboard", &user, csrf) { <h1>Welcome, { user.Username }</h1><div class="grid"><article><h2>Study languages</h2><p>{ fmt.Sprintf("%d configured", len(profiles)) }</p><a href="/languages">Configure</a></article><article><h2>OPDS catalogs</h2><p>{ fmt.Sprintf("%d connected", len(connections)) }</p><a href="/connections">Browse books</a></article><article><h2>Analysis</h2><p>{ fmt.Sprintf("%d recent jobs", len(jobs)) }</p><a href="/jobs">View jobs</a></article></div> }
}
templ LanguagesPage(user domain.User, csrf string, profiles []domain.LanguageProfile, message string) {
	@Layout("Languages", &user, csrf) { <p><a href="/admin">← Administration</a></p><h1>Supported languages</h1><p>Configure the languages available for study. Learners choose from this administrator-managed set in the study workflow.</p>
	if message != "" {
		<p role="alert">{ message }</p>
	}
	<article><form method="post" action="/languages"><input type="hidden" name="csrf_token" value={ csrf }/><div class="grid"><label>Language code<input name="language" placeholder="de" required/></label><label>Display name<input name="display_name" placeholder="German" required/></label></div><button>Save language</button></form></article><section>
	if len(profiles) == 0 {
		<p>No study language configured yet.</p>
	}
	if len(profiles) > 0 {
	<table><thead><tr><th>Name</th><th>Code</th></tr></thead><tbody>
	for _, p := range profiles {
		<tr><td>{ p.DisplayName }</td><td><code>{ p.Language }</code></td></tr>
	}
	</tbody></table>
	}
	</section> }
}
templ ConnectionsPage(user domain.User, csrf string, connections []domain.OpdsConnection) {
	@Layout("Add books", &user, csrf) { <h1>Add books</h1>
	<p>Browse an administrator-configured OPDS catalog and add EPUB books to My Library.</p>
	if len(connections) == 0 {
		<article><h2>No catalogs available</h2><p>Ask an administrator to configure an OPDS catalog.</p></article>
	}
	<div class="catalog-list">
	for _, c := range connections {
		<article><header><strong>{ c.Name }</strong> <small>{ c.Language }</small></header><a role="button" href={ templ.URL("/catalog?connection="+c.ID) }>Browse catalog</a></article>
	}
	</div> }
}
templ AdminConnectionsPage(user domain.User, csrf string, connections []domain.OpdsConnection, message string) {
	@Layout("OPDS connections", &user, csrf) { <p><a href="/admin">← Administration</a></p><h1>OPDS connections</h1><p>Configure the shared catalogs available to every learner. Credentials are encrypted at rest and only shown here.</p>
	if message != "" {
		<p role="status">{ message }</p>
	}
	<article><h2>Add connection</h2><form method="post" action="/admin/connections"><input type="hidden" name="csrf_token" value={ csrf }/><div class="grid"><label>Name<input name="name" required/></label><label>Catalog URL<input type="url" name="url" required placeholder="https://example.com/opds"/></label><label>Book language<input name="language" placeholder="de" required/></label></div><div class="grid"><label>Username <small>(optional)</small><input name="username" autocomplete="username"/></label><label>Password <small>(optional, encrypted at rest)</small><input type="password" name="password" autocomplete="new-password"/></label></div><button>Add catalog</button></form></article>
	if len(connections) == 0 {
		<p>No catalog connection configured yet.</p>
	}
	<div class="catalog-list">
	for _, c := range connections {
		<article><header><strong>{ c.Name }</strong> <small>{ c.Language }</small></header><p class="break">{ c.URL }</p><p>{ credentialSummary(c) }</p><details><summary>Edit connection</summary><form method="post" action={ templ.SafeURL("/admin/connections/"+c.ID) }><input type="hidden" name="csrf_token" value={ csrf }/><div class="grid"><label>Name<input name="name" value={ c.Name } required/></label><label>Catalog URL<input type="url" name="url" value={ c.URL } required/></label><label>Book language<input name="language" value={ c.Language } required/></label></div><div class="grid"><label>Username<input name="username" value={ c.Username } autocomplete="username"/></label><label>New password <small>(leave blank to keep current)</small><input type="password" name="password" autocomplete="new-password"/></label></div><button class="outline">Save changes</button></form></details><form class="inline right" method="post" action={ templ.SafeURL("/admin/connections/"+c.ID+"/delete") } onsubmit="return confirm('Delete this catalog connection?')"><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Delete</button></form></article>
	}
	</div> }
}
templ CatalogPage(user domain.User, csrf string, connection domain.OpdsConnection) {
	@Layout(connection.Name, &user, csrf) { <p><a href="/connections">← Catalog connections</a></p><header class="page-heading"><div><h1>{ connection.Name }</h1><p>Browse collections or search for a book to import and analyze.</p></div></header><div id="catalog-results" hx-get={ "/opds/browse?connection="+connection.ID } hx-trigger="load" hx-swap="innerHTML"><p aria-busy="true">Loading catalog…</p></div> }
}
templ FeedFragment(csrf, connectionID string, feed opds.Feed, trail []CatalogCrumb, root bool) {
	<section>
	if root {
		if opds.SupportsSearch(feed) {
			<form role="search" hx-get="/opds/search" hx-target="#catalog-results" hx-swap="innerHTML"><input type="hidden" name="connection" value={ connectionID }/><label>Search this catalog<input type="search" name="q" placeholder="Title or author" required/></label><button type="submit">Search</button></form>
		} else {
			<p><small>Search is not available for this catalog. Browse its collections below.</small></p>
		}
	}
	<nav aria-label="Catalog breadcrumb"><a hx-get={ browseURL(connectionID, "", nil) } hx-target="#catalog-results" hx-swap="innerHTML" href={ templ.URL(browseURL(connectionID, "", nil)) }>Catalog root</a>
	for i, crumb := range trail {
		<span> / </span>
		if i < len(trail)-1 {
			<a hx-get={ browseURL(connectionID, crumb.URL, trail[:i]) } hx-target="#catalog-results" hx-swap="innerHTML" href={ templ.URL(browseURL(connectionID, crumb.URL, trail[:i])) }>{ crumb.Title }</a>
		} else {
			<span aria-current="page">{ crumb.Title }</span>
		}
	}
	</nav><h2>{ feed.Title }</h2>
	if len(feed.Entries) == 0 {
		<article><p>No books or collections were found here.</p></article>
	}
	<div class="catalog-grid">
	for _, entry := range feed.Entries {
		@EntryCard(csrf, connectionID, entry, trail)
	}
	</div></section>
}
templ SearchResults(csrf, connectionID, query string, feed opds.Feed) {
	<section><button class="outline" hx-get={ browseURL(connectionID, "", nil) } hx-target="#catalog-results" hx-swap="innerHTML">← Back to catalog</button><h2>Results for “{ query }”</h2>
	if len(feed.Entries) == 0 {
		<article><p>No matching books were found. Try another title or author.</p></article>
	}
	<div class="catalog-grid">
	for _, entry := range feed.Entries {
		@EntryCard(csrf, connectionID, entry, nil)
	}
	</div></section>
}
templ CatalogNotice(message string) { <article role="status"><p>{ message }</p></article> }
templ EntryCard(csrf, connectionID string, entry opds.Entry, trail []CatalogCrumb) {
	<article><h3>{ entry.Title }</h3>
	if href := navigationLink(entry); href != "" {
		<a role="button" class="outline" href={ templ.URL(browseURL(connectionID, href, trail)) } hx-get={ browseURL(connectionID, href, trail) } hx-target="#catalog-results" hx-swap="innerHTML">Open collection</a>
	}
	if epubLink := acquisitionLink(entry); epubLink != nil {
		<form method="post" action="/opds/acquire" data-acquire><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="connection" value={ connectionID }/><input type="hidden" name="entry_id" value={ entry.ID }/><input type="hidden" name="title" value={ entry.Title }/><input type="hidden" name="href" value={ epubLink.Href }/><button type="submit">Import &amp; analyze</button><small>Downloads the EPUB to My Library and queues analysis.</small></form>
	}
	if navigationLink(entry) == "" && acquisitionLink(entry) == nil {
		<p><small>No compatible EPUB is available for this entry.</small></p>
	}
	</article>
}
templ JobsPage(user domain.User, csrf string, jobs []domain.AnalysisJob, message string) {
	@Layout("Jobs", &user, csrf) { <h1>Analysis jobs</h1>
	if message != "" {
		<p>{ message }</p>
	}
	if len(jobs) == 0 {
		<p>No books have been submitted.</p>
	}
	if len(jobs) > 0 {
	<table><thead><tr><th>Job</th><th>Progress</th><th>Created</th><th>Error</th></tr></thead><tbody>
	for _, job := range jobs {
		<tr><td><a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", job.ID)) }>{ fmt.Sprintf("#%d", job.ID) }</a></td><td><progress value={ fmt.Sprintf("%d",job.Progress) } max="100"></progress> { fmt.Sprintf("%d%%",job.Progress) }</td><td>{ job.CreatedAt.Format("2006-01-02 15:04") }</td><td>{ job.Error }</td></tr>
	}
	</tbody></table>
	} }
}
templ JobPage(user domain.User, csrf string, status analysis.Status) {
	@Layout(fmt.Sprintf("Job #%d", status.ID), &user, csrf) { <h1>{ fmt.Sprintf("Analysis job #%d", status.ID) }</h1><div id="job-status">@JobStatus(status)</div> }
}
templ JobStatus(status analysis.Status) {
	<article
		if jobRunning(status) {
			hx-get={ fmt.Sprintf("/jobs/%d/status", status.ID) }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
		id="job-status"><h2>{ jobState(status) }</h2><progress value={ fmt.Sprintf("%d", status.Progress) } max="100"></progress><p>{ fmt.Sprintf("%d%% complete · attempt %d", status.Progress, status.Attempt) }</p>
		if status.Error != "" {
			<p role="alert"><strong>Action needed:</strong> { status.Error } <a href="/connections">Check the source catalog and try importing again.</a></p>
		}
		if status.CorpusID != "" {
			<p>Analysis complete. <a href="/review">Continue to vocabulary review</a>.</p>
		}
	</article>
}
templ ReviewPage(user domain.User, csrf string, items []review.Item, message string) {
	@Layout("Review", &user, csrf) { <h1>Vocabulary review</h1><p>Ranked candidates resume where you left off.</p>
	if message != "" {
		<p role="alert">{ message }</p>
	}
	if len(items) == 0 {
		<article><p>No actionable candidates are ready.</p></article>
	}
	for _, item := range items {
		@ReviewItem(csrf, item)
	}
	}
}
templ ReviewItem(csrf string, item review.Item) {
	<article id={ "candidate-"+item.Candidate.Candidate.Identity.CanonicalLemma }><header><h2>{ item.Candidate.Candidate.Identity.CanonicalLemma } <small>{ item.Candidate.Candidate.Identity.UPOS }</small></h2><p>{ fmt.Sprintf("Rank score %.3f · global %.2f · corpus %.2f · across %d text(s)", item.Candidate.Components.Score, item.Candidate.Components.GlobalPercentile, item.Candidate.Components.CorpusPercentile, item.Candidate.Components.CrossText) }</p></header>
	if item.Enrichment.Translation.Available {
		<p><strong>Translation:</strong> { item.Enrichment.Translation.Value }</p>
	}
	if item.Enrichment.Gloss.Available {
		<p><strong>Gloss:</strong> { item.Enrichment.Gloss.Value }</p>
	}
	if item.Enrichment.Pronunciation.Available {
		<p><strong>Pronunciation:</strong> { item.Enrichment.Pronunciation.Value }</p>
	}
	if item.Sentences.Chosen != nil {
		<blockquote>{ item.Sentences.Chosen.Text }</blockquote><form method="post" action="/review/edit"><input type="hidden" name="csrf_token" value={ csrf }/>@ReviewIdentity(item)<label>Edit example<input name="sentence" value={ item.Sentences.Chosen.Text } required/></label><button class="outline">Save example</button></form>
	}
	if len(item.Sentences.Alternatives) > 0 {
		<details><summary>Alternate sentences</summary>
		for i, alternate := range item.Sentences.Alternatives {
			<form method="post" action="/review/alternate"><input type="hidden" name="csrf_token" value={ csrf }/>@ReviewIdentity(item)<input type="hidden" name="alternate" value={ fmt.Sprintf("%d", i) }/><button class="outline">{ alternate.Text }</button></form>
		}
		</details>
	}
	<footer><div class="grid">
		@ReviewAction(csrf, item, "accept", "Accept") @ReviewAction(csrf, item, "ignore", "Ignore") @ReviewAction(csrf, item, "known", "Mark known") @ReviewAction(csrf, item, "reset", "Reset")
	</div></footer></article>
}
templ ReviewIdentity(item review.Item) { <input type="hidden" name="language" value={ item.Candidate.Candidate.Identity.Language }/><input type="hidden" name="lemma" value={ item.Candidate.Candidate.Identity.CanonicalLemma }/><input type="hidden" name="upos" value={ item.Candidate.Candidate.Identity.UPOS }/> }
templ ReviewAction(csrf string, item review.Item, action, label string) { <form method="post" action={ templ.SafeURL("/review/"+action) }><input type="hidden" name="csrf_token" value={ csrf }/>@ReviewIdentity(item)<button>{ label }</button></form> }
templ DeckPage(user domain.User, csrf string, book domain.SourceMaterialSummary) { @Layout("Deck", &user, csrf) { <p><a href={ templ.SafeURL("/books/"+book.Source.ID) }>← { book.Source.Title }</a></p><h1>Configure Anki deck</h1><p>Choose which accepted vocabulary from this book to include and how to prioritize it.</p><article><form method="post" action="/deck/download"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="book" value={ book.Source.ID }/><label>Deck name<input name="name" value={ book.Source.Title } required/></label><fieldset><label><input type="checkbox" name="filter_known" value="true" checked/> Filter known words</label><small>Exclude lemmas in your { book.Source.Language } known-word list, including entries that apply to every part of speech.</small></fieldset><fieldset><legend>Ordering</legend><label><input type="radio" name="ranking" value="encounter" checked/> First encounter</label><small>Study words in the order they first appear as you read this book.</small><label><input type="radio" name="ranking" value="balanced"/> Balanced ranking</label><small>60% broader language-corpus frequency, 30% frequency in this book, plus priority and cross-text signals.</small><label><input type="radio" name="ranking" value="book"/> Frequency in this book</label><label><input type="radio" name="ranking" value="global"/> Broader language-corpus frequency</label></fieldset><button>Download Anki TSV</button></form></article><details><summary>Note type setup</summary><pre>{ cardexport.NoteTypeDefinition() }</pre></details> } }
templ KnownVocabPage(user domain.User, csrf string, profiles []domain.LanguageProfile, language string, known []domain.KnownVocabulary) {
	@KnownVocabPageWithResult(user, csrf, profiles, language, nil, known, "")
}
templ KnownVocabPageWithResult(user domain.User, csrf string, profiles []domain.LanguageProfile, language string, result *knownvocab.ImportResult, known []domain.KnownVocabulary, message string) {
	@Layout("Known vocabulary", &user, csrf) { <h1>Known vocabulary</h1><p>Import words you already know so pre-learning decks focus on new vocabulary.</p>
	<article><form method="post" action="/known-vocab/import" enctype="multipart/form-data" hx-post="/known-vocab/import" hx-target="#known-vocab-results" hx-swap="innerHTML"><input type="hidden" name="csrf_token" value={ csrf }/><label>Language code<input name="language" value={ language } list="study-languages" placeholder="de" required/></label><datalist id="study-languages">
	for _, profile := range profiles {
		<option value={ profile.Language }>{ profile.DisplayName }</option>
	}
	</datalist><label>Paste lemma list<textarea name="vocabulary" rows="10" placeholder={ "Haus\ngehen\tVERB" }></textarea></label><label>Or upload a UTF-8 text file<input type="file" name="vocabulary_file" accept="text/plain,.txt,.tsv"/></label><small>One lemma per line, optionally followed by a tab and Universal POS tag.</small><button>Import known words</button></form></article><section id="known-vocab-results">@KnownVocabResult(language, result, known, message)</section> }
}
templ KnownVocabResult(language string, result *knownvocab.ImportResult, known []domain.KnownVocabulary, message string) {
	if message != "" {
		<p role="alert">{ message }</p>
	}
	if result != nil {
		<article><h2>Import result</h2><p role="status"><strong>{ fmt.Sprintf("%d imported", result.Imported) }</strong> · { fmt.Sprintf("%d already known", result.AlreadyKnown) } · { fmt.Sprintf("%d rejected", len(result.Rejected)) }</p>
		if len(result.Rejected) > 0 {
			<h3>Rejected rows</h3><table><thead><tr><th>Row</th><th>Original</th><th>Reason</th></tr></thead><tbody>
			for _, rejection := range result.Rejected {
				<tr><td>{ fmt.Sprintf("%d", rejection.Row) }</td><td><code>{ rejection.Original }</code></td><td>{ rejection.Error }</td></tr>
			}
			</tbody></table>
		}
		</article>
	}
	<h2>Previously imported
	if language != "" {
		<small> · { language }</small>
	}
	</h2>
	if language == "" {
		<p>Choose a language to view known vocabulary.</p>
	} else if len(known) == 0 {
		<p>No known vocabulary imported for this language yet.</p>
	} else {
		<table><thead><tr><th>Lemma</th><th>Part of speech</th><th>Imported</th></tr></thead><tbody>
		for _, entry := range known {
			<tr><td>{ entry.CanonicalLemma }</td><td>{ knownVocabUPOS(entry.UPOS) }</td><td>{ entry.CreatedAt.Format("2006-01-02") }</td></tr>
		}
		</tbody></table>
	}
}
templ AdminFrequencyPage(user domain.User, csrf string, datasets []domain.FrequencyDataset, language, message string) {
	@Layout("Frequency resources", &user, csrf) { <p><a href="/admin">← Administration</a></p><h1>Frequency resources</h1>
	if message != "" {
		<p role="alert">{ message }</p>
	}
	<article><h2>Upload DWDS dataset</h2><form method="post" action="/admin/frequency" enctype="multipart/form-data"><input type="hidden" name="csrf_token" value={ csrf }/><div class="grid"><label>Language<input name="language" value={ language } placeholder="de" required/></label><label>Version<input name="version" required/></label></div><label>Dataset<input type="file" name="dataset" required/></label><label><input type="checkbox" name="replace"/> Activate this version after import</label><button>Upload</button></form></article>
	<form method="get" action="/admin/frequency"><label>Filter language<input name="language" value={ language } placeholder="de"/></label><button class="outline">List datasets</button></form>
	<table><thead><tr><th>Language</th><th>Version</th><th>Status</th><th>Actions</th></tr></thead><tbody>
	for _, dataset := range datasets {
		<tr><td>{ dataset.Language }</td><td>{ dataset.Version }</td><td>{ frequencyStatus(dataset) }</td><td><div class="grid">
		if dataset.Active {
			@FrequencyAction(csrf, dataset.ID, "deactivate", "Deactivate")
		} else {
			@FrequencyAction(csrf, dataset.ID, "activate", "Activate")
		}
		@FrequencyAction(csrf, dataset.ID, "remove", "Remove")
		</div></td></tr>
	}
	</tbody></table> }
}
templ FrequencyAction(csrf, id, action, label string) { <form method="post" action={ templ.SafeURL("/admin/frequency/"+id+"/"+action) }><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline">{ label }</button></form> }
templ AdminUsersPage(user domain.User, csrf, message string) {
	@Layout("Users", &user, csrf) { <p><a href="/admin">← Administration</a></p><h1>User registration</h1><p>Register non-admin learner accounts.</p>
	if message != "" {
		<p role="alert">{ message }</p>
	}
	<article><form method="post" action="/admin/users"><input type="hidden" name="csrf_token" value={ csrf }/><label>Username<input name="username" required/></label><label>Password<input type="password" name="password" minlength="8" required/></label><button>Register learner</button></form></article> }
}

templ AdminPage(user domain.User, csrf string) {
	@Layout("Administration", &user, csrf) { <header class="page-heading"><div><h1>Administration</h1><p>Server configuration and account management.</p></div></header><div class="admin-grid">
		<article><h2>Users</h2><p>Create and manage non-admin learner accounts.</p><a role="button" class="outline" href="/admin/users">Manage users</a></article>
		<article><h2>Languages</h2><p>Configure the languages learners can choose for study.</p><a role="button" class="outline" href="/languages">Configure languages</a></article>
		<article><h2>Frequency data</h2><p>Upload and activate language frequency datasets.</p><a role="button" class="outline" href="/admin/frequency">Manage frequency data</a></article>
		<article><h2>OPDS connections</h2><p>Configure catalog connections used to find books.</p><a role="button" class="outline" href="/admin/connections">Configure connections</a></article>
	</div> }
}
