package webapp

import (
	"fmt"
	"net/url"
	"strings"
	"github.com/justin-hayes/mouseion/internal/analysis"
	"github.com/justin-hayes/mouseion/internal/domain"
	"github.com/justin-hayes/mouseion/internal/enrichmentjob"
	"github.com/justin-hayes/mouseion/internal/knownvocab"
	"github.com/justin-hayes/mouseion/internal/lemmadisplay"
	"github.com/justin-hayes/mouseion/internal/lexical"
	"github.com/justin-hayes/mouseion/internal/opds"
)

templ Layout(title string, user *domain.User, csrf string) {
	<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{ title } · Mouseion</title><link rel="stylesheet" href="/static/vendor/pico-2.1.1.min.css"/><link rel="stylesheet" href="/static/app.css"/><script src="/static/vendor/htmx-2.0.7.min.js" defer></script><script>
window.escapeHtml = function (s) {
  return String(s).replace(/[&<>"']/g, function (c) {
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
};
document.addEventListener('htmx:responseError', function (evt) {
  var target = evt.detail.target;
  if (!target) return;
  var text = ((evt.detail.xhr && evt.detail.xhr.responseText) || 'Request failed').trim();
  target.innerHTML = '<article role="alert"><strong>Catalog error:</strong> ' + window.escapeHtml(text) + '<p><small>Review the catalog connection or try again.</small></p></article>';
});
document.addEventListener('submit', function (evt) {
  var form = evt.target.closest && evt.target.closest('form[data-acquire]');
  if (!form) return;
  var button = form.querySelector('button[type="submit"]');
  if (button) { button.disabled = true; button.setAttribute('aria-busy', 'true'); button.textContent = 'Adding to library…'; }
});
document.addEventListener('submit', async function (evt) {
  var form = evt.target.closest && evt.target.closest('form[data-prepare-deck]');
  if (!form) return;
  evt.preventDefault();
  var button = form.querySelector('button[type="submit"]');
  var status = form.parentElement.querySelector('[data-deck-preparation]');
  if (button) { button.disabled = true; button.setAttribute('aria-busy', 'true'); button.textContent = 'Queuing deck…'; }
  try {
    var response = await fetch(form.action, {method: 'POST', body: new FormData(form), credentials: 'same-origin'});
    if (!response.ok) {
      var detail = (await response.text()).trim();
      throw new Error(detail || ('Request failed with status ' + response.status));
    }
    form.hidden = true;
    status.hidden = false;
    await window.pollDeckPreparation(response.url, status, form);
  } catch (error) {
    status.hidden = false;
    status.innerHTML = '<p role="alert">Deck preparation could not start: ' + window.escapeHtml(error && error.message ? error.message : 'Please try again.') + '</p>';
    if (button) { button.disabled = false; button.removeAttribute('aria-busy'); button.textContent = 'Prepare deck'; }
  }
});
window.pollDeckPreparation = async function (statusURL, target, sourceForm) {
  try {
    var response = await fetch(statusURL, {credentials: 'same-origin'});
    if (!response.ok) throw new Error((await response.text()).trim() || ('Request failed with status ' + response.status));
    var preparation = await response.json();
    var stateLabels = {queued: 'Deck queued', preparing: 'Preparing deck', ready: 'Deck ready', failed: 'Deck preparation failed', cancelled: 'Deck preparation cancelled'};
    var phaseLabels = {queued: 'Waiting to start', freezing: 'Freezing the selected vocabulary', submitting: 'Submitting translation requests', waiting: 'Waiting for Batch translation', reconciling: 'Reconciling translation results', retrying: 'Retrying temporary translation failures', translating: 'Translating selected vocabulary', finalizing: 'Finalizing the Anki package', completed: 'Preparation complete', failed: 'Preparation failed', cancelled: 'Preparation cancelled'};
    var active = preparation.state === 'queued' || preparation.state === 'preparing';
    var html = '<h3>' + window.escapeHtml(stateLabels[preparation.state] || 'Deck preparation') + '</h3>';
    if (active) {
      html += '<p aria-busy="true">' + window.escapeHtml(phaseLabels[preparation.phase] || (preparation.state === 'queued' ? 'Waiting for preparation to begin' : 'Preparing the deck')) + '…</p>';
      var t = preparation.translation || {};
      if (Number(t.eligible || 0) > 0) html += 'Translations: ' + Number(t.completed || 0) + ' complete · ' + Number(t.failed || 0) + ' unavailable · ' + Number(t.retrying || 0) + ' retrying · ' + Number(t.pending || 0) + ' waiting.';
      var b = preparation.batch || {};
      if (Number(b.requests || 0) > 0) html += 'Batch requests: ' + Number(b.completed || 0) + ' complete · ' + Number(b.failed || 0) + ' failed · ' + Number(b.expired || 0) + ' expired' + (Number(b.age_seconds || 0) > 0 ? ' · running for ' + Math.floor(Number(b.age_seconds || 0) / 3600) + 'h' : '') + '.';
    }
    html += '<progress value="' + Number(preparation.progress || 0) + '" max="100">' + Number(preparation.progress || 0) + '%</progress>';
    if (preparation.deck_name) html += '<p><strong>Deck:</strong> <code>' + window.escapeHtml(preparation.deck_name) + '</code><br/><strong>Filename:</strong> <code>' + window.escapeHtml(preparation.filename) + '</code></p>';
    if (preparation.ready) {
      var c = preparation.completeness || {};
      html += '<p><strong>Completeness:</strong> ' + Number(c.total_cards || 0) + ' cards · ' + Number(c.cards_with_english || 0) + ' with English · ' + Number(c.cards_with_contextual_sentence_translations || 0) + ' with contextual sentence translations · ' + Number(c.quality_omissions || 0) + ' omitted for sentence quality.</p>';
      html += '<a role="button" download href="' + window.escapeHtml(preparation.download_url) + '">Download deck</a> <a role="button" class="outline" href="/campaigns">Add to learning queue</a>';
    } else if (active) {
      html += '<button type="button" class="outline secondary" data-cancel-preparation>Cancel preparation</button>';
    } else {
      if (preparation.error) html += '<p role="alert">' + window.escapeHtml(preparation.error) + '</p>';
      html += '<button type="button" data-retry-preparation>Retry preparation</button>';
    }
    target.innerHTML = html;
    var cancel = target.querySelector('[data-cancel-preparation]');
    if (cancel) cancel.addEventListener('click', function () { window.updateDeckPreparation(statusURL.replace(/\/status$/, '/cancel'), target, sourceForm); });
    var retry = target.querySelector('[data-retry-preparation]');
    if (retry) retry.addEventListener('click', function () { window.updateDeckPreparation(statusURL.replace(/\/status$/, '/retry'), target, sourceForm); });
    if (active) setTimeout(function () { window.pollDeckPreparation(statusURL, target, sourceForm); }, 1500);
  } catch (error) {
    target.innerHTML = '<p role="alert">Could not check deck preparation: ' + window.escapeHtml(error && error.message ? error.message : 'Please try again.') + '</p><button type="button" data-check-preparation>Try again</button>';
    target.querySelector('[data-check-preparation]').addEventListener('click', function () { window.pollDeckPreparation(statusURL, target, sourceForm); });
  }
};
window.updateDeckPreparation = async function (action, target, sourceForm) {
  var data = new FormData();
  data.set('csrf_token', sourceForm.querySelector('[name="csrf_token"]').value);
  var consent = sourceForm.querySelector('[name="external_translation_consent"]');
  if (consent && consent.checked) data.set('external_translation_consent', 'on');
  try {
    var response = await fetch(action, {method: 'POST', body: data, credentials: 'same-origin'});
    if (!response.ok) throw new Error((await response.text()).trim() || ('Request failed with status ' + response.status));
    await window.pollDeckPreparation(action.replace(/\/(cancel|retry)$/, '/status'), target, sourceForm);
  } catch (error) {
    target.insertAdjacentHTML('beforeend', '<p role="alert">Deck action failed: ' + window.escapeHtml(error && error.message ? error.message : 'Please try again.') + '</p>');
  }
};
</script></head><body><header class="container"><nav><ul><li><a href="/"><strong>Mouseion</strong></a></li></ul>
	if user != nil {
		<ul>
		<li><a href="/library">My Library</a></li><li><a href="/campaigns">Learning</a></li><li><a href="/connections">Add books</a></li><li><a href="/settings">Settings</a></li>
		<li><small>{ user.Username }</small></li><li><form class="inline" method="post" action="/logout"><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Log out</button></form></li></ul>
	}
	</nav></header><main class="container">{ children... }</main></body></html>
}
templ LibraryPage(user domain.User, csrf string, books []domain.SourceMaterialSummary, message string) {
	@Layout("My Library", &user, csrf) { <header class="page-heading"><div><h1>My Library</h1><p>Your books, ready for pre-learning.</p></div><a role="button" href="/connections">Add a book</a></header>
	if message != "" {
		<p role="status">{ message }</p>
	}
	if len(books) == 0 {
		<article><h2>Your library is empty</h2><p>Browse a catalog and import a book to begin.</p><a href="/connections">Browse catalogs</a></article>
	}
	if len(books) > 0 {
		<div class="library-list">
		for _, book := range books {
			<article><div><h2 class="bibliographic-title"><a href={ templ.SafeURL("/books/"+book.Source.ID) }>{ book.Source.Title }</a></h2><p class="metadata"><code>{ book.Source.Language }</code> · imported { book.Source.CreatedAt.Format("2006-01-02") }</p></div><span class={ "status status-"+statusClass(book.AnalysisStatus) }>{ book.AnalysisStatus }</span></article>
		}
		</div>
	}
	}
}
templ CampaignsPage(user domain.User, csrf string, campaigns []campaignView, prepared []preparedCampaignOption, message string, pageError string) {
	@Layout("Learning", &user, csrf) {
		<header class="page-heading"><div><h1>Learning campaigns</h1><p>Choose one prepared book and deck to study now, and keep the rest in your queue.</p></div><a role="button" class="outline" href="/library">Prepare another deck</a></header>
		if message != "" {
			<p role="status">{ message }</p>
		}
		if pageError != "" {
			<p role="alert">{ pageError }</p>
		}
		<section aria-labelledby="active-campaign-heading"><h2 id="active-campaign-heading">Active campaign</h2>
			if !hasCampaignStatus(campaigns, domain.CampaignActive) {
				<p>No campaign is active. Start one from your queue below.</p>
			}
			for _, item := range campaigns {
				if item.Campaign.Status == domain.CampaignActive {
					@CampaignCard(item, csrf, false)
				}
			}
		</section>
		<section aria-labelledby="campaign-queue-heading"><h2 id="campaign-queue-heading">Queue</h2>
			if !hasCampaignStatus(campaigns, domain.CampaignQueued) {
				<p>Your learning queue is empty.</p>
			}
			for _, item := range campaigns {
				if item.Campaign.Status == domain.CampaignQueued {
					@CampaignCard(item, csrf, true)
				}
			}
		</section>
		if len(prepared) > 0 {
			<section aria-labelledby="prepared-books-heading"><h2 id="prepared-books-heading">Prepared books</h2><p>Add a ready book and deck to your learning queue.</p><div class="campaign-list">
				for _, item := range prepared {
					<article><div><h3>{ item.Book.Source.Title }</h3><p><span class="status status-ready">Deck ready</span> · <code>{ item.Deck.DeckName }</code></p><p>{ fmt.Sprintf("%d cards", item.Deck.TotalCards) } · <a href={ templ.SafeURL("/deck-preparations/"+item.Deck.ID+"/download") }>Download deck</a></p></div><form method="post" action="/campaigns"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="deck_preparation_id" value={ item.Deck.ID }/><button>Add to queue</button></form></article>
				}
			</div></section>
		}
		<section aria-labelledby="campaign-history-heading"><h2 id="campaign-history-heading">History</h2>
			if !hasCampaignHistory(campaigns) {
				<p>No completed or abandoned campaigns yet.</p>
			}
			for _, item := range campaigns {
				if item.Campaign.Status == domain.CampaignComplete || item.Campaign.Status == domain.CampaignAbandoned {
					@CampaignCard(item, csrf, false)
				}
			}
		</section>
	}
}
templ CampaignCard(item campaignView, csrf string, activatable bool) {
	<article class="campaign-card"><div><h3><a href={ templ.SafeURL("/books/"+item.Book.Source.ID) }>{ item.Book.Source.Title }</a></h3><p><span class={ "status status-"+statusClass(string(item.Campaign.Status)) }>{ campaignStatusLabel(item.Campaign.Status) }</span> · <code>{ item.Deck.DeckName }</code></p><dl class="campaign-progress"><div><dt>Book</dt><dd>{ campaignBookLabel(item.Campaign.BookProgress) }{ campaignProgressTime(item.Campaign.BookFinishedAt) }</dd></div><div><dt>Deck</dt><dd>{ campaignDeckLabel(item.Campaign.DeckProgress) }{ campaignProgressTime(item.Campaign.DeckReviewedAt) }</dd></div></dl>
	if item.Campaign.Status == domain.CampaignQueued && item.Coverage != nil {
		<p><strong>{ fmt.Sprintf("%.1f%%", knownCoveragePercent(*item.Coverage)) }</strong> current-known coverage · <strong>{ fmt.Sprintf("%.1f%%", activeCampaignCoveragePercent(*item.Coverage)) }</strong> future-book coverage after the active campaign graduates</p>
	}
	if item.Campaign.CompletedAt != nil {
		<p>Completed { item.Campaign.CompletedAt.UTC().Format("2006-01-02 15:04 UTC") }</p>
	}
	<p><a href={ templ.SafeURL("/deck-preparations/"+item.Deck.ID+"/download") }>Download prepared deck</a></p></div>
	if activatable {
		<form method="post" action={ templ.SafeURL("/campaigns/"+item.Campaign.ID+"/activate") }><input type="hidden" name="csrf_token" value={ csrf }/><button>Start learning</button></form>
	}
	if item.Campaign.Status == domain.CampaignActive {
		<div class="campaign-actions">
		if item.Campaign.BookProgress != domain.BookFinished {
			<form method="post" action={ templ.SafeURL("/campaigns/"+item.Campaign.ID+"/book-finished") }><input type="hidden" name="csrf_token" value={ csrf }/><button>Mark book finished</button></form>
		}
		if item.Campaign.DeckProgress != domain.DeckReviewed {
			<form method="post" action={ templ.SafeURL("/campaigns/"+item.Campaign.ID+"/deck-reviewed") }><input type="hidden" name="csrf_token" value={ csrf }/><button>Mark deck reviewed</button></form>
		}
		<form method="post" action={ templ.SafeURL("/campaigns/"+item.Campaign.ID+"/abandon") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline">Abandon campaign</button></form>
		</div>
	}
	</article>
}
templ BookPage(user domain.User, csrf string, book domain.SourceMaterialSummary, coverage *domain.AnalysisCoverage, statisticsUnavailable bool, message string) {
	@Layout(book.Source.Title, &user, csrf) { <p><a href="/library">← My Library</a></p><header class="page-heading"><div><h1>{ book.Source.Title }</h1><p><code>{ book.Source.Language }</code> · { book.Source.MediaType }</p></div><span class={ "status status-"+statusClass(book.AnalysisStatus) }>{ book.AnalysisStatus }</span></header>
	if message != "" {
		<p role="status">{ message }</p>
	}
	if coverage != nil {
		<section aria-labelledby="analyzed-scope-heading"><h2 id="analyzed-scope-heading">Analyzed scope</h2>
			if coverage.ReviewedScopeID != "" {
				<p><strong>{ fmt.Sprintf("%d selected units", len(coverage.SelectedUnits)) }</strong> from this EPUB were analyzed. Coverage, thresholds, projections, highest-impact unknown vocabulary, and structural metrics apply only to these selected units, not necessarily to the full EPUB.</p>
				<p><small>Reviewed scope <code>{ coverage.ReviewedScopeID }</code></small></p>
				<ul>
					for _, unit := range coverage.SelectedUnits {
						<li>{ corpusUnitLabel(unit) }</li>
					}
				</ul>
			} else {
				<p><strong>Legacy/full-text scope.</strong> This corpus predates reviewed EPUB scopes or was analyzed from the source's full text. All metrics on this page apply to that persisted full-text corpus.</p>
			}
		</section>
		if hasAnalysisWarnings(*coverage) {
			<section aria-labelledby="analysis-quality-heading"><h2 id="analysis-quality-heading">Analysis quality</h2>
				<p>These checks describe concrete gaps in the analyzer output. They do not assign a quality grade.</p>
				if coverage.TextProfile != nil && coverage.TextProfile.SentenceCount == 0 {
					<article role="note"><strong>No sentences returned.</strong> Sentence-length signals are unavailable. Analyze the book again if the source text should contain sentences.</article>
				}
				if coverage.TextProfile != nil && coverage.TextProfile.EmptySentenceCount > 0 {
					<article role="note"><strong>Empty sentences returned.</strong> { fmt.Sprintf("%d analyzer-provided sentences contained no tokens; those sentences count as zero tokens in the structural statistics.", coverage.TextProfile.EmptySentenceCount) }</article>
				}
				if coverage.TextProfile != nil && coverage.TextProfile.NormalizedTokenCount > 0 && coverage.AnalyzableTokenCount == 0 {
					<article role="note"><strong>No vocabulary-analyzable tokens.</strong> The analyzer returned normalized tokens, but none passed the vocabulary filters, so coverage and vocabulary projections have no usable token denominator.</article>
				}
			</section>
		}
		if coverage.TextProfile != nil {
			<section aria-labelledby="text-profile-heading"><h2 id="text-profile-heading">Text profile</h2>
				<div class="coverage-summary">
					<article><strong>{ fmt.Sprintf("%d", coverage.TextProfile.SentenceCount) }</strong><span>sentences</span></article>
					<article><strong>{ fmt.Sprintf("%.1f", coverage.TextProfile.MedianSentenceTokenCount) }</strong><span>median tokens per sentence</span></article>
					<article><strong>{ fmt.Sprintf("%d", coverage.TextProfile.P90SentenceTokenCount) }</strong><span>90th-percentile tokens</span></article>
					<article><strong>{ fmt.Sprintf("%.1f%%", longSentencePercent(*coverage.TextProfile)) }</strong><span>long sentences (&gt;35 tokens)</span></article>
				</div>
				<p><strong>{ fmt.Sprintf("%d of %d", coverage.AnalyzableTokenCount, coverage.TextProfile.NormalizedTokenCount) }</strong> normalized tokens contribute to vocabulary coverage. Sentence lengths include every normalized token, including punctuation.</p>
				<details><summary>How the text profile works</summary><p>Sentence boundaries and tokens come from the analyzer. The median is the middle sentence length (or the average of the two middle lengths), and the 90th percentile uses nearest-rank selection. A long sentence has more than 35 normalized tokens. These are separate, descriptive signals—not a difficulty score or proficiency-level claim.</p></details>
			</section>
		}
		if coverage.TextProfile == nil {
			<article role="note"><h2>Text profile unavailable</h2><p>This book was analyzed before sentence statistics were recorded. Analyze it again to see structural signals.</p></article>
		}
		<section aria-labelledby="coverage-heading"><h2 id="coverage-heading">Vocabulary coverage</h2>
			<div class="coverage-summary">
				<article><strong>{ fmt.Sprintf("%.1f%%", knownCoveragePercent(*coverage)) }</strong><span>current-known coverage</span></article>
				<article><strong>{ fmt.Sprintf("%.1f%%", activeCampaignCoveragePercent(*coverage)) }</strong><span>active-campaign projected coverage</span></article>
				<article><strong>{ fmt.Sprintf("%d", coverage.AnalyzableTokenCount) }</strong><span>analyzable tokens</span></article>
				<article><strong>{ fmt.Sprintf("%d", coverage.DistinctLemmaCount) }</strong><span>distinct lemmas</span></article>
			</div>
			<p>Your current known vocabulary—including vocabulary graduated by completed campaigns—covers <strong>{ fmt.Sprintf("%d", coverage.KnownTokenCount) }</strong> token occurrences across <strong>{ fmt.Sprintf("%d", coverage.KnownLemmaCount) }</strong> distinct lemmas. The active campaign could add <strong>{ fmt.Sprintf("%d", coverage.ActiveCampaignTokenCount) }</strong> occurrences across <strong>{ fmt.Sprintf("%d", coverage.ActiveCampaignLemmaCount) }</strong> lemmas after graduation; this projection is not counted as known. The remaining unknown vocabulary accounts for <strong>{ fmt.Sprintf("%d", coverage.UnknownTokenCount) }</strong> occurrences across <strong>{ fmt.Sprintf("%d", coverage.UnknownLemmaCount) }</strong> lemmas.</p>
			<h3>Additional vocabulary</h3><p>Smallest number of deck-eligible lemmas needed to reach each analyzed-scope token coverage target:</p>
			<div class="coverage-thresholds">
				for _, threshold := range coverage.Thresholds {
					if threshold.Reachable {
						<article><strong>{ fmt.Sprintf("%d", threshold.LemmaCount) }</strong><span>{ fmt.Sprintf("lemmas for %d%%", threshold.TargetPercent) }</span></article>
					} else {
						<article><strong>Unavailable</strong><span>{ fmt.Sprintf("%d%% cannot be reached with deck-eligible vocabulary", threshold.TargetPercent) }</span></article>
					}
				}
			</div>
			if len(coverage.TopUnknownLemmas) > 0 {
				<h3>Highest-impact unknown vocabulary</h3>
				<p>The most frequent deck-eligible lemmas in this analyzed scope:</p>
				<ol class="top-unknown">
					for _, lemma := range coverage.TopUnknownLemmas {
						if lexical.IsLemma(lemma.CanonicalLemma) {
							<li><span><strong>{ lemmadisplay.Format(book.Source.Language, lemma.CanonicalLemma, lemma.UPOS) }</strong> <small>{ lemma.UPOS }</small></span><span>{ fmt.Sprintf("%d occurrences", lemma.OccurrenceCount) }</span></li>
						}
					}
				</ol>
				<p>The top { fmt.Sprintf("%d", coverage.UnknownConcentration.TopLemmaCount) } deck-eligible lemmas account for <strong>{ fmt.Sprintf("%.1f%%", concentrationPercent(coverage.UnknownConcentration)) }</strong> of eligible unknown occurrences.</p>
				<h3>Projected token coverage</h3>
				<p>If you learned the most frequent deck-eligible lemmas:</p>
				<div class="coverage-thresholds">
					for _, projection := range coverage.Projections {
						<article><strong>{ fmt.Sprintf("%.1f%%", projectedCoveragePercent(projection, coverage.AnalyzableTokenCount)) }</strong><span>{ fmt.Sprintf("after top %d lemmas", projection.TopLemmaCount) }</span></article>
					}
				</div>
			}
			<details><summary>How these metrics work</summary><p><strong>Current-known coverage</strong> is the share of analyzable token occurrences in the resulting corpus matched by vocabulary explicitly marked known or graduated from a completed campaign. <strong>Active-campaign projected coverage</strong> adds reserved vocabulary from the active campaign without claiming it is known. Analyzable tokens include nouns, verbs, adjectives, and adverbs; punctuation and other parts of speech are excluded. Distinct lemmas count lemma and part-of-speech identities.</p><p>Active-campaign vocabulary is excluded from a new deck while it is reserved. Abandoned campaign vocabulary becomes <strong>deck-eligible vocabulary</strong> again. Unattached legacy generated history remains conservatively excluded. The 95%, 97%, and 99% estimates use the same analyzed-scope token denominator as current coverage. A target is unavailable when excluded vocabulary prevents deck-eligible words from reaching it.</p></details>
		</section>
	}
	if statisticsUnavailable {
		<article role="note"><h2>Analysis insights unavailable</h2><p>This book was analyzed before reproducible vocabulary and sentence statistics were recorded. Analyze it again to see coverage, projections, and the structural profile.</p></article>
	}
	<div class="book-actions"><article><h2>Analysis</h2>
		if book.Source.MediaType == "application/epub+zip" {
			<p><a href={ templ.SafeURL(scopeReviewURL(book)) }>Review and analyze a new EPUB scope</a></p>
		}
		if book.AnalysisJobID > 0 {
			<p><a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", book.AnalysisJobID)) }>View analysis status and results</a></p>
		}
		if book.AnalysisJobID == 0 {
			<p>Confirm an EPUB scope before starting analysis.</p>
		}
		if book.Source.MediaType != "application/epub+zip" || book.ConfirmedScopeID != "" || book.ReviewedScopeID != "" {
			<form method="post" action={ templ.SafeURL("/books/"+book.Source.ID+"/analyze") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline">{ analyzeLabel(book.AnalysisStatus) }</button>
				if book.ConfirmedScopeID != "" || book.ReviewedScopeID != "" {
					<small>Analysis uses the confirmed immutable scope <code>{ firstNonEmpty(book.ConfirmedScopeID, book.ReviewedScopeID) }</code>. Reanalysis reuses reviewed scope history; review a new scope to create distinct history.</small>
				}
			</form>
		} else {
			<a role="button" class="outline" href={ templ.SafeURL(scopeReviewURL(book)) }>Review and confirm scope</a>
			}
	</article><article><h2>Generate vocabulary deck</h2><p>Create an Anki deck from one completed scoped analysis, covering at least 97% of that analysis's unknown vocabulary.</p>
		if book.AnalysisStatus == "analyzed" && book.AnalysisJobID > 0 {
			<p>Deck preparation is tied to the exact analysis result and its immutable scope.</p><a role="button" class="outline" href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", book.AnalysisJobID)) }>Open analysis result to prepare deck</a>
		} else {
			<button disabled>Available after a scoped analysis</button>
		}
	</article></div> }
}

templ EPUBScopeReviewPage(user domain.User, csrf string, review epubScopeView, pageError string, selectedCSV string) {
	@Layout("Review analysis scope", &user, csrf) {
		<p><a href={ templ.SafeURL("/books/"+review.Book.ID) }>← { review.Book.Title }</a></p>
		<header class="page-heading"><div><h1>Review analysis scope</h1><p>Choose the readable EPUB units that should be used by a future analysis.</p></div></header>
		if pageError != "" {
			<article role="alert" tabindex="-1"><strong>Scope not saved.</strong> { pageError }</article>
		}
		<article role="note"><strong>How recommendations work</strong><p>High-confidence front or back matter is excluded when the structure strongly suggests reference material. Unknown and low-confidence units need particular attention because the available evidence is limited or conflicting. You remain in control of every unit.</p></article>
		if review.DegradedRecommendation {
			<article role="note"><strong>Limited structural confidence</strong><p>No high-confidence main matter was found. Substantive medium-confidence main matter is included with review suggested; unknown units remain excluded for review instead of being promoted by a whole-book fallback.</p></article>
		}
		<nav aria-label="Scope presets"><strong>Start with a preset:</strong> <a href={ templ.SafeURL(scopePresetURL(review, "recommended")) }>Current classifier recommendation</a> · <a href={ templ.SafeURL(scopePresetURL(review, "all")) }>All readable units</a>
			if review.PriorScope != nil {
				<span> · </span><a href={ templ.SafeURL(scopePresetURL(review, "prior")) }>Prior selection</a>
			}
		</nav>
		if review.PriorScope != nil {
			<section aria-labelledby="scope-comparison-heading"><h2 id="scope-comparison-heading">Scope comparison</h2><p>Prior scope <code>{ review.PriorScope.ScopeID }</code> compared with the <strong>{ review.Preset }</strong> preset.</p>
				<p><strong>Prior:</strong> { fmt.Sprintf("%d units · %d characters · about %d tokens", len(review.PriorScope.SelectedUnits), review.Comparison.OldCharacters, review.Comparison.OldTokens) }<br/><strong>Proposed:</strong> { fmt.Sprintf("%d units · %d characters · about %d tokens", len(review.PriorScope.SelectedUnits)+len(review.Comparison.Added)-len(review.Comparison.Removed), review.Comparison.NewCharacters, review.Comparison.NewTokens) }</p>
				<h3>Prior included units</h3><ul>
					for _, item := range review.Comparison.Old {
						<li><code>{ item.Unit.ID }</code> — { item.Unit.Title }</li>
					}
				</ul>
				<h3>Proposed included units</h3><ul>
					for _, item := range review.Comparison.New {
						<li><code>{ item.Unit.ID }</code> — { item.Unit.Title }</li>
					}
				</ul>
				<h3>Added units</h3>
				if len(review.Comparison.Added) == 0 {
					<p>None.</p>
				} else {
					<ul>
						for _, item := range review.Comparison.Added {
							<li><code>{ item.Unit.ID }</code> — { item.Unit.Title } ({ fmt.Sprintf("%d characters · about %d tokens", item.CharacterCount, item.TokenEstimate) })</li>
						}
					</ul>
				}
				<h3>Removed units</h3>
				if len(review.Comparison.Removed) == 0 {
					<p>None.</p>
				} else {
					<ul>
						for _, item := range review.Comparison.Removed {
							<li><code>{ item.Unit.ID }</code> — { item.Unit.Title } ({ fmt.Sprintf("%d characters · about %d tokens", item.CharacterCount, item.TokenEstimate) })</li>
						}
					</ul>
				}
			</section>
		}
		<form method="post" action={ templ.SafeURL("/books/"+review.Book.ID+"/scope") } data-scope-review>
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<input type="hidden" name="snapshot_id" value={ review.SnapshotID }/>
			<fieldset class="scope-actions"><legend>Apply a selection</legend><button type="button" class="outline" data-select="recommended">Accept recommendation</button><button type="button" class="outline" data-select="main">Select all main matter</button><button type="button" class="outline" data-select="all">Include all</button><button type="button" class="outline secondary" data-select="none">Exclude all</button></fieldset>
			<div class="scope-summary" role="status" aria-live="polite" aria-atomic="true"><span>{ fmt.Sprintf("All units: %d characters, about %d tokens", review.AllCharacters, review.AllTokens) }</span><strong data-selected-count>0 units selected</strong><span data-selected-size>Selected: 0 characters, about 0 tokens</span></div>
			if len(review.Groups) > 0 {
				<section class="scope-groups" aria-labelledby="scope-groups-heading"><h2 id="scope-groups-heading">EPUB groups</h2><p>Groups come from persisted navigation, landmarks, or stable resource paths. Their controls are expanded and validated by the server.</p>
					for _, item := range review.Groups {
						<article class="scope-group" style={ fmt.Sprintf("margin-left:%dem", item.Group.Depth*2) } data-group-units={ strings.Join(item.Group.UnitIDs, ",") }>
							<header><strong>{ item.Group.Label }</strong><span data-group-state role="status" aria-live="polite">Selection pending</span></header>
							<p><span>{ fmt.Sprintf("All group units: %d units | %d characters | about %d tokens", len(item.Group.UnitIDs), item.CharacterCount, item.TokenEstimate) }</span><br/><strong data-group-selected>Selected: calculating…</strong></p>
							<button type="submit" class="outline" name="group_include" value={ item.Group.ID }>Include group</button>
							<button type="submit" class="outline secondary" name="group_exclude" value={ item.Group.ID }>Exclude group</button>
						</article>
					}
				</section>
			} else {
				<p role="note"><strong>Flat spine order.</strong> This EPUB has no reliable persisted hierarchy, so units remain in deterministic reading order.</p>
			}
			<fieldset class="scope-units"><legend>Readable units in spine order</legend>
				for _, item := range review.Units {
					<article class="scope-unit" data-category={ string(item.Classification.Category) } data-recommended={ fmt.Sprintf("%t", item.Classification.RecommendedInclusion) } data-characters={ fmt.Sprintf("%d", item.CharacterCount) } data-tokens={ fmt.Sprintf("%d", item.TokenEstimate) }>
						<header><label for={ "scope-unit-"+fmt.Sprintf("%d", item.Unit.Order) }><input id={ "scope-unit-"+fmt.Sprintf("%d", item.Unit.Order) } type="checkbox" name="unit_id" value={ item.Unit.ID } checked?={ scopeUnitChecked(selectedCSV, item.Unit.ID, item.Classification.RecommendedInclusion) }/> Include { item.Unit.Title }</label><span>{ fmt.Sprintf("Unit %d", item.Unit.Order+1) }</span></header>
						<p><strong>{ item.Unit.Title }</strong> <small>{ titleSourceLabel(item.Unit.TitleSource) }</small></p>
						<dl><div><dt>Category</dt><dd>{ categoryLabel(item.Classification.Category) }</dd></div><div><dt>Confidence</dt><dd>{ fmt.Sprintf("%d%%", item.Classification.Confidence) }</dd></div><div><dt>Recommendation</dt><dd>{ recommendationLabel(item.Classification) }</dd></div><div><dt>Recommendation policy</dt><dd>{ recommendationExplanation(item.Classification) }</dd></div><div><dt>Estimated size</dt><dd>{ fmt.Sprintf("%d characters · about %d tokens", item.CharacterCount, item.TokenEstimate) }</dd></div></dl>
						if !item.Classification.RecommendedInclusion && item.Classification.Confidence >= domain.EPUBConfidenceHighMinimum {
							<p class="scope-warning"><strong>High-confidence exclusion:</strong> including this unit overrides a strong exclusion recommendation.</p>
						}
						if item.Classification.Category == domain.EPUBCategoryUnknown || item.Classification.Confidence <= domain.EPUBConfidenceLowMaximum {
							<p class="scope-warning"><strong>Review carefully:</strong> this unit is unknown or low confidence.</p>
						}
						<h3>Classification evidence</h3><ol>
							for _, reason := range item.Classification.Reasons {
								<li>{ reason.Message }</li>
							}
						</ol>
					</article>
				}
			</fieldset>
			<button type="submit">Confirm scope</button><small>This saves an immutable reviewed scope. Analysis is a separate action on the book page.</small>
		</form>
		<script>
const scopeForm = document.querySelector('[data-scope-review]');
if (scopeForm) {
  const boxes = Array.from(scopeForm.querySelectorAll('input[name="unit_id"]'));
  const updateScopeSummary = () => {
    const selected = boxes.filter((box) => box.checked);
    const characters = selected.reduce((sum, box) => sum + Number(box.closest('[data-characters]').dataset.characters), 0);
    const tokens = selected.reduce((sum, box) => sum + Number(box.closest('[data-tokens]').dataset.tokens), 0);
    scopeForm.querySelector('[data-selected-count]').textContent = `${selected.length} ${selected.length === 1 ? 'unit' : 'units'} selected`;
    scopeForm.querySelector('[data-selected-size]').textContent = `Selected: ${characters.toLocaleString()} characters, about ${tokens.toLocaleString()} tokens`;
    scopeForm.querySelectorAll('[data-group-units]').forEach((group) => {
      const ids = new Set(group.dataset.groupUnits.split(','));
      const members = boxes.filter((box) => ids.has(box.value));
      const selected = members.filter((box) => box.checked);
      const selectedMembers = selected.length;
      const selectedCharacters = selected.reduce((sum, box) => sum + Number(box.closest('[data-characters]').dataset.characters), 0);
      const selectedTokens = selected.reduce((sum, box) => sum + Number(box.closest('[data-tokens]').dataset.tokens), 0);
      group.querySelector('[data-group-state]').textContent = selectedMembers === 0 ? 'Excluded' : selectedMembers === members.length ? 'Included' : `Partially selected (${selectedMembers} of ${members.length})`;
      group.querySelector('[data-group-selected]').textContent = `Selected: ${selectedMembers} ${selectedMembers === 1 ? 'unit' : 'units'} | ${selectedCharacters.toLocaleString()} characters | about ${selectedTokens.toLocaleString()} tokens`;
    });
  };
  scopeForm.addEventListener('change', updateScopeSummary);
  scopeForm.addEventListener('click', (event) => {
    const button = event.target.closest('[data-select]');
    if (!button) return;
    boxes.forEach((box) => {
      const unit = box.closest('[data-category]');
      box.checked = button.dataset.select === 'all' || (button.dataset.select === 'recommended' && unit.dataset.recommended === 'true') || (button.dataset.select === 'main' && unit.dataset.category === 'main_matter');
    });
    updateScopeSummary();
  });
  updateScopeSummary();
}
		</script>
	}
}

func scopeUnitChecked(selectedCSV, unitID string, recommended bool) bool { if selectedCSV == "" { return recommended }; selectedCSV = strings.TrimPrefix(selectedCSV, "submitted:"); for _, selected := range strings.Split(selectedCSV, ",") { if selected == unitID { return true } }; return false }
func titleSourceLabel(source string) string { if source == domain.UnitTitleHeading { return "title from document heading" }; return "fallback title from manifest ID" }
func categoryLabel(category domain.EPUBUnitCategory) string { return strings.ReplaceAll(string(category), "_", " ") }
func recommendationLabel(classification domain.EPUBUnitClassification) string {
	if classification.RecommendedInclusion && classification.Confidence < domain.EPUBConfidenceHighMinimum { return "Include — review suggested" }
	if classification.RecommendedInclusion { return "Include" }
	if classification.Category == domain.EPUBCategoryUnknown { return "Exclude — review required" }
	return "Exclude"
}
func recommendationExplanation(classification domain.EPUBUnitClassification) string {
	if classification.RecommendedInclusion && classification.Confidence < domain.EPUBConfidenceHighMinimum { return "Included as plausible main matter; review is suggested because the structural evidence is not high confidence." }
	if classification.RecommendedInclusion { return "Included because high-confidence structural evidence identifies main matter." }
	if classification.Category == domain.EPUBCategoryUnknown && hasReferenceLikeEvidence(classification.Reasons) { return "Excluded because reference-like evidence does not make an unknown unit safe for automatic inclusion; review it before adding it." }
	if classification.Category == domain.EPUBCategoryUnknown { return "Excluded because unknown structural evidence is not safe for automatic inclusion; review it before adding it." }
	return "Excluded because the structural category is outside the recommended main-matter scope."
}
func hasReferenceLikeEvidence(reasons []domain.EPUBClassificationReason) bool { for _, reason := range reasons { value := strings.ToLower(reason.Signal+" "+reason.Message); if strings.Contains(value, "reference") || strings.Contains(value, "citation") || strings.Contains(value, "bibliograph") || strings.Contains(value, "index") || strings.Contains(value, "register") || strings.Contains(value, "quellen") || strings.Contains(value, "literatur") { return true } }; return false }
func scopeReviewURL(book domain.SourceMaterialSummary) string { if book.ReviewedScopeID == "" { return "/books/"+book.Source.ID+"/scope" }; return "/books/"+book.Source.ID+"/scope?preset=prior&prior_scope_id="+url.QueryEscape(book.ReviewedScopeID) }
func scopePresetURL(review epubScopeView, preset string) string { value := "/books/"+review.Book.ID+"/scope?preset="+url.QueryEscape(preset); if review.PriorScope != nil { value += "&prior_scope_id="+url.QueryEscape(review.PriorScope.ScopeID) }; return value }

func knownCoveragePercent(coverage domain.AnalysisCoverage) float64 {
	if coverage.AnalyzableTokenCount == 0 {
		return 0
	}
	return min(float64(coverage.KnownTokenCount)*100/float64(coverage.AnalyzableTokenCount), 100)
}

func activeCampaignCoveragePercent(coverage domain.AnalysisCoverage) float64 {
	if coverage.AnalyzableTokenCount == 0 { return 0 }
	return min(float64(coverage.KnownTokenCount+coverage.ActiveCampaignTokenCount)*100/float64(coverage.AnalyzableTokenCount), 100)
}

func concentrationPercent(projection domain.CoverageProjection) float64 {
	if projection.EligibleTokenCount == 0 {
		return 0
	}
	return float64(projection.OccurrenceCount) * 100 / float64(projection.EligibleTokenCount)
}

func projectedCoveragePercent(projection domain.CoverageProjection, analyzableTokens int64) float64 {
	if analyzableTokens == 0 {
		return 0
	}
	return min(float64(projection.ProjectedTokenCount)*100/float64(analyzableTokens), 100)
}

func longSentencePercent(profile domain.TextProfile) float64 {
	if profile.SentenceCount == 0 {
		return 0
	}
	return float64(profile.LongSentenceCount) * 100 / float64(profile.SentenceCount)
}

func hasAnalysisWarnings(coverage domain.AnalysisCoverage) bool {
	if coverage.TextProfile == nil {
		return false
	}
	return coverage.TextProfile.SentenceCount == 0 ||
		coverage.TextProfile.EmptySentenceCount > 0 ||
		(coverage.TextProfile.NormalizedTokenCount > 0 && coverage.AnalyzableTokenCount == 0)
}

func corpusUnitLabel(unit domain.CorpusSelectedUnit) string {
	if strings.TrimSpace(unit.Title) != "" {
		return unit.Title
	}
	if strings.TrimSpace(unit.SourceHref) != "" {
		return unit.SourceHref
	}
	return unit.UnitID
}

templ LoginPage(csrf, message, next string, onboarding bool) {
	@Layout("Sign in", nil, csrf) { <article class="narrow">
	if onboarding {
		<h1>Create your account</h1><p>Set up the first learner account for this Mouseion installation.</p>
	} else {
		<h1>Sign in</h1>
	}
	if message != "" {
		<p role="alert">{ message }</p>
	}
	if onboarding {
		<form method="post" action="/onboarding"><input type="hidden" name="csrf_token" value={ csrf }/><label>Username<input name="username" required autocomplete="username"/></label><label>Password<input type="password" name="password" minlength="8" required autocomplete="new-password"/></label><button>Create account</button></form>
	} else {
		<form method="post" action="/login"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="next" value={ next }/><label>Username<input name="username" required autocomplete="username"/></label><label>Password<input type="password" name="password" required autocomplete="current-password"/></label><button>Sign in</button></form>
	}
	</article> }
}
templ Dashboard(user domain.User, csrf string, profiles []domain.LanguageProfile, connections []domain.OpdsConnection, jobs []domain.AnalysisJob) {
	@Layout("Dashboard", &user, csrf) { <h1>Welcome, { user.Username }</h1><div class="grid"><article><h2>Study languages</h2><p>{ fmt.Sprintf("%d configured", len(profiles)) }</p><a href="/languages">Configure</a></article><article><h2>My OPDS catalogs</h2><p>{ fmt.Sprintf("%d connected", len(connections)) }</p><a href="/connections">Manage catalogs</a></article><article><h2>Analysis</h2><p>{ fmt.Sprintf("%d recent jobs", len(jobs)) }</p><a href="/jobs">View jobs</a></article></div> }
}
templ SettingsPage(user domain.User, csrf string, supported []domain.SupportedLanguage, profiles []domain.LanguageProfile, degraded bool, language string, result *knownvocab.ImportResult, known []domain.KnownVocabulary, message string) {
	@Layout("Settings", &user, csrf) { <h1>Account settings</h1><p>Choose the languages you study and optionally import words you already know for each one.</p>
	if message != "" {
		<p role="status">{ message }</p>
	}
	<article><h2>Study languages</h2>
		if degraded {
			<p role="alert">NLP language discovery is temporarily unavailable. Your saved study languages are unchanged.</p>
		}
		if len(supported) == 0 {
			if !degraded {
				<p>No analysis languages are currently ready.</p>
			}
		}
		if len(supported) > 0 {
			<form method="post" action="/settings/languages"><input type="hidden" name="csrf_token" value={ csrf }/><label>Add a supported language<select name="language" required><option value="">Choose a language</option>
			for _, candidate := range supported {
				<option value={ candidate.Language }>{ candidate.DisplayName } ({ candidate.Language })</option>
			}
			</select></label><button>Add study language</button></form>
		}
	</article>
	if len(profiles) == 0 {
		<article><p>Select at least one study language to manage known vocabulary.</p></article>
	}
	for _, profile := range profiles {
		<article><header class="page-heading"><div><h2>{ profile.DisplayName } <code>{ profile.Language }</code></h2><p>Known vocabulary is private to your account and used to filter generated decks.</p></div><form method="post" action="/settings/languages/remove"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="language" value={ profile.Language }/><button class="outline secondary">Remove</button></form></header>
		<form method="post" action="/known-vocab/import" enctype="multipart/form-data"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="return_to" value="settings"/><input type="hidden" name="language" value={ profile.Language }/><label>UTF-8 lemma file<input type="file" name="vocabulary_file" accept="text/plain,.txt" required/></label><small>One lemma per nonblank line. Tab-separated columns are rejected.</small><button>Import known words</button></form>
		if language == profile.Language {
			<section>@KnownVocabResult(language, result, known, "")</section>
		}
		</article>
	}
	}
}
templ ConnectionsPage(user domain.User, csrf string, connections []domain.OpdsConnection, message string) {
	@Layout("Add books", &user, csrf) { <h1>Add books</h1>
	<p>Configure your OPDS catalogs, then browse them to add EPUB books to My Library. Credentials are encrypted at rest and private to your account.</p>
	if message != "" {
		<p role="status">{ message }</p>
	}
	<article><h2>Add catalog</h2><form method="post" action="/connections"><input type="hidden" name="csrf_token" value={ csrf }/><div class="grid"><label>Name<input name="name" required/></label><label>Catalog URL<input type="url" name="url" required placeholder="https://example.com/opds"/></label></div><div class="grid"><label>Username <small>(optional)</small><input name="username" autocomplete="username"/></label><label>Password <small>(optional, encrypted at rest)</small><input type="password" name="password" autocomplete="new-password"/></label></div><button>Add catalog</button></form></article>
	if len(connections) == 0 {
		<p>No catalog connection configured yet.</p>
	}
	<div class="catalog-list">
	for _, c := range connections {
		<article><header><strong>{ c.Name }</strong></header><p class="break">{ c.URL }</p><p>{ credentialSummary(c) }</p><a role="button" href={ templ.URL("/catalog?connection="+c.ID) }>Browse catalog</a><details><summary>Edit connection</summary><form method="post" action={ templ.SafeURL("/connections/"+c.ID) }><input type="hidden" name="csrf_token" value={ csrf }/><div class="grid"><label>Name<input name="name" value={ c.Name } required/></label><label>Catalog URL<input type="url" name="url" value={ c.URL } required/></label></div><div class="grid"><label>Username<input name="username" value={ c.Username } autocomplete="username"/></label><label>New password <small>(leave blank to keep current)</small><input type="password" name="password" autocomplete="new-password"/></label></div><button class="outline">Save changes</button></form></details><form class="inline right" method="post" action={ templ.SafeURL("/connections/"+c.ID+"/delete") } onsubmit="return confirm('Delete this catalog connection?')"><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Delete</button></form></article>
	}
	</div> }
}
templ CatalogPage(user domain.User, csrf string, connection domain.OpdsConnection, languages []domain.SupportedLanguage, degraded bool) {
	@Layout(connection.Name, &user, csrf) { <p><a href="/connections">← Catalog connections</a></p><header class="page-heading"><div><h1>{ connection.Name }</h1><p>Browse collections or search for a book to import and analyze.</p></div></header>
	if degraded {
		<p role="alert">NLP language discovery is temporarily unavailable. Catalog browsing and import are paused.</p>
	} else if len(languages) > 0 {
		<form hx-get="/opds/language" hx-target="#catalog-results" hx-swap="innerHTML"><input type="hidden" name="connection" value={ connection.ID }/><label>Browse EPUBs by language<select name="language" required><option value="">Choose a language</option>
		for _, language := range languages {
			<option value={ language.Language }>{ language.DisplayName }</option>
		}</select></label><button type="submit">Browse language</button></form>
	} else {
		<p><small>No analysis languages are currently ready.</small></p>
	}
	<div id="catalog-results"></div> }
}
templ CatalogRootFragment(connectionID, language string, feed opds.Feed) {
	<section>
	if opds.SupportsSearch(feed) {
		<form role="search" hx-get="/opds/search" hx-target="#catalog-results" hx-swap="innerHTML"><input type="hidden" name="connection" value={ connectionID }/><input type="hidden" name="language" value={ language }/><label>Search this catalog<input type="search" name="q" placeholder="Title or author" required/></label><button type="submit">Search</button></form>
	} else {
		<p><small>Search is not available for this catalog.</small></p>
	}
	</section>
}
templ FeedFragment(csrf, connectionID, language, returnTo, message string, feed opds.Feed, trail []CatalogCrumb) {
	<section>
	if message != "" {
		@CatalogNotice(message)
	}
	<nav aria-label="Catalog breadcrumb"><a hx-get={ browseURLForLanguage(connectionID, language, "", nil) } hx-target="#catalog-results" hx-swap="innerHTML" href={ templ.URL(browseURLForLanguage(connectionID, language, "", nil)) }>Catalog root</a>
	for i, crumb := range trail {
		<span> / </span>
		if i < len(trail)-1 {
			<a hx-get={ browseURLForLanguage(connectionID, language, crumb.URL, trail[:i]) } hx-target="#catalog-results" hx-swap="innerHTML" href={ templ.URL(browseURLForLanguage(connectionID, language, crumb.URL, trail[:i])) }>{ crumb.Title }</a>
		} else {
			<span aria-current="page">{ crumb.Title }</span>
		}
	}
	</nav><h2>{ feed.Title }</h2>
	if len(feed.Entries) == 0 {
		<article><p>No books or collections were found here.</p></article>
	}
	<div class="catalog-grid">
	for _, entry := range feed.Entries {
		@EntryCard(csrf, connectionID, language, returnTo, entry, trail)
	}
	</div></section>
}
templ SearchResults(csrf, connectionID, language, returnTo, message, query string, feed opds.Feed) {
	<section>
	if message != "" {
		@CatalogNotice(message)
	}
	<button class="outline" hx-get={ browseURLForLanguage(connectionID, language, "", nil) } hx-target="#catalog-results" hx-swap="innerHTML">← Back to catalog</button><h2>Results for “{ query }”</h2>
	if len(feed.Entries) == 0 {
		<article><p>No matching books were found. Try another title or author.</p></article>
	}
	<div class="catalog-grid">
	for _, entry := range feed.Entries {
		@EntryCard(csrf, connectionID, language, returnTo, entry, nil)
	}
	</div></section>
}
templ LanguageResults(csrf, connectionID, language, returnTo, message string, feed opds.Feed) {
	<section>
	if message != "" {
		@CatalogNotice(message)
	}
	<h2>{ feed.Title }</h2><p><small>Showing EPUB editions only.</small></p>
	if len(feed.Entries) == 0 {
		<article><p>No EPUB books were found for this language.</p></article>
	}
	<div class="catalog-grid">
	for _, entry := range feed.Entries {
		@EntryCardForLanguage(csrf, connectionID, language, returnTo, entry)
	}
	</div></section>
}
templ EntryCardForLanguage(csrf, connectionID, language, returnTo string, entry opds.Entry) {
	<article><h3>{ entry.Title }</h3>
	if epubLink := acquisitionLink(entry); epubLink != nil {
		@AcquisitionForm(csrf, connectionID, language, returnTo, entry, epubLink.Href)
	}
	</article>
}
templ CatalogNotice(message string) { <article role="status"><p>{ message }</p></article> }
templ EntryCard(csrf, connectionID, language, returnTo string, entry opds.Entry, trail []CatalogCrumb) {
	<article><h3>{ entry.Title }</h3>
	if href := navigationLink(entry); href != "" {
		<a role="button" class="outline" href={ templ.URL(browseURLForLanguage(connectionID, language, href, trail)) } hx-get={ browseURLForLanguage(connectionID, language, href, trail) } hx-target="#catalog-results" hx-swap="innerHTML">Open collection</a>
	}
	if epubLink := acquisitionLink(entry); epubLink != nil {
		@AcquisitionForm(csrf, connectionID, language, returnTo, entry, epubLink.Href)
	}
	if navigationLink(entry) == "" && acquisitionLink(entry) == nil {
		<p><small>No compatible EPUB is available for this entry.</small></p>
	}
	</article>
}
templ AcquisitionForm(csrf, connectionID, language, returnTo string, entry opds.Entry, href string) {
	<form method="post" action="/opds/acquire" data-acquire hx-post="/opds/acquire" hx-target="closest article" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="connection" value={ connectionID }/>
	if language != "" {
		<input type="hidden" name="language" value={ language }/>
	}
	<input type="hidden" name="entry_id" value={ entry.ID }/><input type="hidden" name="title" value={ entry.Title }/><input type="hidden" name="href" value={ href }/>
	if returnTo != "" {
		<input type="hidden" name="return_to" value={ returnTo }/>
	}
	<button type="submit">Add to library</button><small>Downloads and validates the EPUB for later scope review. Analysis starts separately.</small></form>
}
templ AcquisitionSuccessCard(entry opds.Entry, sourceID string, alreadyPresent bool) {
	<article><h3>{ entry.Title }</h3>
	if alreadyPresent {
		<p role="status">Already in My Library.</p>
	} else {
		<p role="status">Added to My Library.</p>
	}
	<p><a href={ templ.SafeURL("/books/"+sourceID+"/scope") }>Review scope</a> when you are ready.</p></article>
}
templ AcquisitionFailureCard(csrf, connectionID, language, returnTo, message string, entry opds.Entry, href string) {
	<article><h3>{ entry.Title }</h3><p role="alert">{ message }</p>@AcquisitionForm(csrf, connectionID, language, returnTo, entry, href)</article>
}
templ JobsPage(user domain.User, csrf string, jobs []domain.AnalysisJob, message string) {
	@Layout("Jobs", &user, csrf) { <h1>Analysis jobs</h1>
	if message != "" {
		<p>{ message }</p>
	}
	if len(jobs) == 0 {
		<p>No books have been submitted.</p>
	}
	if len(jobs) > 0 {
	<table><thead><tr><th>Job</th><th>Progress</th><th>Created</th><th>Error</th></tr></thead><tbody>
	for _, job := range jobs {
		<tr><td><a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", job.ID)) }>{ fmt.Sprintf("#%d", job.DisplayNumber) }</a></td><td><progress value={ fmt.Sprintf("%d",job.Progress) } max="100"></progress> { fmt.Sprintf("%d%%",job.Progress) }</td><td>{ job.CreatedAt.Format("2006-01-02 15:04") }</td><td>{ job.Error }</td></tr>
	}
	</tbody></table>
	} }
}
templ JobPage(user domain.User, csrf string, status analysis.Status) {
	@Layout(fmt.Sprintf("Job #%d", status.DisplayNumber), &user, csrf) { <h1>{ fmt.Sprintf("Analysis job #%d", status.DisplayNumber) }</h1><div id="job-status">@JobStatus(csrf, status)</div> }
}
templ JobStatus(csrf string, status analysis.Status) {
	<article
		if jobRunning(status) {
			hx-get={ fmt.Sprintf("/jobs/%d/status", status.ID) }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
		id="job-status"><h2>{ jobState(status) }</h2><p role="status" aria-live="polite">{ analysisStatusSummary(status) }</p><progress value={ fmt.Sprintf("%d", status.Progress) } max="100"></progress>
		if status.Error != "" {
			<p role="alert"><strong>Action needed:</strong> { status.Error }</p>
		}
		if jobRetryable(status) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/retry", status.ID)) }><input type="hidden" name="csrf_token" value={ csrf }/><button>Retry analysis</button></form>
		}
		if jobRunning(status) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/cancel", status.ID)) }><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Cancel analysis</button></form>
		}
		if status.CorpusID != "" {
			if status.ScopeID != "" && status.LogicalState == "completed" {
				<p>Analysis complete. Prepare a deck from this immutable analysis result.</p>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/deck/preparations", status.ID)) } data-prepare-deck><input type="hidden" name="csrf_token" value={ csrf }/><label><input type="checkbox" name="external_translation_consent"/> Send each selected lemma and example sentence to the configured translation provider</label><small>Preparation runs in the background. You can download the completed deck when it is ready.</small><button type="submit">Prepare deck</button></form><section data-deck-preparation role="status" aria-live="polite" aria-atomic="true" hidden></section>
			} else {
				<p>Analysis complete. Legacy/full-text results cannot unlock a new deck preparation.</p>
			}
		}
	</article>
}
templ KnownVocabPage(user domain.User, csrf string, profiles []domain.LanguageProfile, language string, known []domain.KnownVocabulary) {
	@KnownVocabPageWithResult(user, csrf, profiles, language, nil, known, "")
}
templ KnownVocabPageWithResult(user domain.User, csrf string, profiles []domain.LanguageProfile, language string, result *knownvocab.ImportResult, known []domain.KnownVocabulary, message string) {
	@Layout("Known vocabulary", &user, csrf) { <h1>Known vocabulary</h1><p>Import words you already know so pre-learning decks focus on new vocabulary.</p>
	<article><form method="post" action="/known-vocab/import" enctype="multipart/form-data" hx-post="/known-vocab/import" hx-target="#known-vocab-results" hx-swap="innerHTML"><input type="hidden" name="csrf_token" value={ csrf }/><label>Language code<input name="language" value={ language } list="study-languages" placeholder="de" required/></label><datalist id="study-languages">
	for _, profile := range profiles {
		<option value={ profile.Language }>{ profile.DisplayName }</option>
	}
	</datalist><label>UTF-8 lemma file<input type="file" name="vocabulary_file" accept="text/plain,.txt" required/></label><small>One lemma per nonblank line. Tab-separated columns are rejected.</small><button>Import known words</button></form></article><section id="known-vocab-results">@KnownVocabResult(language, result, known, message)</section> }
}
templ KnownVocabResult(language string, result *knownvocab.ImportResult, known []domain.KnownVocabulary, message string) {
	if message != "" {
		<p role="alert">{ message }</p>
	}
	if result != nil {
		<article><h2>Import result</h2><p role="status"><strong>{ fmt.Sprintf("%d imported", result.Imported) }</strong> · { fmt.Sprintf("%d already known", result.AlreadyKnown) } · { fmt.Sprintf("%d rejected", len(result.Rejected)) }</p>
		if len(result.Rejected) > 0 {
			<h3>Rejected rows</h3><table><thead><tr><th>Row</th><th>Original</th><th>Reason</th></tr></thead><tbody>
			for _, rejection := range result.Rejected {
				<tr><td>{ fmt.Sprintf("%d", rejection.Row) }</td><td><code>{ rejection.Original }</code></td><td>{ rejection.Error }</td></tr>
			}
			</tbody></table>
		}
		</article>
	}
	<h2>Previously imported
	if language != "" {
		<small> · { language }</small>
	}
	</h2>
	if language == "" {
		<p>Choose a language to view known vocabulary.</p>
	} else if len(known) == 0 {
		<p>No known vocabulary imported for this language yet.</p>
	} else {
		<table><thead><tr><th>Lemma</th><th>Part of speech</th><th>Imported</th></tr></thead><tbody>
		for _, entry := range known {
			<tr><td>{ lemmadisplay.Format(entry.Language, entry.CanonicalLemma, entry.UPOS) }</td><td>{ knownVocabUPOS(entry.UPOS) }</td><td>{ entry.CreatedAt.Format("2006-01-02") }</td></tr>
		}
		</tbody></table>
	}
}
templ KnownVocabImportStatus(status knownvocab.Status) {
	if status.State != "completed" && status.State != "discarded" && status.State != "cancelled" {
		<article id="known-vocab-import-status" hx-get={ fmt.Sprintf("/known-vocab/imports/%d/status", status.ID) } hx-trigger="load delay:500ms" hx-swap="outerHTML">@knownVocabImportStatusBody(status)</article>
	} else {
		<article id="known-vocab-import-status">@knownVocabImportStatusBody(status)</article>
	}
}
templ EnrichmentJobStatus(status enrichmentjob.Status, csrf string) {
	<article id="enrichment-job-status"
		if status.State != "completed" && status.State != "cancelled" && status.State != "discarded" {
			hx-get={ fmt.Sprintf("/enrichment-jobs/%d/status", status.ID) }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}>
		<h3>Contextual translations</h3><p role="status"><strong>{ enrichmentJobLabel(string(status.State)) }</strong> · { fmt.Sprintf("%d of %d completed · attempt %d", status.Completed, status.Total, status.Attempt) }</p>
		if status.Total > 0 {
			<progress value={ fmt.Sprintf("%d", status.Completed) } max={ fmt.Sprintf("%d", status.Total) }></progress>
		}
		if status.Error != "" {
			<p role="alert">Latest error: { status.Error }</p>
		}
		if status.State != "completed" && status.State != "cancelled" && status.State != "discarded" {
			<form hx-post={ fmt.Sprintf("/enrichment-jobs/%d/cancel", status.ID) } hx-target="#enrichment-job-status" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Cancel translations</button></form>
		}
	</article>
}
templ knownVocabImportStatusBody(status knownvocab.Status) {
		<h2>Import status</h2>
		<p role="status"><strong>{ knownVocabJobLabel(string(status.State)) }</strong>
		if status.Total > 0 {
			<span> · { fmt.Sprintf("%d of %d rows processed", status.Processed, status.Total) }</span>
		}
		</p>
		if status.State == "completed" {
			<p><strong>{ fmt.Sprintf("%d imported", status.Imported) }</strong> · { fmt.Sprintf("%d already known", status.AlreadyKnown) } · { fmt.Sprintf("%d rejected", len(status.Rejected)) }</p>
			if len(status.Rejected) > 0 {
				<h3>Rejected rows</h3><table><thead><tr><th>Row</th><th>Original</th><th>Reason</th></tr></thead><tbody>
				for _, rejection := range status.Rejected {
					<tr><td>{ fmt.Sprintf("%d", rejection.Row) }</td><td><code>{ rejection.Original }</code></td><td>{ rejection.Error }</td></tr>
				}
				</tbody></table>
			}
			<p><a href={ templ.SafeURL("/known-vocab?language="+status.Language) }>View imported vocabulary</a></p>
		}
		if status.Error != "" {
			<p role="alert">Import failed: { status.Error }</p>
		}
}
