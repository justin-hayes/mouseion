package webapp

import (
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/justin-hayes/mouseion/internal/analysis"
	"github.com/justin-hayes/mouseion/internal/cataloguesync"
	"github.com/justin-hayes/mouseion/internal/domain"
	"github.com/justin-hayes/mouseion/internal/enrichmentjob"
	"github.com/justin-hayes/mouseion/internal/knownvocab"
)

templ Layout(title string, user *domain.User, csrf string) {
	@ShellLayout(title, user, csrf, navigationContextForTitle(title))
}

templ ShellLayout(title string, user *domain.User, csrf string, context NavigationContext, shellStyles ...shellStyle) {
	<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{ title } · Mouseion</title>
	<link rel="preload" href="/static/vendor/fonts/commissioner-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin/><link rel="stylesheet" href="/static/app.css"/><script src="/static/vendor/htmx-4.0.0.min.js" defer></script><script src="/static/my-books.js" defer></script><script>
window.escapeHtml = function (s) {
  return String(s).replace(/[&<>"']/g, function (c) {
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
};
document.addEventListener('submit', function (evt) {
  var form = evt.target.closest && evt.target.closest('form[data-acquire]');
  if (!form) return;
  var button = form.querySelector('button[type="submit"]');
  if (button) { button.disabled = true; button.setAttribute('aria-busy', 'true'); button.textContent = 'Adding to My Books…'; }
});
document.addEventListener('submit', async function (evt) {
  var form = evt.target.closest && evt.target.closest('form[data-prepare-deck]');
  if (!form) return;
  evt.preventDefault();
  var button = form.querySelector('button[type="submit"]');
  var status = form.parentElement.querySelector('[data-deck-preparation]');
  if (button) { button.disabled = true; button.setAttribute('aria-busy', 'true'); button.textContent = 'Preparing deck…'; }
  try {
    var response = await fetch(form.action, {method: 'POST', body: new FormData(form), credentials: 'same-origin', headers: {'Accept': 'application/json'}});
    if (!response.ok) {
      var detail = (await response.text()).trim();
      throw new Error(detail || ('Request failed with status ' + response.status));
    }
    form.hidden = true;
    status.hidden = false;
    await window.pollDeckPreparation(response.url, status, form);
  } catch (error) {
    status.hidden = false;
    status.innerHTML = '<p role="alert">Deck preparation could not start: ' + window.escapeHtml(error && error.message ? error.message : 'Please try again.') + '</p>';
    if (button) { button.disabled = false; button.removeAttribute('aria-busy'); button.textContent = 'Prepare deck'; }
  }
});
window.pollDeckPreparation = async function (statusURL, target, sourceForm) {
  try {
    var response = await fetch(statusURL, {credentials: 'same-origin', headers: {'Accept': 'application/json'}});
    if (!response.ok) throw new Error((await response.text()).trim() || ('Request failed with status ' + response.status));
    var preparation = await response.json();
    var stateLabels = {queued: 'Deck queued', preparing: 'Preparing deck', ready: 'Deck ready', failed: 'Deck preparation failed', cancelled: 'Deck preparation cancelled'};
    var phaseLabels = {queued: 'Waiting to start', freezing: 'Freezing the selected vocabulary', submitting: 'Submitting translation requests', waiting: 'Waiting for Batch translation; it can take hours (up to 24h)', reconciling: 'Reconciling translation results', retrying: 'Retrying temporary translation failures', translating: 'Translating selected vocabulary', assembling: 'Assembling the Anki package', finalizing: 'Finalizing the Anki package', completed: 'Preparation complete', failed: 'Preparation failed', cancelled: 'Preparation cancelled'};
    var active = preparation.state === 'queued' || preparation.state === 'preparing';
    var html = '<h3>' + window.escapeHtml(stateLabels[preparation.state] || 'Deck preparation') + '</h3>';
    if (active) {
      html += '<p aria-busy="true">' + window.escapeHtml(phaseLabels[preparation.phase] || (preparation.state === 'queued' ? 'Waiting for preparation to begin' : 'Preparing the deck')) + '…</p>';
      var t = preparation.translation || {};
      if (Number(t.eligible || 0) > 0) html += 'Translations: ' + Number(t.completed || 0) + ' complete · ' + Number(t.failed || 0) + ' unavailable · ' + Number(t.retrying || 0) + ' retrying · ' + Number(t.pending || 0) + ' waiting.';
      var b = preparation.batch || {};
      if (Number(b.requests || 0) > 0) html += 'Batch requests: ' + Number(b.completed || 0) + ' complete · ' + Number(b.failed || 0) + ' failed · ' + Number(b.expired || 0) + ' expired' + (Number(b.age_seconds || 0) > 0 ? ' · running for ' + Math.floor(Number(b.age_seconds || 0) / 3600) + 'h' : '') + '.';
    }
    html += '<progress aria-label="Deck preparation progress" value="' + Number(preparation.progress || 0) + '" max="100">' + Number(preparation.progress || 0) + '%</progress>';
    if (preparation.deck_name) html += '<p><strong>Deck:</strong> <code>' + window.escapeHtml(preparation.deck_name) + '</code><br/><strong>Filename:</strong> <code>' + window.escapeHtml(preparation.filename) + '</code></p>';
    if (preparation.ready) {
      var readyResponse = await fetch(statusURL, {credentials: 'same-origin', headers: {'Accept': 'text/html', 'HX-Request-Type': 'partial'}});
      if (!readyResponse.ok) throw new Error((await readyResponse.text()).trim() || ('Request failed with status ' + readyResponse.status));
      target.outerHTML = await readyResponse.text(); return;
    } else if (active) {
      html += '<button type="button" class="button button--outline" data-cancel-preparation>Cancel preparation</button>';
    } else {
      if (preparation.error) html += '<p role="alert">' + window.escapeHtml(preparation.error) + '</p>';
      html += '<button type="button" class="button" data-retry-preparation>Retry preparation</button>';
    }
    target.innerHTML = html;
    var cancel = target.querySelector('[data-cancel-preparation]');
    if (cancel) cancel.addEventListener('click', function () { window.updateDeckPreparation(statusURL.replace(/\/status$/, '/cancel'), target, sourceForm, cancel); });
    var retry = target.querySelector('[data-retry-preparation]');
    if (retry) retry.addEventListener('click', function () { window.updateDeckPreparation(statusURL.replace(/\/status$/, '/retry'), target, sourceForm, retry); });
    if (active) setTimeout(function () { window.pollDeckPreparation(statusURL, target, sourceForm); }, 1500);
  } catch (error) {
    target.innerHTML = '<p role="alert">Could not check deck preparation: ' + window.escapeHtml(error && error.message ? error.message : 'Please try again.') + '</p><button type="button" class="button button--outline" data-check-preparation>Try again</button>';
    target.querySelector('[data-check-preparation]').addEventListener('click', function () { window.pollDeckPreparation(statusURL, target, sourceForm); });
  }
};
window.updateDeckPreparation = async function (action, target, sourceForm, actionButton) {
  var data = new FormData();
  data.set('csrf_token', sourceForm.querySelector('[name="csrf_token"]').value);
  var actionLabel = /\/cancel$/.test(action) ? 'Canceling deck preparation…' : 'Retrying deck preparation…';
  var originalLabel = actionButton ? actionButton.textContent : '';
  if (actionButton) {
    actionButton.disabled = true;
    actionButton.setAttribute('aria-busy', 'true');
    actionButton.textContent = actionLabel;
  }
  target.setAttribute('aria-busy', 'true');
  var pendingStatus = document.createElement('p');
  pendingStatus.setAttribute('role', 'status');
  pendingStatus.setAttribute('data-deck-action-pending', '');
  pendingStatus.textContent = actionLabel;
  target.insertBefore(pendingStatus, target.firstChild);
  try {
    var response = await fetch(action, {method: 'POST', body: data, credentials: 'same-origin', headers: {'Accept': 'application/json'}});
    if (!response.ok) throw new Error((await response.text()).trim() || ('Request failed with status ' + response.status));
    target.removeAttribute('aria-busy');
    await window.pollDeckPreparation(action.replace(/\/(cancel|retry)$/, '/status'), target, sourceForm);
  } catch (error) {
    target.removeAttribute('aria-busy');
    var pendingMessage = target.querySelector('[data-deck-action-pending]');
    if (pendingMessage) pendingMessage.remove();
    if (actionButton) {
      actionButton.disabled = false;
      actionButton.removeAttribute('aria-busy');
      actionButton.textContent = originalLabel;
    }
    target.insertAdjacentHTML('beforeend', '<p role="alert">Deck action failed: ' + window.escapeHtml(error && error.message ? error.message : 'Please try again.') + '</p>');
  }
};
window.showConcordanceNetworkRecovery = function (ctx) {
  if (!ctx || !ctx.sourceElement || !ctx.sourceElement.closest('#concordance-workflow') || ctx.response) return;
  var recovery = document.getElementById('concordance-recovery');
  if (!recovery) return;
  recovery.replaceChildren();
  var message = document.createElement('p');
  message.setAttribute('role', 'alert');
  message.textContent = 'Concordance received no response because the connection failed or the browser-side request timed out. Your current results and URL are unchanged. Retry the attempted search.';
  var retry = document.createElement('a');
  retry.href = ctx.request.action; retry.className = 'button button--outline';
  retry.textContent = 'Retry Concordance lookup';
  recovery.append(message, retry);
};
window.showVocabularyNetworkRecovery = function (ctx) {
  if (!ctx || !ctx.sourceElement || !ctx.sourceElement.closest('#vocabulary-workflow') || ctx.response) return;
  var recovery = document.getElementById('vocabulary-recovery');
  if (!recovery) return;
  recovery.replaceChildren();
  var message = document.createElement('p');
  message.setAttribute('role', 'alert');
  message.textContent = 'Browse received no response. The previous results and URL are unchanged. Retry the attempted search.';
  var retry = document.createElement('a');
  retry.href = ctx.request.action;
  retry.textContent = 'Retry Browse';
  recovery.append(message, retry);
};
document.addEventListener('htmx:after:swap', function (evt) {
  var ctx = evt.detail && evt.detail.ctx;
  if (!ctx || !ctx.target || ctx.target.id !== 'vocabulary-browse-results') return;
  var summary = document.getElementById('vocabulary-results-heading');
  if (summary) {
    summary.focus();
    var clicked = ctx.sourceEvent && ctx.sourceEvent.target;
    if (clicked && clicked.closest && clicked.closest('nav[aria-label="Browse pages"]')) {
      summary.scrollIntoView({block: 'start'});
    }
  }
});
document.addEventListener('htmx:after:history:restore', function () {
  if (window.location.pathname !== '/vocabulary') return;
  var summary = document.getElementById('vocabulary-results-heading');
  if (summary) summary.focus();
});
document.addEventListener('htmx:after:swap', function (evt) {
  var ctx = evt.detail && evt.detail.ctx;
  if (!ctx || !ctx.target || (ctx.target.id !== 'concordance-workflow' && ctx.target.id !== 'concordance-results')) return;
  var summary = document.getElementById('concordance-summary');
  if (summary) summary.focus();
});
document.addEventListener('htmx:after:history:restore', function () {
  if (!window.location.pathname.startsWith('/vocabulary/concordance')) return;
  var summary = document.getElementById('concordance-summary');
  if (summary) summary.focus();
});
function focusConcordanceSummaryForMissingReturnTarget() {
  if (!window.location.pathname.startsWith('/vocabulary/concordance')) return;
  var target = new URLSearchParams(window.location.search).get('focus');
  if (!target || document.getElementById(target)) return;
  var summary = document.getElementById('concordance-summary');
  if (summary) summary.focus();
}
document.addEventListener('DOMContentLoaded', focusConcordanceSummaryForMissingReturnTarget);
window.addEventListener('pageshow', focusConcordanceSummaryForMissingReturnTarget);
document.addEventListener('htmx:after:swap', function (evt) {
			['provisional-journey-list', 'provisional-journey-content', 'primary-goal-section', 'library-results'].forEach(function (id) {
			var region = document.getElementById(id);
			if (!region) return;
			var focusID = region.getAttribute('data-focus-id');
			if (!focusID) return;
			var ctx = evt.detail && evt.detail.ctx;
			var swappedTarget = ctx && ctx.target;
			if (id === 'provisional-journey-list' && swappedTarget && swappedTarget.id !== 'provisional-journey-content') return;
			var source = ctx && ctx.sourceElement;
			var targetSelector = source && source.getAttribute('hx-target');
			var target = targetSelector ? document.querySelector(targetSelector) : null;
			var targetsRegion = source && (source === region || source.id === id || source.getAttribute('hx-target') === '#' + id || (target && region.contains(target)) || (swappedTarget && region.contains(swappedTarget)));
			if (source && !targetsRegion && !region.contains(source) && source.getAttribute('data-focus-results') !== 'true') {
			  region.removeAttribute('data-focus-id');
			  return;
    }
    var focusTarget = document.getElementById(focusID);
    if (focusTarget) focusTarget.focus();
    region.removeAttribute('data-focus-id');
  });
});
	</script></head><body class={ shellBodyClass(shellStyles) }><a class="skip-link" href="#main-content">Skip to main content</a><header class="page-container site-header"><nav class="site-header__nav" aria-label="Primary navigation" data-navigation-context={ string(context) }><a class="site-header__brand" href="/"><strong>Mouseion</strong></a>
	if user != nil {
		<div class="site-header__tools">@ActiveStudyLanguageSwitcher(shellViewFromContext(ctx), csrf)
		<details class="site-header__account"><summary><span class="site-header__account-name">{ user.Username }</span><span class="site-header__account-compact">Account</span></summary><div class="site-header__account-panel"><p>Signed in as <strong>{ user.Username }</strong></p><form method="post" action="/logout"><input type="hidden" name="csrf_token" value={ csrf }/><button class="button button--outline button--quiet" type="submit">Log out</button></form></div></details></div>
		<ul class="site-header__navigation">
		<li><a href="/library" { destinationAttributes(context, NavigationLibrary)... }>My Books</a></li><li><a href="/reading" { destinationAttributes(context, NavigationReadingJourney)... }>Reading</a></li><li><a href="/vocabulary" { destinationAttributes(context, NavigationVocabulary)... }>Vocabulary</a></li><li><a href="/catalogs" { destinationAttributes(context, NavigationCatalogs)... }>Catalogs</a></li></ul>
	}
	</nav></header><main id="main-content" class="page-container" tabindex="-1">{ children... }</main></body></html>
}
templ LibraryPage(user domain.User, csrf string, books []domain.SourceMaterialSummary, message, goalBookID string, hasCatalogueConnections bool) {
	@MyBooksPage(user, csrf, legacyMyBooks(books), message, "", goalBookID, hasCatalogueConnections, MyBooksBrowseState{})
}

templ MyBookRow(csrf string, book domain.MyBook, refreshEligible bool, message string) {
	<li id={ myBookRowID(book.Book.ID) } class="resource-card library-book" aria-labelledby={ "book-title-" + book.Book.ID }>
		if myBookInJourney(book) {
			<a class="library-book__identity-link" href={ templ.SafeURL(readingBookURL(book.Book.ID)) }>
				@BookCoverMedia(book.Book.ID, book.Cover)
				<h2 id={ "book-title-" + book.Book.ID } class="bibliographic-title">{ book.Book.Title }</h2>
			</a>
		} else {
			<div class="library-book__identity-link">
				@BookCoverMedia(book.Book.ID, book.Cover)
				<h2 id={ "book-title-" + book.Book.ID } class="bibliographic-title">{ book.Book.Title }</h2>
			</div>
		}
		if author := strings.TrimSpace(book.Book.Author); author != "" {
			<p class="library-book__author">By { author }</p>
		}
		if myBookInJourney(book) {
			if book.WorkflowBucket() == domain.MyBookBucketCurrentReading {
				<p class="library-book__membership">Currently reading</p>
			} else {
				<p class="library-book__membership"><span aria-hidden="true">+</span> To Read</p>
			}
		}
		if book.CompletionCount > 0 {
			<p class="metadata"><strong>Reading history</strong>: { myBooksReadCountLabel(book.CompletionCount) }</p>
			<p class="metadata"><strong>Latest completion</strong>: { myBooksCompletionDateLabel(book.LatestCompletionAt) } · { myBooksCompletionSourceLabel(book.LatestCompletionSource) }</p>
		}
		<div class="library-book__actions">
			if myBookInJourney(book) {
				<a class="btn btn-outline library-book__journey-action" href={ templ.SafeURL(readingBookURL(book.Book.ID)) }><span aria-hidden="true">-&gt;</span> View in Reading</a>
			}
			if book.Disposition != "" {
				<p class="metadata"><strong>Workflow</strong>: { myBookWorkflowLabel(book) }</p>
				if myBookDisposition(book) == domain.BookDispositionInbox || myBookDisposition(book) == domain.BookDispositionSetAside {
					if book.Book.LanguageState == domain.LanguageChosen {
						<form method="post" action={ templ.SafeURL("/library/books/" + url.PathEscape(book.Book.ID) + "/to-read") }>
							<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_revision" value={ fmt.Sprint(book.DispositionRevision) }/>
							<button type="submit" class="btn btn-outline library-book__journey-action">Move to To Read</button>
						</form>
					} else {
						<p class="metadata">Choose a language in the catalog before moving this Book to To Read.</p>
					}
				}
			} else if !myBookInJourney(book) {
				<form method="post" action={ templ.SafeURL("/library/books/" + url.PathEscape(book.Book.ID) + "/to-read") }>
				<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_revision" value={ fmt.Sprint(book.DispositionRevision) }/>
					<button type="submit" class="btn btn-outline library-book__journey-action"><span aria-hidden="true">+</span> Move to To Read</button>
				</form>
			}
			<details class="more-actions">
				<summary>More actions</summary>
				<div class="more-actions__body">
					if book.CompletionCount == 0 && book.Book.LanguageState == domain.LanguageChosen && !book.IsCurrentReading {
						@Confirmation("Mark as previously read", "This records one completion from before Mouseion. It adds no snapshot or vocabulary counts and does not change Known vocabulary.", StatusNeutral) {
							<form method="post" action={ templ.SafeURL("/library/books/"+url.PathEscape(book.Book.ID)+"/previously-read") }><input type="hidden" name="csrf_token" value={ csrf }/><button type="submit" class="btn btn-outline">Confirm previously read</button></form>
						}
					}
					if book.CompletionCount > 0 && book.Book.LanguageState == domain.LanguageChosen {
						<form method="post" action={ templ.SafeURL("/library/books/"+url.PathEscape(book.Book.ID)+"/read-again") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_revision" value={ fmt.Sprint(book.DispositionRevision) }/><button type="submit" class="btn btn-outline">Read again</button></form>
					}
					if refreshEligible {
						<form method="post" action={ templ.SafeURL("/library/books/" + url.PathEscape(book.Book.ID) + "/refresh") } hx-post={ templ.SafeURL("/library/books/" + url.PathEscape(book.Book.ID) + "/refresh") } hx-target={ templ.SafeURL("#" + myBookRowID(book.Book.ID)) } hx-swap="outerHTML" data-focus-results="true">
							<input type="hidden" name="csrf_token" value={ csrf }/>
							<button type="submit" class="btn btn-outline">Refresh metadata</button>
						</form>
					}
					if book.Disposition != "" && (myBookDisposition(book) == domain.BookDispositionInbox || myBookDisposition(book) == domain.BookDispositionToRead) && !book.IsCurrentReading {
						@Confirmation("Set aside", myBookSetAsideConfirmationText(book), StatusDanger) {
							<form method="post" action={ templ.SafeURL("/library/books/" + url.PathEscape(book.Book.ID) + "/set-aside") }>
								<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_revision" value={ fmt.Sprint(book.DispositionRevision) }/>
								<button type="submit" class="btn btn-outline">Confirm set aside</button>
							</form>
						}
					}
				</div>
			</details>
		</div>
		if message != "" {
			<p class="library-book__message" role="status" aria-live="polite">{ message }</p>
		}
	</li>
}

templ NeedsLanguageBookRow(book domain.MyBook) {
	<li class="library-diagnostic-item" aria-labelledby={ "book-title-" + book.Book.ID }>
		<div>
			<h3 id={ "book-title-" + book.Book.ID } class="bibliographic-title">{ book.Book.Title }</h3>
			if author := strings.TrimSpace(book.Book.Author); author != "" {
				<p class="library-book__author">By { author }</p>
			}
			<p class="metadata">Language not assigned in the catalog</p>
		</div>
	</li>
}

templ MyBooksBrowseLink(browse MyBooksBrowseState, page int, label string, selected, focusResults bool) {
	<a class="btn btn-outline" data-my-books-enhanced data-focus-results={ boolString(focusResults) } { myBooksSelectedAttributes(selected)... } href={ templ.SafeURL(myBooksResultsURL(browse, page)) } hx-get={ myBooksResultsURL(browse, page) } hx-target="#library-results" hx-swap="outerHTML" hx-push-url="true" hx-status:5xx="target:#library-results select:#library-results swap:outerHTML push:false">{ label }</a>
}

templ MyBooksResultsError(message, retryURL string) {
	<section id="library-results" aria-labelledby="library-books-heading" data-focus-id="library-books-heading">
		<h2 id="library-books-heading" tabindex="-1">My Books could not be loaded</h2>
		<p role="alert">{ message }</p>
		<p><a class="btn btn-outline" href={ templ.SafeURL(retryURL) }>Try again</a></p>
	</section>
}

templ MyBooksFailurePage(user domain.User, csrf, message, retryURL string) {
	@ShellLayout("My Books", &user, csrf, NavigationLibrary, shellStyleMyBooks) {
		@PageHeader("My Books", "Your working collection is temporarily unavailable.", nil)
		@Feedback(FeedbackError, "My Books needs attention", message)
		<p><a class="btn btn-outline" href={ templ.SafeURL(retryURL) }>Try again</a></p>
	}
}

templ MyBooksDispositionFilters(browse MyBooksBrowseState) {
	<nav class="library-filters" aria-label="My Books filters">
		@MyBooksDispositionFilterLink(browse, "All", "", myBooksAllDispositionCount(browse))
		@MyBooksDispositionFilterLink(browse, "Inbox", domain.BookDispositionInbox, myBooksDispositionCount(browse, domain.BookDispositionInbox))
		@MyBooksDispositionFilterLink(browse, "To Read", domain.BookDispositionToRead, myBooksDispositionCount(browse, domain.BookDispositionToRead))
		@MyBooksDispositionFilterLink(browse, "Set Aside", domain.BookDispositionSetAside, myBooksDispositionCount(browse, domain.BookDispositionSetAside))
		<a class="btn btn-outline" { myBooksSelectedAttributes(browse.History)... } href={ templ.SafeURL(myBooksHistoryFilterURL(browse, true)) }>{ fmt.Sprintf("Read (%d)", browse.ReadCount) }</a>
	</nav>
}

templ MyBooksDispositionFilterLink(browse MyBooksBrowseState, label string, disposition domain.BookDisposition, count int) {
	<a class="btn btn-outline" { myBooksSelectedAttributes(browse.Disposition == disposition && !browse.History)... } href={ templ.SafeURL(myBooksDispositionURL(browse, disposition)) }>{ fmt.Sprintf("%s (%d)", label, count) }</a>
}

templ MyBooksResults(csrf string, books []domain.MyBook, browse MyBooksBrowseState) {
	<section id="library-results" aria-labelledby="library-books-heading" data-focus-id="library-books-heading">
		<h2 id="library-books-heading" tabindex="-1">{ myBooksResultsHeading(browse) }</h2>
		if browse.Total == 0 {
			<p { myBooksResultAnnouncementAttributes()... }>
				if browse.TextNoMatch && browse.NeedsLanguage {
					No books awaiting a language match “{ browse.Query }”. <a data-my-books-enhanced data-focus-results="true" href={ templ.SafeURL(myBooksFilteredURL("", 1, true, browse.Disposition)) } hx-get={ myBooksFilteredURL("", 1, true, browse.Disposition) } hx-target="#library-results" hx-swap="outerHTML" hx-push-url="true" hx-status:5xx="target:#library-results select:#library-results swap:outerHTML push:false">Clear search</a>
				} else if browse.TextNoMatch {
					if browse.History {
						No books with reading history in { myBooksLanguageName(browse) } match “{ browse.Query }”.
					} else {
						No books in your local collection in { myBooksLanguageName(browse) } match “{ browse.Query }”.
					}
					<a data-my-books-enhanced data-focus-results="true" href={ templ.SafeURL(myBooksHistoryURL("", 1, browse.NeedsLanguage, browse.Disposition, browse.History)) } hx-get={ myBooksHistoryURL("", 1, browse.NeedsLanguage, browse.Disposition, browse.History) } hx-target="#library-results" hx-swap="outerHTML" hx-push-url="true" hx-status:5xx="target:#library-results select:#library-results swap:outerHTML push:false">Clear search</a>
				} else if browse.NeedsLanguage {
					No books are awaiting a language in the local collection.
				} else if browse.History {
					No books with reading history are in this local collection.
				} else if browse.Language != "" {
					if browse.Disposition != "" {
						No { myBooksDispositionLabel(browse.Disposition) } books in your local collection are in { myBooksLanguageName(browse) }.
					} else {
						No books in your local collection are in { myBooksLanguageName(browse) }.
					}
				}
			</p>
		} else {
			<p { myBooksResultAnnouncementAttributes()... }>{ myBooksResultCount(browse.Total) }</p>
		}
		if len(books) > 0 {
			if browse.NeedsLanguage {
				<ul class="library-diagnostic-list" role="list">
					for _, book := range books {
						@NeedsLanguageBookRow(book)
					}
				</ul>
			} else {
				<ul class="library-grid" role="list">
					for _, book := range books {
						if myBooksBookInLanguage(browse, book) {
							@MyBookRow(csrf, book, browse.RefreshableBookIDs[book.Book.ID], "")
						}
					}
				</ul>
			}
		}
		if browse.PageCount > 1 {
			<nav class="library-paging" aria-label="Paging">
				if browse.Page > 1 {
					@MyBooksBrowseLink(browse, browse.Page-1, "Previous", false, true)
				}
				@MyBooksBrowseLink(browse, browse.Page, fmt.Sprintf("Page %d of %d", browse.Page, browse.PageCount), true, true)
				if browse.Page < browse.PageCount {
					@MyBooksBrowseLink(browse, browse.Page+1, "Next", false, true)
				}
			</nav>
		}
	</section>
}

templ NeedsLanguageStrip(count int) {
	<section class="library-needs-language" aria-labelledby="library-needs-language-heading">
		<h2 id="library-needs-language-heading">Books awaiting a language</h2>
		if count == 1 {
			<p>1 book is outside the active language collections because the catalog has not assigned a language.</p>
		} else {
			<p>{ fmt.Sprintf("%d books are outside the active language collections because the catalog has not assigned a language.", count) }</p>
		}
		<p>Fix the language in the catalog, then re-sync from <a href="/catalogs">Catalogs</a>.</p>
		<p><a href="/library?needs-language">Review books awaiting a language</a></p>
	</section>
}

templ MyBooksPage(user domain.User, csrf string, books []domain.MyBook, message, pageError, goalBookID string, hasCatalogueConnections bool, browse MyBooksBrowseState) {
	@ShellLayout("My Books", &user, csrf, NavigationLibrary, shellStyleMyBooks) {
		<section class="library-masthead" aria-labelledby="library-page-title">
			<header class="page-header">
				<div class="page-header__content">
					<h1 id="library-page-title">{ myBooksPageHeading(browse) }</h1>
					<p>Your working collection: literature you care about, with clear evidence for what you can do next.</p>
				</div>
			</header>
		</section>
		if message != "" {
			@Feedback(FeedbackSuccess, "", message)
		}
		if pageError != "" {
			@Feedback(FeedbackError, "My Books needs attention", pageError)
		}
		if len(books) == 0 && (!browse.Enabled || (browse.AllCount == 0 && browse.Language != "")) {
			@EmptyState("Set up a catalog connection", "Mouseion needs a catalog connection owned by your learner account before it can build My Books. Ready-language metadata will appear here.") {
				<a role="button" href="/catalogs">Set up a catalog</a>
				if hasCatalogueConnections {
					<a class="btn btn-outline" href="/catalogs">Sync catalog</a>
				}
			}
		}
		if browse.Enabled && browse.Language == "" && !browse.NeedsLanguage {
			if browse.NeedsLanguageCount > 0 {
				@NeedsLanguageStrip(browse.NeedsLanguageCount)
			} else if browse.AllCount == 0 {
				@EmptyState("Set up a catalog connection", "Mouseion needs a catalog connection owned by your learner account before it can build My Books. Ready-language metadata will appear here.") {
				<a role="button" href="/catalogs">Set up a catalog</a>
					if hasCatalogueConnections {
						<a class="btn btn-outline" href="/catalogs">Sync catalog</a>
					}
				}
			} else {
				@EmptyState("Choose a study language", "Choose a language in the shell before browsing its Books.") {}
			}
		} else if browse.Enabled && (browse.AllCount > 0 || browse.NeedsLanguage) {
			if browse.NeedsLanguageCount > 0 {
				@NeedsLanguageStrip(browse.NeedsLanguageCount)
			}
			@MyBooksDispositionFilters(browse)
			<section class="library-finder" aria-label="Find books">
				<form class="library-search" role="search" method="get" action={ templ.SafeURL(myBooksHistoryURL("", 1, browse.NeedsLanguage, browse.Disposition, browse.History)) } hx-get={ myBooksHistoryURL("", 1, browse.NeedsLanguage, browse.Disposition, browse.History) } hx-target="#library-results" hx-swap="outerHTML" hx-push-url="true" hx-status:5xx="target:#library-results select:#library-results swap:outerHTML push:false" data-my-books-enhanced>
					<label for="library-search-query">Search My Books</label>
					<div class="library-search__controls">
						<input class="input" id="library-search-query" type="search" name="q" value={ browse.Query } placeholder="Title, author, or edition"/>
					<button class="btn btn-primary" type="submit">Search</button>
					</div>
				</form>
			</section>
			<div id="library-recovery" aria-live="polite"></div>
			@MyBooksResults(csrf, books, browse)
		} else if len(books) > 0 {
			<section class="library-list" aria-labelledby="acquired-books-heading">
				<h2 id="acquired-books-heading">Books in My Books</h2>
				<ul class="library-grid" role="list">
					for _, book := range books {
						@MyBookRow(csrf, book, browse.RefreshableBookIDs[book.Book.ID], "")
					}
				</ul>
			</section>
		}
	}
}

templ JourneyPage(user domain.User, csrf string, journey journeyPageView, message string, pageError string) {
	@ShellLayout("Reading", &user, csrf, NavigationReadingJourney, shellStyleReading) {
		@PageHeader(journeyPageTitle(journey), "Review your current Book and other books you may want to read.", nil) {
			<a class="button button--outline" href="/library">Add books from My Books</a>
		}
		if message != "" {
			@Feedback(FeedbackSuccess, "", message)
		}
		if pageError != "" {
			@Feedback(FeedbackError, "Action needed", pageError)
		}
		if journey.LanguageHandoff != nil {
			@ReadingLanguageHandoff(*journey.LanguageHandoff, journey.LanguageLabel, journey.ActiveLanguageLabel, csrf)
		}
		@GoalSection(journey.Goal, csrf, "", "", "")
		<section aria-labelledby="provisional-journey-heading"><h2 id="provisional-journey-heading">To Read books</h2>
			@JourneyProvisionalList(journey, csrf, "", "")
		</section>
	}
}

templ ReadingLanguageHandoff(handoff journeyLanguageHandoffView, pageLanguageLabel, activeLanguageLabel, csrf string) {
	<section class="language-handoff" aria-labelledby="language-handoff-heading">
		<h2 id="language-handoff-heading">This Book is in { handoff.LanguageLabel }</h2>
		<p><strong>{ handoff.BookTitle }</strong> is in { handoff.LanguageLabel }. This Reading page is showing { pageLanguageLabel }, while your saved study language is { activeLanguageLabel }. This request does not change the saved language; switch it if you want { handoff.LanguageLabel } to become active.</p>
		<form method="post" action="/active-study-language"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="language" value={ handoff.Language }/><input type="hidden" name="return_to" value={ readingBookURL(handoff.BookID) }/><button class="button" type="submit">Switch to { handoff.LanguageLabel } and open this Book</button></form>
	</section>
}

templ PrimaryGoalFinishPage(user domain.User, csrf string, outcome primaryGoalFinishView) {
	@ShellLayout("Reading finished", &user, csrf, NavigationReadingJourney, shellStyleReading) {
		@PrimaryGoalFinish(outcome)
	}
}

templ PrimaryGoalFinish(outcome primaryGoalFinishView) {
	<section id="primary-goal-section" tabindex="-1" aria-labelledby="primary-goal-finish-heading" class="journey-goal journey-finish-outcome" data-focus-id="primary-goal-finish-heading">
		<h1 id="primary-goal-finish-heading" tabindex="-1">Reading finished</h1>
		<p role="status" aria-live="polite" aria-atomic="true">Reading finished for <strong>{ outcome.BookTitle }</strong>.</p>
		<h2>Vocabulary transition</h2>
		<p>{ finishGraduationText(outcome) }</p>
		<p><a class="button button--outline" href="/reading">Choose what to read next</a></p>
	</section>
}
templ JourneyProvisionalList(journey journeyPageView, csrf, focusBookID, statusMessage string) {
	<div id="provisional-journey-list" data-focus-id={ journeyBookAnchorID(focusBookID) }>
		<p id="provisional-journey-status" class="journey-status" role="status" aria-live="polite" aria-atomic="true">{ statusMessage }</p>
		@JourneyProvisionalContent(journey, csrf, focusBookID, statusMessage, false)
	</div>
}

templ JourneyProvisionalContent(journey journeyPageView, csrf, focusBookID, statusMessage string, announce bool) {
	<div id="provisional-journey-content" data-focus-id={ journeyBookAnchorID(focusBookID) }>
		if announce && statusMessage != "" {
			<div hx-swap-oob="innerHTML:#provisional-journey-status">{ statusMessage }</div>
		}
		if len(journey.Provisional) == 0 {
			@EmptyState("No other To Read books", "There are no other To Read books in this language. Add or reconsider books from My Books when you are ready.") {
				<a class="button button--outline" href="/library">Browse My Books</a>
			}
		}
		<ol class="journey-list" aria-label="To Read books">
			for _, item := range journey.Provisional {
				<li>@JourneyBookCard(item, false, csrf)</li>
			}
		</ol>
	</div>
}
templ GoalSection(goal *journeyBookView, csrf string, message, sectionError, focusBookID string) {
	<section id="primary-goal-section" tabindex="-1" aria-labelledby="primary-goal-heading" class="journey-goal" data-focus-id={ goalSectionFocusID(focusBookID) }><h2 id="primary-goal-heading">Current reading</h2>
		if message != "" {
			<p id="goal-section-status" class="journey-status" role="status" aria-live="polite" aria-atomic="true">{ message }</p>
		}
		if sectionError != "" {
			<article role="alert" class="feedback feedback--error"><strong>Action needed</strong><p>{ sectionError }</p></article>
		}
		if goal == nil {
			@EmptyState("No current Book yet", "Start an analyzed To Read book when you are ready to begin reading.")
		} else {
			@JourneyBookCard(*goal, true, csrf)
		}
	</section>
}
templ JourneyBookCard(item journeyBookView, primary bool, csrf string) {
	<article id={ journeyBookAnchorID(journeyBookID(item)) } tabindex="-1" data-focus-anchor class={ journeyBookClass(primary) }><div class="journey-book__cover">@BookCoverMedia(journeyBookID(item), item.Cover)</div><div class="journey-book__identity"><h3>
	if journeyEntryAvailable(item) {
		<a href={ templ.SafeURL(readingBookURL(journeyBookID(item))) }>{ canonicalBookTitle(item.Book) }</a>
	} else {
		{ canonicalBookTitle(item.Book) }
	}
	</h3>
	if author := canonicalBookAuthor(item.Book); author != "" {
		<p class="journey-book__author">By { author }</p>
	}
	if primary {
		<p>@StatusBadge("Current reading", StatusInfo) <span aria-hidden="true">·</span> Current commitment</p>
		<p class="metadata"><strong>Reading state</strong>: Not yet marked finished. Reading, analysis, and deck preparation remain independent facts.</p>
		<p class="metadata"><strong>Reserved vocabulary</strong>: <span class="numeric">{ fmt.Sprintf("%d", item.GoalSnapshotSize) }</span> frozen identities.</p>
	} else {
		<p>@StatusBadge("To Read", StatusNeutral)</p>
	}
	if primary && item.GoalReadingOnly {
		@StatusBadge("Reading only", StatusInfo)
		if item.GoalUnassessed {
			<p>No analysis or deck-eligible vocabulary exists yet, so Mouseion cannot model vocabulary for this Book. Reading directly is the current path.</p>
		} else {
			<p>Analysis evidence exists, but this Book has no deck-eligible vocabulary. Reading directly is the current path.</p>
		}
	}
	</div>
	<div class="journey-book__evidence">
	@JourneyEvidence(item, csrf, primary)
	if primary {
		<section class="goal-card__deck" aria-labelledby={ "goal-deck-heading-" + journeyBookID(item) }>
			<h4 id={ "goal-deck-heading-" + journeyBookID(item) }>Deck preparation</h4>
			if bookHasCompletedAnalysis(item.Book) {
				<p><a href={ templ.SafeURL(journeyDeckPreparationTaskURL(journeyBookID(item))) }>Open focused deck task</a></p>
			}
			if item.GoalSnapshotSize == 0 {
				<p><strong>Deck state</strong>: No deck needed. This Book has no frozen vocabulary identities to prepare.</p>
			} else if item.GoalPreparation != nil {
				<p class="metadata"><strong>Deck state</strong>: { deckPreparationTitle(*item.GoalPreparation) }.</p>
				@GoalDeckPreparationStatus(csrf, journeyBookID(item), item.GoalSnapshotID, *item.GoalPreparation)
			} else if item.GoalDeckMissing {
				<p role="note" aria-live="polite"><strong>Deck state: Missing.</strong> No artifact exists for this frozen snapshot. The current reading and snapshot remain unchanged.</p>
				<form method="post" action={ templ.SafeURL("/reading/books/"+journeyBookID(item)+"/deck/retry") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ item.GoalSnapshotID }/><button class="button" type="submit">Prepare deck</button></form>
			} else if item.GoalDeckUnavailable {
				<p role="note" aria-live="polite"><strong>Deck state: Unavailable.</strong> The current reading and snapshot remain unchanged.</p>
				<form method="post" action={ templ.SafeURL("/reading/books/"+journeyBookID(item)+"/deck/retry") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ item.GoalSnapshotID }/><button class="button" type="submit">Retry deck preparation</button></form>
			}
		</section>
	}
	</div>
	if !primary {
		<div class="journey-book__controls" role="group" aria-label={ "Actions for "+canonicalBookTitle(item.Book) }>
			if item.CanChooseGoal {
				<a class="button button--outline" href="/reading/switch">Switch current reading</a>
			} else if item.GoalEligibilityReason != "" {
				<p class="journey-book__goal-reason metadata">{ item.GoalEligibilityReason }</p>
			}
			<details class="more-actions">
				<summary>More actions</summary>
				<div class="more-actions__body">
				<p>Book disposition is managed in <a href="/library">My Books</a>.</p>
				</div>
			</details>
		</div>
	} else {
		<div class="goal-card__actions">
				@Confirmation("Mark reading finished", goalCompletionConfirmationText(item), StatusNeutral) {
				<form method="post" action="/reading/finish" hx-post="/reading/finish" hx-target="#primary-goal-section" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_book_id" value={ journeyBookID(item) }/><input type="hidden" name="expected_current_snapshot_id" value={ item.GoalSnapshotID }/><button class="button" type="submit">Mark reading finished</button></form>
			}
			<a class="button button--outline" href="/reading/switch">Switch current reading</a>
			@Confirmation("Stop reading for now", "This clears the current reading and releases only its active Reserved vocabulary. The Book remains To Read, and its analysis, decks, and history remain. You can start it again from Reading.", StatusNeutral) {
				<form method="post" action="/reading/stop"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_book_id" value={ journeyBookID(item) }/><input type="hidden" name="expected_current_snapshot_id" value={ item.GoalSnapshotID }/><button type="submit" class="button button--outline">Confirm stop for now</button></form>
			}
			@Confirmation("Set aside this Book", "This clears the current reading, moves the Book to Set Aside, and releases only its active Reserved vocabulary. Its analysis, decks, and history remain. You can move it back to To Read from My Books.", StatusDanger) {
				<form method="post" action="/reading/set-aside"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_book_id" value={ journeyBookID(item) }/><input type="hidden" name="expected_current_snapshot_id" value={ item.GoalSnapshotID }/><button type="submit" class="button button--danger">Confirm set aside</button></form>
			}
			<details class="more-actions">
				<summary>More actions</summary>
				<div class="more-actions__body">
				<p>Book disposition is managed in <a href="/library">My Books</a>.</p>
				</div>
			</details>
			<p>To replace this Book, use Switch current reading and choose another eligible To Read book.</p>
		</div>
	}
	</article>
}

templ GoalDeckPreparationStatus(csrf, bookID, snapshotID string, preparation domain.DeckPreparation) {
	<p><strong>{ deckPreparationTitle(preparation) }.</strong> { deckPreparationSummary(preparation) }</p>
		if preparation.State == domain.DeckPreparationReady {
			if preparation.Error == domain.DeckPreparationRequiresRepreparationError {
				@Feedback(FeedbackError, "Action needed", domain.DeckPreparationRequiresRepreparationError)
				<form method="post" action={ templ.SafeURL("/reading/books/"+bookID+"/deck/retry") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ snapshotID }/><button class="button" type="submit">Re-prepare deck</button></form>
			} else if deckPreparationEmpty(preparation) {
				<p>No cards were created from this snapshot.</p>
			} else {
			<a class="button" download href={ templ.SafeURL("/deck-preparations/"+preparation.ID+"/download") }>Download deck</a>
			<form method="post" action={ templ.SafeURL("/deck-preparations/"+preparation.ID+"/reprepare") }><input type="hidden" name="csrf_token" value={ csrf }/><button type="submit" class="button button--outline">Re-prepare with current Meaning evidence</button></form>
		}
	} else if deckPreparationActive(preparation) {
		<form method="post" action={ templ.SafeURL("/reading/books/"+bookID+"/deck/cancel") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ snapshotID }/><button class="button button--outline">Cancel preparation</button></form>
		if preparation.State == domain.DeckPreparationQueued {
			<form method="post" action={ templ.SafeURL("/reading/books/"+bookID+"/deck/retry") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ snapshotID }/><button class="button" type="submit">Retry deck preparation</button></form>
		}
	} else {
		if preparation.State == domain.DeckPreparationFailed {
			@Feedback(FeedbackError, "Action needed", preparationFailureMessageFor(preparation))
		} else if preparation.State == domain.DeckPreparationCancelled {
			@Feedback(FeedbackError, "Action needed", "Preparation was cancelled. Retry this exact reading snapshot when ready.")
		}
		<form method="post" action={ templ.SafeURL("/reading/books/"+bookID+"/deck/retry") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ snapshotID }/><button class="button" type="submit">Retry deck preparation</button></form>
	}
}

templ JourneyEvidence(item journeyBookView, csrf string, primary bool) {
	if journeyEvidenceState(item) != "current" {
		<p><strong>{ journeyEvidenceLabel(item) }:</strong> { journeyEvidenceDescription(item) }</p>
		{{ action := journeyAnalysisAction(item) }}
		if action.Status != "" {
			if action.Label != "" && action.Submit {
				<form class="inline-action" method="post" action={ templ.SafeURL(action.URL) }><input type="hidden" name="csrf_token" value={ csrf }/><button type="submit" class="button button--outline">{ action.Label }</button></form>
			} else if action.Label != "" && action.URL != "" {
				<p><a href={ templ.SafeURL(action.URL) }>{ action.Label }</a></p>
			}
		}
	}
}

func journeyEntryAvailable(item journeyBookView) bool {
	return item.Book.EvidenceState() == domain.BookAnalyzed && bookHasCompletedAnalysis(item.Book)
}
templ DeckPreparationStatusPage(user domain.User, csrf string, preparation domain.DeckPreparation, resultURL string, journeyAction deckJourneyActionView) {
	@ShellLayout("Deck preparation", &user, csrf, NavigationLibrary, shellStyleReading) {
		if resultURL != "" {
			@Breadcrumb(resultURL, "Reading")
		}
		@PageHeader("Deck preparation", "Prepare an Anki deck from one exact completed analysis.", StatusBadge(deckPreparationTitle(preparation), deckPreparationStatusTone(preparation)))
		@DeckPreparationStatus(csrf, preparation, resultURL, journeyAction)
	}
}

templ DeckPreparationStatus(csrf string, preparation domain.DeckPreparation, resultURL string, journeyAction deckJourneyActionView) {
	@AsyncStatus(deckPreparationAttributes(preparation), "deck-preparation-status", deckPreparationTitle(preparation), deckPreparationSummary(preparation), preparationProgress(preparation), 100, deckPreparationActive(preparation)) {
		if resultURL != "" {
			<p><a href={ templ.SafeURL(resultURL) }>Return to book</a></p>
		}
		if preparation.TranslationEligible > 0 {
			<p><strong>Translations:</strong> { fmt.Sprintf("%d complete · %d unavailable · %d retrying · %d waiting", preparation.TranslationDone, preparation.TranslationFailed, preparation.TranslationRetrying, preparation.TranslationPending) }</p>
		}
		if preparation.BatchRequestCount > 0 {
			<p><strong>Batch translation:</strong> { fmt.Sprintf("%d of %d requests complete · %d failed · %d expired · completion can take hours (up to 24h)", preparation.BatchCompletedRequests, preparation.BatchRequestCount, preparation.BatchFailedRequests, preparation.BatchExpiredRequests) }</p>
		}
		for _, omission := range preparation.MeaningOmissions {
			<p><strong>Omitted { omission.TargetWord }:</strong> { omission.Reason }</p>
		}
		if preparation.DeckName != "" && !deckPreparationEmpty(preparation) {
			<p><strong>Deck:</strong> <code>{ preparation.DeckName }</code> · <strong>Filename:</strong> <code>{ preparation.Filename }</code></p>
		}
		if preparation.State == domain.DeckPreparationReady {
			if preparation.Error == domain.DeckPreparationRequiresRepreparationError {
				@Feedback(FeedbackError, "Action needed", domain.DeckPreparationRequiresRepreparationError)
				if preparation.GoalSnapshotID != "" && journeyAction.State == deckIsCurrentReading && journeyAction.BookID != "" {
					<form method="post" action={ templ.SafeURL("/reading/books/"+journeyAction.BookID+"/deck/retry") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ preparation.GoalSnapshotID }/><button class="button" type="submit">Re-prepare deck</button></form>
				} else if journeyAction.BookID == "" {
					<form method="post" action={ templ.SafeURL("/deck-preparations/"+preparation.ID+"/retry") }>
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<p>Re-preparation uses the configured translation provider to create contextual Glosses. If the provider is unavailable, the deck will remain failed and can be retried after configuration.</p>
						<button class="button" type="submit">Re-prepare deck</button>
					</form>
				} else {
					<p role="note">This Book is no longer Current reading. The preparation remains historical and cannot be submitted again.</p>
				}
			} else if deckPreparationEmpty(preparation) {
				@EmptyState("No recurring vocabulary", "This book has no recurring vocabulary to study, so no cards were created.")
			} else {
				if deckPreparationHasNewerRevision(preparation) {
					@Feedback(FeedbackInfo, "Updated deck revision available", fmt.Sprintf("Download deck revision %d to update your existing Anki notes in place.", preparation.DeckRevision))
				}
				<p><strong>Completeness:</strong> { deckCompletenessSummary(preparation) }</p>
				for _, evidence := range preparation.EvidenceCoverage {
					if evidence.Configured {
						<p><strong>Meaning evidence:</strong> { fmt.Sprintf("%s matched %d of %d targets; %d candidates frozen, %d omitted by the candidate bound", evidence.Source, evidence.Matched, evidence.Selected, evidence.Candidates, evidence.Omitted) }</p>
					} else {
						<p><strong>Meaning evidence:</strong> { fmt.Sprintf("%s index not configured; no local candidates were available for %d targets", evidence.Source, evidence.Selected) }</p>
					}
				}
				@ActionGroup() {
					<a class="button" download href={ templ.SafeURL("/deck-preparations/"+preparation.ID+"/download") }>Download deck</a>
					if preparation.GoalSnapshotID != "" && journeyAction.State == deckIsCurrentReading || journeyAction.BookID == "" {
						<form method="post" action={ templ.SafeURL("/deck-preparations/"+preparation.ID+"/reprepare") }>
							<input type="hidden" name="csrf_token" value={ csrf }/>
							<button type="submit" class="button button--outline">Re-prepare with current Meaning evidence</button>
						</form>
					}
				}
				if preparation.GoalSnapshotID != "" && journeyAction.State == deckIsCurrentReading || journeyAction.BookID == "" {
					<p>Re-preparation remains bound to this snapshot while using current dictionary evidence and translation rules. The existing deck remains available for download.</p>
				} else if journeyAction.BookID == "" {
					<p>Re-preparation creates a new deck generation using current dictionary evidence and translation rules. The existing deck remains available for download.</p>
				} else {
					<p role="note">This Book is no longer Current reading. Its ready artifact remains available for download, but no new preparation can be submitted.</p>
				}
				@DeckJourneyAction(journeyAction)
			}
		} else if deckPreparationActive(preparation) {
					<form method="post" action={ templ.SafeURL("/deck-preparations/"+preparation.ID+"/cancel") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="button button--outline">Cancel preparation</button></form>
		} else {
			if preparation.State == domain.DeckPreparationFailed {
				@Feedback(FeedbackError, "Action needed", preparationFailureMessageFor(preparation))
			}
			if preparation.GoalSnapshotID != "" && journeyAction.State == deckIsCurrentReading && journeyAction.BookID != "" {
				<form method="post" action={ templ.SafeURL("/reading/books/"+journeyAction.BookID+"/deck/retry") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ preparation.GoalSnapshotID }/><button class="button" type="submit">Retry deck preparation</button></form>
			} else if journeyAction.BookID == "" {
				<form method="post" action={ templ.SafeURL("/deck-preparations/"+preparation.ID+"/retry") }>
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<p>Preparation requires the configured translation provider to create contextual Glosses. If it is unavailable, configure it and retry.</p>
					<button class="button" type="submit">Retry preparation</button>
				</form>
			} else {
				<p role="note">This Book is no longer Current reading. The submitted job may finish, but no retry can be submitted.</p>
			}
		}
	}
}

func bookHasCompletedAnalysis(book domain.SourceMaterialSummary) bool { return book.AnalysisStatus == "analyzed" && book.AnalysisState == "completed" && book.AnalysisRunID != "" && book.CorpusID != "" }
func journeyDeckPreparationTaskURL(bookID string) string { return "/reading/books/" + url.PathEscape(bookID) + "/deck/preparations/new" }
func completedAtLabel(value *time.Time) string { if value == nil || value.IsZero() { return "Unavailable" }; return value.UTC().Format("2006-01-02 15:04:05 UTC") }

func deckCompletenessSummary(preparation domain.DeckPreparation) string {
	glossSummary := fmt.Sprintf("%d with fallback gloss", preparation.CardsWithFallbackGloss)
	if preparation.ContextualGlossesReported {
		glossSummary = fmt.Sprintf("%d with contextual Gloss · %d inferred from sentence context", preparation.ContextualGlosses, preparation.ContextOnlyGlosses)
	}
	return fmt.Sprintf("%d cards · %d with English · %d with contextual sentence translations · %s · %d omitted for sentence quality", preparation.TotalCards, preparation.CardsWithEnglish, preparation.CardsWithContextualSentenceTranslations, glossSummary, preparation.QualityOmissions)
}

func knownCoveragePercent(coverage domain.AnalysisCoverage) float64 {
	if coverage.AnalyzableTokenCount == 0 {
		return 0
	}
	return min(float64(coverage.KnownTokenCount)*100/float64(coverage.AnalyzableTokenCount), 100)
}

func corpusUnitLabel(unit domain.CorpusSelectedUnit) string {
	if strings.TrimSpace(unit.Title) != "" {
		return unit.Title
	}
	if strings.TrimSpace(unit.SourceHref) != "" {
		return unit.SourceHref
	}
	return unit.UnitID
}

templ LoginPage(csrf, message, next string, onboarding bool) {
	@ShellLayout("Sign in", nil, csrf, navigationContextForTitle("Sign in"), shellStyleLogin) { <article class="narrow login-screen">
	if onboarding {
		<h1>Create your account</h1><p class="login-screen__intro">Set up the first learner account for this Mouseion installation.</p>
	} else {
		<h1>Sign in</h1><p class="login-screen__intro">Return to your reading desk.</p>
	}
	if message != "" {
		<p class="alert alert-error login-screen__error" role="alert">{ message }</p>
	}
	if onboarding {
		<form class="login-form" method="post" action="/onboarding"><input type="hidden" name="csrf_token" value={ csrf }/><label class="login-field">Username<input name="username" required autocomplete="username"/></label><label class="login-field">Password<input type="password" name="password" minlength="8" required autocomplete="new-password"/><small>Use at least 8 characters.</small></label><button class="btn btn-primary" type="submit">Create account</button></form>
	} else {
		<form class="login-form" method="post" action="/login"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="next" value={ next }/><label class="login-field">Username<input name="username" required autocomplete="username"/></label><label class="login-field">Password<input type="password" name="password" required autocomplete="current-password"/></label><button class="btn btn-primary" type="submit">Sign in</button></form>
	}
	</article> }
}
templ ConnectionsPage(user domain.User, csrf string, connections []domain.OpdsConnection, message string, statuses map[string]domain.CatalogueSyncStatus) {
	@ConnectionsPageForBook(user, csrf, connections, message, "", "", statuses)
}

templ ConnectionsPageForBook(user domain.User, csrf string, connections []domain.OpdsConnection, message, errorMessage, bookID string, statuses map[string]domain.CatalogueSyncStatus) {
	@ShellLayout("Catalogs", &user, csrf, NavigationCatalogs, shellStyleCatalogs) {
		@PageHeader("Catalogs", "Connect a catalog and add EPUB books to My Books.", nil)
		if message != "" {
			@Feedback(FeedbackSuccess, "", message)
		}
		if errorMessage != "" {
			@Feedback(FeedbackError, "", errorMessage)
		}
		if len(connections) == 0 {
			@EmptyState("Add your first catalog connection", "A connection lets Mouseion sync ready-language bibliographic metadata into My Books. Your credentials stay private and are never shown again.") {
				<a href="#catalog-connection-form">Add catalog connection</a>
			}
		}
		<article id="catalog-connection-form"><h2>Add catalog connection</h2><form class="catalog-connection-form" method="post" action="/connections"><input type="hidden" name="csrf_token" value={ csrf }/>
			if bookID != "" {
				<input type="hidden" name="book_id" value={ bookID }/>
			}
		<div class="form-grid"><label>Name<input class="input" name="name" required/></label><label>Catalog URL<input class="input" type="url" name="url" required placeholder="https://example.com/opds"/></label></div><div class="form-grid"><label>Username <small>(optional)</small><input class="input" name="username" autocomplete="username"/></label><label>Password <small>(optional, encrypted at rest)</small><input class="input" type="password" name="password" autocomplete="new-password"/></label></div><button class="button" type="submit">Add catalog</button></form></article>
		if len(connections) > 0 {
			<h2>Catalog maintenance</h2>
			<p>Edit a saved connection or remove future catalog access. Owned books and their artifacts remain.</p>
		}
		<div class="catalog-list">
		for _, c := range connections {
				<article id={ "connection-" + c.ID } aria-labelledby={ "connection-name-" + c.ID }><header><h3 id={ "connection-name-" + c.ID }>{ c.Name }</h3></header><div id={ "connection-status-" + c.ID } role="status" aria-live="polite" aria-atomic="true">@CatalogueSyncConnectionStatus(catalogueSyncConnectionViewFor(c, statuses))</div>@CatalogueSyncConnectionActions(csrf, c, catalogueSyncConnectionViewFor(c, statuses))<p class="break">{ safeConnectionURL(c.URL) }</p><p>{ credentialSummary(c) }</p><details id={ "edit-connection-" + c.ID }><summary>Edit connection</summary><form class="catalog-connection-form" method="post" action={ templ.SafeURL("/connections/"+c.ID) }><input type="hidden" name="csrf_token" value={ csrf }/><div class="form-grid"><label>Name<input class="input" name="name" value={ c.Name } required/></label><label>Catalog URL <small>(leave blank to keep current URL)</small><input class="input" type="url" name="url" value={ connectionURLForEdit(c) } placeholder="Leave blank to keep current URL"/></label></div><div class="form-grid"><label>Username<input class="input" name="username" value={ c.Username } autocomplete="username"/></label><label>New password <small>(leave blank to keep current)</small><input class="input" type="password" name="password" autocomplete="new-password"/></label></div><button class="button button--outline" type="submit">Save changes</button></form></details>@Confirmation("Delete catalog connection", "This removes future access through this connection and its credentials. Books already in My Books and their artifacts remain available.", StatusDanger) {<form method="post" action={ templ.SafeURL("/connections/"+c.ID+"/delete") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="button button--outline" type="submit">Confirm deletion</button></form>}</article>
		}
		</div>
	}
}
templ JobsPage(user domain.User, csrf string, jobs []domain.AnalysisJob, message string, readingBookURLs map[string]string) {
	@ShellLayout("Jobs", &user, csrf, NavigationLibrary, shellStyleJobs) {
		@PageHeader("Analysis jobs", "Operational history for submitted analyses.", nil)
		if message != "" {
			@Feedback(FeedbackInfo, "", message)
		}
		if len(jobs) == 0 {
			@EmptyState("No analysis runs yet", "Add a book to Reading to generate analysis evidence.") {
				<a href="/library">Go to My Books</a>
			}
		}
		if len(jobs) > 0 {
			@ResponsiveTable("Analysis history") {
				<thead><tr><th>Job</th><th>Progress</th><th>Created</th><th>Error</th></tr></thead><tbody>
				for _, job := range jobs {
					<tr><td>
						if url := readingBookURLs[job.SourceMaterialID]; url != "" && job.AnalysisState == "completed" && job.AnalysisRunID != "" && job.CorpusID != "" {
							<a href={ templ.SafeURL(url) }>{ fmt.Sprintf("#%d · Reading", job.DisplayNumber) }</a>
						} else {
							<a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", job.ID)) }>{ fmt.Sprintf("#%d", job.DisplayNumber) }</a>
						}
					</td><td><progress aria-label={ fmt.Sprintf("Analysis job %d progress", job.DisplayNumber) } value={ fmt.Sprintf("%d",job.Progress) } max="100"></progress> { fmt.Sprintf("%d%%",job.Progress) }</td><td>{ job.CreatedAt.Format("2006-01-02 15:04") }</td><td>{ job.Error }</td></tr>
				}
				</tbody>
			}
		}
	}
}

templ JobPage(user domain.User, csrf string, status analysis.Status, readingBookURL string) {
	@ShellLayout(fmt.Sprintf("Job #%d", status.DisplayNumber), &user, csrf, NavigationLibrary, shellStyleJobs) {
		@PageHeader(fmt.Sprintf("Analysis job #%d", status.DisplayNumber), "Operational status for this analysis run.", nil)
		@JobStatus(csrf, status, readingBookURL)
	}
}
templ JobStatus(csrf string, status analysis.Status, readingBookURL string) {
	@AsyncStatus(jobStatusAttributes(status.ID, jobRunning(status)), "job-status", jobState(status), analysisStatusSummary(status), status.Progress, 100, jobRunning(status)) {
		if status.Error != "" {
			@Feedback(FeedbackError, "Analysis needs attention", status.Error+" Retry the analysis when you are ready.")
		}
		@ActionGroup() {
			if jobRetryable(status) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/retry", status.ID)) }><input type="hidden" name="csrf_token" value={ csrf }/><button class="button" type="submit">Retry analysis</button></form>
			}
			if jobRunning(status) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/cancel", status.ID)) }><input type="hidden" name="csrf_token" value={ csrf }/><button class="button button--outline" type="submit">Cancel analysis</button></form>
			}
		}
		if status.CorpusID != "" {
			if status.LogicalState == "completed" {
					if status.SourceMaterialID != "" && status.RunID != "" && readingBookURL != "" {
						<p>Analysis complete. Continue with this book in Reading.</p>
						<a role="button" class="button button--outline" href={ templ.SafeURL(readingBookURL) }>View in Reading</a>
					} else {
						if status.SourceMaterialID != "" && status.RunID != "" {
							<p>Analysis complete, but this book is no longer available in Reading.</p>
						} else {
							<p>Analysis complete. Prepare a deck from this immutable analysis result.</p>
							<p>Deck preparation requires the configured translation provider to produce contextual Glosses. Only the target, one representative sentence, and public lexical evidence are sent.</p>
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/deck/preparations", status.ID)) } data-prepare-deck><input type="hidden" name="csrf_token" value={ csrf }/><small>Preparation runs in the background. You can download the completed deck when it is ready.</small><button type="submit">Prepare deck</button></form><section data-deck-preparation role="status" aria-live="polite" aria-atomic="true" hidden></section>
						}
					}
			} else {
				<p>Analysis complete. Legacy/full-text results cannot unlock a new deck preparation.</p>
			}
		}
	}
}
templ VocabularyBrowsePageView(user domain.User, csrf string, language string, page domain.VocabularyBrowsePage, query string) {
	@ShellLayout("Vocabulary", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@VocabularyPageHeader("browse")
		<p id="vocabulary-pending" class="htmx-indicator" role="status">Loading Browse. The previous results remain visible until the request completes.</p>
		<div id="vocabulary-workflow" hx-on:htmx:error="window.showVocabularyNetworkRecovery(ctx)">
		if language == "" {
			@EmptyState("No study languages yet", "Add or sync a Book with a chosen language before browsing vocabulary.") {
				<a class="vocabulary-action-link" href="/catalogs">Connect a catalog</a>
			}
		}
		if language != "" {
			<p class="vocabulary-language">Viewing active study language <code>{ language }</code>.</p>
			if page.CurrentBookID == "" {
				<p role="status">No Current reading is set for this study language.</p>
				<p><a class="vocabulary-action-link" href="/reading">Choose a Book in Reading</a></p>
			} else if len(page.Books) > 0 && !page.Books[0].HasCurrentAnalysis {
				<p><strong>Current reading: { page.Books[0].Title }</strong></p>
				<p role="status">This Book has no current completed analysis, so Browse cannot show current vocabulary evidence.</p>
				<p><a class="vocabulary-action-link" href="/reading">Review this Book in Reading</a></p>
			} else if len(page.Books) > 0 {
				<p class="vocabulary-scope"><strong>Current reading: { page.Books[0].Title }</strong> — this Book's eligible vocabulary, with evidence from current analyzed Books in this language.</p>
			}
			if page.CurrentBookID != "" {
			<form method="get" action="/vocabulary" class="data-width vocabulary-filter" hx-get="/vocabulary" hx-target="#vocabulary-browse-results" hx-select="#vocabulary-browse-results" hx-swap="outerHTML" hx-push-url="true" hx-sync="#vocabulary-workflow:replace" hx-config="timeout:9s" hx-indicator="#vocabulary-pending" hx-status:409="target:#vocabulary-recovery select:#vocabulary-recovery swap:outerHTML push:false" hx-status:4xx="target:#vocabulary-recovery select:#vocabulary-recovery swap:outerHTML push:false" hx-status:5xx="target:#vocabulary-recovery select:#vocabulary-recovery swap:outerHTML push:false">
				<input type="hidden" name="reading" value={ page.CurrentBookID }/>
				<label for="vocabulary-prefix">Canonical lemma prefix</label><input class="input" id="vocabulary-prefix" type="search" name="q" value={ query }/>
				<p class="vocabulary-exclusions">By default, Known, Reserved, and words in a prepared Book deck are hidden. Exclusions do not change counts or order.</p>
				<label for="vocabulary-include-all"><input id="vocabulary-include-all" type="checkbox" name="all" value="1" checked?={ page.IncludeAll }/> Show already accounted-for words</label>
			<button class="btn btn-primary" type="submit">Search</button>
			</form>
			}
			<div id="vocabulary-browse-results">
			if query != "" {
				<p class="vocabulary-applied-query">Applied prefix: <code>{ query }</code></p>
			}
			if page.BrowseCountsUnavailable {
				<p role="alert"><strong>Browse counts unavailable.</strong> Counts could not be rebuilt after repeated attempts. Ask your server operator to restart Mouseion to requeue missing durable count work.</p>
			} else if page.BrowseCountsUpdating {
				<p role="status" aria-live="polite"><strong>Updating Browse counts.</strong> Results are withheld until every currently analyzed Book in this study language has exact, ready counts. Browse results are temporarily unavailable.</p>
			} else if page.CurrentBookID != "" && len(page.Books) > 0 && page.Books[0].HasCurrentAnalysis {
			<h2 id="vocabulary-results-heading" tabindex="-1" autofocus?={ query != "" || page.Page > 1 || page.IncludeAll }>Browse results</h2>
			if page.Total == 0 && page.InventoryTotal == 0 {
				<p>The current analysis has no eligible vocabulary identities.</p>
			}
			if page.Total == 0 && page.InventoryTotal > 0 && page.ScopedInventoryTotal == 0 {
				<p>No eligible identities are in this Book.</p>
			}
			if page.Total == 0 && page.ScopedInventoryTotal > 0 && query == "" && !page.IncludeAll {
				<p>All eligible identities in this Book are already Known, Reserved, or included in a prepared Book deck. Show already accounted-for words to reveal them.</p>
			}
			if page.Total == 0 && page.ScopedInventoryTotal > 0 && (query != "" || page.IncludeAll) {
				if query != "" && !page.IncludeAll {
					<p>No visible identities match this canonical-lemma prefix. Already-accounted-for words may be hidden; show them to include those matches.</p>
				} else {
					<p>No current identities match this canonical-lemma prefix. Clear or broaden the prefix to see more.</p>
				}
			}
			if page.Total > 0 {
				<p>{ fmt.Sprintf("%d visible identities in this Book", page.Total) }. Counts use current completed analyses and effective occurrence decisions, including singletons.</p>
				@ResponsiveTable("Current effective vocabulary") {
					<caption>Current effective vocabulary</caption><thead><tr><th scope="col">Lemma</th><th scope="col">Part of speech</th><th scope="col">Occurrence counts</th><th scope="col">Learner state</th></tr></thead><tbody>
				for _, row := range page.Rows {
					<tr><th scope="row"><a class="vocabulary-lemma-link" href={ templ.SafeURL(vocabularyConcordanceURL(row.CanonicalLemma, row.UPOS, page.CurrentBookID)) }>{ vocabularyBrowseDisplayLemma(language, row.CanonicalLemma, row.UPOS) }</a></th><td><code>{ row.UPOS }</code></td><td>{ vocabularyBrowseOccurrenceCounts(row) }</td><td>{ vocabularyBrowseState(row) }
						if row.InBookDeck {
							<small>In a Book deck</small>
						}
					</td></tr>
				}
				</tbody>
				}
				@VocabularyBrowsePager(page, query)
			}
			}
		<div id="vocabulary-recovery" aria-live="polite"></div>
		</div>
		}
		</div>
	}
}

templ VocabularyConcordancePageView(user domain.User, csrf, language string, books []domain.SourceMaterialSummary, lookup domain.ConcordanceLookup, result domain.ConcordanceResult, applied bool, message, focusTarget string) {
	@ShellLayout("Concordance", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@VocabularyPageHeader("concordance")
		<p id="concordance-pending" class="htmx-indicator" role="status">Searching. The previous results remain under their previously applied query and scope.</p>
		<div id="concordance-workflow" hx-on:htmx:error="window.showConcordanceNetworkRecovery(ctx)">
		if language == "" {
			@EmptyState("No study languages yet", "Add or sync a Book with a chosen language before looking up vocabulary.") {
				<a href="/catalogs">Connect a catalog</a>
			}
		}
		if language != "" {
			<p class="concordance-language">Study language: <code>{ language }</code> <span>· Current analyzed Books</span></p>
			<form method="get" action="/vocabulary/concordance" hx-get="/vocabulary/concordance" hx-target="#concordance-workflow" hx-select="#concordance-workflow" hx-swap="outerHTML" hx-push-url="true" hx-sync="#concordance-workflow:replace" hx-config="timeout:9s" hx-indicator="#concordance-pending" hx-status:409="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:4xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:5xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" class="concordance-query">
				for _, bookID := range lookup.BookIDs {
					<input type="hidden" name="book" value={ bookID }/>
				}
				if lookup.GrammarDirection != "" {
					<input type="hidden" name="grammar" value={ lookup.GrammarDirection }/><input type="hidden" name="relation" value={ lookup.Relation }/>
				}
				<div class="concordance-query-field">
					<label for="concordance-mode">Lookup evidence</label>
				<select class="input" id="concordance-mode" name="mode">
						<option value="surface" selected?={ lookup.Mode == "surface" }>Observed surface</option>
						<option value="effective" selected?={ lookup.Mode == "effective" }>Effective lemma</option>
						<option value="analyzer" selected?={ lookup.Mode == "analyzer" }>Analyzer lemma (evidence)</option>
					</select>
				</div>
				<div class="concordance-query-field">
					<label for="concordance-term">Exact term</label><input class="input" id="concordance-term" type="search" name="term" value={ lookup.Term } required/>
				</div>
				<div class="concordance-pos-field">
					<label for="concordance-upos">Part of speech</label>
					<select class="input" id="concordance-upos" name="upos"><option value="">Choose for a lemma lookup</option>
						for _, pos := range []string{"NOUN", "VERB", "ADJ", "ADV", "PROPN", "PRON", "DET", "ADP", "AUX", "CCONJ", "SCONJ", "NUM", "PART", "INTJ", "PUNCT", "SYM", "X"} {
							<option value={ pos } selected?={ lookup.UPOS == pos }>{ pos }</option>
						}
					</select>
				</div>
				<button class="button" type="submit">Find</button>
			</form>
			<div class="concordance-scopes">
			<details>
				<summary>Books (applied: { concordanceBookScope(lookup, books) })</summary>
			<form method="get" action="/vocabulary/concordance" hx-get="/vocabulary/concordance" hx-target="#concordance-workflow" hx-select="#concordance-workflow" hx-swap="outerHTML" hx-push-url="true" hx-sync="#concordance-workflow:replace" hx-config="timeout:9s" hx-indicator="#concordance-pending" hx-status:409="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:4xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:5xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false">
					<input type="hidden" name="mode" value={ lookup.Mode }/><input type="hidden" name="term" value={ lookup.Term }/><input type="hidden" name="upos" value={ lookup.UPOS }/>
					if lookup.GrammarDirection != "" {
						<input type="hidden" name="grammar" value={ lookup.GrammarDirection }/><input type="hidden" name="relation" value={ lookup.Relation }/>
					}
					<fieldset><legend>Search current analysis in</legend>
						for _, book := range books {
							<label><input type="checkbox" name="book" value={ book.BookID } checked?={ concordanceBookSelected(lookup.BookIDs, book.BookID) }/>{ concordanceBookTitle(book) }</label>
						}
					</fieldset>
					<button class="button button--outline" type="submit">Apply Books</button>
				</form>
			</details>
			<details>
				<summary>Grammar (applied: { concordanceGrammarScope(lookup) })</summary>
				<form method="get" action="/vocabulary/concordance" hx-get="/vocabulary/concordance" hx-target="#concordance-workflow" hx-select="#concordance-workflow" hx-swap="outerHTML" hx-push-url="true" hx-sync="#concordance-workflow:replace" hx-config="timeout:9s" hx-indicator="#concordance-pending" hx-status:409="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:4xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:5xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false">
					<input type="hidden" name="mode" value={ lookup.Mode }/><input type="hidden" name="term" value={ lookup.Term }/><input type="hidden" name="upos" value={ lookup.UPOS }/>
					for _, bookID := range lookup.BookIDs {
						<input type="hidden" name="book" value={ bookID }/>
					}
					<label for="concordance-grammar">Grammar direction</label>
					<select class="input" id="concordance-grammar" name="grammar"><option value="">No grammar filter</option><option value="own" selected?={ lookup.GrammarDirection == "own" }>Queried occurrence's own relation</option><option value="governor" selected?={ lookup.GrammarDirection == "governor" }>Dependents of queried governor</option></select>
					<label for="concordance-relation">Dependency relation</label><input class="input" id="concordance-relation" name="relation" value={ lookup.Relation } placeholder="e.g. nsubj"/>
					<button class="button button--outline" type="submit">Apply grammar</button>
				</form>
			</details>
			</div>
			if message != "" {
				<div id="concordance-recovery" aria-live="polite">
					<p role="alert">{ message }</p>
					<a class="button button--outline" href={ templ.SafeURL(vocabularyConcordancePageURL(1, lookup)) }>Retry Concordance lookup</a>
				</div>
			} else {
				<div id="concordance-recovery" aria-live="polite"></div>
			}
			if applied {
				<section id="concordance-results" aria-labelledby="concordance-summary">
					<h2 id="concordance-summary" tabindex="-1" autofocus?={ concordanceFocusFallsBackToSummary(result.Occurrences, focusTarget) }>Current results</h2>
					<p>{ concordanceAppliedSummary(lookup) } · { concordanceBookScope(lookup, books) } · { concordanceGrammarScope(lookup) }.</p>
					<p>{ concordanceResultRange(result) } · page { fmt.Sprintf("%d", result.Page) }{ concordanceMoreResultsText(result) }.</p>
					if len(result.Occurrences) == 0 && lookup.Page == 1 {
						<p>No current analyzed occurrences match this exact lookup.</p>
					}
					if len(result.Occurrences) == 0 && lookup.Page > 1 {
						<p>No results are available on this page. The search scope may have changed; use Previous or restart the lookup rather than treating this page as a zero-match search.</p>
					}
					if len(result.Occurrences) > 0 {
						<ol id="concordance-native-results" class="concordance-results" role="list">
						for _, occurrence := range result.Occurrences {
							<li class="concordance-result">
								<details class="concordance-row" name="concordance-occurrences" id={ concordanceOccurrenceID(occurrence) } tabindex="-1" autofocus?={ concordanceFocusMatches(occurrence, focusTarget) }>
									<summary aria-label={ "Occurrence of " + occurrence.Surface + " in " + occurrence.BookTitle }>
										<span class="concordance-book-title">{ occurrence.BookTitle }</span>
										<span class="concordance-before">{ concordanceBefore(occurrence) }</span>
										<strong class="concordance-surface">{ occurrence.Surface }</strong>
										<span class="concordance-after">{ concordanceAfter(occurrence) }</span>
									</summary>
									<div class="concordance-context">
										{{ before, target, after := concordanceSentenceParts(occurrence) }}
										<p class="reading-text">
											if target != "" {
												{ before }<strong class="concordance-observed-target">{ target }</strong>{ after }
											} else {
												{ occurrence.SentenceText }
											}
										</p>
									</div>
								</details>
                                <a class="concordance-study-link" aria-label="Study this sentence and its syntax" title="Study this sentence and its syntax" href={ templ.SafeURL(vocabularySentenceStudyURL(occurrence, lookup)) }><span aria-hidden="true">↗</span></a>
							</li>
						}
						</ol>
					}
					if result.HasPrevious || result.HasNext {
						<nav aria-label="Concordance pages">
							if result.HasPrevious {
							<a class="button button--outline" href={ templ.SafeURL(vocabularyConcordancePageURL(result.Page-1, lookup)) } hx-get={ templ.SafeURL(vocabularyConcordancePageURL(result.Page-1, lookup)) } hx-target="#concordance-results" hx-select="#concordance-results" hx-swap="outerHTML" hx-push-url="true" hx-sync="#concordance-workflow:replace" hx-config="timeout:9s" hx-indicator="#concordance-pending" hx-status:409="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:4xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:5xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false">Previous</a>
							}
							if result.HasNext {
							<a class="button button--outline" href={ templ.SafeURL(vocabularyConcordancePageURL(result.Page+1, lookup)) } hx-get={ templ.SafeURL(vocabularyConcordancePageURL(result.Page+1, lookup)) } hx-target="#concordance-results" hx-select="#concordance-results" hx-swap="outerHTML" hx-push-url="true" hx-sync="#concordance-workflow:replace" hx-config="timeout:9s" hx-indicator="#concordance-pending" hx-status:409="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:4xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false" hx-status:5xx="target:#concordance-recovery select:#concordance-recovery swap:outerHTML push:false">Next</a>
							}
						</nav>
					}
				</section>
				}
			}
		</div>
		}
}

templ VocabularySentenceStudyPageView(user domain.User, csrf string, study domain.SentenceStudy, back string) {
	@ShellLayout("Sentence study", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@PageHeader("Study this sentence and its syntax", "A complete source sentence with syntax attributed to the analyzer.", nil)
		<p><a href={ templ.SafeURL(back) }>Return to Concordance results</a></p>
		<section class="reading-width" aria-labelledby="sentence-study-heading">
			<h2 id="sentence-study-heading">{ study.BookTitle }</h2>
			<p>{ study.ChapterTitle } · sentence { fmt.Sprintf("%d", study.SentenceOrdinal+1) }</p>
			<p>Identified target: <strong>{ sentenceStudyTarget(study) }</strong></p>
			<p class="reading-text sentence-study-text">
				{ study.SentenceText }
			</p>
			if len(study.Tokens) == 0 {
				<p>Syntax evidence is unavailable for this sentence; the complete sentence remains available to study.</p>
			} else {
				<h3>Analyzer-attributed tokens</h3>
				<ol class="sentence-study-tokens">
					for _, token := range study.Tokens {
						<li>
							if token.Ordinal == study.TargetOrdinal {
								<strong>{ token.Surface } — identified target</strong>
							} else {
								<strong>{ token.Surface }</strong>
							}
							: <code>{ token.UPOS }</code>, lemma evidence <code>{ token.RawLemma }</code>, effective lemma <code>{ token.EffectiveLemma }</code>;
							dependency <code>{ token.Dependency }</code>, head { token.HeadSurface } (token { fmt.Sprintf("%d", token.HeadOrdinal+1) }).
							if token.Corrected {
								<span> Corrected for this occurrence.</span>
							}
							if token.Excluded {
								<span> Excluded from effective vocabulary; retained as syntax evidence.</span>
							}
						</li>
					}
				</ol>
				if study.GrammarDirection == "governor" {
					<h3>Relevant dependents · <code>{ study.Relation }</code></h3>
					<ul>
						for _, token := range sentenceStudyRelevantDependents(study) {
							<li>{ token.Surface } — token { fmt.Sprintf("%d", token.Ordinal+1) }, head { token.HeadSurface }, relation <code>{ token.Dependency }</code>{ concordanceDecisionLabelForStudy(token) }</li>
						}
					</ul>
				}
			}
		</section>
	}
}

func vocabularyConcordanceURL(lemma, upos, bookID string) string {
	values := url.Values{"mode": {"effective"}, "term": {lemma}, "upos": {upos}}
	if bookID != "" {
		values.Set("book", bookID)
	}
	return "/vocabulary/concordance?" + values.Encode()
}

func concordanceAppliedSummary(lookup domain.ConcordanceLookup) string {
	switch lookup.Mode {
	case "effective":
		return "Applied effective lemma + " + lookup.UPOS + " lookup for “" + lookup.Term + "”"
	case "analyzer":
		return "Applied analyzer lemma evidence + " + lookup.UPOS + " lookup for “" + lookup.Term + "”"
	default:
		return "Applied exact observed surface lookup for “" + lookup.Term + "”"
	}
}

func concordanceBookScope(lookup domain.ConcordanceLookup, books []domain.SourceMaterialSummary) string {
	if len(lookup.BookIDs) == 0 { return "all current Books" }
	titles := make([]string, 0, len(lookup.BookIDs))
	for _, bookID := range lookup.BookIDs {
		for _, book := range books {
			if book.BookID == bookID {
				titles = append(titles, concordanceBookTitle(book))
				break
			}
		}
	}
	if len(titles) == 0 { return "selected Book subset (unavailable or no current match)" }
	return strings.Join(titles, ", ")
}

func concordanceGrammarScope(lookup domain.ConcordanceLookup) string {
	if lookup.GrammarDirection == "own" { return "own relation: " + lookup.Relation }
	if lookup.GrammarDirection == "governor" { return "governor dependents, relation: " + lookup.Relation }
	return "no grammar filter"
}

func concordanceBookSelected(ids []string, candidate string) bool {
	for _, id := range ids { if id == candidate { return true } }
	return false
}

func concordanceBookTitle(book domain.SourceMaterialSummary) string {
	if book.BookTitle != "" { return book.BookTitle }
	return book.Source.Title
}

func concordanceOccurrenceID(occurrence domain.ConcordanceResultOccurrence) string {
	return fmt.Sprintf("occurrence-%s-%d-%d", occurrence.BookID, occurrence.SentenceOrdinal, occurrence.TokenOrdinal)
}

func concordanceFocusMatches(occurrence domain.ConcordanceResultOccurrence, focusTarget string) bool {
	return focusTarget != "" && focusTarget == concordanceOccurrenceID(occurrence)
}

func concordanceFocusFallsBackToSummary(occurrences []domain.ConcordanceResultOccurrence, focusTarget string) bool {
	if focusTarget == "" {
		return false
	}
	for _, occurrence := range occurrences {
		if concordanceFocusMatches(occurrence, focusTarget) {
			return false
		}
	}
	return true
}

func vocabularySentenceStudyURL(occurrence domain.ConcordanceResultOccurrence, lookup domain.ConcordanceLookup) string {
	values := url.Values{
		"book": {occurrence.BookID}, "run": {occurrence.AnalysisRunID}, "corpus": {occurrence.CorpusID},
		"unit": {occurrence.UnitID}, "sentence": {fmt.Sprintf("%d", occurrence.SentenceOrdinal)},
		"target": {fmt.Sprintf("%d", occurrence.TokenOrdinal)}, "target_surface": {occurrence.Surface},
	}
	if lookup.GrammarDirection != "" {
		values.Set("grammar", lookup.GrammarDirection)
		values.Set("relation", lookup.Relation)
	}
	focusTarget := concordanceOccurrenceID(occurrence)
	backValues, _ := url.Parse(vocabularyConcordancePageURL(lookup.Page, lookup))
	backQuery := backValues.Query()
	backQuery.Set("focus", focusTarget)
	backValues.RawQuery = backQuery.Encode()
	back := backValues.String() + "#" + url.PathEscape(focusTarget)
	values.Set("return", back)
	return "/vocabulary/concordance/sentence?" + values.Encode()
}

func sentenceStudyTarget(study domain.SentenceStudy) string {
	for _, token := range study.Tokens {
		if token.Ordinal == study.TargetOrdinal {
			return token.Surface
		}
	}
	if study.TargetSurface != "" { return study.TargetSurface + " (syntax evidence unavailable)" }
	return "Target unavailable in syntax evidence"
}

func sentenceStudyRelevantDependents(study domain.SentenceStudy) []domain.SentenceStudyToken {
	var target *domain.SentenceStudyToken
	for i := range study.Tokens {
		if study.Tokens[i].Ordinal == study.TargetOrdinal {
			target = &study.Tokens[i]
			break
		}
	}
	if target == nil { return nil }
	var relevant []domain.SentenceStudyToken
	for _, token := range study.Tokens {
		if token.HeadOrdinal == target.HeadOrdinal && token.Dependency == study.Relation {
			relevant = append(relevant, token)
		}
	}
	return relevant
}

func concordanceDecisionLabelForStudy(token domain.SentenceStudyToken) string {
	if token.Excluded { return " (excluded from effective vocabulary; retained as syntax evidence)" }
	if token.Corrected { return " (corrected for this occurrence)" }
	return ""
}

func concordanceResultRange(result domain.ConcordanceResult) string {
	if len(result.Occurrences) == 0 {
		return "No results on this page"
	}
	start := (result.Page-1)*25 + 1
	return fmt.Sprintf("Results %d–%d", start, start+len(result.Occurrences)-1)
}

func concordanceMoreResultsText(result domain.ConcordanceResult) string {
	if result.HasNext { return " · more results available" }
	return ""
}

func concordanceLocation(occurrence domain.ConcordanceResultOccurrence) string {
	if occurrence.ChapterTitle != "" {
		return occurrence.ChapterTitle
	}
	return "sentence " + fmt.Sprintf("%d", occurrence.SentenceOrdinal+1)
}

func concordanceDecisionLabel(occurrence domain.ConcordanceResultOccurrence) string {
	var labels []string
	if occurrence.Corrected {
		labels = append(labels, "corrected for this occurrence")
	}
	if occurrence.Excluded {
		labels = append(labels, "excluded from effective vocabulary; retained as analyzer evidence")
	}
	if len(labels) == 0 {
		return ""
	}
	return " (" + strings.Join(labels, "; ") + ")"
}

func concordanceBefore(occurrence domain.ConcordanceResultOccurrence) string {
	start := int(occurrence.SentenceStartOffset)
	if start < 0 || start > len(occurrence.SentenceText) {
		return "…"
	}
	runes := []rune(occurrence.SentenceText[:start])
	if len(runes) > 44 {
		runes = runes[len(runes)-44:]
		return "…" + string(runes)
	}
	return string(runes)
}

func concordanceAfter(occurrence domain.ConcordanceResultOccurrence) string {
	end := int(occurrence.SentenceEndOffset)
	if end < 0 || end > len(occurrence.SentenceText) {
		return "…"
	}
	runes := []rune(occurrence.SentenceText[end:])
	if len(runes) > 44 {
		return string(runes[:44]) + "…"
	}
	return string(runes)
}

func concordanceSentenceParts(occurrence domain.ConcordanceResultOccurrence) (string, string, string) {
	start := int(occurrence.SentenceStartOffset)
	end := int(occurrence.SentenceEndOffset)
	text := occurrence.SentenceText
	if start < 0 || end <= start || end > len(text) || text[start:end] != occurrence.Surface {
		return "", "", ""
	}
	return text[:start], text[start:end], text[end:]
}

templ VocabularyConcordanceErrorPageView(user domain.User, csrf, language string, books []domain.SourceMaterialSummary, lookup domain.ConcordanceLookup, timeout bool) {
	@ShellLayout("Concordance", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@VocabularyPageHeader("concordance")
		<p>Active study language: <code>{ language }</code>.</p>
		@VocabularyConcordanceErrorRecovery(books, lookup, timeout)
	}
}

templ VocabularyConcordanceErrorRecovery(books []domain.SourceMaterialSummary, lookup domain.ConcordanceLookup, timeout bool) {
	<div id="concordance-recovery" aria-live="polite">
		if timeout {
			@Feedback(FeedbackError, "Concordance server timed out", "The server could not complete this search in time. Your current results, if shown, remain under their old applied label; retry or narrow the Book scope. A timeout is not a zero-result claim.")
		} else {
			@Feedback(FeedbackError, "Concordance lookup was not applied", "The search did not complete. Retry it, or narrow the term or Book scope. A failed search is not a zero-result claim.")
		}
		<form method="get" action="/vocabulary/concordance">
			<input type="hidden" name="mode" value={ lookup.Mode }/><input type="hidden" name="term" value={ lookup.Term }/><input type="hidden" name="upos" value={ lookup.UPOS }/>
			if lookup.GrammarDirection != "" {
				<input type="hidden" name="grammar" value={ lookup.GrammarDirection }/><input type="hidden" name="relation" value={ lookup.Relation }/>
			}
			<input type="hidden" name="page" value="1"/>
			<fieldset><legend>Books for this search (leave all unchecked to search all current Books)</legend>
				for _, book := range books {
					<label><input type="checkbox" name="book" value={ book.BookID } checked?={ concordanceBookSelected(lookup.BookIDs, book.BookID) }/>{ concordanceBookTitle(book) }</label>
				}
			</fieldset>
			<button class="button" type="submit">Retry Concordance lookup from page 1</button>
		</form>
		<p>For an unusually broad query, select one or a few Books above. Retry begins at page 1 so it cannot silently skip matches after a scope change.</p>
	</div>
}

templ VocabularyConcordanceChangedPageView(user domain.User, csrf, language string, books []domain.SourceMaterialSummary, lookup domain.ConcordanceLookup) {
	@ShellLayout("Concordance", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@VocabularyPageHeader("concordance")
		<p>Active study language: <code>{ language }</code>.</p>
		@VocabularyConcordanceChangedRecovery(books, lookup)
	}
}

templ VocabularyConcordanceChangedRecovery(books []domain.SourceMaterialSummary, lookup domain.ConcordanceLookup) {
	<div id="concordance-recovery" aria-live="polite">
		@Feedback(FeedbackWarning, "Current evidence changed", "This page was not applied because analyses or occurrence corrections changed after the previous result page. Restart to avoid silently skipping or repeating matches.")
		<a class="button button--outline" href={ templ.SafeURL(vocabularyConcordanceRestartURL(lookup)) }>Restart from results</a>
		<form method="get" action="/vocabulary/concordance">
			<input type="hidden" name="mode" value={ lookup.Mode }/><input type="hidden" name="term" value={ lookup.Term }/><input type="hidden" name="upos" value={ lookup.UPOS }/>
			if lookup.GrammarDirection != "" {
				<input type="hidden" name="grammar" value={ lookup.GrammarDirection }/><input type="hidden" name="relation" value={ lookup.Relation }/>
			}
			for _, book := range books {
				<label><input type="checkbox" name="book" value={ book.BookID } checked?={ concordanceBookSelected(lookup.BookIDs, book.BookID) }/>{ concordanceBookTitle(book) }</label>
			}
			<button class="button" type="submit">Retry with current evidence</button>
		</form>
	</div>
}

templ VocabularyBrowseErrorPageView(user domain.User, csrf, language string, query domain.VocabularyBrowseQuery) {
	@ShellLayout("Vocabulary", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@VocabularyPageHeader("browse")
		<div id="vocabulary-recovery" aria-live="polite">
		<p>Active study language: <code>{ language }</code>.</p>
		@Feedback(FeedbackError, "Browse could not be loaded", "Your search was not applied. Retry with this prefix or a shorter one. A failed request is not an empty result.")
		<form method="get" action="/vocabulary">
			<input type="hidden" name="q" value={ query.Prefix }/>
			<input type="hidden" name="reading" value={ query.ReadingBookID }/>
			<input type="hidden" name="page" value={ fmt.Sprintf("%d", query.Page) }/>
		if query.IncludeAll {
			<input type="hidden" name="all" value="1"/>
		}
		if query.Revision != "" {
			<input type="hidden" name="rev" value={ query.Revision }/>
		}
		<button type="submit">Retry Browse</button>
		</form>
		<a class="vocabulary-action-link" href="/vocabulary">Clear search</a>
		<p>Browse does not report partial counts as complete.</p>
		</div>
	}
}

templ VocabularyBrowseChangedPageView(user domain.User, csrf, language string, query domain.VocabularyBrowseQuery) {
	@ShellLayout("Vocabulary", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@VocabularyPageHeader("browse")
		<div id="vocabulary-recovery" aria-live="polite">
		<p>Active study language: <code>{ language }</code>.</p>
		@Feedback(FeedbackWarning, "Current evidence changed", "These results were not applied because the current Book or corpus changed since this page was requested. Restart in the Current reading to avoid silently switching Books or skipping identities.")
		<a role="button" href={ templ.SafeURL(vocabularyBrowsePageURL(1, domain.VocabularyBrowsePage{CurrentBookID: query.CurrentBookID, IncludeAll: query.IncludeAll}, query.Prefix)) }>Restart in the Current reading</a>
		<a class="vocabulary-action-link" href="/vocabulary">Clear search</a>
		</div>
	}
}

templ VocabularyBrowsePager(page domain.VocabularyBrowsePage, query string) {
	<section aria-label="Vocabulary pages"><p>{ fmt.Sprintf("Page %d of %d", page.Page, (int(page.Total)+24)/25) }</p><nav aria-label="Browse pages">
		if page.Page > 1 {
			<a class="btn btn-outline" href={ templ.SafeURL(vocabularyBrowsePageURL(page.Page-1, page, query)) } hx-get={ templ.SafeURL(vocabularyBrowsePageURL(page.Page-1, page, query)) } hx-target="#vocabulary-browse-results" hx-select="#vocabulary-browse-results" hx-swap="outerHTML" hx-push-url="true" hx-sync="#vocabulary-workflow:replace" hx-config="timeout:9s" hx-indicator="#vocabulary-pending" hx-status:409="target:#vocabulary-recovery select:#vocabulary-recovery swap:outerHTML push:false" hx-status:4xx="target:#vocabulary-recovery select:#vocabulary-recovery swap:outerHTML push:false" hx-status:5xx="target:#vocabulary-recovery select:#vocabulary-recovery swap:outerHTML push:false">Previous</a>
		}
		if page.Page*25 < int(page.Total) {
			<a class="btn btn-outline" href={ templ.SafeURL(vocabularyBrowsePageURL(page.Page+1, page, query)) } hx-get={ templ.SafeURL(vocabularyBrowsePageURL(page.Page+1, page, query)) } hx-target="#vocabulary-browse-results" hx-select="#vocabulary-browse-results" hx-swap="outerHTML" hx-push-url="true" hx-sync="#vocabulary-workflow:replace" hx-config="timeout:9s" hx-indicator="#vocabulary-pending" hx-status:409="target:#vocabulary-recovery select:#vocabulary-recovery swap:outerHTML push:false" hx-status:4xx="target:#vocabulary-recovery select:#vocabulary-recovery swap:outerHTML push:false" hx-status:5xx="target:#vocabulary-recovery select:#vocabulary-recovery swap:outerHTML push:false">Next</a>
		}
	</nav></section>
}

func vocabularyBrowseState(row domain.VocabularyBrowseRow) string {
	state := "Unknown"
	if row.Known {
		state = "Known"
	}
	if row.Reserved {
		if row.Known {
			return "Known · Reserved"
		}
		state = "Reserved"
	}
	return state
}

func vocabularyBookEvidenceState(book domain.VocabularyBrowseBook) string {
	if book.HasVocabularyEvidence {
		return "Contributes current eligible vocabulary evidence"
	}
	if book.HasCurrentAnalysis {
		return "Current analysis; no eligible vocabulary occurrences"
	}
	return "No current completed analysis"
}

templ VocabularyPageWithResult(user domain.User, csrf string, languages, knownLanguages []domain.StudyLanguage, language string, result *knownvocab.ImportResult, message string) {
	@ShellLayout("Vocabulary", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@VocabularyPageHeader("import")
		<section id="known-vocabulary" class="known-vocabulary">
		if language == "" {
			if len(languages) == 0 {
				@EmptyState("No study languages yet", "Add or sync a book with a chosen language before importing known vocabulary.") {
					<a href="/catalogs">Connect a catalog</a>
				}
			} else {
				<p>Choose a study language in the shell before importing a lemma file.</p>
			}
		} else {
			if len(languages) == 0 {
				<p>This language is preserved from earlier vocabulary imports, but it is not currently represented by a chosen-language book.</p>
			}
			<p>Viewing <strong>{ vocabularyLanguageName(languages, knownLanguages, language) }</strong> <code>{ language }</code>. Imports are additive and idempotent: new, duplicate, and rejected rows are reported separately.</p>
			if studyLanguagePresent(languages, language) {
				<form class="vocabulary-import-form" method="post" action="/vocabulary/import" enctype="multipart/form-data" hx-post={ knownVocabImportAction() } hx-encoding="multipart/form-data" hx-target="#vocabulary-results" hx-swap="innerHTML" hx-indicator="#vocabulary-import-pending"><input type="hidden" name="csrf_token" value={ csrf }/><label for="known-vocabulary-file">UTF-8 lemma file</label><input id="known-vocabulary-file" type="file" name="vocabulary_file" accept="text/plain,.txt" required/><small>One lemma per nonblank line. Tab-separated columns are rejected.</small><button class="btn btn-primary" type="submit">Import known vocabulary</button><p id="vocabulary-import-pending" class="htmx-indicator" role="status">Importing known vocabulary. Keep this page open while the request completes.</p></form>
			} else {
				<p>This language is preserved from earlier vocabulary imports, but it is not currently represented by a chosen-language book. Importing is unavailable until a book in this language is added.</p>
			}
		}
		</section>
		<section id="vocabulary-results" aria-live="polite">@KnownVocabResult(result, message)</section>
	}
}
templ KnownVocabResult(result *knownvocab.ImportResult, message string) {
	if message != "" {
		@Feedback(FeedbackError, "Import not completed", message)
	}
	if result != nil {
		<article class="resource-card vocabulary-callout known-vocabulary-result"><h2>Import result</h2><p role="status"><strong>{ fmt.Sprintf("%d new", result.Imported) }</strong> · { fmt.Sprintf("%d duplicates", result.AlreadyKnown) } · { fmt.Sprintf("%d rejected", len(result.Rejected)) }</p>
		if len(result.Rejected) > 0 {
			<h3>Rejected rows</h3>
			@ResponsiveTable("Rejected vocabulary rows") {
				<thead><tr><th>Row</th><th>Original</th><th>Reason</th></tr></thead><tbody>
				for _, rejection := range result.Rejected {
					<tr><td>{ fmt.Sprintf("%d", rejection.Row) }</td><td><code>{ rejection.Original }</code></td><td>{ rejection.Error }</td></tr>
				}
				</tbody>
			}
			}
		</article>
	}
}
templ KnownVocabImportStatus(status knownvocab.Status) {
	@AsyncStatus(knownVocabImportAttributes(status), "known-vocab-import-status", knownVocabImportTitle(status), knownVocabImportSummary(status), int(status.Processed), int(status.Total), knownVocabJobBusy(string(status.State))) {
		@knownVocabImportStatusBody(status)
	}
}
templ KnownVocabImportStatusPage(user domain.User, csrf string, status knownvocab.Status) {
	@ShellLayout("Known vocabulary import", &user, csrf, NavigationVocabulary, shellStyleVocabulary) {
		@VocabularyPageHeader("import")
		@KnownVocabImportStatus(status)
		if knownVocabJobBusy(string(status.State)) {
			<p><a class="vocabulary-action-link" href="/vocabulary/import">Return to Vocabulary</a></p>
		}
	}
}
templ EnrichmentJobStatus(status enrichmentjob.Status, csrf string) {
	@AsyncStatus(enrichmentJobAttributes(status), "enrichment-job-status", "Contextual translations: "+enrichmentJobLabel(string(status.State)), enrichmentJobSummary(status), int(status.Completed), int(status.Total), status.State != "completed" && status.State != "cancelled" && status.State != "discarded") {
		if status.Error != "" {
			@Feedback(FeedbackError, "Translation needs attention", status.Error+" Review the affected book and try again when the provider is available.")
		}
		if status.State != "completed" && status.State != "cancelled" && status.State != "discarded" {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/enrichment-jobs/%d/cancel", status.ID)) } hx-post={ fmt.Sprintf("/enrichment-jobs/%d/cancel", status.ID) } hx-target="#enrichment-job-status" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value={ csrf }/><button class="button button--outline" type="submit">Cancel translations</button></form>
		}
	}
}
templ knownVocabImportStatusBody(status knownvocab.Status) {
		if knownVocabJobBusy(string(status.State)) {
			<p>Return to Vocabulary to review the result after processing finishes.</p>
		}
		if status.State == "completed" {
			if len(status.Rejected) > 0 {
				<p><strong>Import completed with partial rejection.</strong> Successful rows remain known; correct the rejected rows and upload another additive import if needed.</p>
			} else {
				<p><strong>Import complete.</strong></p>
			}
			if len(status.Rejected) > 0 {
				<h3>Rejected rows</h3>@ResponsiveTable("Rejected vocabulary rows") {
					<thead><tr><th>Row</th><th>Original</th><th>Reason</th></tr></thead><tbody>
					for _, rejection := range status.Rejected {
						<tr><td>{ fmt.Sprintf("%d", rejection.Row) }</td><td><code>{ rejection.Original }</code></td><td>{ rejection.Error }</td></tr>
					}
					</tbody>
				}
				}
				<p><a href={ templ.SafeURL(knownVocabImportRecoveryTarget()) }>Return to Vocabulary to import more known vocabulary</a></p>
		}
		if status.State == "completed" || status.State == "discarded" || status.State == "cancelled" {
			<p><strong>{ fmt.Sprintf("%d new", status.Imported) }</strong> · { fmt.Sprintf("%d duplicates", status.AlreadyKnown) } · { fmt.Sprintf("%d rejected", len(status.Rejected)) }</p>
		}
		if status.Error != "" && status.State != "cancelled" && status.State != "discarded" {
			<p role="alert"><strong>Import failed:</strong> { status.Error } Upload the original file again after correcting the problem.</p>
		}
		if status.State == "cancelled" {
			<p role="alert"><strong>Import cancelled.</strong> No new result is available from this attempt. Upload the file again when ready.</p>
			if status.Language != "" {
				<p>Selected language: <code>{ status.Language }</code></p>
			}
			<p><a href={ templ.SafeURL(knownVocabImportRecoveryTarget()) }>Return to Vocabulary to retry the import</a></p>
		}
		if status.State == "discarded" {
			<p role="alert"><strong>Import failed.</strong>
			if status.Error != "" {
				{ status.Error }
			}
			The job was discarded after repeated attempts. Upload the file again after correcting the problem.</p>
			if status.Language != "" {
				<p>Selected language: <code>{ status.Language }</code></p>
			}
			<p><a href={ templ.SafeURL(knownVocabImportRecoveryTarget()) }>Return to Vocabulary to retry the import</a></p>
		}
}

templ DeckJourneyAction(action deckJourneyActionView) {
	if action.State != deckJourneyUnknown {
		<div id={ deckJourneyActionID(action.BookID) } role="status" aria-live="polite" aria-atomic="true">
			if action.Message != "" {
				if strings.Contains(action.Message, "changed since") {
					<p role="alert">{ action.Message }</p>
				} else {
					<p role="status">{ action.Message }</p>
				}
			}
			if action.Error != "" {
				<p role="alert">{ action.Error }</p>
			}
			if action.State == deckJourneyNotMember {
				<p><strong>Not in To Read.</strong> Manage this book's disposition in <a href="/library">My Books</a>.</p>
			} else if action.State == deckIsToRead {
				<p><strong>To Read.</strong> This book is already in To Read.</p>
				<p><a href={ templ.SafeURL("/reading#"+journeyBookAnchorID(action.BookID)) }>View in Reading</a></p>
			} else if action.State == deckIsCurrentReading {
				<p><strong>Current Book.</strong> This deck is preparation for the Book you are reading now.</p>
				<p><a href={ templ.SafeURL("/reading#"+journeyBookAnchorID(action.BookID)) }>View current book in Reading</a></p>
			}
		</div>
	}
}

templ JobsPageWithCatalogueSync(user domain.User, csrf string, jobs []domain.AnalysisJob, syncJobs []cataloguesync.Status, message string, readingBookURLs map[string]string) {
	@ShellLayout("Jobs", &user, csrf, NavigationLibrary, shellStyleJobs) {
		@PageHeader("Jobs", "Operational history for catalog sync and analysis work.", nil)
		if message != "" {
			@Feedback(FeedbackInfo, "", message)
		}
		if len(jobs) == 0 && len(syncJobs) == 0 {
			@EmptyState("No jobs yet", "Catalog sync and analysis work will appear here when submitted.") { <a href="/library">Go to My Books</a> }
		}
		if len(syncJobs) > 0 {
			@ResponsiveTable("Catalog sync history") {
				<thead><tr><th>Kind</th><th>Connection</th><th>Status</th><th>Attempt</th><th>Created</th><th>Error</th></tr></thead><tbody>
				for _, job := range syncJobs {
					<tr><td><a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", job.ID)) }>Catalog sync</a></td><td>{ job.ConnectionName }</td><td>{ catalogueSyncJobState(job) }</td><td>{ fmt.Sprintf("%d", job.Attempt) }</td><td>{ job.CreatedAt.Format("2006-01-02 15:04") }</td><td>{ job.Error }</td></tr>
				}
				</tbody>
			}
		}
		if len(jobs) > 0 {
			@ResponsiveTable("Analysis history") {
				<thead><tr><th>Kind</th><th>Job</th><th>Status</th><th>Progress</th><th>Created</th><th>Error</th></tr></thead><tbody>
				for _, job := range jobs {
					<tr><td>Analysis</td><td>
						if url := readingBookURLs[job.SourceMaterialID]; url != "" && job.AnalysisState == "completed" && job.AnalysisRunID != "" && job.CorpusID != "" {
							<a href={ templ.SafeURL(url) }>{ fmt.Sprintf("#%d · result", job.DisplayNumber) }</a>
						} else {
							<a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", job.ID)) }>{ fmt.Sprintf("#%d", job.DisplayNumber) }</a>
						}
					</td><td>@StatusBadge(analysisJobStatusLabel(job.AnalysisState), analysisJobStatusTone(job.AnalysisState))</td><td><progress aria-label={ fmt.Sprintf("Analysis job %d progress", job.DisplayNumber) } value={ fmt.Sprintf("%d",job.Progress) } max="100"></progress> { fmt.Sprintf("%d%%",job.Progress) }</td><td>{ job.CreatedAt.Format("2006-01-02 15:04") }</td><td>{ job.Error }</td></tr>
				}
				</tbody>
			}
		}
	}
}

templ CatalogueSyncJobPage(user domain.User, csrf string, status cataloguesync.Status) {
	@ShellLayout(fmt.Sprintf("Catalog sync #%d", status.ID), &user, csrf, NavigationLibrary, shellStyleJobs) {
		@PageHeader("Catalog sync", status.ConnectionName, nil)
		@CatalogueSyncJobStatus(csrf, status)
	}
}

templ CatalogueSyncJobStatus(csrf string, status cataloguesync.Status) {
	@AsyncStatus(catalogueSyncJobStatusAttributes(status.ID, catalogueSyncStatusRunning(status)), "catalogue-sync-job-status", catalogueSyncJobState(status), catalogueSyncJobSummary(status), status.Progress, 100, catalogueSyncStatusRunning(status)) {
		if status.Error != "" {
			@Feedback(FeedbackError, "Catalog sync needs attention", status.Error)
		}
		@ActionGroup() {
			if status.LogicalState == "failed" || status.LogicalState == "cancelled" {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/retry", status.ID)) }><input type="hidden" name="csrf_token" value={ csrf }/><button class="button" type="submit">Retry catalog sync</button></form>
			}
			if catalogueSyncStatusRunning(status) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/cancel", status.ID)) }><input type="hidden" name="csrf_token" value={ csrf }/><button class="button button--outline" type="submit">Cancel catalog sync</button></form>
			}
		}
		<p>Catalog sync reconciles metadata only; it does not download EPUB content.</p>
	}
}

templ JourneyDeckPreparationPage(user domain.User, csrf string, task journeyDeckPreparationView, resultURL string) {
	@ShellLayout("Prepare deck · "+canonicalBookTitle(task.Book), &user, csrf, NavigationReadingJourney, shellStyleReading) {
		@Breadcrumb(resultURL, "Reading")
		@PageHeader("Prepare a deck", canonicalBookTitle(task.Book), StatusBadge("Exact source", StatusInfo))
		<section class="narrow" aria-labelledby="journey-deck-task-heading">
		<h2 id="journey-deck-task-heading">Deck preparation task</h2>
		<p>This task belongs to <strong>{ canonicalBookTitle(task.Book) }</strong>. Preparation never changes reading state, Known vocabulary, or Reserved vocabulary.</p>
		<dl>
			<dt>Book language</dt><dd>{ task.Book.Source.Language }</dd>
			<dt>Current analysis</dt><dd><code>{ task.AnalysisRunID }</code> from the current EPUB snapshot <code>{ task.Book.Source.ContentSnapshotID }</code></dd>
			if task.Goal {
				<dt>Frozen reading snapshot</dt><dd><code>{ task.GoalSnapshotID }</code> · { fmt.Sprintf("%d frozen identities", task.GoalSnapshotSize) }</dd>
			}
		</dl>
		if task.Unavailable {
			@Feedback(FeedbackWarning, "Deck preparation unavailable", "The preparation service could not verify this exact source. No deck action was started.")
		} else if task.Goal {
			if task.GoalSnapshotSize == 0 {
				@EmptyState("No deck needed", "This frozen reading snapshot contains no vocabulary identities, so no cards will be created.")
			} else if task.Preparation != nil {
				@DeckPreparationStatus(csrf, *task.Preparation, resultURL, deckJourneyActionView{BookID: task.BookID, State: deckIsCurrentReading})
			} else {
				<p role="note"><strong>Deck state: Missing.</strong> This exact reading snapshot remains unchanged. Prepare it when ready.</p>
				<form method="post" action={ templ.SafeURL("/reading/books/"+url.PathEscape(task.BookID)+"/deck/preparations") } data-prepare-deck>
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<button type="submit">Prepare deck</button>
				</form>
				<section data-deck-preparation role="status" aria-live="polite" aria-atomic="true" hidden></section>
			}
		} else if task.Preparation != nil {
			@DeckPreparationStatus(csrf, *task.Preparation, resultURL, deckJourneyActionView{BookID: task.BookID, State: deckIsToRead})
		} else {
			if task.Missing {
				<p role="note"><strong>Deck state: Not prepared.</strong> No artifact exists for this exact current analysis.</p>
			}
			<form method="post" action={ templ.SafeURL("/reading/books/"+url.PathEscape(task.BookID)+"/deck/preparations") } data-prepare-deck>
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<p>Preparation uses the configured translation provider to create contextual Glosses. Only the target, one representative sentence, and public lexical evidence are sent. If the provider is unavailable, preparation fails without creating a local-only deck; configure it and retry.</p>
				<button type="submit">Prepare deck</button>
			</form>
			<section data-deck-preparation role="status" aria-live="polite" aria-atomic="true" hidden></section>
		}
		<p><a href={ templ.SafeURL(resultURL) }>Back to this Book in Reading</a></p>
		</section>
	}
}

templ ReadingChooserPage(user domain.User, csrf string, chooser readingChooserPageView, message string, pageError string) {
	@ShellLayout(readingChooserPageTitle(chooser), &user, csrf, NavigationReadingJourney, shellStyleReading) {
		@PageHeader(readingChooserPageTitle(chooser), readingChooserPageDescription(chooser), nil) {
			if chooser.CurrentBookID != "" {
			<a class="button button--outline" href="/reading">Return to current reading</a>
			} else {
			<a class="button button--outline" href="/library?disposition=to_read">Review To Read books</a>
			}
		}
		if message != "" {
			@Feedback(FeedbackSuccess, "", message)
		}
		if pageError != "" {
			@Feedback(FeedbackError, "Action needed", pageError)
		}
		if chooser.LanguageHandoff != nil {
			@ReadingLanguageHandoff(*chooser.LanguageHandoff, chooser.LanguageLabel, chooser.ActiveLanguageLabel, csrf)
		}
		if chooser.Language == "" {
			<section class="reading-chooser-empty" aria-labelledby="reading-chooser-no-language-heading">
				<h2 id="reading-chooser-no-language-heading">Choose a study language</h2>
				<p>Reading candidates appear after My Books has a book with a chosen language.</p>
				<a class="button button--outline" href="/library">Open My Books</a>
			</section>
		}
		if chooser.Language != "" && readingChooserCandidateCount(chooser) == 0 {
			<section class="reading-chooser-empty" aria-labelledby="reading-chooser-empty-heading">
				if chooser.CurrentBookID != "" {
					<h2 id="reading-chooser-empty-heading">No other eligible To Read books</h2>
					<p>Your current book remains unchanged. Move another book to To Read or return to your current reading.</p>
					<a class="button button--outline" href="/reading">Return to current reading</a>
				} else {
					<h2 id="reading-chooser-empty-heading">No To Read books yet</h2>
					<p>Move a book to To Read in My Books when you may want to read it. You can leave other books in Inbox or set them aside.</p>
					<a class="button button--outline" href="/library">Browse My Books</a>
				}
			</section>
		}
		if chooser.Language != "" && readingChooserCandidateCount(chooser) > 0 {
			if len(chooser.At99Plus)+len(chooser.At97To99)+len(chooser.At95To97)+len(chooser.Below95)+len(chooser.NoComparison) > 0 {
				<p>Coverage compares currently Known vocabulary with analyzable tokens in each current analysis. Bands use exact token counts; displayed percentages are rounded.</p>
			}
			@ReadingChooserBand("99% or above", "At least 99% of analyzable tokens match Known vocabulary.", chooser.At99Plus, csrf, chooser.CurrentBookID, chooser.CurrentSnapshotID)
			@ReadingChooserBand("97% to below 99%", "At least 97% and below 99% of analyzable tokens match Known vocabulary.", chooser.At97To99, csrf, chooser.CurrentBookID, chooser.CurrentSnapshotID)
			@ReadingChooserBand("95% to below 97%", "At least 95% and below 97% of analyzable tokens match Known vocabulary.", chooser.At95To97, csrf, chooser.CurrentBookID, chooser.CurrentSnapshotID)
			@ReadingChooserBand("Below 95%", "Below 95% of analyzable tokens match Known vocabulary.", chooser.Below95, csrf, chooser.CurrentBookID, chooser.CurrentSnapshotID)
			@ReadingChooserBand("No vocabulary comparison", "Analysis completed, but there are no analyzable tokens for a numeric coverage comparison.", chooser.NoComparison, csrf, chooser.CurrentBookID, chooser.CurrentSnapshotID)
			if len(chooser.InProgress) > 0 {
				<section aria-labelledby="reading-chooser-in-progress-heading">
					<h2 id="reading-chooser-in-progress-heading">Analysis in progress</h2>
					<p>Accepted analysis work remains visible here while it runs.</p>
					<ul class="reading-chooser-list" role="list">
						for _, item := range chooser.InProgress {
							@ReadingChooserBook(item, csrf, chooser.CurrentBookID, chooser.CurrentSnapshotID)
						}
					</ul>
				</section>
			}
			if len(chooser.Attention) > 0 {
				<section aria-labelledby="reading-chooser-attention-heading">
					<h2 id="reading-chooser-attention-heading">Needs attention</h2>
					<p>These candidates need current content or usable analysis before their coverage can be compared.</p>
					<ul class="reading-chooser-list" role="list">
						for _, item := range chooser.Attention {
							@ReadingChooserBook(item, csrf, chooser.CurrentBookID, chooser.CurrentSnapshotID)
						}
					</ul>
				</section>
			}
		}
	}
}

templ ReadingChooserBand(title, description string, books []readingChooserBookView, csrf, currentBookID, currentSnapshotID string) {
	if len(books) > 0 {
		<section aria-label={ title }>
			<h2>{ title }</h2>
			<p>{ description }</p>
			<ul class="reading-chooser-list" role="list">
				for _, item := range books {
					@ReadingChooserBook(item, csrf, currentBookID, currentSnapshotID)
				}
			</ul>
		</section>
	}
}

templ ReadingChooserBook(item readingChooserBookView, csrf, currentBookID, currentSnapshotID string) {
	<li class="reading-chooser-book">
		<article class="resource-card">
			<h3 class="bibliographic-title">{ readingChooserBookTitle(item.Book) }</h3>
			if author := strings.TrimSpace(item.Book.Book.Author); author != "" {
				<p>By { author }</p>
			}
			if item.Coverage != nil {
				<p class="numeric"><strong>Current coverage:</strong> { readingChooserCoverageDisplay(*item.Coverage) } ({ item.Coverage.KnownTokenCount } of { item.Coverage.AnalyzableTokenCount } analyzable tokens)</p>
				<p class="numeric">{ readingChooserNextMarkerText(*item.Coverage, item.Band) }</p>
				<details>
					<summary>Coverage investment at 95%, 97%, and 99%</summary>
					<ul>
					for _, threshold := range item.Coverage.Thresholds {
						if threshold.TargetPercent == 95 || threshold.TargetPercent == 97 || threshold.TargetPercent == 99 {
							<li class="numeric">{ readingChooserThresholdText(threshold) }</li>
						}
					}
					</ul>
					<p>Investment counts eligible vocabulary identities, not deck size.</p>
				</details>
				if currentBookID != "" {
					@Confirmation("Switch to this book", "Switching atomically releases the current book's active reservation and freezes this To Read book's current analysis snapshot. The former current book remains To Read; its analysis, decks, and history remain. You can start either book again later.", StatusNeutral) {
						<form method="post" action={ templ.SafeURL("/reading/books/" + item.Book.Book.ID + "/switch") }>
							<input type="hidden" name="csrf_token" value={ csrf }/>
							<input type="hidden" name="expected_current_book_id" value={ currentBookID }/>
							<input type="hidden" name="expected_current_snapshot_id" value={ currentSnapshotID }/>
						<button class="button" type="submit">Confirm switch to this book</button>
						</form>
					}
				} else {
					@Confirmation("Start reading", "Starting this book makes it your current reading and freezes its current analysis and vocabulary snapshot.", StatusNeutral) {
						<form method="post" action={ templ.SafeURL("/reading/books/" + item.Book.Book.ID + "/start") }>
							<input type="hidden" name="csrf_token" value={ csrf }/>
						<button class="button" type="submit">Confirm start reading</button>
						</form>
					}
				}
				<p><a href={ templ.SafeURL("/reading/books/"+item.Book.Book.ID+"/lemma-review") }>Review a word in this Book</a></p>
			} else {
				<p><strong>{ readingChooserStateLabel(item.State) }</strong> — { item.Description }</p>
				if item.State == readingChooserInProgress {
					if item.Book.Acquired.AnalysisJobID > 0 {
						<a href={ templ.SafeURL(readingChooserAnalysisJobURL(item.Book.Acquired.AnalysisJobID)) }>Review analysis progress</a>
					} else {
						<a href="/library?disposition=to_read">Review To Read books</a>
					}
				} else if item.State == readingChooserNeedsAttention {
					<form method="post" action={ templ.SafeURL("/reading/books/" + item.Book.Book.ID + "/reanalyze") }>
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<button class="button" type="submit">Retry acquisition or analysis</button>
					</form>
				}
			}
		</article>
	</li>
}

templ VocabularyViewsNav(active string) {
	<nav aria-label="Vocabulary views">
		if active == "browse" {
			<a href="/vocabulary" aria-current="page">Browse</a>
		} else {
			<a href="/vocabulary">Browse</a>
		}
		if active == "concordance" {
			<a href="/vocabulary/concordance" aria-current="page">Concordance</a>
		} else {
			<a href="/vocabulary/concordance">Concordance</a>
		}
		if active == "import" {
			<a href="/vocabulary/import" aria-current="page">Import Known words</a>
		} else {
			<a href="/vocabulary/import">Import Known words</a>
		}
	</nav>
}

templ VocabularyPageHeader(active string) {
	<header class="vocabulary-page-header">
		<h1>Vocabulary</h1>
		@VocabularyViewsNav(active)
	</header>
}
