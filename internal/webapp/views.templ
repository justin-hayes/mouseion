package webapp

import (
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/justin-hayes/mouseion/internal/analysis"
	"github.com/justin-hayes/mouseion/internal/domain"
	"github.com/justin-hayes/mouseion/internal/enrichmentjob"
	"github.com/justin-hayes/mouseion/internal/knownvocab"
	"github.com/justin-hayes/mouseion/internal/lemmadisplay"
	"github.com/justin-hayes/mouseion/internal/lexical"
	"github.com/justin-hayes/mouseion/internal/opds"
)

templ Layout(title string, user *domain.User, csrf string) {
	@ShellLayout(title, user, csrf, navigationContextForTitle(title))
}

templ ShellLayout(title string, user *domain.User, csrf string, context NavigationContext) {
	<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{ title } · Mouseion</title><link rel="stylesheet" href="/static/vendor/pico-2.1.1.min.css"/><link rel="stylesheet" href="/static/app.css"/><script src="/static/vendor/htmx-2.0.7.min.js" defer></script><script>
window.escapeHtml = function (s) {
  return String(s).replace(/[&<>"']/g, function (c) {
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
};
document.addEventListener('htmx:responseError', function (evt) {
  var target = evt.detail.target;
  if (!target) return;
  var text = ((evt.detail.xhr && evt.detail.xhr.responseText) || 'Request failed').trim();
  var workflowNode = target.closest && target.closest('[data-workflow]');
  var workflow = workflowNode ? workflowNode.getAttribute('data-workflow') : 'This operation';
  target.innerHTML = '<article role="alert"><strong>' + window.escapeHtml(workflow) + ' could not be updated:</strong> ' + window.escapeHtml(text) + '<p><small>Review this operation or try again.</small></p></article>';
});
document.addEventListener('submit', function (evt) {
  var form = evt.target.closest && evt.target.closest('form[data-acquire]');
  if (!form) return;
  var button = form.querySelector('button[type="submit"]');
  if (button) { button.disabled = true; button.setAttribute('aria-busy', 'true'); button.textContent = 'Adding to My Books…'; }
});
document.addEventListener('submit', async function (evt) {
  var form = evt.target.closest && evt.target.closest('form[data-prepare-deck]');
  if (!form) return;
  evt.preventDefault();
  var button = form.querySelector('button[type="submit"]');
  var status = form.parentElement.querySelector('[data-deck-preparation]');
  if (button) { button.disabled = true; button.setAttribute('aria-busy', 'true'); button.textContent = 'Preparing deck…'; }
  try {
    var response = await fetch(form.action, {method: 'POST', body: new FormData(form), credentials: 'same-origin', headers: {'Accept': 'application/json'}});
    if (!response.ok) {
      var detail = (await response.text()).trim();
      throw new Error(detail || ('Request failed with status ' + response.status));
    }
    form.hidden = true;
    status.hidden = false;
    await window.pollDeckPreparation(response.url, status, form);
  } catch (error) {
    status.hidden = false;
    status.innerHTML = '<p role="alert">Deck preparation could not start: ' + window.escapeHtml(error && error.message ? error.message : 'Please try again.') + '</p>';
    if (button) { button.disabled = false; button.removeAttribute('aria-busy'); button.textContent = 'Prepare deck'; }
  }
});
window.pollDeckPreparation = async function (statusURL, target, sourceForm) {
  try {
    var response = await fetch(statusURL, {credentials: 'same-origin', headers: {'Accept': 'application/json'}});
    if (!response.ok) throw new Error((await response.text()).trim() || ('Request failed with status ' + response.status));
    var preparation = await response.json();
    var stateLabels = {queued: 'Deck queued', preparing: 'Preparing deck', ready: 'Deck ready', failed: 'Deck preparation failed', cancelled: 'Deck preparation cancelled'};
    var phaseLabels = {queued: 'Waiting to start', freezing: 'Freezing the selected vocabulary', submitting: 'Submitting translation requests', waiting: 'Waiting for Batch translation; it can take hours (up to 24h)', reconciling: 'Reconciling translation results', retrying: 'Retrying temporary translation failures', translating: 'Translating selected vocabulary', assembling: 'Assembling the Anki package', finalizing: 'Finalizing the Anki package', completed: 'Preparation complete', failed: 'Preparation failed', cancelled: 'Preparation cancelled'};
    var active = preparation.state === 'queued' || preparation.state === 'preparing';
    var html = '<h3>' + window.escapeHtml(stateLabels[preparation.state] || 'Deck preparation') + '</h3>';
    if (active) {
      html += '<p aria-busy="true">' + window.escapeHtml(phaseLabels[preparation.phase] || (preparation.state === 'queued' ? 'Waiting for preparation to begin' : 'Preparing the deck')) + '…</p>';
      var t = preparation.translation || {};
      if (Number(t.eligible || 0) > 0) html += 'Translations: ' + Number(t.completed || 0) + ' complete · ' + Number(t.failed || 0) + ' unavailable · ' + Number(t.retrying || 0) + ' retrying · ' + Number(t.pending || 0) + ' waiting.';
      var b = preparation.batch || {};
      if (Number(b.requests || 0) > 0) html += 'Batch requests: ' + Number(b.completed || 0) + ' complete · ' + Number(b.failed || 0) + ' failed · ' + Number(b.expired || 0) + ' expired' + (Number(b.age_seconds || 0) > 0 ? ' · running for ' + Math.floor(Number(b.age_seconds || 0) / 3600) + 'h' : '') + '.';
    }
    html += '<progress aria-label="Deck preparation progress" value="' + Number(preparation.progress || 0) + '" max="100">' + Number(preparation.progress || 0) + '%</progress>';
    if (preparation.deck_name) html += '<p><strong>Deck:</strong> <code>' + window.escapeHtml(preparation.deck_name) + '</code><br/><strong>Filename:</strong> <code>' + window.escapeHtml(preparation.filename) + '</code></p>';
    if (preparation.ready) {
      var readyResponse = await fetch(statusURL, {credentials: 'same-origin', headers: {'Accept': 'text/html', 'HX-Request': 'true'}});
      if (!readyResponse.ok) throw new Error((await readyResponse.text()).trim() || ('Request failed with status ' + readyResponse.status));
      target.outerHTML = await readyResponse.text(); return;
    } else if (active) {
      html += '<button type="button" class="outline secondary" data-cancel-preparation>Cancel preparation</button>';
    } else {
      if (preparation.error) html += '<p role="alert">' + window.escapeHtml(preparation.error) + '</p>';
      html += '<button type="button" data-retry-preparation>Retry preparation</button>';
    }
    target.innerHTML = html;
    var cancel = target.querySelector('[data-cancel-preparation]');
    if (cancel) cancel.addEventListener('click', function () { window.updateDeckPreparation(statusURL.replace(/\/status$/, '/cancel'), target, sourceForm); });
    var retry = target.querySelector('[data-retry-preparation]');
    if (retry) retry.addEventListener('click', function () { window.updateDeckPreparation(statusURL.replace(/\/status$/, '/retry'), target, sourceForm); });
    if (active) setTimeout(function () { window.pollDeckPreparation(statusURL, target, sourceForm); }, 1500);
  } catch (error) {
    target.innerHTML = '<p role="alert">Could not check deck preparation: ' + window.escapeHtml(error && error.message ? error.message : 'Please try again.') + '</p><button type="button" data-check-preparation>Try again</button>';
    target.querySelector('[data-check-preparation]').addEventListener('click', function () { window.pollDeckPreparation(statusURL, target, sourceForm); });
  }
};
window.updateDeckPreparation = async function (action, target, sourceForm) {
  var data = new FormData();
  data.set('csrf_token', sourceForm.querySelector('[name="csrf_token"]').value);
  var consent = sourceForm.querySelector('[name="external_translation_consent"]');
  if (consent && consent.checked) data.set('external_translation_consent', 'on');
  try {
    var response = await fetch(action, {method: 'POST', body: data, credentials: 'same-origin', headers: {'Accept': 'application/json'}});
    if (!response.ok) throw new Error((await response.text()).trim() || ('Request failed with status ' + response.status));
    await window.pollDeckPreparation(action.replace(/\/(cancel|retry)$/, '/status'), target, sourceForm);
  } catch (error) {
    target.insertAdjacentHTML('beforeend', '<p role="alert">Deck action failed: ' + window.escapeHtml(error && error.message ? error.message : 'Please try again.') + '</p>');
  }
};
document.addEventListener('htmx:afterSwap', function () {
  ['provisional-journey-list', 'primary-goal-section'].forEach(function (id) {
    var region = document.getElementById(id);
    if (!region) return;
    var focusID = region.getAttribute('data-focus-id');
    if (!focusID) return;
    var focusTarget = document.getElementById(focusID);
    if (focusTarget) focusTarget.focus();
    region.removeAttribute('data-focus-id');
  });
});
</script></head><body><a class="skip-link" href="#main-content">Skip to main content</a><header class="container site-header"><nav class="site-header__nav" aria-label="Primary navigation" data-navigation-context={ string(context) }><ul class="site-header__brand"><li><a href="/"><strong>Mouseion</strong></a></li></ul>
	if user != nil {
		<ul class="site-header__navigation">
		<li><a href="/library" { destinationAttributes(context, NavigationLibrary)... }>My Books</a></li><li><a href="/journey" { destinationAttributes(context, NavigationReadingJourney)... }>Reading Journey</a></li><li><a href="/settings" { destinationAttributes(context, NavigationSettings)... }>Settings</a></li>
		<li><small>{ user.Username }</small></li><li><form class="inline" method="post" action="/logout"><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Log out</button></form></li></ul>
	}
	</nav></header><main id="main-content" class="container" tabindex="-1">{ children... }</main></body></html>
}
templ LibraryPage(user domain.User, csrf string, books []domain.SourceMaterialSummary, message, goalBookID string) {
	@MyBooksPage(user, csrf, legacyMyBooks(books), message, "", goalBookID)
}

templ MyBooksPage(user domain.User, csrf string, books []domain.MyBook, message, pageError, goalBookID string) {
	@ShellLayout("My Books", &user, csrf, NavigationLibrary) {
		@PageHeader("My Books", "Keep the books you care about together with honest evidence for what Mouseion can do next.", nil) {
			<details id="book-form">
				<summary>Add a book</summary>
				<p>Save bibliographic metadata now. Mouseion will not assume a language or pretend that an EPUB has been acquired.</p>
				<form method="post" action="/library/books">
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<label>Title<input name="title" required autocomplete="off"/></label>
					<fieldset>
						<legend>Language state</legend>
						<label><input type="radio" name="language_state" value="unknown" required/> I have not chosen a language yet</label>
						<label><input type="radio" name="language_state" value="chosen"/> I chose this language explicitly</label>
						<label>Chosen language tag<input name="language_tag" placeholder="de" autocomplete="language"/></label>
					</fieldset>
					<button type="submit">Add to My Books</button>
				</form>
			</details>
		}
		if message != "" {
			@Feedback(FeedbackSuccess, "", message)
		}
		if pageError != "" {
			@Feedback(FeedbackError, "My Books needs attention", pageError)
		}
		if len(books) == 0 {
			@EmptyState("No books in My Books yet", "Use Add a book above, or acquire an EPUB from one of your catalogs.") {
				<a href="/connections">Acquire an EPUB</a>
			}
		}
		if len(books) > 0 {
			<section class="library-list" aria-labelledby="acquired-books-heading">
				<h2 id="acquired-books-heading">Books in My Books</h2>
				for _, book := range books {
					<article class="resource-card library-book" aria-labelledby={ "book-title-" + book.Book.ID }>
						<div class="library-book__identity">
							<h2 id={ "book-title-" + book.Book.ID } class="bibliographic-title">
								if book.Acquired != nil {
									<a href={ templ.SafeURL("/books/"+book.Acquired.Source.ID) }>{ book.Book.Title }</a>
								} else {
									{ book.Book.Title }
								}
							</h2>
							<p class="metadata">
								if book.Book.LanguageState == domain.LanguageChosen {
									<span>language: { book.Book.LanguageTag }</span>
								} else {
									<span>language not chosen</span>
								}
								if book.Acquired != nil && book.Acquired.Source.MediaType != "" {
									<span>{ book.Acquired.Source.MediaType }</span>
								}
								if book.Acquired != nil && !book.Acquired.Source.CreatedAt.IsZero() {
									<span>acquired { book.Acquired.Source.CreatedAt.Format("2006-01-02") }</span>
								}
							</p>
						</div>
						<div class="library-book__supporting">
							@StatusBadge(myBookEvidenceLabel(myBookEvidenceStateFor(book)), statusTone(myBookEvidenceLabel(myBookEvidenceStateFor(book))))
							if book.Book.ID == goalBookID {
								@StatusBadge("Current Primary Goal", StatusInfo)
								<p><a href={ templ.SafeURL("/journey#journey-book-"+book.Book.ID) }>View Primary Goal in Reading Journey</a></p>
							}
							if book.Acquired != nil && book.Acquired.AnalysisStatus != "" && book.Acquired.AnalysisStatus != myBookEvidenceLabel(myBookEvidenceStateFor(book)) {
								<p class="metadata">Analysis evidence: { myBookAnalysisLabel(book.Acquired.AnalysisStatus) }</p>
							}
							<p class="library-next-action"><strong>Next action:</strong>
								if myBookLifecycleActionFor(book).Status != myBookEvidenceLabel(myBookEvidenceStateFor(book)) {
									{ myBookLifecycleActionFor(book).Status }.
								}
								{ myBookLifecycleActionFor(book).Description }
							</p>
							<div class="action-group">
								@LifecycleActionControl(myBookLifecycleActionFor(book), csrf)
								if book.Book.ID != goalBookID {
									<form method="post" action={ templ.SafeURL("/goal/books/"+book.Book.ID) }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_goal_book_id" value={ goalBookID }/><button type="submit" class="outline">Choose as Primary Goal</button></form>
								}
								@Confirmation("Remove from My Books", "This removes only My Books membership. Acquired content, aliases, and immutable history remain.", StatusDanger) {
									<form method="post" action={ templ.SafeURL("/library/books/"+book.Book.ID+"/remove") }><input type="hidden" name="csrf_token" value={ csrf }/><button type="submit" class="outline secondary">Confirm removal</button></form>
								}
							</div>
						</div>
					</article>
				}
			</section>
		}
	}
}
templ JourneyPage(user domain.User, csrf string, journey journeyPageView, message string, pageError string, activeCampaignID string) {
	@ShellLayout("Reading Journey", &user, csrf, NavigationReadingJourney) {
		@PageHeader("Reading Journey", "Keep one current Primary Goal anchored first, followed by the provisional order you chose.", nil) {
			<a role="button" class="outline" href="/library">Prepare another deck</a>
		}
		if message != "" {
			@Feedback(FeedbackSuccess, "", message)
		}
		if pageError != "" {
			@Feedback(FeedbackError, "Action needed", pageError)
			if activeCampaignID != "" {
				<p><a href={ templ.SafeURL("#"+campaignAnchorID(activeCampaignID)) }>Return to the active campaign</a></p>
			}
		}
		@GoalSection(journey.Goal, journey.Residual, csrf, "", "", "")
		<section aria-labelledby="provisional-journey-heading"><h2 id="provisional-journey-heading">Provisional Journey</h2>
			@JourneyProvisionalList(journey, csrf, "", "")
		</section>
		if journey.RouteComparison != nil {
			<section aria-labelledby="route-comparison-heading" class="journey-comparison">
				<h2 id="route-comparison-heading">Compare your order with a vocabulary-efficient alternative</h2>
				<p class="reading-width">Your order above is canonical and remains the active order. This optional comparison is read-only evidence: it never reorders your Journey or selects a Primary Goal. It optimizes exactly one named lexical property—current known-token coverage—using exact integer token counts from current analyzed evidence.</p>
				<p class="reading-width">The comparison is calculated when this page is requested. Fixed constraints, including an active Primary Goal when it is a Journey member, remain fixed. Thresholds for 95%, 97%, and 99% coverage are supporting per-book investment data, not ordering inputs. Structural difficulty, coverage, evidence quality, and learner desire remain separate; this view does not combine them into one score.</p>
				<p class="reading-width">Current coverage is present evidence. Reserved active-campaign vocabulary is not current knowledge; when a reservation snapshot exists and is not confirmed, a separate conditional variant shows what would change if that single transition were confirmed. Reading a book does not change coverage.</p>
				if journey.RouteComparison.ComparisonUnavailable {
					<p role="status"><strong>Comparison unavailable.</strong> The current Journey evidence could not be loaded. Your canonical order is unchanged; try again when analyzed evidence is available.</p>
				} else if len(journey.RouteComparison.LearnerOrder) == 0 {
					<p role="status"><strong>Comparison unavailable.</strong> Add a second Journey book with current analyzed evidence to see a comparison.</p>
				} else {
					<p><strong>{ fmt.Sprintf("%d comparable, %d incomparable", journey.RouteComparison.ComparableCount, journey.RouteComparison.IncomparableCount) }</strong> — incomparable books stay in their learner positions, are not ranked, and are excluded from totals.</p>
					<h3>Your order (canonical)</h3>
					<ol aria-label="Your canonical Journey order">
						for _, item := range journey.RouteComparison.LearnerOrder {
							<li><strong>{ item.Title }</strong> — rank { item.RankLabel } @StatusBadge(item.EvidenceBadge, item.EvidenceTone)
								if item.Comparable {
									<span> · { item.CurrentCoverageLabel } current known-token coverage; threshold investment: { item.ThresholdLabel }</span>
								} else {
									<span> — { item.IncomparableDetail }</span>
								}
							</li>
						}
					</ol>
					if journey.RouteComparison.ComparableCount == 0 {
						<p role="status"><strong>No comparable evidence is available.</strong> The canonical positions above are retained until current analyzed evidence can be compared.</p>
					} else {
						<details>
							<summary>Show vocabulary-efficient alternative (optional comparison)</summary>
						<h3>Current advisory order</h3>
						<p>Comparable books are ordered by descending current known-token coverage, then learner position, then language and book ID. These are the visible tie-break assumptions; no other property changes the order.</p>
						<div class="table-region" tabindex="0" aria-label="Current advisory order table">
							<table><caption>Current advisory order; fixed and incomparable positions remain constrained.</caption><thead><tr><th scope="col">Rank</th><th scope="col">Book</th><th scope="col">Evidence</th><th scope="col">Current coverage</th><th scope="col">Threshold investment</th><th scope="col">Placement</th></tr></thead><tbody>
								for _, item := range journey.RouteComparison.AdvisoryOrder {
									<tr><td>{ item.RankLabel }</td><td>{ item.Title }</td><td>@StatusBadge(item.EvidenceBadge, item.EvidenceTone)</td><td>{ item.CurrentCoverageLabel }</td><td>{ item.ThresholdLabel }</td><td>{ routePlacementLabel(item) }{ routeIncomparableSuffix(item) }</td></tr>
								}
							</tbody></table>
						</div>
						if journey.RouteComparison.HasConditional && conditionalRouteDiffers(journey.RouteComparison.AdvisoryOrder, journey.RouteComparison.ConditionalOrder) {
							<h3>If the pending study is confirmed (conditional projected evidence)</h3>
							<p>This is a separate conditional projected variant, not current evidence. It assumes only the active campaign's reserved vocabulary graduates through the single justified transition.</p>
							<div class="table-region" tabindex="0" aria-label="Conditional advisory order table">
								<table><caption>Conditional advisory order if the pending study is confirmed.</caption><thead><tr><th scope="col">Rank</th><th scope="col">Book</th><th scope="col">Conditional coverage</th><th scope="col">Placement</th></tr></thead><tbody>
									for _, item := range journey.RouteComparison.ConditionalOrder {
										<tr><td>{ item.RankLabel }</td><td>{ item.Title }</td><td>{ item.ConditionalCoverageLabel }</td><td>{ routePlacementLabel(item) }{ routeIncomparableSuffix(item) }</td></tr>
									}
								</tbody></table>
							</div>
						}
						</details>
					}
				}
			</section>
		}
		<section aria-labelledby="campaign-operations-heading" class="journey-secondary"><h2 id="campaign-operations-heading">Campaign history &amp; operations</h2>
			<p>Campaign records and prepared decks are supporting history and operations. They are separate from Reading Journey membership.</p>
			if len(journey.Prepared) > 0 {
				<h3>Prepared books and decks</h3><div class="campaign-list">
				for _, item := range journey.Prepared {
                    <article class="resource-card"><div><h4>{ item.Book.Source.Title }</h4><p>@StatusBadge("Deck ready", StatusSuccess) <span aria-hidden="true">·</span> <code>{ item.Deck.DeckName }</code></p><p>{ fmt.Sprintf("%d cards", item.Deck.TotalCards) } · <a href={ templ.SafeURL("/deck-preparations/"+item.Deck.ID+"/download") }>Download deck</a></p></div></article>
				}
				</div>
			}
			if len(journey.Campaigns) == 0 && len(journey.Prepared) == 0 {
				<p>No campaign history or operations are available.</p>
			}
			for _, item := range journey.Campaigns {
				if item.Campaign.Status == domain.CampaignComplete || item.Campaign.Status == domain.CampaignAbandoned || item.Campaign.Status == domain.CampaignActive || item.Campaign.Status == domain.CampaignQueued {
					@CampaignCard(item, csrf, item.Campaign.Status == domain.CampaignQueued)
				}
			}
		</section>
	}
}

templ PrimaryGoalFinishPage(user domain.User, csrf string, outcome primaryGoalFinishView) {
	@ShellLayout("Reading finished", &user, csrf, NavigationReadingJourney) {
		@PrimaryGoalFinish(outcome, csrf)
	}
}

templ PrimaryGoalFinish(outcome primaryGoalFinishView, csrf string) {
	<section id="primary-goal-section" tabindex="-1" aria-labelledby="primary-goal-finish-heading" class="journey-goal journey-finish-outcome">
		<h1 id="primary-goal-finish-heading">Reading finished</h1>
		<p role="status" aria-live="polite" aria-atomic="true">Reading finished for <strong>{ outcome.BookTitle }</strong>.</p>
		if outcome.Error != "" {
			<article role="alert" class="feedback feedback--error"><strong>Action needed</strong><p>{ outcome.Error }</p></article>
		}
		<ol class="finish-outcome" aria-label="Reading finish outcome">
			<li>
				<h2>Reading finished</h2>
				<p>{ outcome.BookTitle } is recorded as finished reading. This does not complete the Reading Journey or establish vocabulary knowledge.</p>
			</li>
			<li>
				<h2>Vocabulary transition</h2>
				<p>{ finishGraduationText(outcome) }</p>
				if len(outcome.Graduated) > 0 {
					<p>Identities added to known vocabulary:</p>
					<ul>
						for _, item := range outcome.Graduated {
							<li>{ finishGraduatedIdentity(item) }</li>
						}
					</ul>
				}
				if outcome.Campaign != nil && outcome.ResidualVocabulary > 0 {
					<p>Continue or abandon this residual campaign from Campaign history &amp; operations. Its prepared deck and reservation remain part of history.</p>
				}
			</li>
			<li>
				<h2>Reading Journey recalculated</h2>
				if outcome.Error == "" {
					if len(outcome.Evidence) == 0 {
						<p>No remaining Journey books have evidence to show. The order remains available for editing.</p>
					}
					for _, item := range outcome.Evidence {
						<section class="finish-evidence" aria-labelledby={ "finish-evidence-" + journeyBookID(item.Book) }>
							<h3 id={ "finish-evidence-" + journeyBookID(item.Book) }>{ journeyBookTitle(item.Book.Book) }</h3>
							if item.Changed {
								<p><strong>Before:</strong> { item.BeforeLabel }; current coverage { item.BeforeCurrent }; conditional-projected coverage { item.BeforeProjected }.</p>
							}
							<p><strong>Now — { item.AfterLabel }:</strong> current coverage { item.AfterCurrent }; conditional-projected coverage { item.AfterProjected }.</p>
						</section>
					}
				}
			</li>
			<li>
				<h2>Where next?</h2>
				<p>Choose what you want to do next. No new Primary Goal has been selected.</p>
				<div class="action-group">
					if len(outcome.Journey.Provisional) > 0 {
						<p><strong>First in your current order:</strong> { journeyBookTitle(outcome.Journey.Provisional[0].Book) }</p>
						<form method="post" action={ templ.SafeURL(finishOutcomeWhereNextURL(outcome.Journey.Provisional[0])) }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_goal_book_id" value=""/><button type="submit">Choose as Primary Goal</button></form>
					}
					<a role="button" class="outline" href="/journey">Reorder Reading Journey</a>
					<a role="button" class="outline" href="/library">Choose another book from My Books</a>
					<a href="/journey">Pause without a new Goal</a>
				</div>
				<p><a href="/journey">Return to the recalculated Reading Journey</a></p>
			</li>
		</ol>
	</section>
}
templ JourneyProvisionalList(journey journeyPageView, csrf, focusBookID, statusMessage string) {
	<div id="provisional-journey-list" data-focus-id={ journeyBookAnchorID(focusBookID) }>
		<p id="provisional-journey-status" class="journey-status" role="status" aria-live="polite" aria-atomic="true">{ statusMessage }</p>
		if len(journey.Provisional) == 0 {
			@EmptyState("No provisional books yet", "Your Reading Journey is empty after the Primary Goal. Add or reconsider books from My Books when you are ready.")
		}
		<div class="journey-list">
			for _, item := range journey.Provisional {
				@JourneyBookCard(item, false, csrf, journey.Revision, journeyExpectedGoalBookID(journey))
			}
		</div>
	</div>
}
templ GoalSection(goal *journeyBookView, residual *goalResidualView, csrf string, message, sectionError, focusBookID string) {
	<section id="primary-goal-section" tabindex="-1" aria-labelledby="primary-goal-heading" class="journey-goal" data-focus-id={ goalSectionFocusID(focusBookID) }><h2 id="primary-goal-heading">Primary Goal</h2>
		if message != "" {
			<p id="goal-section-status" class="journey-status" role="status" aria-live="polite" aria-atomic="true">{ message }</p>
		}
		if sectionError != "" {
			<article role="alert" class="feedback feedback--error"><strong>Action needed</strong><p>{ sectionError }</p></article>
		}
		if goal == nil {
			@EmptyState("No Primary Goal yet", "Choose a book as your current commitment from your provisional order or My Books when you are ready. Reading Journey membership and preparation remain separate.")
		} else {
			@JourneyBookCard(goalCardView(goal, residual), true, csrf, 0, "")
		}
	</section>
}
templ JourneyBookCard(item journeyBookView, primary bool, csrf string, expectedRevision int64, expectedGoalBookID string) {
	<article id={ journeyBookAnchorID(journeyBookID(item)) } tabindex="-1" data-focus-anchor class={ journeyBookClass(primary) }><div><h3><a href={ templ.SafeURL("/books/"+journeyBookID(item)) }>{ journeyBookTitle(item.Book) }</a></h3>
	if primary {
		<p>@StatusBadge("Primary Goal", StatusInfo) <span aria-hidden="true">·</span> Current commitment</p>
	} else {
		<p>@StatusBadge("Provisional — your order", StatusNeutral) <span aria-hidden="true">·</span> Your order</p>
	}
	if primary && item.GoalReadingOnly {
		@StatusBadge("Reading-only Goal", StatusInfo)
		if item.GoalUnassessed {
			<p>No analysis or deck exists yet, so Mouseion cannot assess this book's vocabulary. This Goal stands on its own; nothing is prepared automatically.</p>
		} else {
			<p>Analysis evidence exists, but no deck has been prepared. Reading directly is the current path; a deck never prepares automatically.</p>
		}
	}
	if primary && item.GoalResidual != nil {
		@StatusBadge("Vocabulary work remains", StatusWarning)
		<p>Changing or clearing this Goal keeps the active campaign and its reserved vocabulary unchanged. Resolve it by graduating or abandoning it from Campaign history &amp; operations.
			if item.GoalResidual.ReservedCount != nil {
				{ fmt.Sprintf(" %d ungraduated vocabulary identities remain reserved.", *item.GoalResidual.ReservedCount) }
			}
		</p>
	}
	@JourneyEvidence(item)
	</div>
	if !primary {
		<div class="journey-book__controls" aria-label={ "Reorder "+journeyBookTitle(item.Book) }>
			<form method="post" action={ journeyMoveURL(journeyBookID(item), true) } hx-post={ journeyMoveURL(journeyBookID(item), true) } hx-target="#provisional-journey-list" hx-swap="outerHTML">
				<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_revision" value={ fmt.Sprintf("%d", expectedRevision) }/>
				<button type="submit" class="outline" aria-label={ "Move "+journeyBookTitle(item.Book)+" earlier" } disabled?={ !item.CanMoveEarlier }>Move earlier</button>
			</form>
			<form method="post" action={ journeyMoveURL(journeyBookID(item), false) } hx-post={ journeyMoveURL(journeyBookID(item), false) } hx-target="#provisional-journey-list" hx-swap="outerHTML">
				<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_revision" value={ fmt.Sprintf("%d", expectedRevision) }/>
				<button type="submit" class="outline" aria-label={ "Move "+journeyBookTitle(item.Book)+" later" } disabled?={ !item.CanMoveLater }>Move later</button>
			</form>
			<form method="post" action={ templ.SafeURL("/goal/books/"+journeyBookID(item)) }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_goal_book_id" value={ expectedGoalBookID }/><button type="submit" class="outline">Choose as Primary Goal</button></form>
		</div>
	} else {
		<div class="goal-card__actions">
			@Confirmation("Mark reading finished", "Record the reading achievement. Vocabulary is changed only when the associated prepared deck has been reviewed.", StatusNeutral) {
				<form method="post" action="/goal/finish" hx-post="/goal/finish" hx-target="#primary-goal-section" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_goal_book_id" value={ journeyBookID(item) }/><button type="submit">Mark reading finished</button></form>
			}
			if item.GoalResidual != nil {
				@Confirmation("Clear Primary Goal", "The active campaign and its reserved vocabulary stay unchanged. Graduate or abandon the residual work from Campaign history & operations.", StatusWarning) {
					<form method="post" action="/goal/clear"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_goal_book_id" value={ journeyBookID(item) }/><button type="submit" class="outline secondary">Clear Primary Goal</button></form>
				}
			} else {
				<form method="post" action="/goal/clear"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_goal_book_id" value={ journeyBookID(item) }/><button type="submit" class="outline secondary">Clear Primary Goal</button></form>
			}
			<p>To choose a different Goal, use Choose as Primary Goal on another book in your provisional order or My Books.</p>
		</div>
	}
	</article>
}
templ JourneyEvidence(item journeyBookView) {
	<p><strong>{ journeyEvidenceLabel(item) }:</strong> { journeyEvidenceDescription(item) }</p>
	<p><strong>Current coverage:</strong> { journeyCurrentCoverage(item) }</p>
	<p><strong>Projected coverage:</strong> { journeyProjectedCoverage(item) }</p>
}
templ CampaignCard(item campaignView, csrf string, activatable bool) {
	<article id={ campaignAnchorID(item.Campaign.ID) } class={ campaignCardClass(item.Campaign.Status) }><div><h3><a href={ templ.SafeURL("/books/"+item.Book.Source.ID) }>{ item.Book.Source.Title }</a></h3><p>@StatusBadge(campaignStatusLabel(item.Campaign.Status), statusTone(string(item.Campaign.Status))) <span aria-hidden="true">·</span> <span>Prepared deck: <code>{ item.Deck.DeckName }</code></span></p><dl class="metadata-list campaign-progress"><div><dt>Book</dt><dd>{ campaignBookLabel(item.Campaign.BookProgress) }{ campaignProgressTime(item.Campaign.BookFinishedAt) }</dd></div><div><dt>Deck</dt><dd>{ campaignDeckLabel(item.Campaign.DeckProgress) }{ campaignProgressTime(item.Campaign.DeckReviewedAt) }</dd></div></dl>
	if item.Campaign.Status == domain.CampaignQueued && item.Coverage != nil {
		<p><strong>{ fmt.Sprintf("%.1f%%", knownCoveragePercent(*item.Coverage)) }</strong> current-known coverage · <strong>{ fmt.Sprintf("%.1f%%", activeCampaignCoveragePercent(*item.Coverage)) }</strong> future-book coverage after the active campaign graduates</p>
	}
	if item.Campaign.CompletedAt != nil {
		<p>Completed { item.Campaign.CompletedAt.UTC().Format("2006-01-02 15:04 UTC") }</p>
	}
	if item.Campaign.Status == domain.CampaignQueued {
		<p>This prepared campaign is separate from Reading Journey membership. Starting reserves its assigned vocabulary for learning; it is not counted as known.</p>
	}
	if item.Campaign.Status == domain.CampaignComplete {
		<p>Assigned vocabulary was graduated to known vocabulary. Generated provenance and this prepared deck remain available.</p>
	}
	if item.Campaign.Status == domain.CampaignAbandoned {
		<p>This campaign remains in history with its book and prepared deck. Ungraduated vocabulary is eligible again unless independently known.</p>
	}
	<p><a href={ templ.SafeURL("/deck-preparations/"+item.Deck.ID+"/download") }>Download prepared deck</a></p></div>
	if activatable {
		<form method="post" action={ templ.SafeURL("/campaigns/"+item.Campaign.ID+"/activate") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_campaign_status" value={ string(item.Campaign.Status) }/><input type="hidden" name="expected_book_progress" value={ string(item.Campaign.BookProgress) }/><input type="hidden" name="expected_deck_progress" value={ string(item.Campaign.DeckProgress) }/><button>Start learning</button></form>
	}
	if item.Campaign.Status == domain.CampaignActive || item.Campaign.Status == domain.CampaignQueued {
		if item.Campaign.Status == domain.CampaignActive {
		<section aria-labelledby={ campaignAnchorID("remaining-"+item.Campaign.ID) } class="campaign-remaining"><h4 id={ campaignAnchorID("remaining-"+item.Campaign.ID) }>Remaining before completion</h4><ul>
			<li>Book: { campaignBookLabel(item.Campaign.BookProgress) }{ campaignRemainingBookText(item.Campaign.BookProgress) }</li>
			<li>Deck: { campaignDeckLabel(item.Campaign.DeckProgress) }{ campaignRemainingDeckText(item.Campaign.DeckProgress) }</li>
		</ul><p>When both conditions are finished, Mouseion adds the campaign's assigned vocabulary to known vocabulary while preserving generated provenance, recalculating coverage evidence, and making no claim about mastery or a spaced-repetition grade.</p></section>
		}
		@ActionGroup() {
			if item.Campaign.Status == domain.CampaignActive {
			if item.Campaign.BookProgress != domain.BookFinished {
				if item.Campaign.DeckProgress == domain.DeckReviewed {
					@Confirmation(campaignCompletionLabel(item), "Review this consequential transition before submitting.", StatusNeutral) {
						@CampaignCompletionDetails(item)
						<form method="post" action={ templ.SafeURL("/campaigns/"+item.Campaign.ID+"/book-finished") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_campaign_status" value={ string(item.Campaign.Status) }/><input type="hidden" name="expected_book_progress" value={ string(item.Campaign.BookProgress) }/><input type="hidden" name="expected_deck_progress" value={ string(item.Campaign.DeckProgress) }/><button>{ campaignCompletionLabel(item) }</button></form>
					}
				} else {
					<form method="post" action={ templ.SafeURL("/campaigns/"+item.Campaign.ID+"/book-finished") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_campaign_status" value={ string(item.Campaign.Status) }/><input type="hidden" name="expected_book_progress" value={ string(item.Campaign.BookProgress) }/><input type="hidden" name="expected_deck_progress" value={ string(item.Campaign.DeckProgress) }/><button>Mark book finished — campaign remains active</button></form>
				}
			}
			if item.Campaign.DeckProgress != domain.DeckReviewed {
				if item.Campaign.BookProgress == domain.BookFinished {
					@Confirmation(campaignCompletionLabel(item), "Review this consequential transition before submitting.", StatusNeutral) {
						@CampaignCompletionDetails(item)
						<form method="post" action={ templ.SafeURL("/campaigns/"+item.Campaign.ID+"/deck-reviewed") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_campaign_status" value={ string(item.Campaign.Status) }/><input type="hidden" name="expected_book_progress" value={ string(item.Campaign.BookProgress) }/><input type="hidden" name="expected_deck_progress" value={ string(item.Campaign.DeckProgress) }/><button>{ campaignCompletionLabel(item) }</button></form>
					}
				} else {
					<form method="post" action={ templ.SafeURL("/campaigns/"+item.Campaign.ID+"/deck-reviewed") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_campaign_status" value={ string(item.Campaign.Status) }/><input type="hidden" name="expected_book_progress" value={ string(item.Campaign.BookProgress) }/><input type="hidden" name="expected_deck_progress" value={ string(item.Campaign.DeckProgress) }/><button>Mark deck reviewed — campaign remains active</button></form>
				}
			}
			}
			@Confirmation("Abandon campaign", "This abandons the campaign without deleting it. The book, prepared deck, generated provenance, and campaign history remain available; any active reservation is released and its vocabulary can be eligible for future decks again unless independently known.", StatusDanger) {
				<p>Book: { item.Book.Source.Title } · Prepared deck: { item.Deck.DeckName }</p><p>Abandonment is not deletion, and there is no completion or mastery claim.</p>
				<p>{ campaignAbandonmentOutcome(item.Campaign.Status) }</p>
				<form method="post" action={ templ.SafeURL("/campaigns/"+item.Campaign.ID+"/abandon") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_campaign_status" value={ string(item.Campaign.Status) }/><input type="hidden" name="expected_book_progress" value={ string(item.Campaign.BookProgress) }/><input type="hidden" name="expected_deck_progress" value={ string(item.Campaign.DeckProgress) }/><button class="outline">Confirm abandonment</button></form>
			}
		}
	}
	</article>
}

templ CampaignCompletionDetails(item campaignView) {
		<dl class="metadata-list"><div><dt>Book</dt><dd>{ item.Book.Source.Title } — Finished</dd></div><div><dt>Prepared deck</dt><dd>{ item.Deck.DeckName } — Reviewed</dd></div></dl>
		<p>{ campaignGraduationOutcome(item) }</p>
		<p>Generated provenance remains attached to this campaign, book, and prepared deck. Coverage evidence will be recalculated after the transition. This is not a mastery claim or a spaced-repetition grade.</p>
		<p>Completion cannot currently be undone in Mouseion; there is no inline undo.</p>
}
templ BookPage(user domain.User, csrf string, book domain.SourceMaterialSummary, coverage *domain.AnalysisCoverage, statisticsUnavailable bool, message string) {
	@BookPageWithHistory(user, csrf, book, coverage, statisticsUnavailable, nil, message)
}
templ BookPageWithHistory(user domain.User, csrf string, book domain.SourceMaterialSummary, coverage *domain.AnalysisCoverage, statisticsUnavailable bool, history []domain.AnalysisJob, message string) {
	@ShellLayout(book.Source.Title, &user, csrf, NavigationLibrary) {
	@Breadcrumb("/library", "My Books")
	@PageHeader(book.Source.Title, book.Source.Language+" · "+book.Source.MediaType, StatusBadge(bookLifecycleActionFor(book, history).Status, bookLifecycleActionFor(book, history).Tone)) {
		@LifecycleActionControl(bookLifecycleActionFor(book, history), csrf)
	}
	if message != "" {
		@Feedback(FeedbackSuccess, "", message)
	}
	@NextActionSummary(bookLifecycleActionFor(book, history))
	if coverage != nil {
		<section aria-labelledby="analyzed-scope-heading"><h2 id="analyzed-scope-heading">Analyzed scope</h2>
			if coverage.ReviewedScopeID != "" {
				<p class="reading-width"><strong>{ fmt.Sprintf("%d selected units", len(coverage.SelectedUnits)) }</strong> from this EPUB were analyzed. Coverage, thresholds, projections, highest-impact unknown vocabulary, and structural metrics apply only to these selected units, not necessarily to the full EPUB.</p>
				<p><small>Reviewed scope <code>{ coverage.ReviewedScopeID }</code></small></p>
				<ul>
					for _, unit := range coverage.SelectedUnits {
						<li>{ corpusUnitLabel(unit) }</li>
					}
				</ul>
			} else {
				<p><strong>Legacy/full-text scope.</strong> This corpus predates reviewed EPUB scopes or was analyzed from the source's full text. All metrics on this page apply to that persisted full-text corpus.</p>
			}
		</section>
		if hasAnalysisWarnings(*coverage) {
			<section aria-labelledby="analysis-quality-heading"><h2 id="analysis-quality-heading">Analysis quality</h2>
				<p>These checks describe concrete gaps in the analyzer output. They do not assign a quality grade.</p>
				if coverage.TextProfile != nil && coverage.TextProfile.SentenceCount == 0 {
					<article role="note"><strong>No sentences returned.</strong> Sentence-length signals are unavailable. Analyze the book again if the source text should contain sentences.</article>
				}
				if coverage.TextProfile != nil && coverage.TextProfile.EmptySentenceCount > 0 {
					<article role="note"><strong>Empty sentences returned.</strong> { fmt.Sprintf("%d analyzer-provided sentences contained no tokens; those sentences count as zero tokens in the structural statistics.", coverage.TextProfile.EmptySentenceCount) }</article>
				}
				if coverage.TextProfile != nil && coverage.TextProfile.NormalizedTokenCount > 0 && coverage.AnalyzableTokenCount == 0 {
					<article role="note"><strong>No vocabulary-analyzable tokens.</strong> The analyzer returned normalized tokens, but none passed the vocabulary filters, so coverage and vocabulary projections have no usable token denominator.</article>
				}
			</section>
		}
		if coverage.TextProfile != nil {
			<section aria-labelledby="text-profile-heading"><h2 id="text-profile-heading">Text profile</h2>
				@StatGroup(textProfileStatItems(*coverage.TextProfile))
				<p><strong>{ fmt.Sprintf("%d of %d", coverage.AnalyzableTokenCount, coverage.TextProfile.NormalizedTokenCount) }</strong> normalized tokens contribute to vocabulary coverage. Sentence lengths include every normalized token, including punctuation.</p>
				<details><summary>How the text profile works</summary><p>Sentence boundaries and tokens come from the analyzer. The median is the middle sentence length (or the average of the two middle lengths), and the 90th percentile uses nearest-rank selection. A long sentence has more than 35 normalized tokens. These are separate, descriptive signals—not a difficulty score or proficiency-level claim.</p></details>
			</section>
		}
		if coverage.TextProfile == nil {
			<article role="note"><h2>Text profile unavailable</h2><p>This book was analyzed before sentence statistics were recorded. Analyze it again to see structural signals.</p></article>
		}
		<section aria-labelledby="coverage-heading"><h2 id="coverage-heading">Vocabulary coverage</h2>
			@StatGroup(coverageStatItems(*coverage))
			<p>Your current known vocabulary—including vocabulary graduated by completed campaigns—covers <strong>{ fmt.Sprintf("%d", coverage.KnownTokenCount) }</strong> token occurrences across <strong>{ fmt.Sprintf("%d", coverage.KnownLemmaCount) }</strong> distinct lemmas. The active campaign could add <strong>{ fmt.Sprintf("%d", coverage.ActiveCampaignTokenCount) }</strong> occurrences across <strong>{ fmt.Sprintf("%d", coverage.ActiveCampaignLemmaCount) }</strong> lemmas after graduation; this projection is not counted as known. The remaining unknown vocabulary accounts for <strong>{ fmt.Sprintf("%d", coverage.UnknownTokenCount) }</strong> occurrences across <strong>{ fmt.Sprintf("%d", coverage.UnknownLemmaCount) }</strong> lemmas.</p>
			<h3>Additional vocabulary</h3><p>Smallest number of deck-eligible lemmas needed to reach each analyzed-scope token coverage target:</p>
			@StatGroup(thresholdStatItems(coverage.Thresholds))
			if len(coverage.TopUnknownLemmas) > 0 {
				<h3>Highest-impact unknown vocabulary</h3>
				<p>The most frequent deck-eligible lemmas in this analyzed scope:</p>
				<ol class="top-unknown">
					for _, lemma := range coverage.TopUnknownLemmas {
						if lexical.IsLemma(lemma.CanonicalLemma) {
							<li><span><strong>{ lemmadisplay.Format(book.Source.Language, lemma.CanonicalLemma, lemma.UPOS) }</strong> <small>{ lemma.UPOS }</small></span><span>{ fmt.Sprintf("%d occurrences", lemma.OccurrenceCount) }</span></li>
						}
					}
				</ol>
				<p>The top { fmt.Sprintf("%d", coverage.UnknownConcentration.TopLemmaCount) } deck-eligible lemmas account for <strong>{ fmt.Sprintf("%.1f%%", concentrationPercent(coverage.UnknownConcentration)) }</strong> of eligible unknown occurrences.</p>
				<h3>Projected token coverage</h3>
				<p>If you learned the most frequent deck-eligible lemmas:</p>
				@StatGroup(projectionStatItems(coverage.Projections, coverage.AnalyzableTokenCount))
			}
			<details><summary>How these metrics work</summary><p><strong>Current-known coverage</strong> is the share of analyzable token occurrences in the resulting corpus matched by vocabulary explicitly marked known or graduated from a completed campaign. <strong>Active-campaign projected coverage</strong> adds reserved vocabulary from the active campaign without claiming it is known. Analyzable tokens include nouns, verbs, adjectives, and adverbs; punctuation and other parts of speech are excluded. Distinct lemmas count lemma and part-of-speech identities.</p><p>Active-campaign vocabulary is excluded from a new deck while it is reserved. Abandoned campaign vocabulary becomes <strong>deck-eligible vocabulary</strong> again. Unattached legacy generated history remains conservatively excluded. The 95%, 97%, and 99% estimates use the same analyzed-scope token denominator as current coverage. A target is unavailable when excluded vocabulary prevents deck-eligible words from reaching it.</p></details>
		</section>
	}
	if statisticsUnavailable {
		<article role="note"><h2>Analysis insights unavailable</h2><p>This book was analyzed before reproducible vocabulary and sentence statistics were recorded. Analyze it again to see coverage, projections, and the structural profile.</p></article>
	}
	if len(history) > 0 {
		<section aria-labelledby="book-analysis-history-heading"><h2 id="book-analysis-history-heading">Analysis history</h2><p>Completed scoped analyses remain available as exact historical results. Other runs remain on their operational status page.</p><ul>
			for _, job := range history {
				if historyURL := analysisHistoryURL(book.Source.ID, job); historyURL != "" {
					<li><a href={ templ.SafeURL(historyURL) }>{ analysisHistoryLabel(job) }</a><span class="metadata"> · { job.CreatedAt.Format("2006-01-02 15:04") }</span></li>
				}
			}
		</ul></section>
	}
	<div class="book-actions"><article class="resource-card"><h2>Analysis</h2>
		<p>{ bookLifecycleActionFor(book, history).Description }</p>
		if book.ConfirmedScopeID != "" || book.ReviewedScopeID != "" {
			<p><small>Analysis uses the confirmed immutable scope <code>{ firstNonEmpty(book.ConfirmedScopeID, book.ReviewedScopeID) }</code>. Reanalysis reuses reviewed scope history; review a new scope to create distinct history.</small></p>
		}
		if book.Source.MediaType == "application/epub+zip" && (book.ConfirmedScopeID != "" || book.ReviewedScopeID != "") {
			<p><a href={ templ.SafeURL(scopeReviewURL(book)) }>Review a new EPUB scope</a></p>
		}
	</article><article class="resource-card"><h2>Generate vocabulary deck</h2><p>Create an Anki deck from one completed scoped analysis, covering at least 97% of that analysis's unknown vocabulary.</p>
		if book.AnalysisStatus == "analyzed" && completedAnalysisURL(book, history) != "" {
			<p>Deck preparation is tied to the exact analysis result and its immutable scope.</p><a role="button" class="outline" href={ templ.SafeURL(completedAnalysisURL(book, history)) }>View analysis result</a>
		} else {
			<button disabled>Available after a scoped analysis</button>
		}
	</article></div> }
}

templ AnalysisResultPage(user domain.User, csrf string, result analysis.CompletedAnalysis, coverage *domain.AnalysisCoverage, statisticsUnavailable bool) {
	@AnalysisResultPageWithPreparation(user, csrf, result, coverage, statisticsUnavailable, nil, emptyDeckJourneyAction())
}

templ AnalysisResultPageWithPreparation(user domain.User, csrf string, result analysis.CompletedAnalysis, coverage *domain.AnalysisCoverage, statisticsUnavailable bool, preparation *domain.DeckPreparation, journeyAction deckJourneyActionView) {
	@ShellLayout("Analysis result · "+result.Source.Title, &user, csrf, NavigationLibrary) {
		@Breadcrumb("/books/"+result.Source.ID, result.Source.Title)
		@PageHeader("Analysis result", result.Source.Title+" · "+result.Source.Language, StatusBadge("Completed", StatusSuccess))
		<div class="data-width analysis-result">
			<section aria-labelledby="analysis-identity-heading"><h2 id="analysis-identity-heading">Identity and trust</h2>
				@MetadataList([]MetadataItem{
					{Term: "Book", Description: result.Source.Title},
					{Term: "Language", Description: result.Source.Language},
					{Term: "Analysis run", Description: result.RunID},
					{Term: "Reviewed scope", Description: result.ScopeID},
					{Term: "Source revision", Description: result.Source.ContentRevisionID},
					{Term: "Unit snapshot", Description: result.SnapshotID},
					{Term: "Completed", Description: completedAtLabel(result.CompletedAt)},
				})
				<p class="reading-width"><strong>{ fmt.Sprintf("%d selected units", len(result.Corpus.SelectedUnits)) }</strong> from the reviewed scope were analyzed. These metrics apply to this immutable scope, not necessarily to the full EPUB.</p>
				<ul>
					for _, unit := range result.Corpus.SelectedUnits {
						<li>{ corpusUnitLabel(unit) }</li>
					}
				</ul>
			</section>
			if coverage != nil && hasAnalysisWarnings(*coverage) {
				<section aria-labelledby="result-quality-heading"><h2 id="result-quality-heading">Analysis quality</h2><p>These are concrete gaps in the persisted analyzer output. They do not assign a quality grade.</p>
					if coverage.TextProfile != nil && coverage.TextProfile.SentenceCount == 0 {
						<article role="note"><strong>No sentences returned.</strong> Sentence-length signals are unavailable.</article>
					}
					if coverage.TextProfile != nil && coverage.TextProfile.EmptySentenceCount > 0 {
						<article role="note"><strong>Empty sentences returned.</strong> { fmt.Sprintf("%d analyzer-provided sentences contained no tokens.", coverage.TextProfile.EmptySentenceCount) }</article>
					}
					if coverage.TextProfile != nil && coverage.TextProfile.NormalizedTokenCount > 0 && coverage.AnalyzableTokenCount == 0 {
						<article role="note"><strong>No vocabulary-analyzable tokens.</strong> Coverage and vocabulary projections have no usable token denominator.</article>
					}
				</section>
			}
			if statisticsUnavailable || coverage == nil {
				@Feedback(FeedbackWarning, "Analysis insights unavailable", "This completed analysis does not have reproducible vocabulary statistics. No coverage or projection values are shown.")
			} else {
				<section aria-labelledby="result-summary-heading"><h2 id="result-summary-heading">Decision summary</h2>
					@StatGroup(coverageStatItems(*coverage))
					<p>Current-known coverage is the share of analyzable token occurrences matched by explicitly known vocabulary or vocabulary graduated by a completed campaign. The active-campaign value is a projection, not known vocabulary.</p>
				</section>
				<section aria-labelledby="result-vocabulary-heading"><h2 id="result-vocabulary-heading">Vocabulary investment</h2>
					<p>These thresholds use the full analyzable-token denominator. Counts are additional deck-eligible lemma identities, not a claim that the learner already knows them.</p>
					@StatGroup(thresholdStatItems(coverage.Thresholds))
					if len(coverage.TopUnknownLemmas) > 0 {
						<h3>Highest-impact unknown vocabulary</h3>
						<ol class="top-unknown">
							for _, lemma := range coverage.TopUnknownLemmas {
								if lexical.IsLemma(lemma.CanonicalLemma) {
									<li><span><strong>{ lemmadisplay.Format(result.Source.Language, lemma.CanonicalLemma, lemma.UPOS) }</strong> <small>{ lemma.UPOS }</small></span><span>{ fmt.Sprintf("%d occurrences", lemma.OccurrenceCount) }</span></li>
								}
							}
						</ol>
						<p>The top { fmt.Sprintf("%d", coverage.UnknownConcentration.TopLemmaCount) } deck-eligible lemmas account for <strong>{ fmt.Sprintf("%.1f%%", concentrationPercent(coverage.UnknownConcentration)) }</strong> of eligible unknown occurrences.</p>
					}
					if len(coverage.Projections) > 0 {
						<h3>Projected token coverage</h3><p>Projection after learning the most frequent deck-eligible lemmas:</p>
						@StatGroup(projectionStatItems(coverage.Projections, coverage.AnalyzableTokenCount))
					}
				</section>
				<section aria-labelledby="result-exclusions-heading"><h2 id="result-exclusions-heading">Vocabulary state and exclusions</h2>
					<p><strong>{ fmt.Sprintf("%d known token occurrences across %d lemmas", coverage.KnownTokenCount, coverage.KnownLemmaCount) }</strong> are current known vocabulary. <strong>{ fmt.Sprintf("%d occurrences across %d lemmas", coverage.UnknownTokenCount, coverage.UnknownLemmaCount) }</strong> remain unknown.</p>
					<p>Vocabulary reserved by the active campaign is shown only in projected coverage and remains excluded from a new deck. Generated vocabulary from other books and unattached legacy generated history is also excluded from learn-next projections; generated means assigned for study, not known. Abandoned campaign vocabulary becomes eligible again.</p>
					if len(coverage.Thresholds) > 0 {
						<p><strong>{ fmt.Sprintf("%d eligible unknown occurrences", coverage.Thresholds[0].EligibleTokenCount) }</strong> are available to the threshold and learn-next calculations.</p>
					}
				</section>
				if coverage.TextProfile != nil {
					<section aria-labelledby="result-structure-heading"><h2 id="result-structure-heading">Structural and text signals</h2>
						@StatGroup(textProfileStatItems(*coverage.TextProfile))
						<p><strong>{ fmt.Sprintf("%d of %d", coverage.AnalyzableTokenCount, coverage.TextProfile.NormalizedTokenCount) }</strong> normalized tokens contribute to vocabulary coverage. Sentence lengths include every normalized token, including punctuation.</p>
						<p>These are separate descriptive signals, not a difficulty score or proficiency level.</p>
					</section>
				} else {
					@Feedback(FeedbackWarning, "Text profile unavailable", "Sentence statistics were not persisted for this analysis, so structural signals are not shown.")
				}
			}
			<section aria-labelledby="result-provenance-heading"><h2 id="result-provenance-heading">Provenance and history</h2>
				@MetadataList([]MetadataItem{
					{Term: "Analyzer", Description: result.AnalyzerName},
					{Term: "Analyzer version", Description: result.AnalyzerVersion},
					{Term: "Analysis configuration", Description: result.ConfigIdentity},
					{Term: "Normalization", Description: result.Artifact.NormalizationProfile+" · "+result.Artifact.NormalizationVersion},
					{Term: "Artifact schema", Description: result.Artifact.SchemaVersion},
				})
				<p><a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", result.JobID)) }>View operational history for analysis job #{ fmt.Sprintf("%d", result.DisplayNumber) }</a></p>
			</section>
			<section aria-labelledby="result-deck-heading"><h2 id="result-deck-heading">Prepare deck</h2>
				<p>This optional preparation uses only this exact completed analysis and its immutable scope. It does not start a learning campaign.</p>
				if preparation != nil {
					@DeckPreparationStatus(csrf, *preparation, analysisResultURL(result), journeyAction)
				} else {
					<form method="post" action={ templ.SafeURL(analysisDeckPreparationURL(result)) } data-prepare-deck>
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<fieldset><legend>Optional external translation</legend>
							<p>English translation is optional. If selected, Mouseion sends each selected lemma and its example sentence outside Mouseion to the configured translation provider. Without consent, preparation stays local and translation fields may be incomplete.</p>
							<label><input type="checkbox" name="external_translation_consent"/> I consent to sending selected vocabulary and example sentences for translation</label>
						</fieldset>
						<button type="submit">Prepare deck</button>
					</form>
					<section data-deck-preparation role="status" aria-live="polite" aria-atomic="true" hidden></section>
				}
			</section>
			<section aria-labelledby="result-next-heading"><h2 id="result-next-heading">What next?</h2><p>Review the evidence above before taking the next action for this exact completed analysis. Deck preparation is a separate explicit step.</p>
				<p><a href={ templ.SafeURL("/books/"+result.Source.ID) }>Return to book</a> · <a href={ templ.SafeURL("/books/"+result.Source.ID+"/scope") }>Review a different scope</a></p>
			</section>
		</div>
	}
}

templ DeckPreparationStatusPage(user domain.User, csrf string, preparation domain.DeckPreparation, resultURL string, journeyAction deckJourneyActionView) {
	@ShellLayout("Deck preparation", &user, csrf, NavigationLibrary) {
		if resultURL != "" {
			@Breadcrumb(resultURL, "Analysis result")
		} else {
			@Breadcrumb("/books/"+preparation.SourceMaterialID, "Book")
		}
		@PageHeader("Deck preparation", "Prepare an Anki deck from one exact completed analysis.", StatusBadge(deckPreparationStatusLabel(preparation.State), statusTone(string(preparation.State))))
		@DeckPreparationStatus(csrf, preparation, resultURL, journeyAction)
	}
}

templ DeckPreparationStatus(csrf string, preparation domain.DeckPreparation, resultURL string, journeyAction deckJourneyActionView) {
	@AsyncStatus(deckPreparationAttributes(preparation), "deck-preparation-status", deckPreparationTitle(preparation), deckPreparationSummary(preparation), preparationProgress(preparation), 100, deckPreparationActive(preparation)) {
		if resultURL != "" {
			<p><a href={ templ.SafeURL(resultURL) }>Return to analysis result</a></p>
		}
		if preparation.TranslationEligible > 0 {
			<p><strong>Translations:</strong> { fmt.Sprintf("%d complete · %d unavailable · %d retrying · %d waiting", preparation.TranslationDone, preparation.TranslationFailed, preparation.TranslationRetrying, preparation.TranslationPending) }</p>
		}
		if preparation.BatchRequestCount > 0 {
			<p><strong>Batch translation:</strong> { fmt.Sprintf("%d of %d requests complete · %d failed · %d expired · completion can take hours (up to 24h)", preparation.BatchCompletedRequests, preparation.BatchRequestCount, preparation.BatchFailedRequests, preparation.BatchExpiredRequests) }</p>
		}
		if preparation.DeckName != "" {
			<p><strong>Deck:</strong> <code>{ preparation.DeckName }</code> · <strong>Filename:</strong> <code>{ preparation.Filename }</code></p>
		}
		if preparation.State == domain.DeckPreparationReady {
			<p><strong>Completeness:</strong> { fmt.Sprintf("%d cards · %d with English · %d with contextual sentence translations · %d omitted for sentence quality", preparation.TotalCards, preparation.CardsWithEnglish, preparation.CardsWithContextualSentenceTranslations, preparation.QualityOmissions) }</p>
			@ActionGroup() {
				<a role="button" download href={ templ.SafeURL("/deck-preparations/"+preparation.ID+"/download") }>Download deck</a>
			}
			@DeckJourneyAction(journeyAction, csrf)
		} else if deckPreparationActive(preparation) {
			<form method="post" action={ templ.SafeURL("/deck-preparations/"+preparation.ID+"/cancel") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Cancel preparation</button></form>
		} else {
			if preparation.State == domain.DeckPreparationFailed {
				@Feedback(FeedbackError, "Action needed", preparationFailureMessage(preparation.FailureClass))
			}
			<form method="post" action={ templ.SafeURL("/deck-preparations/"+preparation.ID+"/retry") }>
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<fieldset><legend>Optional external translation for the retry</legend><p>If selected, Mouseion sends each selected lemma and its example sentence outside Mouseion to the configured translation provider. Without consent, the retry stays local and translation fields may be incomplete.</p><label><input type="checkbox" name="external_translation_consent"/> I consent to sending selected vocabulary and example sentences for translation</label></fieldset>
				<button type="submit">Retry preparation</button>
			</form>
		}
	}
}

templ EPUBScopeReviewPage(user domain.User, csrf string, review tocScopeView, pageError string, selectedCSV string) {
	@ShellLayout("Review analysis scope", &user, csrf, NavigationLibrary) {
		@Breadcrumb("/books/"+review.Book.ID, review.Book.Title)
		@PageHeader("Review analysis scope", "Choose the readable EPUB units that should be used by a future analysis.", nil)
		if pageError != "" {
			@Feedback(FeedbackError, "Scope not saved.", pageError)
		}
		<section class="next-action" aria-labelledby="scope-next-action-heading"><h2 id="scope-next-action-heading">Next action</h2><p><strong>Confirm this scope.</strong> This saves an immutable selection for the book. It does not start analysis; after confirmation, return to the book page to choose <strong>Start analysis</strong>.</p></section>
		<form method="post" action={ templ.SafeURL("/books/"+review.Book.ID+"/scope") } data-scope-review>
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<input type="hidden" name="snapshot_id" value={ review.SnapshotID }/>
			<fieldset class="scope-actions"><legend>Choose readable sections</legend><button type="button" class="outline" data-select="all">Check all</button><button type="button" class="outline secondary" data-select="none">Uncheck all</button></fieldset>
			<div class="scope-summary" role="status" aria-live="polite" aria-atomic="true"><span>{ fmt.Sprintf("All units: %d characters, about %d tokens", scopeTotalCharacters(review.Choices), scopeTotalTokens(review.Choices)) }</span><strong data-selected-count>{ fmt.Sprintf("%d %s selected", scopeSelectedUnits(review.Choices, selectedCSV), unitPlural(scopeSelectedUnits(review.Choices, selectedCSV))) }</strong><span data-selected-size>{ fmt.Sprintf("Selected: %d characters, about %d tokens", scopeSelectedCharacters(review.Choices, selectedCSV), scopeSelectedTokens(review.Choices, selectedCSV)) }</span></div>
			<fieldset class="scope-units"><legend>Readable sections in spine order</legend>
				for _, choice := range review.Choices {
					<article class="scope-choice" data-characters={ fmt.Sprintf("%d", choice.CharacterCount) } data-tokens={ fmt.Sprintf("%d", choice.TokenEstimate) } data-unit-count={ fmt.Sprintf("%d", len(choice.UnitIDs)) }>
						<label for={ "scope-choice-"+fmt.Sprintf("%d", choice.First) }><input id={ "scope-choice-"+fmt.Sprintf("%d", choice.First) } type="checkbox" name="unit_id" value={ strings.Join(choice.UnitIDs, ",") } checked?={ scopeChoiceChecked(selectedCSV, choice.UnitIDs) }/> { choice.Label }</label>
						<p><small>{ fmt.Sprintf("%d readable %s · %d characters · about %d tokens", len(choice.UnitIDs), unitPlural(len(choice.UnitIDs)), choice.CharacterCount, choice.TokenEstimate) }</small></p>
					</article>
				}
			</fieldset>
			<button type="submit">Confirm scope</button><small>This saves an immutable reviewed scope. Analysis is a separate action on the book page.</small>
		</form>
		<script>
const scopeForm = document.querySelector('[data-scope-review]');
if (scopeForm) {
  const boxes = Array.from(scopeForm.querySelectorAll('input[name="unit_id"]'));
  const updateScopeSummary = () => {
    const selected = boxes.filter((box) => box.checked);
    const units = selected.reduce((sum, box) => sum + Number(box.closest('[data-unit-count]').dataset.unitCount), 0);
    const characters = selected.reduce((sum, box) => sum + Number(box.closest('[data-characters]').dataset.characters), 0);
    const tokens = selected.reduce((sum, box) => sum + Number(box.closest('[data-tokens]').dataset.tokens), 0);
    scopeForm.querySelector('[data-selected-count]').textContent = `${units} ${units === 1 ? 'unit' : 'units'} selected`;
    scopeForm.querySelector('[data-selected-size]').textContent = `Selected: ${characters.toLocaleString()} characters, about ${tokens.toLocaleString()} tokens`;
  };
  scopeForm.addEventListener('change', updateScopeSummary);
  scopeForm.addEventListener('click', (event) => {
    const button = event.target.closest('[data-select]');
    if (!button) return;
    boxes.forEach((box) => { box.checked = button.dataset.select === 'all'; });
    updateScopeSummary();
  });
  updateScopeSummary();
}
		</script>
	}
}

func scopeChoiceChecked(selectedCSV string, unitIDs []string) bool { if selectedCSV == "" { return true }; selected := make(map[string]struct{}); for _, id := range strings.Split(strings.TrimPrefix(selectedCSV, "submitted:"), ",") { selected[id] = struct{}{} }; for _, id := range unitIDs { if _, ok := selected[id]; !ok { return false } }; return true }
func scopeTotalCharacters(choices []tocScopeChoice) int { total := 0; for _, choice := range choices { total += choice.CharacterCount }; return total }
func scopeTotalTokens(choices []tocScopeChoice) int { total := 0; for _, choice := range choices { total += choice.TokenEstimate }; return total }
func scopeSelectedUnits(choices []tocScopeChoice, selectedCSV string) int { total := 0; for _, choice := range choices { if scopeChoiceChecked(selectedCSV, choice.UnitIDs) { total += len(choice.UnitIDs) } }; return total }
func scopeSelectedCharacters(choices []tocScopeChoice, selectedCSV string) int { total := 0; for _, choice := range choices { if scopeChoiceChecked(selectedCSV, choice.UnitIDs) { total += choice.CharacterCount } }; return total }
func scopeSelectedTokens(choices []tocScopeChoice, selectedCSV string) int { total := 0; for _, choice := range choices { if scopeChoiceChecked(selectedCSV, choice.UnitIDs) { total += choice.TokenEstimate } }; return total }
func unitPlural(count int) string { if count == 1 { return "unit" }; return "units" }
func catalogBrowseURL(connectionID, bookID string) string { if bookID == "" { return "/catalog?connection=" + url.QueryEscape(connectionID) }; return "/catalog?connection=" + url.QueryEscape(connectionID) + "&book_id=" + url.QueryEscape(bookID) }
func scopeReviewURL(book domain.SourceMaterialSummary) string { return "/books/"+book.Source.ID+"/scope" }
func completedAnalysisURL(book domain.SourceMaterialSummary, history []domain.AnalysisJob) string { for _, job := range history { if historyURL := analysisHistoryURL(book.Source.ID, job); strings.Contains(historyURL, "/analyses/") { return historyURL } }; return "" }
func completedAtLabel(value *time.Time) string { if value == nil || value.IsZero() { return "Unavailable" }; return value.UTC().Format("2006-01-02 15:04:05 UTC") }

func knownCoveragePercent(coverage domain.AnalysisCoverage) float64 {
	if coverage.AnalyzableTokenCount == 0 {
		return 0
	}
	return min(float64(coverage.KnownTokenCount)*100/float64(coverage.AnalyzableTokenCount), 100)
}

func activeCampaignCoveragePercent(coverage domain.AnalysisCoverage) float64 {
	if coverage.AnalyzableTokenCount == 0 { return 0 }
	return min(float64(coverage.KnownTokenCount+coverage.ActiveCampaignTokenCount)*100/float64(coverage.AnalyzableTokenCount), 100)
}

func concentrationPercent(projection domain.CoverageProjection) float64 {
	if projection.EligibleTokenCount == 0 {
		return 0
	}
	return float64(projection.OccurrenceCount) * 100 / float64(projection.EligibleTokenCount)
}

func projectedCoveragePercent(projection domain.CoverageProjection, analyzableTokens int64) float64 {
	if analyzableTokens == 0 {
		return 0
	}
	return min(float64(projection.ProjectedTokenCount)*100/float64(analyzableTokens), 100)
}

func longSentencePercent(profile domain.TextProfile) float64 {
	if profile.SentenceCount == 0 {
		return 0
	}
	return float64(profile.LongSentenceCount) * 100 / float64(profile.SentenceCount)
}

func hasAnalysisWarnings(coverage domain.AnalysisCoverage) bool {
	if coverage.TextProfile == nil {
		return false
	}
	return coverage.TextProfile.SentenceCount == 0 ||
		coverage.TextProfile.EmptySentenceCount > 0 ||
		(coverage.TextProfile.NormalizedTokenCount > 0 && coverage.AnalyzableTokenCount == 0)
}

func corpusUnitLabel(unit domain.CorpusSelectedUnit) string {
	if strings.TrimSpace(unit.Title) != "" {
		return unit.Title
	}
	if strings.TrimSpace(unit.SourceHref) != "" {
		return unit.SourceHref
	}
	return unit.UnitID
}

templ LoginPage(csrf, message, next string, onboarding bool) {
	@ShellLayout("Sign in", nil, csrf, navigationContextForTitle("Sign in")) { <article class="narrow">
	if onboarding {
		<h1>Create your account</h1><p>Set up the first learner account for this Mouseion installation.</p>
	} else {
		<h1>Sign in</h1>
	}
	if message != "" {
		<p role="alert">{ message }</p>
	}
	if onboarding {
		<form method="post" action="/onboarding"><input type="hidden" name="csrf_token" value={ csrf }/><label>Username<input name="username" required autocomplete="username"/></label><label>Password<input type="password" name="password" minlength="8" required autocomplete="new-password"/></label><button>Create account</button></form>
	} else {
		<form method="post" action="/login"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="next" value={ next }/><label>Username<input name="username" required autocomplete="username"/></label><label>Password<input type="password" name="password" required autocomplete="current-password"/></label><button>Sign in</button></form>
	}
	</article> }
}
templ SettingsPage(user domain.User, csrf string, supported []domain.SupportedLanguage, profiles []domain.LanguageProfile, degraded bool, language string, result *knownvocab.ImportResult, known []domain.KnownVocabulary, message string) {
	@ShellLayout("Settings", &user, csrf, NavigationSettings) {
	@PageHeader("Account settings", "Choose the languages you study and optionally import words you already know for each one.", nil)
	if message != "" {
		@Feedback(FeedbackSuccess, "", message)
	}
	<section id="study-languages" aria-labelledby="study-languages-heading">
		<h2 id="study-languages-heading">Study languages</h2>
		<p>Study languages are saved learner preferences. NLP analysis readiness comes from the language service, while a catalog browse language is chosen independently and does not change these preferences.</p>
		if degraded {
			@Feedback(FeedbackWarning, "NLP language discovery is temporarily unavailable", "Your saved study languages are unchanged. New study-language additions are disabled until readiness can be checked.")
		}
		<h3>Saved study preferences</h3>
		if len(profiles) == 0 {
			<p>No study languages are saved yet. Choose a ready NLP language below when one is available.</p>
		} else {
			<div class="settings-language-list">
			for _, profile := range profiles {
				<article class="resource-card settings-language-item"><header class="page-heading"><div><h3>{ profile.DisplayName } <code>{ profile.Language }</code></h3><p class="metadata">Saved study preference</p></div></header><p>{ studyLanguageStatus(profile, supported, degraded) }</p>
				@Confirmation("Remove study language", fmt.Sprintf("Remove %s as a study preference only. Your vocabulary, books, analyses, prepared decks, and campaigns for %s remain.", profile.DisplayName, profile.DisplayName), StatusDanger) {<form method="post" action="/settings/languages/remove"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="language" value={ profile.Language }/><button class="outline secondary">Confirm removal</button></form>}
				</article>
			}
			</div>
		}
		if degraded {
			<p class="metadata">Ready NLP capabilities cannot be verified right now, so only existing preferences remain actionable.</p>
		} else if len(supported) == 0 {
			<p>No analysis languages are currently ready. Readiness is provided by the NLP service and cannot be enabled by changing a preference.</p>
		} else if !hasAddableStudyLanguage(supported, profiles) {
			<p>All currently ready NLP languages are already saved as study preferences.</p>
		} else {
			<h3>Add a ready NLP language</h3>
			<form method="post" action="/settings/languages"><input type="hidden" name="csrf_token" value={ csrf }/><label>Ready language<select name="language" required><option value="">Choose a language</option>
			for _, candidate := range supported {
				if !studyLanguageSaved(profiles, candidate.Language) {
					<option value={ candidate.Language }>{ candidate.DisplayName } ({ candidate.Language })</option>
				}
			}
			</select></label><button>Add study language</button></form>
		}
	</section>
	<section id="known-vocabulary" aria-labelledby="known-vocabulary-heading">
		<h2 id="known-vocabulary-heading">Known vocabulary</h2>
		<p>Known vocabulary is private to your account and language-scoped. It includes words you explicitly record and vocabulary graduated by a completed campaign; generated or active-campaign vocabulary is not counted as known.</p>
		if len(profiles) == 0 {
			@EmptyState("No study language to select", "Save a study language before importing or viewing its known vocabulary.")
		} else {
			<form method="get" action="/settings#known-vocabulary" class="settings-language-picker"><label>Language<select name="language" required><option value="">Choose a study language</option>
			for _, profile := range profiles {
				<option value={ profile.Language } selected?={ language == profile.Language }>{ profile.DisplayName } ({ profile.Language })</option>
			}
			</select></label><button class="outline">View known vocabulary</button></form>
			if language == "" {
				<p>Select a study language to view its known vocabulary or import a lemma file.</p>
			} else {
				<p>Viewing <strong>{ studyLanguageName(profiles, language) }</strong> <code>{ language }</code>. Imports are additive and idempotent: new, duplicate, and rejected rows are reported separately.</p>
				if studyLanguageSaved(profiles, language) {
					<form method="post" action={ templ.SafeURL(knownVocabImportAction(language, "settings")) } enctype="multipart/form-data" hx-post={ knownVocabImportAction(language, "settings") } hx-encoding="multipart/form-data" hx-target="#known-vocabulary-results" hx-swap="innerHTML"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="return_to" value="settings"/><input type="hidden" name="language" value={ language }/><label>UTF-8 lemma file<input type="file" name="vocabulary_file" accept="text/plain,.txt" required/></label><small>One lemma per nonblank line. Tab-separated columns are rejected.</small><button>Import known vocabulary</button></form>
				} else {
					<p>This language is no longer a saved study preference. Existing known vocabulary remains available; save a ready study language before importing more.</p>
				}
				<section id="known-vocabulary-results">@KnownVocabResult(language, result, known, "")</section>
			}
		}
	</section>
	}
}
templ ConnectionsPage(user domain.User, csrf string, connections []domain.OpdsConnection, message string) {
	@ConnectionsPageForBook(user, csrf, connections, message, "")
}

templ ConnectionsPageForBook(user domain.User, csrf string, connections []domain.OpdsConnection, message, bookID string) {
	@ShellLayout("Add books", &user, csrf, NavigationAcquisition) {
		@PageHeader("Add books", "Connect a catalog, choose a ready analysis language, and add EPUB books to My Books.", nil)
		if message != "" {
			@Feedback(FeedbackSuccess, "", message)
		}
		if len(connections) == 0 {
			@EmptyState("Add your first catalog connection", "A connection tells Mouseion where to look for EPUB books. Your credentials stay private and are never shown again.") {
				<a href="#catalog-connection-form">Add catalog connection</a>
			}
		} else {
			<section aria-labelledby="catalog-choice-heading">
				<h2 id="catalog-choice-heading">Choose a catalog to browse</h2>
				<p>Choose explicitly; Mouseion will not silently select among your catalogs.</p>
			</section>
		}
		<article id="catalog-connection-form"><h2>Add catalog connection</h2><form method="post" action="/connections"><input type="hidden" name="csrf_token" value={ csrf }/>
			if bookID != "" {
				<input type="hidden" name="book_id" value={ bookID }/>
			}
			<div class="grid"><label>Name<input name="name" required/></label><label>Catalog URL<input type="url" name="url" required placeholder="https://example.com/opds"/></label></div><div class="grid"><label>Username <small>(optional)</small><input name="username" autocomplete="username"/></label><label>Password <small>(optional, encrypted at rest)</small><input type="password" name="password" autocomplete="new-password"/></label></div><button>Add catalog</button></form></article>
		if len(connections) > 0 {
			<h2>Catalog maintenance</h2>
			<p>Edit a saved connection or remove future catalog access. Owned books and their artifacts remain.</p>
		}
		<div class="catalog-list">
		for _, c := range connections {
				<article id={ "connection-" + c.ID }><header><strong>{ c.Name }</strong></header><p class="break">{ safeAcquisitionURL(c.URL) }</p><p>{ credentialSummary(c) }</p><a role="button" href={ templ.URL(catalogBrowseURL(c.ID, bookID)) }>Browse catalog</a><details><summary>Edit connection</summary><form method="post" action={ templ.SafeURL("/connections/"+c.ID) }><input type="hidden" name="csrf_token" value={ csrf }/><div class="grid"><label>Name<input name="name" value={ c.Name } required/></label><label>Catalog URL <small>(leave blank to keep current URL)</small><input type="url" name="url" value={ connectionURLForEdit(c) } placeholder="Leave blank to keep current URL"/></label></div><div class="grid"><label>Username<input name="username" value={ c.Username } autocomplete="username"/></label><label>New password <small>(leave blank to keep current)</small><input type="password" name="password" autocomplete="new-password"/></label></div><button class="outline">Save changes</button></form></details>@Confirmation("Delete catalog connection", "This removes future access through this connection and its credentials. Books already in My Books and their artifacts remain available.", StatusDanger) {<form method="post" action={ templ.SafeURL("/connections/"+c.ID+"/delete") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Confirm deletion</button></form>}</article>
		}
		</div>
	}
}
templ CatalogPage(user domain.User, csrf string, connection domain.OpdsConnection, languages []domain.SupportedLanguage, degraded bool) {
	@CatalogPageForBook(user, csrf, connection, languages, degraded, "")
}

templ CatalogPageForBook(user domain.User, csrf string, connection domain.OpdsConnection, languages []domain.SupportedLanguage, degraded bool, bookID string) {
	@ShellLayout(connection.Name, &user, csrf, NavigationAcquisition) { <p><a href="/connections">← Catalog connections</a></p>@PageHeader(connection.Name, "Browse this catalog and add EPUB books to My Books. Analysis starts separately.", nil)
	if degraded {
		@Feedback(FeedbackWarning, "Language readiness is degraded", "The NLP service could not confirm current capabilities. Saved language choices remain unchanged; return later before browsing or adding books.")
	} else if len(languages) > 0 {
			<form method="get" action="/opds/language" hx-get="/opds/language" hx-target="#catalog-results" hx-swap="outerHTML" hx-indicator="#catalog-loading"><input type="hidden" name="connection" value={ connection.ID }/>
			if bookID != "" {
				<input type="hidden" name="book_id" value={ bookID }/>
			}
			<label>Browse EPUBs by language<select name="language" required><option value="">Choose a language</option>
		for _, language := range languages {
			<option value={ language.Language }>{ language.DisplayName }</option>
		}</select></label><button type="submit">Browse language</button></form>
	} else {
		@EmptyState("No ready analysis languages", "Ready analysis languages come from the NLP service. Changing a learner study preference cannot enable a pipeline.") {
			<a href="/connections">Return later</a>
		}
	}
	<p id="catalog-loading" class="catalog-loading" role="status" aria-live="polite">Loading catalog feed…</p><div id="catalog-results" aria-live="polite" aria-atomic="true"><p>Choose a ready language to browse this catalog.</p></div> }
}
templ CatalogRootFragment(connectionID, language string, feed opds.Feed) {
	<section>
	if opds.SupportsSearch(feed) {
			<form role="search" method="get" action="/opds/search" hx-get="/opds/search" hx-target="#catalog-results" hx-swap="outerHTML"><input type="hidden" name="connection" value={ connectionID }/><input type="hidden" name="language" value={ language }/><label>Search this catalog<input type="search" name="q" placeholder="Title or author" required/></label><button type="submit">Search</button></form>
	} else {
		<p><small>Search is not available for this catalog.</small></p>
	}
	</section>
}

templ CatalogSearchForm(connectionID, language, returnTo string, trail []CatalogCrumb) {
	<form role="search" method="get" action="/opds/search" hx-get="/opds/search" hx-target="#catalog-results" hx-swap="outerHTML"><input type="hidden" name="connection" value={ connectionID }/><input type="hidden" name="language" value={ language }/>
	if bookID := bookIDFromReturnPath(returnTo); bookID != "" {
		<input type="hidden" name="book_id" value={ bookID }/>
	}
	if returnTo != "" {
		<input type="hidden" name="return_to" value={ returnTo }/>
	}
	for _, crumb := range trail {
		<input type="hidden" name="trail" value={ crumb.Title+"\x1f"+crumb.URL }/>
	}
	<label>Search this catalog<input type="search" name="q" placeholder="Title or author" required/></label><button type="submit">Search</button></form>
}

templ CatalogRootResults(csrf, connectionID, language, returnTo, message string, feed opds.Feed, owned []acquisitionEntryState) {
	<section id="catalog-results" aria-live="polite" aria-atomic="true">
		if message != "" {
			@CatalogNotice(message)
		}
		if opds.SupportsSearch(feed) {
			@CatalogSearchForm(connectionID, language, returnTo, nil)
		} else {
			<p><small>Search is not available for this catalog. Browse its collections instead.</small></p>
		}
		<h2>{ feed.Title }</h2>
		if len(feed.Entries) == 0 {
			@EmptyState("This catalog feed is empty", "No books or collections were found here.") { <a href={ templ.URL(returnTo) }>Refresh this feed</a> }
		}
		<div class="catalog-grid">
		for _, entry := range feed.Entries {
			@EntryCardWithState(csrf, connectionID, language, returnTo, entry, nil, owned)
		}
		</div>@CatalogPagination(connectionID, language, nil, feed)
		</section>
}
templ FeedFragment(csrf, connectionID, language, returnTo, message string, feed opds.Feed, trail []CatalogCrumb) {
	@FeedFragmentWithState(csrf, connectionID, language, returnTo, message, feed, trail, nil)
}
templ FeedFragmentWithState(csrf, connectionID, language, returnTo, message string, feed opds.Feed, trail []CatalogCrumb, owned []acquisitionEntryState) {
	<section id="catalog-results" aria-live="polite" aria-atomic="true">
	if message != "" {
		@CatalogNotice(message)
	}
	if opds.SupportsSearch(feed) {
		@CatalogSearchForm(connectionID, language, returnTo, trail)
	} else {
		<p><small>Search is not available for this catalog. Browse its collections instead.</small></p>
	}
	<nav aria-label="Catalog breadcrumb"><a hx-get={ browseURLForLanguage(connectionID, language, "", nil) } hx-target="#catalog-results" hx-swap="outerHTML" href={ templ.URL(browseURLForLanguage(connectionID, language, "", nil)) }>Catalog root</a>
	for i, crumb := range trail {
		<span> / </span>
		if i < len(trail)-1 {
			<a hx-get={ browseURLForLanguage(connectionID, language, crumb.URL, trail[:i]) } hx-target="#catalog-results" hx-swap="outerHTML" href={ templ.URL(browseURLForLanguage(connectionID, language, crumb.URL, trail[:i])) }>{ crumb.Title }</a>
		} else {
			<span aria-current="page">{ crumb.Title }</span>
		}
	}
	</nav><h2>{ feed.Title }</h2>
	if len(feed.Entries) == 0 {
		@EmptyState("This collection is empty", "No books or collections were found here.") { <a href={ templ.URL(returnTo) }>Refresh this collection</a> }
	}
	<div class="catalog-grid">
	for _, entry := range feed.Entries {
		@EntryCardWithState(csrf, connectionID, language, returnTo, entry, trail, owned)
	}
	</div>@CatalogPagination(connectionID, language, trail, feed)</section>
}
templ CatalogPagination(connectionID, language string, trail []CatalogCrumb, feed opds.Feed) {
	<nav class="catalog-pagination" aria-label="Catalog pages">
		if href := feedLink(feed, "previous"); href != "" {
			<a href={ templ.URL(browseURLForLanguage(connectionID, language, href, trail)) } hx-get={ browseURLForLanguage(connectionID, language, href, trail) } hx-target="#catalog-results" hx-swap="outerHTML">Previous page</a>
		}
		if href := feedLink(feed, "next"); href != "" {
			<a href={ templ.URL(browseURLForLanguage(connectionID, language, href, trail)) } hx-get={ browseURLForLanguage(connectionID, language, href, trail) } hx-target="#catalog-results" hx-swap="outerHTML">Next page</a>
		}
	</nav>
}
templ SearchResults(csrf, connectionID, language, returnTo, message, query string, feed opds.Feed) {
	@SearchResultsWithState(csrf, connectionID, language, returnTo, browseURLForLanguage(connectionID, language, "", nil), message, query, feed, nil)
}
templ SearchResultsWithState(csrf, connectionID, language, returnTo, backTo, message, query string, feed opds.Feed, owned []acquisitionEntryState) {
	<section id="catalog-results" aria-live="polite" aria-atomic="true">
	if message != "" {
		@CatalogNotice(message)
	}
	<a role="button" class="outline" href={ templ.URL(backTo) } hx-get={ backTo } hx-target="#catalog-results" hx-swap="outerHTML">← Back to catalog</a><h2>Results for “{ query }”</h2>
	@CatalogSearchForm(connectionID, language, backTo, nil)
	if len(feed.Entries) == 0 {
		@EmptyState("No matching books were found", "Revise search with another title or author. The selected catalog and language are unchanged.") { <a href={ templ.URL(backTo) }>Return to catalog</a> }
	}
	<div class="catalog-grid">
	for _, entry := range feed.Entries {
		@EntryCardWithState(csrf, connectionID, language, returnTo, entry, nil, owned)
	}
	</div>@SearchPagination(connectionID, language, backTo, query, feed)</section>
}
templ SearchPagination(connectionID, language, backTo, query string, feed opds.Feed) {
	<nav class="catalog-pagination" aria-label="Search result pages">
		if href := feedLink(feed, "previous"); href != "" {
			<a href={ templ.URL(searchPageURL(connectionID, language, query, backTo, href)) } hx-get={ searchPageURL(connectionID, language, query, backTo, href) } hx-target="#catalog-results" hx-swap="outerHTML">Previous page</a>
		}
		if href := feedLink(feed, "next"); href != "" {
			<a href={ templ.URL(searchPageURL(connectionID, language, query, backTo, href)) } hx-get={ searchPageURL(connectionID, language, query, backTo, href) } hx-target="#catalog-results" hx-swap="outerHTML">Next page</a>
		}
	</nav>
}
templ LanguageResults(csrf, connectionID, language, returnTo, message string, feed opds.Feed) {
	@LanguageResultsWithState(csrf, connectionID, language, returnTo, message, feed, nil)
}
templ LanguageResultsWithState(csrf, connectionID, language, returnTo, message string, feed opds.Feed, owned []acquisitionEntryState) {
	<section id="catalog-results" aria-live="polite" aria-atomic="true">
	if message != "" {
		@CatalogNotice(message)
	}
	<a role="button" class="outline" href={ templ.URL(browseURLForLanguage(connectionID, language, "", nil)) }>← Back to catalog</a>
	@CatalogSearchForm(connectionID, language, returnTo, nil)
	<h2>{ feed.Title }</h2><p><small>Showing EPUB editions only.</small></p>
	if len(feed.Entries) == 0 {
		@EmptyState("This language feed is empty", "No EPUB books were found for this language. Try another collection or search.") { <a href={ templ.URL(browseURLForLanguage(connectionID, language, "", nil)) }>Go back</a> }
	}
	<div class="catalog-grid">
	for _, entry := range feed.Entries {
		@EntryCardForLanguageWithState(csrf, connectionID, language, returnTo, entry, owned)
	}
	</div>@LanguagePagination(connectionID, language, feed)</section>
}
templ LanguagePagination(connectionID, language string, feed opds.Feed) {
	<nav class="catalog-pagination" aria-label="Catalog pages">
		if href := feedLink(feed, "previous"); href != "" {
			<a href={ templ.URL(languagePageURL(connectionID, language, href)) } hx-get={ languagePageURL(connectionID, language, href) } hx-target="#catalog-results" hx-swap="outerHTML">Previous page</a>
		}
		if href := feedLink(feed, "next"); href != "" {
			<a href={ templ.URL(languagePageURL(connectionID, language, href)) } hx-get={ languagePageURL(connectionID, language, href) } hx-target="#catalog-results" hx-swap="outerHTML">Next page</a>
		}
	</nav>
}
templ EntryCardForLanguage(csrf, connectionID, language, returnTo string, entry opds.Entry) {
	@EntryCardForLanguageWithState(csrf, connectionID, language, returnTo, entry, nil)
}
templ EntryCardForLanguageWithState(csrf, connectionID, language, returnTo string, entry opds.Entry, owned []acquisitionEntryState) {
	<article><h3>{ entry.Title }</h3>
	if epubLink := acquisitionLink(entry); epubLink != nil {
		if sourceID := acquisitionEntrySource(owned, connectionID, language, entry, epubLink.Href); sourceID != "" {
			@AcquisitionOwnedCard(entry, sourceID)
		} else {
			@AcquisitionForm(csrf, connectionID, language, returnTo, entry, epubLink.Href)
		}
	}
	</article>
}
templ CatalogNotice(message string) { <article role="status"><p>{ message }</p></article> }
templ EntryCard(csrf, connectionID, language, returnTo string, entry opds.Entry, trail []CatalogCrumb) {
	@EntryCardWithState(csrf, connectionID, language, returnTo, entry, trail, nil)
}
templ EntryCardWithState(csrf, connectionID, language, returnTo string, entry opds.Entry, trail []CatalogCrumb, owned []acquisitionEntryState) {
	<article><h3>{ entry.Title }</h3>
	if href := navigationLink(entry); href != "" {
		<a role="button" class="outline" href={ templ.URL(browseURLForLanguage(connectionID, language, href, trail)) } hx-get={ browseURLForLanguage(connectionID, language, href, trail) } hx-target="#catalog-results" hx-swap="outerHTML">Open collection</a>
	}
	if epubLink := acquisitionLink(entry); epubLink != nil {
		if sourceID := acquisitionEntrySource(owned, connectionID, language, entry, epubLink.Href); sourceID != "" {
			@AcquisitionOwnedCard(entry, sourceID)
		} else {
			@AcquisitionForm(csrf, connectionID, language, returnTo, entry, epubLink.Href)
		}
	}
	if navigationLink(entry) == "" && acquisitionLink(entry) == nil {
		<p><small>No compatible EPUB is available for this entry.</small></p>
	}
	</article>
}
templ AcquisitionForm(csrf, connectionID, language, returnTo string, entry opds.Entry, token string) {
	<form method="post" action="/opds/acquire" data-acquire hx-post="/opds/acquire" hx-target="closest article" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="connection" value={ connectionID }/>
	if language != "" {
		<input type="hidden" name="language" value={ language }/>
	}
	<input type="hidden" name="acquisition" value={ token }/>
	if returnTo != "" {
		<input type="hidden" name="return_to" value={ returnTo }/>
	}
	<button type="submit">Add to My Books</button><small>Downloads and validates the EPUB for later scope review. Analysis starts separately.</small></form>
}
templ AcquisitionSuccessCard(entry opds.Entry, sourceID string, alreadyPresent bool) {
	@AcquisitionSuccessCardWithReturn(entry, sourceID, alreadyPresent, "#catalog-results")
}
templ AcquisitionSuccessCardWithReturn(entry opds.Entry, sourceID string, alreadyPresent bool, returnTo string) {
	<article data-acquisition-result="settled"><h3>{ entry.Title }</h3>
	if alreadyPresent {
		<p>Already in My Books; this acquisition resolved to the existing book.</p>
	} else {
		<p>Added to My Books.</p>
	}
	<p><a href={ templ.SafeURL("/books/"+sourceID) }>Open owned book</a> when you are ready.</p><a href={ templ.SafeURL(returnTo) }>Continue browsing</a></article>
}
templ AcquisitionOwnedCard(entry opds.Entry, sourceID string) {
	<article class="acquisition-owned"><p role="status"><strong>Already in My Books</strong></p><a href={ templ.SafeURL("/books/"+sourceID) }>Open owned book</a></article>
}
templ AcquisitionFailureCard(csrf, connectionID, connectionName, language, returnTo, message string, entry opds.Entry, href string) {
	<article><h3>{ entry.Title }</h3><p role="alert">{ message }</p><p><strong>Affected connection:</strong> { connectionName }</p><p><a href={ templ.SafeURL("/connections#connection-"+connectionID) }>Edit connection</a> or retry the acquisition.</p>@AcquisitionForm(csrf, connectionID, language, returnTo, entry, href)</article>
}

templ CatalogRootPage(user domain.User, csrf string, connection domain.OpdsConnection, language, message string, feed opds.Feed, owned []acquisitionEntryState) {
	@ShellLayout(connection.Name, &user, csrf, NavigationAcquisition) {
		@Breadcrumb("/catalog?connection="+connection.ID, connection.Name)
		@PageHeader(connection.Name, "Browse collections and add EPUB books while keeping this catalog context.", nil)
		@CatalogRootResults(csrf, connection.ID, language, "/opds/browse?connection="+connection.ID+"&language="+language, message, feed, owned)
	}
}
templ CatalogFeedPage(user domain.User, csrf string, connection domain.OpdsConnection, feed opds.Feed, trail []CatalogCrumb, language, returnTo, message string, owned []acquisitionEntryState) {
	@ShellLayout(connection.Name, &user, csrf, NavigationAcquisition) {
		@Breadcrumb("/catalog?connection="+connection.ID, connection.Name)
		@PageHeader(connection.Name, "Browse collections and add EPUB books while keeping this catalog context.", nil)
		@FeedFragmentWithState(csrf, connection.ID, language, returnTo, message, feed, trail, owned)
	}
}
templ CatalogLanguagePage(user domain.User, csrf string, connection domain.OpdsConnection, language, returnTo, message string, feed opds.Feed, owned []acquisitionEntryState) {
	@ShellLayout(connection.Name, &user, csrf, NavigationAcquisition) {
		@Breadcrumb("/catalog?connection="+connection.ID, connection.Name)
		@PageHeader(connection.Name, "Browse EPUB books in the selected ready analysis language.", nil)
		@LanguageResultsWithState(csrf, connection.ID, language, returnTo, message, feed, owned)
	}
}
templ CatalogSearchPage(user domain.User, csrf string, connection domain.OpdsConnection, language, returnTo, backTo, query, message string, feed opds.Feed, owned []acquisitionEntryState) {
	@ShellLayout(connection.Name, &user, csrf, NavigationAcquisition) {
		@Breadcrumb("/catalog?connection="+connection.ID, connection.Name)
		@PageHeader(connection.Name, "Search this catalog and add EPUB books without losing your selected language.", nil)
		@SearchResultsWithState(csrf, connection.ID, language, returnTo, backTo, message, query, feed, owned)
	}
}
templ CatalogFailurePage(user domain.User, csrf string, connection domain.OpdsConnection, message, retryURL string) {
	@ShellLayout(connection.Name, &user, csrf, NavigationAcquisition) {
		@Breadcrumb("/connections", "Catalog connections")
		@PageHeader(connection.Name, "Catalog access needs attention before browsing can continue.", nil)
		@CatalogFailureFragment(connection, message, retryURL)
	}
}
templ CatalogFailureFragment(connection domain.OpdsConnection, message, retryURL string) {
	<section id="catalog-results" aria-live="polite" aria-atomic="true">
		@Feedback(catalogFailureKind(message), catalogFailureTitle(message), message)
		<p><strong>Affected connection:</strong> { connection.Name }</p>
		<div class="action-group"><a role="button" href={ templ.SafeURL("/connections#connection-"+connection.ID) }>Edit connection</a><a role="button" class="outline" href={ templ.SafeURL(retryURL) }>Retry</a></div>
	</section>
}
templ AcquisitionFailurePage(user domain.User, csrf string, connection domain.OpdsConnection, language, returnTo, message string, entry opds.Entry, href string) {
	@ShellLayout(connection.Name, &user, csrf, NavigationAcquisition) {
		@Breadcrumb("/catalog?connection="+connection.ID, connection.Name)
		@PageHeader(connection.Name, "The book was not added; you can recover and continue browsing.", nil)
		<article><h2>{ entry.Title }</h2><p><strong>Affected connection:</strong> { connection.Name }</p><p role="alert">{ message }</p><p><a href={ templ.SafeURL("/connections#connection-"+connection.ID) }>Edit connection</a> or retry the acquisition below.</p>@AcquisitionForm(csrf, connection.ID, language, returnTo, entry, href)</article>
	}
}
templ JobsPage(user domain.User, csrf string, jobs []domain.AnalysisJob, message string) {
	@ShellLayout("Jobs", &user, csrf, NavigationLibrary) {
		@PageHeader("Analysis jobs", "Operational history for submitted analyses.", nil)
		if message != "" {
			@Feedback(FeedbackInfo, "", message)
		}
		if len(jobs) == 0 {
			@EmptyState("No analysis runs yet", "Start analysis from a book after confirming its scope.") {
				<a href="/library">Go to My Books</a>
			}
		}
		if len(jobs) > 0 {
			@ResponsiveTable("Analysis history") {
				<thead><tr><th>Job</th><th>Progress</th><th>Created</th><th>Error</th></tr></thead><tbody>
				for _, job := range jobs {
					<tr><td>
						if job.AnalysisState == "completed" && job.AnalysisRunID != "" && job.CorpusID != "" {
							<a href={ templ.SafeURL(fmt.Sprintf("/books/%s/analyses/%s", job.SourceMaterialID, job.AnalysisRunID)) }>{ fmt.Sprintf("#%d · result", job.DisplayNumber) }</a>
						} else {
							<a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", job.ID)) }>{ fmt.Sprintf("#%d", job.DisplayNumber) }</a>
						}
					</td><td><progress aria-label={ fmt.Sprintf("Analysis job %d progress", job.DisplayNumber) } value={ fmt.Sprintf("%d",job.Progress) } max="100"></progress> { fmt.Sprintf("%d%%",job.Progress) }</td><td>{ job.CreatedAt.Format("2006-01-02 15:04") }</td><td>{ job.Error }</td></tr>
				}
				</tbody>
			}
		}
	}
}
templ JobPage(user domain.User, csrf string, status analysis.Status) {
	@ShellLayout(fmt.Sprintf("Job #%d", status.DisplayNumber), &user, csrf, NavigationLibrary) {
		@PageHeader(fmt.Sprintf("Analysis job #%d", status.DisplayNumber), "Operational status for this analysis run.", nil)
		@JobStatus(csrf, status)
	}
}
templ JobStatus(csrf string, status analysis.Status) {
	@AsyncStatus(jobStatusAttributes(status.ID, jobRunning(status)), "job-status", jobState(status), analysisStatusSummary(status), status.Progress, 100, jobRunning(status)) {
		if status.Error != "" {
			@Feedback(FeedbackError, "Analysis needs attention", status.Error+" Retry the analysis when the confirmed scope is still valid.")
		}
		@ActionGroup() {
			if jobRetryable(status) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/retry", status.ID)) }><input type="hidden" name="csrf_token" value={ csrf }/><button>Retry analysis</button></form>
			}
			if jobRunning(status) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/cancel", status.ID)) }><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Cancel analysis</button></form>
			}
		}
		if status.CorpusID != "" {
			if status.ScopeID != "" && status.LogicalState == "completed" {
					if status.SourceMaterialID != "" && status.RunID != "" {
						<p>Analysis complete. Review the insights for this immutable analysis result.</p>
						<a role="button" class="outline" href={ templ.SafeURL(fmt.Sprintf("/books/%s/analyses/%s", status.SourceMaterialID, status.RunID)) }>View analysis result</a>
					} else {
						<p>Analysis complete. Prepare a deck from this immutable analysis result.</p>
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/deck/preparations", status.ID)) } data-prepare-deck><input type="hidden" name="csrf_token" value={ csrf }/><label><input type="checkbox" name="external_translation_consent"/> Send each selected lemma and example sentence to the configured translation provider</label><small>Preparation runs in the background. You can download the completed deck when it is ready.</small><button type="submit">Prepare deck</button></form><section data-deck-preparation role="status" aria-live="polite" aria-atomic="true" hidden></section>
					}
			} else {
				<p>Analysis complete. Legacy/full-text results cannot unlock a new deck preparation.</p>
			}
		}
	}
}
templ KnownVocabPageWithResult(user domain.User, csrf string, profiles []domain.LanguageProfile, language string, result *knownvocab.ImportResult, known []domain.KnownVocabulary, message string) {
	@ShellLayout("Known vocabulary", &user, csrf, NavigationSettings) { <h1>Known vocabulary</h1><p>Import words you already know so pre-learning decks focus on new vocabulary.</p>
	<article><form method="post" action="/known-vocab/import" enctype="multipart/form-data" hx-post="/known-vocab/import" hx-encoding="multipart/form-data" hx-target="#known-vocab-results" hx-swap="innerHTML"><input type="hidden" name="csrf_token" value={ csrf }/><label>Language code<input name="language" value={ language } list="study-languages" placeholder="de" required/></label><datalist id="study-languages">
	for _, profile := range profiles {
		<option value={ profile.Language }>{ profile.DisplayName }</option>
	}
	</datalist><label>UTF-8 lemma file<input type="file" name="vocabulary_file" accept="text/plain,.txt" required/></label><small>One lemma per nonblank line. Tab-separated columns are rejected.</small><button>Import known words</button></form></article><section id="known-vocab-results">@KnownVocabResult(language, result, known, message)</section> }
}
templ KnownVocabResult(language string, result *knownvocab.ImportResult, known []domain.KnownVocabulary, message string) {
	if message != "" {
		@Feedback(FeedbackError, "Import not completed", message)
	}
	if result != nil {
		<article class="resource-card"><h2>Import result</h2><p role="status"><strong>{ fmt.Sprintf("%d new", result.Imported) }</strong> · { fmt.Sprintf("%d duplicates", result.AlreadyKnown) } · { fmt.Sprintf("%d rejected", len(result.Rejected)) }</p>
		if len(result.Rejected) > 0 {
			<h3>Rejected rows</h3>
			@ResponsiveTable("Rejected vocabulary rows") {
				<thead><tr><th>Row</th><th>Original</th><th>Reason</th></tr></thead><tbody>
				for _, rejection := range result.Rejected {
					<tr><td>{ fmt.Sprintf("%d", rejection.Row) }</td><td><code>{ rejection.Original }</code></td><td>{ rejection.Error }</td></tr>
				}
				</tbody>
			}
		}
		</article>
	}
	<h2>Known vocabulary
	if language != "" {
		<small> · language code { language }</small>
	}
	</h2>
	if language == "" {
		<p>Choose a language to view known vocabulary.</p>
	} else if len(known) == 0 {
		<p>No known vocabulary has been recorded for this language yet. This does not mean the language is unavailable or that the learner knows no words.</p>
	} else {
		@ResponsiveTable("Known vocabulary") {
			<thead><tr><th>Lemma</th><th>Part of speech</th><th>Provenance</th><th>Recorded</th></tr></thead><tbody>
			for _, entry := range known {
				<tr><td>{ lemmadisplay.Format(entry.Language, entry.CanonicalLemma, entry.UPOS) }</td><td>{ knownVocabUPOS(entry.UPOS) }</td><td>{ knownVocabProvenance(entry) }</td><td>{ entry.CreatedAt.Format("2006-01-02") }</td></tr>
			}
			</tbody>
		}
	}
}
templ KnownVocabImportStatus(status knownvocab.Status) {
	@AsyncStatus(knownVocabImportAttributes(status), "known-vocab-import-status", knownVocabImportTitle(status), knownVocabImportSummary(status), int(status.Processed), int(status.Total), knownVocabJobBusy(string(status.State))) {
		@knownVocabImportStatusBody(status)
	}
}
templ EnrichmentJobStatus(status enrichmentjob.Status, csrf string) {
	@AsyncStatus(enrichmentJobAttributes(status), "enrichment-job-status", "Contextual translations: "+enrichmentJobLabel(string(status.State)), enrichmentJobSummary(status), int(status.Completed), int(status.Total), status.State != "completed" && status.State != "cancelled" && status.State != "discarded") {
		if status.Error != "" {
			@Feedback(FeedbackError, "Translation needs attention", status.Error+" Review the affected book and try again when the provider is available.")
		}
		if status.State != "completed" && status.State != "cancelled" && status.State != "discarded" {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/enrichment-jobs/%d/cancel", status.ID)) } hx-post={ fmt.Sprintf("/enrichment-jobs/%d/cancel", status.ID) } hx-target="#enrichment-job-status" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value={ csrf }/><button class="outline secondary">Cancel translations</button></form>
		}
	}
}
templ knownVocabImportStatusBody(status knownvocab.Status) {
		if knownVocabJobBusy(string(status.State)) {
			<p>Return to Settings to review the result after processing finishes.</p>
		}
		if status.State == "completed" {
			if len(status.Rejected) > 0 {
				<p><strong>Import completed with partial rejection.</strong> Successful rows remain known; correct the rejected rows and upload another additive import if needed.</p>
			} else {
				<p><strong>Import complete.</strong></p>
			}
			if len(status.Rejected) > 0 {
				<h3>Rejected rows</h3>@ResponsiveTable("Rejected vocabulary rows") {
					<thead><tr><th>Row</th><th>Original</th><th>Reason</th></tr></thead><tbody>
					for _, rejection := range status.Rejected {
						<tr><td>{ fmt.Sprintf("%d", rejection.Row) }</td><td><code>{ rejection.Original }</code></td><td>{ rejection.Error }</td></tr>
					}
					</tbody>
				}
				}
				<p><a href={ templ.SafeURL(knownVocabImportRecoveryTarget(status.Language)) }>Review known vocabulary</a></p>
		}
		if status.State == "completed" || status.State == "discarded" || status.State == "cancelled" {
			<p><strong>{ fmt.Sprintf("%d new", status.Imported) }</strong> · { fmt.Sprintf("%d duplicates", status.AlreadyKnown) } · { fmt.Sprintf("%d rejected", len(status.Rejected)) }</p>
		}
		if status.Error != "" && status.State != "cancelled" && status.State != "discarded" {
			<p role="alert"><strong>Import failed:</strong> { status.Error } Upload the original file again after correcting the problem.</p>
		}
		if status.State == "cancelled" {
			<p role="alert"><strong>Import cancelled.</strong> No new result is available from this attempt. Upload the file again when ready.</p>
			if status.Language != "" {
				<p>Selected language: <code>{ status.Language }</code></p>
			}
			<p><a href={ templ.SafeURL(knownVocabImportRecoveryTarget(status.Language)) }>Return to Known vocabulary settings to retry the import</a></p>
		}
		if status.State == "discarded" {
			<p role="alert"><strong>Import failed.</strong>
			if status.Error != "" {
				{ status.Error }
			}
			The job was discarded after repeated attempts. Upload the file again after correcting the problem.</p>
			if status.Language != "" {
				<p>Selected language: <code>{ status.Language }</code></p>
			}
			<p><a href={ templ.SafeURL(knownVocabImportRecoveryTarget(status.Language)) }>Return to Known vocabulary settings to retry the import</a></p>
		}
}

templ DeckJourneyAction(action deckJourneyActionView, csrf string) {
	if action.State != deckJourneyUnknown {
		<div id={ deckJourneyActionID(action.BookID) } role="status" aria-live="polite" aria-atomic="true">
			if action.Message != "" {
				if strings.Contains(action.Message, "changed since") {
					<p role="alert">{ action.Message }</p>
				} else {
					<p role="status">{ action.Message }</p>
				}
			}
			if action.Error != "" {
				<p role="alert">{ action.Error }</p>
			}
			if action.State == deckJourneyNotMember {
				<p><strong>Not in Reading Journey.</strong> Add this book to your provisional Reading Journey when you are ready.</p>
				<form method="post" action={ templ.SafeURL(deckJourneyAddURL(action.BookID)) } hx-post={ templ.SafeURL(deckJourneyAddURL(action.BookID)) } hx-target={ templ.SafeURL("#"+deckJourneyActionID(action.BookID)) } hx-swap="outerHTML">
					<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_revision" value={ fmt.Sprintf("%d", action.Revision) }/>
					if action.PreparationID != "" {
						<input type="hidden" name="deck_preparation_id" value={ action.PreparationID }/>
					}
					<button type="submit">Add to Reading Journey</button>
				</form>
			} else if action.State == deckJourneyMember {
				<p><strong>In Reading Journey.</strong> This book is already in your Reading Journey.</p>
				<p><a href={ templ.SafeURL("/journey#"+journeyBookAnchorID(action.BookID)) }>View this Journey entry</a></p>
			} else if action.State == deckJourneyGoal {
				<p><strong>Primary Goal.</strong> This deck is preparation for your current Primary Goal.</p>
				<p><a href={ templ.SafeURL("/journey#"+journeyBookAnchorID(action.BookID)) }>View Primary Goal in Reading Journey</a></p>
			}
		</div>
	}
}
