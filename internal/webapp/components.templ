package webapp

import "fmt"
import "github.com/justin-hayes/mouseion/internal/domain"

templ PageHeader(title, description string, status templ.Component) {
	<header class="page-header">
		<div class="page-header__content">
			<h1>{ title }</h1>
			if description != "" {
				<p>{ description }</p>
			}
			if status != nil {
				<div class="page-header__status">@status
</div>
			}
		</div>
		<div class="page-header__actions">
			{ children... }
		</div>
	</header>
}

templ LifecycleActionControl(action bookLifecycleAction, csrf string) {
	if action.Submit {
		<form class="inline-action" method="post" action={ templ.SafeURL(action.URL) }><input type="hidden" name="csrf_token" value={ csrf }/><button type="submit" class="outline">{ action.Label }</button></form>
	} else if action.URL != "" {
		<a role="button" href={ templ.SafeURL(action.URL) }>{ action.Label }</a>
	}
}

templ NextActionSummary(action bookLifecycleAction) {
	<section class="next-action" aria-labelledby="next-action-heading">
		<h2 id="next-action-heading">Next action</h2>
		<p><strong>{ action.Status }.</strong> { action.Description }</p>
	</section>
}

templ Breadcrumb(href, label string) {
	<nav class="breadcrumb" aria-label="Breadcrumb">
		<a href={ templ.SafeURL(href) }>← { label }</a>
	</nav>
}

templ StatusBadge(label string, tone StatusTone) {
	<span class={ statusBadgeClass(tone) }>{ label }</span>
}

templ Feedback(kind FeedbackKind, title, message string) {
	<article { feedbackAttributes(kind)... } class={ feedbackClass(kind) } role={ feedbackRole(kind) } aria-live={ feedbackLive(kind) }>
		if title != "" {
			<strong>{ title }</strong>
		}
		if message != "" {
			<p>{ message }</p>
		}
	</article>
}

templ EmptyState(title, message string) {
	<article class="empty-state">
		<h2>{ title }</h2>
		if message != "" {
			<p>{ message }</p>
		}
		<div class="empty-state__actions">
			{ children... }
		</div>
	</article>
}

templ ActionGroup() {
	<div class="action-group">
		{ children... }
	</div>
}

templ ResourceCard() {
	<article class="resource-card">
		{ children... }
	</article>
}

templ Confirmation(summary, description string, tone StatusTone) {
	<details class={ confirmationClass(tone) }>
		<summary>{ summary }</summary>
		<div class="confirmation__body">
			if description != "" {
				<p>{ description }</p>
			}
			{ children... }
		</div>
	</details>
}

templ StatGroup(items []StatItem) {
	<div class="stat-group" role="list">
		for _, item := range items {
			<article class="stat-group__item" role="listitem">
				<strong class="stat-group__value numeric">{ item.Value }</strong>
				<span class="stat-group__label">{ item.Label }</span>
				if item.Detail != "" {
					<small class="stat-group__detail">{ item.Detail }</small>
				}
			</article>
		}
	</div>
}

templ MetadataList(items []MetadataItem) {
	<dl class="metadata-list">
		for _, item := range items {
			<div>
				<dt>{ item.Term }</dt>
				<dd>{ item.Description }</dd>
			</div>
		}
	</dl>
}

templ ResponsiveTable(label string) {
	<div class="table-region" role="region" aria-label={ label } tabindex="0">
		<table>
			{ children... }
		</table>
	</div>
}

templ AsyncStatus(attributes templ.Attributes, id, title, summary string, value, max int, busy bool) {
	<section { attributes... } id={ id } class="async-status" role="status" aria-live="polite" aria-atomic="true" aria-busy={ boolString(busy) }>
		<p class="async-status__title"><strong>{ title }</strong></p>
		if summary != "" {
			<p>{ summary }</p>
		}
		if max > 0 {
			<progress aria-label={ title + " progress" } value={ fmt.Sprintf("%d", value) } max={ fmt.Sprintf("%d", max) }>{ fmt.Sprintf("%d of %d", value, max) }</progress>
		}
		<div class="async-status__actions">
			{ children... }
		</div>
	</section>
}

templ ActiveStudyLanguageSwitcher(view *shellView, csrf string) {
	if view != nil && len(view.Options) > 0 {
		<li class="site-header__language"><form method="post" action="/active-study-language"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="return_to" value={ view.ReturnTo }/><label for="active-study-language">Study language<select id="active-study-language" name="language" required onchange="this.form.submit()">if view.ActiveLanguage == "" {
			<option value="" disabled selected>Choose a study language</option>
		}
			for _, option := range view.Options {
				<option value={ option.Language } selected?={ view.ActiveLanguage == option.Language }>{ activeStudyLanguageLabel(option) }</option>
			}
		</select></label><noscript><button type="submit">Switch language</button></noscript></form></li>
	}
}

templ CatalogueSyncConnectionStatus(view catalogueSyncConnectionView) {
	<p><strong>{ view.State }</strong></p>
	if view.HasLastSyncedAt {
		<p>Last successful sync: <time datetime={ view.LastSyncedAtISO }>{ view.LastSyncedAt }</time></p>
	}
	if view.Message != "" {
		<p>{ view.Message }</p>
	}
	if view.UpsertSummary != "" {
		<p>{ view.UpsertSummary }</p>
	}
	if view.Error != "" {
		<p><strong>Sync detail:</strong> { view.Error }</p>
	}
}

templ CatalogueSyncConnectionActions(csrf string, connection domain.OpdsConnection, view catalogueSyncConnectionView) {
	<div class="action-group">
		<form method="post" action={ templ.SafeURL("/connections/" + connection.ID + "/sync") }><input type="hidden" name="csrf_token" value={ csrf }/><button type="submit" disabled?={ view.Syncing }>Sync now</button></form>
		if view.Syncing {
			<span>Sync already in progress.</span>
			<a href="/jobs">View job status</a>
		}
		if view.Failed {
			<a role="button" class="outline" href={ templ.SafeURL("#edit-connection-" + connection.ID) }>Edit connection</a>
			<a href="/jobs">View job status</a>
		}
		if view.State == "Last synced" {
			<a role="button" class="outline" href="/library">Browse My Books</a>
		}
	</div>
}
