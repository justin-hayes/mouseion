package webapp

import "fmt"
import "strconv"
import "time"
import "github.com/justin-hayes/mouseion/internal/domain"

templ PageHeader(title, description string, status templ.Component) {
	<header class="page-header">
		<div class="page-header__content">
			<h1>{ title }</h1>
			if description != "" {
				<p>{ description }</p>
			}
			if status != nil {
				<div class="page-header__status">@status
</div>
			}
		</div>
		<div class="page-header__actions">
			{ children... }
		</div>
	</header>
}

// CoverImage is a retained cover image at its intrinsic size. The alternative
// text is empty because the adjacent visible title names the Book.
templ CoverImage(src string, width, height int) {
	<img class="book-cover-media__image" src={ templ.SafeURL(src) } alt="" width={ fmt.Sprintf("%d", width) } height={ fmt.Sprintf("%d", height) } loading="lazy" decoding="async"/>
}

templ BookCoverMedia(bookID string, plate titlePlate, cover domain.BookCover) {
	<div class="book-cover-media">
		if cover.State == domain.BookCoverAvailable && cover.Width > 0 && cover.Height > 0 {
			@CoverImage(bookCoverURL(bookID), cover.Width, cover.Height)
		} else {
			<div class="book-cover-media__placeholder" aria-hidden="true">
				<span class="title-plate__title">{ plate.Title }</span>
				if plate.OriginalTitle != "" {
					<span class="title-plate__greek" lang={ plate.OriginalLang }>{ plate.OriginalTitle }</span>
				}
				if plate.Author != "" {
					<span class="title-plate__author">{ plate.Author }</span>
				}
				<span class="book-cover-media__label">{ bookCoverLabel(cover) }</span>
			</div>
		}
	</div>
}

templ Breadcrumb(href, label string) {
	<nav class="breadcrumb" aria-label="Breadcrumb">
		<a href={ templ.SafeURL(href) }>← { label }</a>
	</nav>
}

templ StatusBadge(label string, tone StatusTone) {
	<span class={ statusBadgeClass(tone) }><span class={ statusBadgeShapeClass(label, tone) } aria-hidden="true"></span>{ label }</span>
}

templ Feedback(kind FeedbackKind, title, message string) {
	<article { feedbackAttributes(kind)... } class={ feedbackClass(kind) } role={ feedbackRole(kind) } aria-live={ feedbackLive(kind) }>
		if title != "" {
			<strong>{ title }</strong>
		}
		if message != "" {
			<p>{ message }</p>
		}
		{ children... }
	</article>
}

templ EmptyState(title, message string) {
	<article class="empty-state">
		<h2>{ title }</h2>
		if message != "" {
			<p>{ message }</p>
		}
		<div class="empty-state__actions">
			{ children... }
		</div>
	</article>
}

templ ActionGroup() {
	<div class="action-group">
		{ children... }
	</div>
}

templ Confirmation(summary, description string, tone StatusTone) {
	<details class={ confirmationClass(tone) }>
		<summary>{ summary }</summary>
		<div class="confirmation__body">
			if description != "" {
				<p>{ description }</p>
			}
			{ children... }
		</div>
	</details>
}

templ ResponsiveTable(label string) {
	<div class="table-region" role="region" aria-label={ label } tabindex="0">
		<table>
			{ children... }
		</table>
	</div>
}

templ AsyncStatus(attributes templ.Attributes, id, title, summary string, value, max int, busy bool, metadata templ.Component) {
	<section { attributes... } id={ id } class="async-status" role="status" aria-live="polite" aria-atomic="true" aria-busy={ boolString(busy) }>
		<p class="async-status__title"><strong>{ title }</strong></p>
		if summary != "" {
			<p>{ summary }</p>
		}
		if max > 0 {
			<progress aria-label={ title + " progress" } value={ fmt.Sprintf("%d", value) } max={ fmt.Sprintf("%d", max) }>{ fmt.Sprintf("%d of %d", value, max) }</progress>
		}
		if metadata != nil {
			@metadata
		}
		<div class="async-status__actions">
			{ children... }
		</div>
	</section>
}

templ OperationalJobMetadata(identityLabel, identity string, createdAt time.Time, attempt, attemptCount int, finishedAt *time.Time) {
	<dl class="operational-metadata" aria-live="off">
		if identity != "" {
			<div><dt>{ identityLabel }</dt><dd>{ identity }</dd></div>
		}
		<div><dt>Created</dt><dd>
			if createdAt.IsZero() {
				Unavailable
			} else {
				<time datetime={ createdAt.UTC().Format(time.RFC3339) }>{ createdAt.UTC().Format("2006-01-02 15:04:05 UTC") }</time>
			}
		</dd></div>
		<div><dt>Attempt</dt><dd>{ fmt.Sprintf("%d of %d", maxOne(attempt), maxOne(attemptCount)) }</dd></div>
		if finishedAt != nil && !finishedAt.IsZero() {
			<div><dt>Finished</dt><dd><time datetime={ finishedAt.UTC().Format(time.RFC3339) }>{ finishedAt.UTC().Format("2006-01-02 15:04:05 UTC") }</time></dd></div>
		}
	</dl>
}

templ ActiveStudyLanguageSwitcher(view *shellView, context NavigationContext) {
	if showStudyLanguagePicker(view, context) {
		<form class="site-header__language" method="get" action="/study-language">if view.PageKind != "" {
			<input type="hidden" name="to" value={ string(view.PageKind) }/>
		}<label for="active-study-language"><span class="site-header__language-label">Study language</span><select id="active-study-language" name="lang" required onchange="this.form.submit()">if view.pageLanguage() == "" {
			<option value="" disabled selected>Choose a study language</option>
		}
			for _, option := range view.Options {
				<option value={ option.Language } selected?={ view.pageLanguage() == option.Language }>{ activeStudyLanguageLabel(option) }</option>
			}
		</select></label><noscript><button class="btn btn-primary" type="submit">Switch language</button></noscript></form>
	}
}

templ CatalogueSyncConnectionStatus(view catalogueSyncConnectionView) {
	<p><strong>{ view.State }</strong></p>
	if view.HasLastSyncedAt {
		<p>Last successful sync: <time datetime={ view.LastSyncedAtISO }>{ view.LastSyncedAt }</time></p>
	}
	if view.Message != "" {
		<p>{ view.Message }</p>
	}
	if view.UpsertSummary != "" {
		<p>{ view.UpsertSummary }</p>
	}
	if view.Error != "" {
		<p><strong>Sync detail:</strong> { view.Error }</p>
	}
}

// CatalogueSyncControl is the one Sync now form used by both the Catalog and
// Manage sources. returnTo chooses the page the sync outcome returns to.
templ CatalogueSyncControl(csrf string, connection domain.OpdsConnection, view catalogueSyncConnectionView, returnTo string) {
	<form method="post" action={ templ.SafeURL("/catalogs/sources/" + connection.ID + "/sync") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="return" value={ returnTo }/><button class="button" type="submit" disabled?={ view.Syncing }>Sync now</button></form>
	if view.Syncing {
		<span>Sync already in progress.</span>
		<a href="/jobs">View job status</a>
	}
}

templ CatalogueSyncConnectionActions(csrf string, connection domain.OpdsConnection, view catalogueSyncConnectionView) {
	<div class="action-group">
		@CatalogueSyncControl(csrf, connection, view, "sources")
		if view.Failed {
			<a role="button" class="button button--outline" href={ templ.SafeURL("#edit-connection-" + connection.ID) }>Edit connection</a>
			<a href="/jobs">View job status</a>
		}
		if view.State == "Last synced" {
			<a role="button" class="button button--outline" href="/library">Browse My Books</a>
		}
	</div>
}

// studyTabLabel is the Study tab's text and, while reviews are due, its due
// chip. The chip is absent at zero. The link's accessible name carries both the
// destination and the count; the visible number is hidden from assistive
// technology so it is not read twice.
templ studyTabLabel(view *shellView) {
	Study
	if view != nil && view.StudyDue > 0 {
		<span class="site-nav__count" aria-hidden="true">{ strconv.Itoa(view.StudyDue) }</span>
	}
}
