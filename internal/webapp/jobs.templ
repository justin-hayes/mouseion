package webapp

import (
	"fmt"

	"github.com/justin-hayes/mouseion/internal/analysis"
	"github.com/justin-hayes/mouseion/internal/cataloguesync"
	"github.com/justin-hayes/mouseion/internal/domain"
)

// JobsPage is the operational history surface: one Book preparations list
// covering Classical preparation, EPUB acquisition and analysis, and one
// Catalog sync list. A Book preparation row links to its Book only while the
// Book is still a current My Books member; an analysis row also keeps its
// link to the analysis detail page, and a Catalog sync row to its own detail
// page.
templ JobsPage(user domain.User, csrf string, preparations []domain.BookPreparationJob, syncJobs []cataloguesync.Status, catalogCode, message string) {
	@ShellLayout("Jobs", &user, csrf, NavigationLibrary, shellStyleJobs) {
		@PageHeader("Jobs", "Operational history for Book preparations and Catalog sync.", nil)
		if message != "" {
			@Feedback(FeedbackInfo, "", message)
		}
		if len(preparations) == 0 && len(syncJobs) == 0 && catalogCode == "" {
			@EmptyState("No jobs yet", "Book preparation and catalog sync work will appear here when submitted.") { <a href="/library">Go to My Books</a> }
		}
		if catalogCode != "" {
			<section aria-labelledby="classical-catalog-job-status-heading">
				<h2 id="classical-catalog-job-status-heading">Classical catalog</h2>
				<p>@StatusBadge("Unavailable", StatusDanger) Preparation and adding are blocked. Stable code: <code>{ catalogCode }</code>.</p>
			</section>
		}
		if len(preparations) > 0 {
			<section>
				<h2>Book preparations</h2>
				@ResponsiveTable("Book preparations") {
					<thead><tr><th>Kind</th><th>Book</th><th>Status</th><th>Stage</th><th>Code</th><th>Progress</th><th>Created</th></tr></thead><tbody>
					for _, job := range preparations {
						{{ lifecycle := jobLifecycleViewFor(job.Lifecycle) }}
						<tr><td>
							if job.Kind == domain.BookPreparationKindAnalysis {
								<a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", job.JobID)) }>{ fmt.Sprintf("Analysis #%d", job.DisplayNumber) }</a>
							} else {
								{ bookPreparationKindLabel(job.Kind) }
							}
						</td><td>
							if job.BookID != "" && job.BookInMyBooks {
								<a href={ templ.SafeURL(catalogBookInMyBooksURL(job.BookID)) }>{ job.BookTitle }</a>
							} else {
								{ job.BookTitle }
							}
						</td><td>
							@StatusBadge(lifecycle.Label, lifecycle.Tone)
							if job.DecisionsTotal > 0 {
								<p class="metadata">{ fmt.Sprintf("%d of %d decisions carried over", job.DecisionsCarried, job.DecisionsTotal) }</p>
							}
						</td><td>
							if job.Stage == "" {
								—
							} else {
								{ string(job.Stage) }
							}
						</td><td>
							if job.Code == "" {
								—
							} else {
								<code>{ string(job.Code) }</code>
							}
							{{ reason := bookPreparationFailureReason(job) }}
							if reason != "" {
								<p class="metadata">{ reason }</p>
							}
						</td><td>
							if job.Progress != nil {
								<progress aria-label={ fmt.Sprintf("Analysis job %d progress", job.DisplayNumber) } value={ fmt.Sprintf("%d", *job.Progress) } max="100"></progress> { fmt.Sprintf("%d%%", *job.Progress) }
							}
						</td><td>{ completedAtLabel(&job.CreatedAt) }</td></tr>
					}
					</tbody>
				}
			</section>
		}
		if len(syncJobs) > 0 {
			<section>
				<h2>Catalog sync</h2>
				@ResponsiveTable("Catalog sync") {
					<thead><tr><th>Connection</th><th>Status</th><th>Created</th><th>Error</th></tr></thead><tbody>
					for _, job := range syncJobs {
						{{ lifecycle := jobLifecycleViewFor(job.Lifecycle) }}
						<tr><td><a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", job.ID)) }>{ job.ConnectionName }</a></td><td>@StatusBadge(lifecycle.Label, lifecycle.Tone)</td><td>{ completedAtLabel(&job.CreatedAt) }</td><td>{ job.Error }</td></tr>
					}
					</tbody>
				}
			</section>
		}
	}
}

templ JobPage(user domain.User, csrf string, status analysis.Status, readingBookURL, bookTitle string) {
	@ShellLayout(fmt.Sprintf("Job #%d", status.DisplayNumber), &user, csrf, NavigationLibrary, shellStyleJobs) {
		@PageHeader(fmt.Sprintf("Analysis job #%d", status.DisplayNumber), "Operational status for this analysis run.", nil)
		@JobStatus(csrf, status, readingBookURL, bookTitle)
	}
}

templ JobStatus(csrf string, status analysis.Status, readingBookURL, bookTitle string) {
	{{ lifecycle := jobLifecycleViewFor(status.Lifecycle) }}
	@AsyncStatus(jobStatusAttributes(status.ID, jobRunning(status)), "job-status", lifecycle.Label, analysisStatusSummary(status), status.Progress, 100, jobRunning(status), OperationalJobMetadata("Book", bookTitle, status.CreatedAt, status.Attempt, status.AttemptCount, status.FinalizedAt)) {
		if analysisNeedsAttention(status) {
			@Feedback(FeedbackError, "Analysis needs attention", analysisFailureSentence(status.FailureCode)+" Retry the analysis when you are ready.")
		}
		@ActionGroup() {
			if jobRetryable(status) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/retry", status.ID)) }><input type="hidden" name="csrf_token" value={ csrf }/><button class="button" type="submit">Retry analysis</button></form>
			}
			if jobRunning(status) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/cancel", status.ID)) }><input type="hidden" name="csrf_token" value={ csrf }/><button class="button button--outline" type="submit">Cancel analysis</button></form>
			}
		}
		if status.CorpusID != "" {
			if status.Lifecycle == domain.JobLifecycleCompleted {
					if status.SourceMaterialID != "" && status.RunID != "" && readingBookURL != "" {
						<p>Analysis complete. Continue with this book in My Books.</p>
						<a role="button" class="button button--outline" href={ templ.SafeURL(readingBookURL) }>View in My Books</a>
					} else {
						if status.SourceMaterialID != "" && status.RunID != "" {
							<p>Analysis complete, but this book is no longer available in Reading.</p>
						} else {
							<p>Analysis complete.</p>
						}
					}
			} else {
				<p>Analysis complete. Legacy full-text results are not part of Reading.</p>
			}
		}
	}
}

templ CatalogueSyncJobPage(user domain.User, csrf string, status cataloguesync.Status) {
	@ShellLayout(fmt.Sprintf("Catalog sync #%d", status.ID), &user, csrf, NavigationLibrary, shellStyleJobs) {
		@PageHeader("Catalog sync", status.ConnectionName, nil)
		@CatalogueSyncJobStatus(csrf, status)
	}
}

templ CatalogueSyncJobStatus(csrf string, status cataloguesync.Status) {
	{{ lifecycle := jobLifecycleViewFor(status.Lifecycle) }}
	@AsyncStatus(catalogueSyncJobStatusAttributes(status.ID, catalogueSyncStatusRunning(status)), "catalogue-sync-job-status", lifecycle.Label, catalogueSyncJobSummary(status), status.Progress, 100, catalogueSyncStatusRunning(status), OperationalJobMetadata("Connection", status.ConnectionName, status.CreatedAt, int(status.Attempt), int(status.AttemptCount), status.FinalizedAt)) {
		if status.Error != "" {
			@Feedback(FeedbackError, "Catalog sync needs attention", status.Error)
		}
		@ActionGroup() {
			if status.Lifecycle.Retryable() {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/retry", status.ID)) }><input type="hidden" name="csrf_token" value={ csrf }/><button class="button" type="submit">Retry catalog sync</button></form>
			}
			if catalogueSyncStatusRunning(status) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/cancel", status.ID)) }><input type="hidden" name="csrf_token" value={ csrf }/><button class="button button--outline" type="submit">Cancel catalog sync</button></form>
			}
		}
		<p>Catalog sync reconciles metadata only; it does not download EPUB content.</p>
	}
}
