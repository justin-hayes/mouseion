package webapp

import "github.com/justin-hayes/mouseion/internal/domain"

// AnalysisUpdateNotice is the Book-level Analysis update notice (ADR 0107). The
// action is a native disclosure confirmation, so it works without JavaScript.
templ AnalysisUpdateNotice(book domain.MyBook, csrf, buttonClass string) {
	{{ offer, candidate := myBookAnalysisUpdate(book) }}
	if offer == domain.AnalysisUpdateAvailable {
		<div class="analysis-update">
			<p><strong>{ analysisUpdateNotice }</strong></p>
			@Confirmation("Update analysis", analysisUpdateConfirmationText(*candidate), StatusNeutral) {
				<form method="post" action={ templ.SafeURL(readingAnalysisUpdateURL(book.Book.ID)) }>
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<input type="hidden" name="expected_run_id" value={ candidate.PublishedRunID }/>
					<input type="hidden" name="expected_target" value={ candidate.Target.Key() }/>
					<button class={ buttonClass } type="submit">Confirm analysis update</button>
				</form>
			}
		</div>
	} else if offer == domain.AnalysisUpdateEndReadingFirst {
		<p class="analysis-update"><strong>{ analysisUpdateNotice }</strong> { analysisUpdateEndReadingFirst }</p>
	}
}
