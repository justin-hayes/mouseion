package webapp

import (
	"strings"

	"github.com/justin-hayes/mouseion/internal/domain"
)

templ ReadingPage(user domain.User, csrf string, readingView readingPageView, message string, pageError string) {
	@ShellLayout("Reading", &user, csrf, NavigationReading, shellStyleReading) {
		if readingView.CurrentReading == nil {
			@PageHeader("Reading", "Choose a To Read book when you are ready.", nil) {
				<a class="button button--outline" href="/library">Add books from My Books</a>
			}
		}
		if message != "" {
			@Feedback(FeedbackSuccess, "", message)
		}
		if pageError != "" {
			@Feedback(FeedbackError, "Action needed", pageError)
		}
		@CurrentReadingSection(readingView.CurrentReading, csrf, "", "", "")
		if readingView.CurrentReading != nil {
			<p class="reading-add-books"><a href="/library">Add books from My Books</a></p>
			@ReadingBrowse(readingView.Browse)
		}
	}
}

templ CurrentReadingFinishPage(user domain.User, csrf string, outcome currentReadingFinishView) {
	@ShellLayout("Reading finished", &user, csrf, NavigationReading, shellStyleReading) {
		@CurrentReadingFinish(outcome)
	}
}

templ CurrentReadingFinish(outcome currentReadingFinishView) {
	<section id="primary-goal-section" tabindex="-1" aria-labelledby="primary-goal-finish-heading" class="journey-goal journey-finish-outcome" data-focus-id="primary-goal-finish-heading">
		<h1 id="primary-goal-finish-heading" tabindex="-1">Reading finished</h1>
		<p role="status" aria-live="polite" aria-atomic="true">Reading finished for <strong>{ outcome.BookTitle }</strong>.</p>
		<h2>Vocabulary transition</h2>
		<p>{ finishGraduationText(outcome) }</p>
		<p><a class="button button--outline" href="/reading">Choose a To Read book</a></p>
	</section>
}

templ CurrentReadingSection(currentReading *readingBookView, csrf string, message, sectionError, focusBookID string) {
	<section id="primary-goal-section" tabindex="-1" aria-label="Current reading" class="journey-goal" data-focus-id={ currentReadingSectionFocusID(focusBookID) }>
		if message != "" {
			<p id="goal-section-status" class="journey-status" role="status" aria-live="polite" aria-atomic="true">{ message }</p>
		}
		if sectionError != "" {
			<article role="alert" class="feedback feedback--error"><strong>Action needed</strong><p>{ sectionError }</p></article>
		}
		if currentReading == nil {
			@EmptyState("No current Book yet", "Start an analyzed To Read book when you are ready to begin reading.")
		} else {
			@ReadingBookCard(*currentReading, csrf)
		}
	</section>
}

templ ReadingBookCard(item readingBookView, csrf string) {
	<article id={ readingBookAnchorID(readingBookID(item)) } tabindex="-1" data-focus-anchor class="resource-card journey-book journey-book--goal">
		<div class="journey-book__title-page journey-book__title-page--current">
			<div class="journey-book__cover">@BookCoverMedia(readingBookID(item), item.Book.BookTitle, item.Book.Source.Language, item.Cover)</div>
			<div class="journey-book__identity">
				if !item.ReadingSince.IsZero() {
					<p class="journey-book__since"><span>Reading since</span> <time datetime={ item.ReadingSince.Format("2006-01-02") }>{ item.ReadingSince.Format("January 2, 2006") }</time></p>
				}
				<h1 class="journey-book__title">
					if readingEntryAvailable(item) {
						<a href={ templ.SafeURL(readingBookURL(readingBookID(item))) }>{ canonicalBookTitle(item.Book) }</a>
					} else {
						{ canonicalBookTitle(item.Book) }
					}
				</h1>
				if author := canonicalBookAuthor(item.Book); author != "" {
					<p class="journey-book__author">By { author }</p>
				}
				@CurrentReadingLifecycleActions(item, csrf)
				if item.ReadingOnly {
					@StatusBadge("Reading only", StatusInfo)
					if item.CurrentReadingUnassessed {
						<p>No analysis or deck-eligible vocabulary exists yet, so Mouseion cannot model vocabulary for this Book. Reading directly is the current path.</p>
					} else {
						<p>Analysis evidence exists, but this Book has no deck-eligible vocabulary. Reading directly is the current path.</p>
					}
				}
			</div>
		</div>
		<div class="journey-book__evidence">
			<section class="goal-card__deck reading-note" aria-labelledby={ "goal-deck-heading-" + readingBookID(item) }>
				<h2 id={ "goal-deck-heading-" + readingBookID(item) }>Book deck</h2>
				if item.CurrentReadingSnapshotSize == 0 {
					<p>No Book deck is needed because no vocabulary was reserved for this reading.</p>
				} else if item.CurrentReadingPreparation != nil {
					<p class="metadata"><strong>Deck status</strong>: { deckPreparationTitle(*item.CurrentReadingPreparation) }.</p>
					@CurrentReadingDeckPreparationStatus(csrf, readingBookID(item), item.CurrentReadingSnapshotID, *item.CurrentReadingPreparation)
				} else if item.CurrentReadingDeckMissing {
					<p role="note" aria-live="polite"><strong>Deck missing.</strong> Prepare a deck for the vocabulary reserved for this reading.</p>
					<form method="post" action={ templ.SafeURL("/reading/books/"+readingBookID(item)+"/deck/retry") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ item.CurrentReadingSnapshotID }/><button class="button" type="submit">Prepare deck</button></form>
				} else if item.CurrentReadingDeckUnavailable {
					<p role="note" aria-live="polite"><strong>Deck unavailable.</strong> Retry preparation when it is available.</p>
					<form method="post" action={ templ.SafeURL("/reading/books/"+readingBookID(item)+"/deck/retry") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ item.CurrentReadingSnapshotID }/><button class="button" type="submit">Retry deck preparation</button></form>
				}
			</section>
			<details class="reading-supporting">
				<summary>Analysis, reservation, and preparation details</summary>
				<section class="reading-note" aria-labelledby={ "reading-note-reserved-" + readingBookID(item) }>
					<h2 id={ "reading-note-reserved-" + readingBookID(item) }>Reserved vocabulary</h2>
					<p>{ reservedVocabularySummary(item.CurrentReadingSnapshotSize) }</p>
				</section>
				<section class="reading-note" aria-labelledby={ "reading-note-analysis-" + readingBookID(item) }>
					<h2 id={ "reading-note-analysis-" + readingBookID(item) }>Analysis</h2>
					if readingEvidenceState(item) == "current" {
						<p>Current analysis evidence is available for this Book.</p>
					}
					@ReadingEvidence(item, csrf)
					if analysisReadyForReading(item.Book) {
						<p><a href={ templ.SafeURL("/reading/books/" + readingBookID(item) + "/lemma-review") }>Review flagged dictionary forms</a></p>
					}
				</section>
				if analysisReadyForReading(item.Book) {
					<section class="reading-note" aria-labelledby={ "reading-note-preparation-" + readingBookID(item) }>
						<h2 id={ "reading-note-preparation-" + readingBookID(item) }>Preparation</h2>
						<p><a href={ templ.SafeURL(readingDeckPreparationTaskURL(readingBookID(item))) }>Open focused deck task</a></p>
					</section>
				}
			</details>
		</div>
	</article>
}

templ CurrentReadingLifecycleActions(item readingBookView, csrf string) {
	<div class="journey-book__lifecycle" role="group" aria-label="Reading actions">
		@Confirmation("Mark reading finished", currentReadingCompletionConfirmationText(item), StatusNeutral) {
			<form method="post" action="/reading/finish" hx-post="/reading/finish" hx-target="#primary-goal-section" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_book_id" value={ readingBookID(item) }/><input type="hidden" name="expected_current_snapshot_id" value={ item.CurrentReadingSnapshotID }/><button class="button" type="submit">Mark reading finished</button></form>
		}
		<a class="button button--quiet" href="/reading/switch">Switch current reading</a>
		@Confirmation("End current reading", "This ends your commitment to this Book without finishing it. It releases only the Reserved vocabulary for this reading, records no completion, and accepts nothing as Known. The Book stays in To Read, and its analysis, decks, and history remain. Reading never ends on its own; choosing this Book again freezes a fresh snapshot.", StatusDanger) {
			<form method="post" action="/reading/end"><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_book_id" value={ readingBookID(item) }/><input type="hidden" name="expected_current_snapshot_id" value={ item.CurrentReadingSnapshotID }/><button type="submit" class="button button--outline">Confirm end current reading</button></form>
		}
	</div>
}

templ CurrentReadingDeckPreparationStatus(csrf, bookID, snapshotID string, preparation domain.DeckPreparation) {
	<p><strong>{ deckPreparationTitle(preparation) }.</strong> { deckPreparationSummary(preparation) }</p>
		if preparation.State == domain.DeckPreparationReady {
			if preparation.Error == domain.DeckPreparationRequiresRepreparationError {
				@Feedback(FeedbackError, "Action needed", domain.DeckPreparationRequiresRepreparationError)
				<form method="post" action={ templ.SafeURL("/reading/books/"+bookID+"/deck/retry") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ snapshotID }/><button class="button" type="submit">Re-prepare deck</button></form>
			} else if deckPreparationEmpty(preparation) {
				<p>No cards were created from this snapshot.</p>
			} else {
			<a class="button" download href={ templ.SafeURL("/deck-preparations/"+preparation.ID+"/download") }>Download deck</a>
			<form method="post" action={ templ.SafeURL("/deck-preparations/"+preparation.ID+"/reprepare") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ preparation.SnapshotID }/><button type="submit" class="button button--outline">Re-prepare with current Meaning evidence</button></form>
		}
	} else if deckPreparationActive(preparation) {
		<form method="post" action={ templ.SafeURL("/reading/books/"+bookID+"/deck/cancel") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ snapshotID }/><button class="button button--outline">Cancel preparation</button></form>
		if preparation.State == domain.DeckPreparationQueued {
			<form method="post" action={ templ.SafeURL("/reading/books/"+bookID+"/deck/retry") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ snapshotID }/><button class="button" type="submit">Retry deck preparation</button></form>
		}
	} else {
		if preparation.State == domain.DeckPreparationFailed {
			@Feedback(FeedbackError, "Action needed", preparationFailureMessageFor(preparation))
		} else if preparation.State == domain.DeckPreparationCancelled {
			@Feedback(FeedbackError, "Action needed", "Preparation was cancelled. Retry this exact reading snapshot when ready.")
		}
		<form method="post" action={ templ.SafeURL("/reading/books/"+bookID+"/deck/retry") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ snapshotID }/><button class="button" type="submit">Retry deck preparation</button></form>
	}
}

templ ReadingEvidence(item readingBookView, csrf string) {
	{{ action := readingAnalysisAction(item) }}
	{{ shadowed := item.Book.EvidenceClassification().ReAnalysisShadowed() }}
	if readingEvidenceState(item) != "current" {
		<p><strong>{ readingEvidenceLabel(item) }:</strong> { readingEvidenceDescription(item) }</p>
	}
	if shadowed {
		<p><strong>{ action.Status }.</strong> { action.Description }</p>
	}
	if readingEvidenceState(item) != "current" || shadowed {
		if action.Status != "" {
			if action.Label != "" && action.Submit {
				<form class="inline-action" method="post" action={ templ.SafeURL(action.URL) }><input type="hidden" name="csrf_token" value={ csrf }/><button type="submit" class="button button--outline">{ action.Label }</button></form>
			} else if action.Label != "" && action.URL != "" {
				<p><a href={ templ.SafeURL(action.URL) }>{ action.Label }</a></p>
			}
		}
	}
}

func readingEntryAvailable(item readingBookView) bool {
	return analysisReadyForReading(item.Book)
}

templ ReadingChooserPage(user domain.User, csrf string, chooser readingChooserPageView, message string, pageError string) {
	@ShellLayout(readingChooserPageTitle(chooser), &user, csrf, NavigationReading, shellStyleReading) {
		@PageHeader(readingChooserPageTitle(chooser), readingChooserPageDescription(chooser), nil) {
			if chooser.CurrentBookID != "" {
			<a class="button button--outline" href="/reading">Return to current reading</a>
			} else {
			<a class="button button--outline" href="/library?disposition=to_read">Review To Read books</a>
			}
		}
		if message != "" {
			@Feedback(FeedbackSuccess, "", message)
		}
		if pageError != "" {
			@Feedback(FeedbackError, "Action needed", pageError)
		}
		if chooser.Language == "" {
			<section class="reading-chooser-empty" aria-labelledby="reading-chooser-no-language-heading">
				<h2 id="reading-chooser-no-language-heading">Choose a study language</h2>
				<p>Reading candidates appear after My Books has a book with a chosen language.</p>
				<a class="button button--outline" href="/library">Open My Books</a>
			</section>
		}
		if chooser.Language != "" && readingChooserCandidateCount(chooser) == 0 {
			<section class="reading-chooser-empty" aria-labelledby="reading-chooser-empty-heading">
				if chooser.CurrentBookID != "" {
					<h2 id="reading-chooser-empty-heading">No other eligible To Read books</h2>
					<p>Your current book remains unchanged. Move another book to To Read or return to your current reading.</p>
					<a class="button button--outline" href="/reading">Return to current reading</a>
				} else {
					<h2 id="reading-chooser-empty-heading">No To Read books yet</h2>
					<p>Move a book to To Read in My Books when you may want to read it. You can leave other books in Inbox.</p>
					<a class="button button--outline" href="/library">Browse My Books</a>
				}
			</section>
		}
		if chooser.Language != "" && readingChooserCandidateCount(chooser) > 0 {
			if len(chooser.At99Plus)+len(chooser.At97To99)+len(chooser.At95To97)+len(chooser.Below95)+len(chooser.NoComparison) > 0 {
				<p>Coverage shows how often words in your Known vocabulary appear in each Book. These groups use exact counts, though the displayed percentages are rounded. They are not reading recommendations.</p>
			}
			@ReadingChooserBand("99% or above", "At least 99% of word occurrences are already Known.", chooser.At99Plus, csrf, chooser.CurrentBookID, chooser.CurrentSnapshotID)
			@ReadingChooserBand("97% to below 99%", "At least 97%, but less than 99%, of word occurrences are already Known.", chooser.At97To99, csrf, chooser.CurrentBookID, chooser.CurrentSnapshotID)
			@ReadingChooserBand("95% to below 97%", "At least 95%, but less than 97%, of word occurrences are already Known.", chooser.At95To97, csrf, chooser.CurrentBookID, chooser.CurrentSnapshotID)
			@ReadingChooserBand("Below 95%", "Less than 95% of word occurrences are already Known.", chooser.Below95, csrf, chooser.CurrentBookID, chooser.CurrentSnapshotID)
			@ReadingChooserBand("No vocabulary comparison", "There are no words to compare for coverage in this analysis.", chooser.NoComparison, csrf, chooser.CurrentBookID, chooser.CurrentSnapshotID)
			if len(chooser.InProgress) > 0 {
				<section aria-labelledby="reading-chooser-in-progress-heading">
					<h2 id="reading-chooser-in-progress-heading">Analysis in progress</h2>
					<p>Accepted analysis work remains visible here while it runs.</p>
					<ul class="reading-chooser-list" role="list">
						for _, item := range chooser.InProgress {
							@ReadingChooserBook(item, csrf, chooser.CurrentBookID, chooser.CurrentSnapshotID)
						}
					</ul>
				</section>
			}
			if len(chooser.Attention) > 0 {
				<section aria-labelledby="reading-chooser-unavailable-heading">
					<h2 id="reading-chooser-unavailable-heading">Not assessed</h2>
					<p>These Books need current content or analysis before their coverage can be compared.</p>
					<ul class="reading-chooser-list" role="list">
						for _, item := range chooser.Attention {
							@ReadingChooserBook(item, csrf, chooser.CurrentBookID, chooser.CurrentSnapshotID)
						}
					</ul>
				</section>
			}
		}
	}
}

templ ReadingChooserBand(title, description string, books []readingChooserBookView, csrf, currentBookID, currentSnapshotID string) {
	if len(books) > 0 {
		<section aria-label={ title }>
			<h2>{ title }</h2>
			<p>{ description }</p>
			<ul class="reading-chooser-list" role="list">
				for _, item := range books {
					@ReadingChooserBook(item, csrf, currentBookID, currentSnapshotID)
				}
			</ul>
		</section>
	}
}

templ ReadingChooserBook(item readingChooserBookView, csrf, currentBookID, currentSnapshotID string) {
	<li class="reading-chooser-book">
		<article class="reading-chooser-entry">
			<div class="reading-chooser-entry__cover">@BookCoverMedia(item.Book.Book.ID, item.Book.Book.Title, item.Book.Book.LanguageTag, item.Book.Cover)</div>
			<div class="reading-chooser-entry__identity">
					<h3 class="bibliographic-title">{ readingChooserBookTitle(item.Book) }</h3>
					if author := strings.TrimSpace(item.Book.Book.Author); author != "" {
						<p>By { author }</p>
					}
				<div class="reading-chooser-entry__actions">
					if item.Coverage != nil {
						if currentBookID != "" {
							@Confirmation("Switch to this book", "Switching atomically releases the current book's active reservation and freezes this To Read book's current analysis snapshot. The former current book remains To Read; its analysis, decks, and history remain. You can start either book again later.", StatusNeutral) {
								<form method="post" action={ templ.SafeURL("/reading/books/" + item.Book.Book.ID + "/switch") }>
									<input type="hidden" name="csrf_token" value={ csrf }/>
									<input type="hidden" name="expected_current_book_id" value={ currentBookID }/>
									<input type="hidden" name="expected_current_snapshot_id" value={ currentSnapshotID }/>
									<button class="button" type="submit">Confirm switch to this book</button>
								</form>
							}
						} else {
							@Confirmation("Start reading", "Starting this book makes it your current reading and freezes its current analysis and vocabulary snapshot.", StatusNeutral) {
								<form method="post" action={ templ.SafeURL("/reading/books/" + item.Book.Book.ID + "/start") }>
									<input type="hidden" name="csrf_token" value={ csrf }/>
									<button class="button" type="submit">Confirm start reading</button>
								</form>
							}
						}
						<p><a href={ templ.SafeURL("/reading/books/"+item.Book.Book.ID+"/lemma-review") }>Review a word in this Book</a></p>
					} else if item.State == readingChooserInProgress {
						if item.Book.Acquired.AnalysisJobID > 0 {
							<a href={ templ.SafeURL(readingChooserAnalysisJobURL(item.Book.Acquired.AnalysisJobID)) }>Review analysis progress</a>
						} else {
							<a href="/library?disposition=to_read">Review To Read books</a>
						}
					} else if item.State == readingChooserNeedsAttention {
						<form method="post" action={ templ.SafeURL("/reading/books/" + item.Book.Book.ID + "/reanalyze") }>
							<input type="hidden" name="csrf_token" value={ csrf }/>
							<button class="button button--outline" type="submit">Retry acquisition or analysis</button>
						</form>
					}
				</div>
			</div>
			<div class="reading-chooser-entry__evidence">
				if item.Coverage != nil {
					<p class="numeric"><strong>Known vocabulary coverage:</strong> { readingChooserCoverageDisplay(*item.Coverage) } ({ readingChooserCount(item.Coverage.KnownTokenCount) } of { readingChooserCount(item.Coverage.AnalyzableTokenCount) } word occurrences)</p>
					<p class="numeric">{ readingChooserNextMarkerText(*item.Coverage, item.Band) }</p>
					<details>
						<summary>Words to reach 95%, 97%, and 99%</summary>
						<ul>
						for _, threshold := range item.Coverage.Thresholds {
							if threshold.TargetPercent == 95 || threshold.TargetPercent == 97 || threshold.TargetPercent == 99 {
								<li class="numeric">{ readingChooserThresholdText(threshold) }</li>
							}
						}
						</ul>
						<p>These counts are distinct words, not the number of cards in a deck.</p>
					</details>
				} else {
					<p><strong>{ readingChooserStateLabel(item.State) }</strong> — { item.Description }</p>
					}
			</div>
		</article>
	</li>
}
