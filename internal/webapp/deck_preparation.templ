package webapp

import (
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/justin-hayes/mouseion/internal/domain"
)

templ DeckPreparationStatusPage(user domain.User, csrf string, preparation domain.DeckPreparation, resultURL string, journeyAction deckJourneyActionView) {
	@ShellLayout("Deck preparation", &user, csrf, NavigationLibrary, shellStyleReading) {
		if resultURL != "" {
			@Breadcrumb(resultURL, "Reading")
		}
		@PageHeader("Deck preparation", "Prepare an Anki deck from one exact completed analysis.", StatusBadge(deckPreparationTitle(preparation), deckPreparationStatusTone(preparation)))
		@DeckPreparationStatus(csrf, preparation, resultURL, journeyAction)
	}
}

templ DeckPreparationStatus(csrf string, preparation domain.DeckPreparation, resultURL string, journeyAction deckJourneyActionView) {
	@AsyncStatus(deckPreparationAttributes(preparation), "deck-preparation-status", deckPreparationTitle(preparation), deckPreparationSummary(preparation), preparationProgress(preparation), 100, deckPreparationActive(preparation), nil) {
		if resultURL != "" {
			<p><a href={ templ.SafeURL(resultURL) }>Return to book</a></p>
		}
		if preparation.TranslationEligible > 0 {
			<p><strong>Translations:</strong> { fmt.Sprintf("%d complete · %d unavailable · %d retrying · %d waiting", preparation.TranslationDone, preparation.TranslationFailed, preparation.TranslationRetrying, preparation.TranslationPending) }</p>
		}
		if preparation.BatchRequestCount > 0 {
			<p><strong>Batch translation:</strong> { fmt.Sprintf("%d of %d requests complete · %d failed · %d expired · completion can take hours (up to 24h)", preparation.BatchCompletedRequests, preparation.BatchRequestCount, preparation.BatchFailedRequests, preparation.BatchExpiredRequests) }</p>
		}
		for _, omission := range preparation.MeaningOmissions {
			<p><strong>Omitted { omission.TargetWord }:</strong> { omission.Reason }</p>
		}
		if preparation.DeckName != "" && !deckPreparationEmpty(preparation) {
			<p><strong>Deck:</strong> <code>{ preparation.DeckName }</code> · <strong>Filename:</strong> <code>{ preparation.Filename }</code></p>
		}
		if preparation.State == domain.DeckPreparationReady {
			if preparation.Error == domain.DeckPreparationRequiresRepreparationError {
				@Feedback(FeedbackError, "Action needed", domain.DeckPreparationRequiresRepreparationError)
				if preparation.GoalSnapshotID != "" && journeyAction.State == deckIsCurrentReading && journeyAction.BookID != "" {
					<form method="post" action={ templ.SafeURL("/reading/books/" + journeyAction.BookID + "/deck/retry") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ preparation.GoalSnapshotID }/><button class="button" type="submit">Re-prepare deck</button></form>
				} else if journeyAction.BookID == "" {
					<form method="post" action={ templ.SafeURL("/deck-preparations/" + preparation.ID + "/retry") }>
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<p>Re-preparation uses the configured translation provider to create contextual Glosses. If the provider is unavailable, the deck will remain failed and can be retried after configuration.</p>
						<button class="button" type="submit">Re-prepare deck</button>
					</form>
				} else {
					<p role="note">This Book is no longer Current reading. The preparation remains historical and cannot be submitted again.</p>
				}
			} else if deckPreparationEmpty(preparation) {
				@EmptyState("No recurring vocabulary", "This book has no recurring vocabulary to study, so no cards were created.")
			} else {
				if deckPreparationHasNewerRevision(preparation) {
					@Feedback(FeedbackInfo, "Updated deck revision available", fmt.Sprintf("Download deck revision %d to update your existing Anki notes in place.", preparation.DeckRevision))
				}
				<p><strong>Completeness:</strong> { deckCompletenessSummary(preparation) }</p>
				for _, evidence := range preparation.EvidenceCoverage {
					if evidence.Configured {
						<p><strong>Meaning evidence:</strong> { fmt.Sprintf("%s matched %d of %d targets; %d candidates frozen, %d omitted by the candidate bound", evidence.Source, evidence.Matched, evidence.Selected, evidence.Candidates, evidence.Omitted) }</p>
					} else {
						<p><strong>Meaning evidence:</strong> { fmt.Sprintf("%s index not configured; no local candidates were available for %d targets", evidence.Source, evidence.Selected) }</p>
					}
				}
				@ActionGroup() {
					<a class="button" download href={ templ.SafeURL("/deck-preparations/" + preparation.ID + "/download") }>Download deck</a>
					if preparation.GoalSnapshotID != "" && journeyAction.State == deckIsCurrentReading || journeyAction.BookID == "" {
						<form method="post" action={ templ.SafeURL("/deck-preparations/" + preparation.ID + "/reprepare") }>
							<input type="hidden" name="csrf_token" value={ csrf }/>
							<input type="hidden" name="expected_current_snapshot_id" value={ preparation.GoalSnapshotID }/>
							<button type="submit" class="button button--outline">Re-prepare with current Meaning evidence</button>
						</form>
					}
				}
				if preparation.GoalSnapshotID != "" && journeyAction.State == deckIsCurrentReading || journeyAction.BookID == "" {
					<p>Re-preparation remains bound to this snapshot while using current dictionary evidence and translation rules. The existing deck remains available for download.</p>
				} else if journeyAction.BookID == "" {
					<p>Re-preparation creates a new deck generation using current dictionary evidence and translation rules. The existing deck remains available for download.</p>
				} else {
					<p role="note">This Book is no longer Current reading. Its ready artifact remains available for download, but no new preparation can be submitted.</p>
				}
				@DeckJourneyAction(journeyAction)
			}
		} else if deckPreparationActive(preparation) {
			<form method="post" action={ templ.SafeURL("/deck-preparations/" + preparation.ID + "/cancel") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="button button--outline">Cancel preparation</button></form>
		} else {
			if preparation.State == domain.DeckPreparationFailed {
				@Feedback(FeedbackError, "Action needed", preparationFailureMessageFor(preparation))
			}
			if preparation.GoalSnapshotID != "" && journeyAction.State == deckIsCurrentReading && journeyAction.BookID != "" {
				<form method="post" action={ templ.SafeURL("/reading/books/" + journeyAction.BookID + "/deck/retry") }><input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="expected_current_snapshot_id" value={ preparation.GoalSnapshotID }/><button class="button" type="submit">Retry deck preparation</button></form>
			} else if journeyAction.BookID == "" {
				<form method="post" action={ templ.SafeURL("/deck-preparations/" + preparation.ID + "/retry") }>
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<p>Preparation requires the configured translation provider to create contextual Glosses. If it is unavailable, configure it and retry.</p>
					<button class="button" type="submit">Retry preparation</button>
				</form>
			} else {
				<p role="note">This Book is no longer Current reading. The submitted job may finish, but no retry can be submitted.</p>
			}
		}
	}
}

func bookHasCompletedAnalysis(book domain.SourceMaterialSummary) bool {
	return book.AnalysisStatus == "analyzed" && book.AnalysisState == "completed" && book.AnalysisRunID != "" && book.CorpusID != ""
}

func journeyDeckPreparationTaskURL(bookID string) string {
	return "/reading/books/" + url.PathEscape(bookID) + "/deck/preparations/new"
}

func completedAtLabel(value *time.Time) string {
	if value == nil || value.IsZero() {
		return "Unavailable"
	}
	return value.UTC().Format("2006-01-02 15:04:05 UTC")
}

func deckCompletenessSummary(preparation domain.DeckPreparation) string {
	glossSummary := fmt.Sprintf("%d with fallback gloss", preparation.CardsWithFallbackGloss)
	if preparation.ContextualGlossesReported {
		glossSummary = fmt.Sprintf("%d with contextual Gloss · %d inferred from sentence context", preparation.ContextualGlosses, preparation.ContextOnlyGlosses)
	}
	return fmt.Sprintf("%d cards · %d with English · %d with contextual sentence translations · %s · %d omitted for sentence quality", preparation.TotalCards, preparation.CardsWithEnglish, preparation.CardsWithContextualSentenceTranslations, glossSummary, preparation.QualityOmissions)
}

func knownCoveragePercent(coverage domain.AnalysisCoverage) float64 {
	if coverage.AnalyzableTokenCount == 0 {
		return 0
	}
	return min(float64(coverage.KnownTokenCount)*100/float64(coverage.AnalyzableTokenCount), 100)
}

func corpusUnitLabel(unit domain.CorpusSelectedUnit) string {
	if strings.TrimSpace(unit.Title) != "" {
		return unit.Title
	}
	if strings.TrimSpace(unit.SourceHref) != "" {
		return unit.SourceHref
	}
	return unit.UnitID
}

templ DeckJourneyAction(action deckJourneyActionView) {
	if action.State != deckJourneyUnknown {
		<div id={ deckJourneyActionID(action.BookID) } role="status" aria-live="polite" aria-atomic="true">
			if action.Message != "" {
				if strings.Contains(action.Message, "changed since") {
					<p role="alert">{ action.Message }</p>
				} else {
					<p role="status">{ action.Message }</p>
				}
			}
			if action.Error != "" {
				<p role="alert">{ action.Error }</p>
			}
			if action.State == deckJourneyNotMember {
				<p><strong>Not in To Read.</strong> Manage this book's disposition in <a href="/library">My Books</a>.</p>
			} else if action.State == deckIsToRead {
				<p><strong>To Read.</strong> This book is already in To Read.</p>
				<p><a href={ templ.SafeURL("/reading#" + journeyBookAnchorID(action.BookID)) }>View in Reading</a></p>
			} else if action.State == deckIsCurrentReading {
				<p><strong>Current Book.</strong> This deck is preparation for the Book you are reading now.</p>
				<p><a href={ templ.SafeURL("/reading#" + journeyBookAnchorID(action.BookID)) }>View current book in Reading</a></p>
			}
		</div>
	}
}

templ JourneyDeckPreparationPage(user domain.User, csrf string, task journeyDeckPreparationView, resultURL string) {
	@ShellLayout("Prepare deck · "+canonicalBookTitle(task.Book), &user, csrf, NavigationReadingJourney, shellStyleReading) {
		@Breadcrumb(resultURL, "Reading")
		@PageHeader("Prepare a deck", canonicalBookTitle(task.Book), StatusBadge("Exact source", StatusInfo))
		<section class="narrow" aria-labelledby="journey-deck-task-heading">
			<h2 id="journey-deck-task-heading">Deck preparation task</h2>
			<p>This task belongs to <strong>{ canonicalBookTitle(task.Book) }</strong>. Preparation never changes reading state, Known vocabulary, or Reserved vocabulary.</p>
			<dl>
				<dt>Book language</dt>
				<dd>{ task.Book.Source.Language }</dd>
				<dt>Current analysis</dt>
				<dd><code>{ task.AnalysisRunID }</code> from the current EPUB snapshot <code>{ task.Book.Source.ContentSnapshotID }</code></dd>
				if task.Goal {
					<dt>Frozen reading snapshot</dt>
					<dd><code>{ task.GoalSnapshotID }</code> · { fmt.Sprintf("%d frozen identities", task.GoalSnapshotSize) }</dd>
				}
			</dl>
			if task.Unavailable {
				@Feedback(FeedbackWarning, "Deck preparation unavailable", "The preparation service could not verify this exact source. No deck action was started.")
			} else if task.Goal {
				if task.GoalSnapshotSize == 0 {
					@EmptyState("No deck needed", "This frozen reading snapshot contains no vocabulary identities, so no cards will be created.")
				} else if task.Preparation != nil {
					@DeckPreparationStatus(csrf, *task.Preparation, resultURL, deckJourneyActionView{BookID: task.BookID, State: deckIsCurrentReading})
				} else {
					<p role="note"><strong>Deck state: Missing.</strong> This exact reading snapshot remains unchanged. Prepare it when ready.</p>
					<form class="focused-deck-form" method="post" action={ templ.SafeURL("/reading/books/" + url.PathEscape(task.BookID) + "/deck/preparations") } data-prepare-deck>
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<input type="hidden" name="expected_current_snapshot_id" value={ task.GoalSnapshotID }/>
						<button type="submit">Prepare deck</button>
					</form>
					<section data-deck-preparation role="status" aria-live="polite" aria-atomic="true" hidden></section>
				}
			} else if task.Preparation != nil {
				@DeckPreparationStatus(csrf, *task.Preparation, resultURL, deckJourneyActionView{BookID: task.BookID, State: deckIsToRead})
			} else {
				if task.Missing {
					<p role="note"><strong>Deck state: Not prepared.</strong> No artifact exists for this exact current analysis.</p>
				}
				<form class="focused-deck-form" method="post" action={ templ.SafeURL("/reading/books/" + url.PathEscape(task.BookID) + "/deck/preparations") } data-prepare-deck>
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<p>Preparation uses the configured translation provider to create contextual Glosses. Only the target, one representative sentence, and public lexical evidence are sent. If the provider is unavailable, preparation fails without creating a local-only deck; configure it and retry.</p>
					<button type="submit">Prepare deck</button>
				</form>
				<section data-deck-preparation role="status" aria-live="polite" aria-atomic="true" hidden></section>
			}
			<p><a href={ templ.SafeURL(resultURL) }>Back to this Book in Reading</a></p>
		</section>
	}
}
