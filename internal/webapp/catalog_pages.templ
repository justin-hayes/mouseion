package webapp

import (
	"fmt"

	"github.com/justin-hayes/mouseion/internal/domain"
)

// CatalogPage is the single learner-facing Catalog. One search and language
// filter cover the built-in Classical catalog and every OPDS source; results
// are grouped by source and connection configuration stays on Manage sources.
templ CatalogPage(user domain.User, csrf string, connections []domain.OpdsConnection, message, errorMessage string, statuses map[string]domain.CatalogueSyncStatus, browse catalogBrowseView) {
	@ShellLayout("Catalog", &user, csrf, NavigationCatalogs, shellStyleCatalogs, shellStyleNoStudyLanguage) {
		@PageHeader("Catalog", "Find a text in the Classical catalog or your OPDS sources. Search and the language filter cover every source.", nil) {
			<a class="button button--outline" href="/catalogs/classical">Classical catalog</a>
			<a class="button button--outline" href="/catalogs/sources">Manage sources</a>
		}
		if message != "" {
			if browse.FocusReadBook {
				<div id="catalog-read-confirmation" tabindex="-1" autofocus>
					@Feedback(FeedbackSuccess, "", message) {
						<a href={ templ.SafeURL(catalogBookInMyBooksURL(browse.ReadBookID)) }>View in My Books</a>
					}
				</div>
			} else if browse.FocusAddedBook {
				<div id="catalog-add-confirmation" tabindex="-1" autofocus>
					@Feedback(FeedbackSuccess, "", message) {
						<a href={ templ.SafeURL(catalogBookInMyBooksURL(browse.AddedBookID)) }>View in My Books</a>
					}
				</div>
			} else {
				@Feedback(FeedbackSuccess, "", message)
			}
		}
		if errorMessage != "" {
			@Feedback(FeedbackError, "", errorMessage)
		}
		@CatalogSearchForm(browse)
		@CatalogSourceStatuses(csrf, connections, statuses)
		@CatalogResults(csrf, browse)
	}
}

// CatalogSearchForm is the one search and language filter over every source.
// It is an ordinary GET form, so the Catalog works without JavaScript and the
// filter is carried in real links.
templ CatalogSearchForm(browse catalogBrowseView) {
	<section class="catalog-finder" aria-label="Find in the Catalog">
		<form class="catalog-search" role="search" method="get" action="/catalogs">
			<div class="catalog-search__text">
				<label class="sr-only" for="catalog-search-query">Search the Catalog</label>
				<input class="input" id="catalog-search-query" type="search" name="q" value={ browse.Query } placeholder="Title, author, Greek title, or Book number"/>
			</div>
			<div class="catalog-search__language">
				<label for="catalog-language-filter">Language</label>
				<select id="catalog-language-filter" name="language">
					for _, option := range browse.LanguageOptions {
						if option.Selected {
							<option value={ option.Value } selected>{ option.Label }</option>
						} else {
							<option value={ option.Value }>{ option.Label }</option>
						}
					}
				</select>
			</div>
			<button class="button" type="submit">Search</button>
			if browse.Query != "" {
				<a class="button button--outline" href={ templ.SafeURL(browse.ClearSearchURL) }>Clear search</a>
			}
		</form>
	</section>
}

// CatalogResults groups every matching Work or entry under its source. One
// status line announces the result update; the sources render their own
// existing presentation below it.
templ CatalogResults(csrf string, browse catalogBrowseView) {
	<div id="catalog-results" aria-labelledby="catalog-results-heading">
		<h2 id="catalog-results-heading" class="sr-only">Catalog results</h2>
		<p id="catalog-result-summary" class="catalog-result-summary" role="status" aria-live="polite" aria-atomic="true">{ browse.ResultSummary }</p>
		if browse.EmptyTitle != "" {
			@EmptyState(browse.EmptyTitle, browse.EmptyMessage) {
				if browse.EmptyActionURL != "" {
					<a href={ templ.SafeURL(browse.EmptyActionURL) }>{ browse.EmptyActionLabel }</a>
				}
			}
		}
		if browse.ClassicalTotal > 0 {
			<section class="catalog-source" id="catalog-source-classical" aria-labelledby="catalog-source-classical-title">
				<header class="catalog-source__header">
					<h2 id="catalog-source-classical-title">Classical catalog</h2>
					<p>{ catalogCountLabel(browse.ClassicalTotal, "work", "works") }</p>
				</header>
				@ClassicalCatalogIndexSections(csrf, browse.ClassicalAuthors, browse.ClassicalView)
			</section>
		}
		for _, section := range browse.Sources {
			if section.Total > 0 {
				@CatalogOpdsSection(csrf, section)
			}
		}
	</div>
}

// CatalogOpdsSection is one connection's cover grid and paging. It reads only
// the local Catalog index.
templ CatalogOpdsSection(csrf string, section catalogOpdsSection) {
	<section class="catalog-source" id={ "catalog-source-" + section.Connection.ID } aria-labelledby={ "catalog-source-title-" + section.Connection.ID }>
		<header class="catalog-source__header">
			<h2 id={ "catalog-source-title-" + section.Connection.ID }>{ section.Connection.Name }</h2>
			<p>{ catalogCountLabel(section.Total, "entry", "entries") }</p>
		</header>
		<ul class="catalog-cover-grid" role="list">
			for _, entry := range section.Entries {
				<li>@CatalogEntryCard(csrf, entry)</li>
			}
		</ul>
		if section.PageCount > 1 {
			<nav class="catalog-pagination" aria-label={ "Pages of " + section.Connection.Name }>
				if section.PreviousURL != "" {
					<a class="button button--outline" href={ templ.SafeURL(section.PreviousURL) }>Previous</a>
				}
				<span>Page { fmt.Sprintf("%d", section.Page) } of { fmt.Sprintf("%d", section.PageCount) }</span>
				if section.NextURL != "" {
					<a class="button button--outline" href={ templ.SafeURL(section.NextURL) }>Next</a>
				}
			</nav>
		}
	</section>
}

// CatalogEntryCard is one OPDS Catalog entry: cover, title, author, and its
// ownership state. An unowned entry offers Add, which says plainly that it
// downloads and analyzes the text, and the secondary I've read this, which
// records a Book the learner read outside Mouseion without downloading it. The
// Catalog index stores advertised cover
// provenance, but upstream URLs are never sent to the browser (ADR 0077); until
// local cover retention reaches index entries, the shared cover frame shows the
// title's initial.
templ CatalogEntryCard(csrf string, entry domain.CatalogueEntry) {
	<article class="catalog-entry" aria-labelledby={ "catalog-entry-title-" + entry.Index.EntryIdentifier }>
		@BookCoverMedia("", entry.Index.Title, entry.Index.LanguageTag, domain.BookCover{})
		<h3 class="catalog-entry__title bibliographic-title" id={ "catalog-entry-title-" + entry.Index.EntryIdentifier }>{ entry.Index.Title }</h3>
		if entry.Index.Author != "" {
			<p class="catalog-entry__author">{ entry.Index.Author }</p>
		}
		if entry.BookID != "" {
			<p class="catalog-entry__ownership"><a href={ templ.SafeURL(catalogBookInMyBooksURL(entry.BookID)) }>In My Books</a></p>
		} else {
			<form class="catalog-entry__add" method="post" action={ templ.SafeURL("/catalogs/sources/" + entry.Index.ConnectionID + "/add") }>
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<input type="hidden" name="entry_identifier" value={ entry.Index.EntryIdentifier }/>
				<p class="catalog-entry__add-copy">Adding downloads and analyzes the text.</p>
				<button class="button button--outline" type="submit">Add</button>
			</form>
			<form class="catalog-entry__read" method="post" action={ templ.SafeURL("/catalogs/sources/" + entry.Index.ConnectionID + "/previously-read") }>
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<input type="hidden" name="entry_identifier" value={ entry.Index.EntryIdentifier }/>
				<button class="button button--outline" type="submit">I've read this</button>
			</form>
		}
	</article>
}

// CatalogSourceStatuses is the Catalog page's compact source summary. Each
// connection names itself, shows its sync state, and offers Sync now. A failed
// sync points at Manage sources for recovery.
templ CatalogSourceStatuses(csrf string, connections []domain.OpdsConnection, statuses map[string]domain.CatalogueSyncStatus) {
	if len(connections) == 0 {
		@EmptyState("No OPDS catalogs connected", "Connect a Calibre-Web or other OPDS catalog to sync its ready-language metadata.") {
			<a href="/catalogs/sources">Connect an OPDS catalog</a>
		}
	} else {
		<section class="catalog-sources" aria-labelledby="catalog-sources-heading">
			<h2 id="catalog-sources-heading">OPDS sources</h2>
			<ul class="catalog-source-status">
				for _, connection := range connections {
					{{ view := catalogueSyncConnectionViewFor(connection, statuses) }}
					<li id={ "source-status-" + connection.ID } aria-labelledby={ "source-status-name-" + connection.ID }>
						<p class="catalog-source-status__line" role="status" aria-live="polite" aria-atomic="true"><strong id={ "source-status-name-" + connection.ID }>{ connection.Name }</strong> @StatusBadge(view.State, view.Tone())</p>
						if view.HasLastSyncedAt {
							<p>Last successful sync: <time datetime={ view.LastSyncedAtISO }>{ view.LastSyncedAt }</time></p>
						}
						if view.Failed {
							<p>{ view.Error } <a href={ templ.SafeURL("/catalogs/sources#connection-" + connection.ID) }>Manage sources</a></p>
						} else if view.Message != "" {
							<p>{ view.Message }</p>
						}
						if view.UpsertSummary != "" {
							<p>{ view.UpsertSummary }</p>
						}
						<div class="action-group">@CatalogueSyncControl(csrf, connection, view, "catalog")</div>
					</li>
				}
			</ul>
		</section>
	}
}

// ManageSourcesPage configures the OPDS connections that feed the Catalog. It
// owns credentials, Sync now, failure recovery, and deletion.
templ ManageSourcesPage(user domain.User, csrf string, connections []domain.OpdsConnection, message, errorMessage, bookID string, statuses map[string]domain.CatalogueSyncStatus) {
	@ShellLayout("Manage sources", &user, csrf, NavigationCatalogs, shellStyleCatalogs, shellStyleNoStudyLanguage) {
		@Breadcrumb("/catalogs", "Catalog")
		@PageHeader("Manage sources", "Add, edit and remove the OPDS catalogs that feed the Catalog.", nil)
		if message != "" {
			@Feedback(FeedbackSuccess, "", message)
		}
		if errorMessage != "" {
			@Feedback(FeedbackError, "", errorMessage)
		}
		if len(connections) == 0 {
			@EmptyState("Add your first catalog connection", "A connection lets Mouseion sync ready-language bibliographic metadata into My Books. Your credentials stay private and are never shown again.") {
				<a href="#catalog-connection-form">Add catalog connection</a>
			}
		}
		<article id="catalog-connection-form"><h2>Add catalog connection</h2><form class="catalog-connection-form" method="post" action="/catalogs/sources"><input type="hidden" name="csrf_token" value={ csrf }/>
			if bookID != "" {
				<input type="hidden" name="book_id" value={ bookID }/>
			}
		<div class="form-grid"><label>Name<input class="input" name="name" required/></label><label>Catalog URL<input class="input" type="url" name="url" required placeholder="https://example.com/opds"/></label></div><div class="form-grid"><label>Username <small>(optional)</small><input class="input" name="username" autocomplete="username"/></label><label>Password <small>(optional, encrypted at rest)</small><input class="input" type="password" name="password" autocomplete="new-password"/></label></div><button class="button" type="submit">Add catalog</button></form></article>
		if len(connections) > 0 {
			<h2>Connected sources</h2>
			<p>Edit a saved connection or remove future catalog access. Books already in My Books and their artifacts remain.</p>
		}
		<div class="catalog-list">
			for _, connection := range connections {
				{{ view := catalogueSyncConnectionViewFor(connection, statuses) }}
				<article class="catalog-record" id={ "connection-" + connection.ID } aria-labelledby={ "connection-name-" + connection.ID }><header><h3 id={ "connection-name-" + connection.ID }>{ connection.Name }</h3></header><div class="catalog-record__status" id={ "connection-status-" + connection.ID } role="status" aria-live="polite" aria-atomic="true">@CatalogueSyncConnectionStatus(view)</div>@CatalogueSyncConnectionActions(csrf, connection, view)<div class="catalog-record__details"><p class="break">{ safeConnectionURL(connection.URL) }</p><p>{ credentialSummary(connection) }</p><details id={ "edit-connection-" + connection.ID }><summary>Edit connection</summary><form class="catalog-connection-form" method="post" action={ templ.SafeURL("/catalogs/sources/" + connection.ID) }><input type="hidden" name="csrf_token" value={ csrf }/><div class="form-grid"><label>Name<input class="input" name="name" value={ connection.Name } required/></label><label>Catalog URL <small>(leave blank to keep current URL)</small><input class="input" type="url" name="url" value={ connectionURLForEdit(connection) } placeholder="Leave blank to keep current URL"/></label></div><div class="form-grid"><label>Username<input class="input" name="username" value={ connection.Username } autocomplete="username"/></label><label>New password <small>(leave blank to keep current)</small><input class="input" type="password" name="password" autocomplete="new-password"/></label></div><button class="button button--outline" type="submit">Save changes</button></form></details>@Confirmation("Delete catalog connection", "This removes future access through this connection and its credentials. Books already in My Books and their artifacts remain available.", StatusDanger) {<form method="post" action={ templ.SafeURL("/catalogs/sources/" + connection.ID + "/delete") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="button button--outline" type="submit">Confirm deletion</button></form>}</div></article>
			}
		</div>
	}
}
