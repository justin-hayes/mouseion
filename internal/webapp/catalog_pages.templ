package webapp

import (
	"github.com/justin-hayes/mouseion/internal/classical"
	"github.com/justin-hayes/mouseion/internal/domain"
)

// CatalogPage is the single learner-facing Catalog. It keeps the built-in
// Classical catalog and shows one sync status line per OPDS source; connection
// configuration lives on Manage sources.
templ CatalogPage(user domain.User, csrf string, connections []domain.OpdsConnection, message, errorMessage string, statuses map[string]domain.CatalogueSyncStatus, catalog *classical.Catalog) {
	@ShellLayout("Catalog", &user, csrf, NavigationCatalogs, shellStyleCatalogs) {
		@PageHeader("Catalog", "Find texts from the Classical catalog and your OPDS sources, and add them to My Books.", nil) {
			<a role="button" class="button button--outline" href="/catalogs/sources">Manage sources</a>
		}
		if message != "" {
			@Feedback(FeedbackSuccess, "", message)
		}
		if errorMessage != "" {
			@Feedback(FeedbackError, "", errorMessage)
		}
		@CatalogSourceStatuses(csrf, connections, statuses)
		@ClassicalCatalogRecord(catalog.Counts())
	}
}

// CatalogSourceStatuses is the Catalog header's compact source summary. Each
// connection names itself, shows its sync state, and offers Sync now. A failed
// sync points at Manage sources for recovery.
templ CatalogSourceStatuses(csrf string, connections []domain.OpdsConnection, statuses map[string]domain.CatalogueSyncStatus) {
	if len(connections) == 0 {
		@EmptyState("No OPDS catalogs connected", "Connect a Calibre-Web or other OPDS catalog to find its ready-language books in the Catalog.") {
			<a role="button" href="/catalogs/sources">Connect an OPDS catalog</a>
		}
	} else {
		<section class="catalog-sources" aria-labelledby="catalog-sources-heading">
			<h2 id="catalog-sources-heading">OPDS sources</h2>
			<ul class="catalog-source-status">
				for _, connection := range connections {
					{{ view := catalogueSyncConnectionViewFor(connection, statuses) }}
					<li id={ "source-status-" + connection.ID } aria-labelledby={ "source-status-name-" + connection.ID }>
						<p class="catalog-source-status__line"><strong id={ "source-status-name-" + connection.ID }>{ connection.Name }</strong> @StatusBadge(view.State, catalogueSyncStatusTone(view))</p>
						if view.HasLastSyncedAt {
							<p>Last successful sync: <time datetime={ view.LastSyncedAtISO }>{ view.LastSyncedAt }</time></p>
						}
						if view.Failed {
							<p>{ view.Error } <a href={ templ.SafeURL("/catalogs/sources#connection-" + connection.ID) }>Manage sources</a></p>
						} else if view.Message != "" {
							<p>{ view.Message }</p>
						}
						if view.UpsertSummary != "" {
							<p>{ view.UpsertSummary }</p>
						}
						<div class="action-group">
							<form method="post" action={ templ.SafeURL("/connections/" + connection.ID + "/sync") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="button" type="submit" disabled?={ view.Syncing }>Sync now</button></form>
							if view.Syncing {
								<span>Sync already in progress.</span>
								<a href="/jobs">View job status</a>
							}
						</div>
					</li>
				}
			</ul>
		</section>
	}
}

// ManageSourcesPage configures the OPDS connections that feed the Catalog. It
// owns credentials, Sync now, failure recovery, and deletion.
templ ManageSourcesPage(user domain.User, csrf string, connections []domain.OpdsConnection, message, errorMessage, bookID string, statuses map[string]domain.CatalogueSyncStatus) {
	@ShellLayout("Manage sources", &user, csrf, NavigationCatalogs, shellStyleCatalogs) {
		@Breadcrumb("/catalogs", "Catalog")
		@PageHeader("Manage sources", "Add, edit and remove the OPDS catalogs that feed the Catalog.", nil)
		if message != "" {
			@Feedback(FeedbackSuccess, "", message)
		}
		if errorMessage != "" {
			@Feedback(FeedbackError, "", errorMessage)
		}
		if len(connections) == 0 {
			@EmptyState("Add your first catalog connection", "A connection lets Mouseion sync ready-language bibliographic metadata into the Catalog. Your credentials stay private and are never shown again.") {
				<a href="#catalog-connection-form">Add catalog connection</a>
			}
		}
		<article id="catalog-connection-form"><h2>Add catalog connection</h2><form class="catalog-connection-form" method="post" action="/catalogs/sources"><input type="hidden" name="csrf_token" value={ csrf }/>
			if bookID != "" {
				<input type="hidden" name="book_id" value={ bookID }/>
			}
		<div class="form-grid"><label>Name<input class="input" name="name" required/></label><label>Catalog URL<input class="input" type="url" name="url" required placeholder="https://example.com/opds"/></label></div><div class="form-grid"><label>Username <small>(optional)</small><input class="input" name="username" autocomplete="username"/></label><label>Password <small>(optional, encrypted at rest)</small><input class="input" type="password" name="password" autocomplete="new-password"/></label></div><button class="button" type="submit">Add catalog</button></form></article>
		if len(connections) > 0 {
			<h2>Connected sources</h2>
			<p>Edit a saved connection or remove future catalog access. Books already in My Books and their artifacts remain.</p>
		}
		<div class="catalog-list">
			for _, connection := range connections {
				{{ view := catalogueSyncConnectionViewFor(connection, statuses) }}
				<article class="catalog-record" id={ "connection-" + connection.ID } aria-labelledby={ "connection-name-" + connection.ID }><header><h3 id={ "connection-name-" + connection.ID }>{ connection.Name }</h3></header><div class="catalog-record__status" id={ "connection-status-" + connection.ID } role="status" aria-live="polite" aria-atomic="true">@CatalogueSyncConnectionStatus(view)</div>@CatalogueSyncConnectionActions(csrf, connection, view)<div class="catalog-record__details"><p class="break">{ safeConnectionURL(connection.URL) }</p><p>{ credentialSummary(connection) }</p><details id={ "edit-connection-" + connection.ID }><summary>Edit connection</summary><form class="catalog-connection-form" method="post" action={ templ.SafeURL("/catalogs/sources/" + connection.ID) }><input type="hidden" name="csrf_token" value={ csrf }/><div class="form-grid"><label>Name<input class="input" name="name" value={ connection.Name } required/></label><label>Catalog URL <small>(leave blank to keep current URL)</small><input class="input" type="url" name="url" value={ connectionURLForEdit(connection) } placeholder="Leave blank to keep current URL"/></label></div><div class="form-grid"><label>Username<input class="input" name="username" value={ connection.Username } autocomplete="username"/></label><label>New password <small>(leave blank to keep current)</small><input class="input" type="password" name="password" autocomplete="new-password"/></label></div><button class="button button--outline" type="submit">Save changes</button></form></details>@Confirmation("Delete catalog connection", "This removes future access through this connection and its credentials. Books already in My Books and their artifacts remain available.", StatusDanger) {<form method="post" action={ templ.SafeURL("/catalogs/sources/" + connection.ID + "/delete") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="button button--outline" type="submit">Confirm deletion</button></form>}</div></article>
			}
		</div>
	}
}
